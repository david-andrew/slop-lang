# A language server (`sloppy lsp`): the Language Server Protocol over standard input and output,
# for editors. Each question about a program is answered by checking it in a child process
# (fork): the checker then always starts afresh, sees the editor's unsaved text (ide_texts), and
# writes what it learned as lines (see ide.jo). Checks take tens of milliseconds, so there is no
# incremental state to keep right; results of the last check are kept for hover, go to
# definition, references, rename, signature help and inlay hints.

use 'util.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'ide.jo'
use 'main.jo'

# ---------------- JSON ----------------
enum JK: null_, bool_, num, str_, arr, obj

struct JNode:
    kind: JK
    s: str          # string value (or object key of this member)
    key: str
    n: int
    first: i32      # arrays and objects: first element/member
    next: i32       # the next element/member of the parent

jn: JNode[] = [JNode()]
js = ""
jp = 0

json_parse = (s: str) -> int:
    jn = [JNode()]
    js = s
    jp = 0
    v = json_value()
    js = ""
    v

json_ws = ():
    loop jp < len(js) and (js[jp] == ' ' or js[jp] == '\t' or js[jp] == '\n' or js[jp] == '\r'): jp += 1

json_new = (k: JK) -> int:
    jn.push(JNode(kind = k))
    jn.len() - 1

json_hex = (c: u8) -> int:
    if c >= '0' and c <= '9': return int(c) - 48
    if c >= 'a' and c <= 'f': return int(c) - 87
    if c >= 'A' and c <= 'F': return int(c) - 55
    0

utf8_of = (cp: int) -> str:
    b: u8[]
    if cp < 0x80: b.push(u8(cp))
    else if cp < 0x800:
        b.push(u8(0xC0 | (cp >> 6)))
        b.push(u8(0x80 | (cp & 63)))
    else if cp < 0x10000:
        b.push(u8(0xE0 | (cp >> 12)))
        b.push(u8(0x80 | ((cp >> 6) & 63)))
        b.push(u8(0x80 | (cp & 63)))
    else:
        b.push(u8(0xF0 | (cp >> 18)))
        b.push(u8(0x80 | ((cp >> 12) & 63)))
        b.push(u8(0x80 | ((cp >> 6) & 63)))
        b.push(u8(0x80 | (cp & 63)))
    str_from_bytes(b)

json_string = () -> str:
    jp += 1
    start = jp
    # (no escapes: one slice)
    loop jp < len(js) and js[jp] != '"' and js[jp] != '\\': jp += 1
    if jp < len(js) and js[jp] == '"':
        jp += 1
        return js[start..jp - 1)
    out: u8[]
    loop k in [start..jp): out.push(js[k])
    loop jp < len(js) and js[jp] != '"':
        c = js[jp]
        if c == '\\' and jp + 1 < len(js):
            jp += 1
            e = js[jp]
            if e == 'n': out.push('\n')
            else if e == 't': out.push('\t')
            else if e == 'r': out.push('\r')
            else if e == 'b': out.push(8)
            else if e == 'f': out.push(12)
            else if e == 'u' and jp + 4 < len(js):
                cp = 0
                loop k in [1..5): cp = cp * 16 + json_hex(js[jp + k])
                jp += 4
                # a surrogate pair
                if cp >= 0xD800 and cp < 0xDC00 and jp + 6 < len(js) and js[jp + 1] == '\\' and js[jp + 2] == 'u':
                    lo = 0
                    loop k in [3..7): lo = lo * 16 + json_hex(js[jp + k])
                    if lo >= 0xDC00 and lo < 0xE000:
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                        jp += 6
                loop b in utf8_of(cp): out.push(b)
            else: out.push(e)
        else: out.push(c)
        jp += 1
    jp += 1
    str_from_bytes(out)

json_value = () -> int:
    json_ws()
    if jp >= len(js): return 0
    c = js[jp]
    if c == '{{':
        o = json_new(.obj)
        jp += 1
        last = 0
        loop true:
            json_ws()
            if jp >= len(js) or js[jp] == '}}': break
            if js[jp] == ',':
                jp += 1
                continue
            if js[jp] != '"': break
            k = json_string()
            json_ws()
            if jp < len(js) and js[jp] == ':': jp += 1
            v = json_value()
            if v == 0: v = json_new(.null_)
            jn[v].key = k
            if last == 0: jn[o].first = i32(v)
            else: jn[last].next = i32(v)
            last = v
        jp += 1
        return o
    if c == '[':
        a = json_new(.arr)
        jp += 1
        last = 0
        loop true:
            json_ws()
            if jp >= len(js) or js[jp] == ']': break
            if js[jp] == ',':
                jp += 1
                continue
            v = json_value()
            if v == 0: break
            if last == 0: jn[a].first = i32(v)
            else: jn[last].next = i32(v)
            last = v
        jp += 1
        return a
    if c == '"':
        v = json_new(.str_)
        jn[v].s = json_string()
        return v
    if c == 't' or c == 'f':
        v = json_new(.bool_)
        if c == 't':
            jn[v].n = 1
            jp += 4
        else: jp += 5
        return v
    if c == 'n':
        jp += 4
        return json_new(.null_)
    start = jp
    loop jp < len(js) and (is_digit(js[jp]) or js[jp] == '-' or js[jp] == '+' or js[jp] == '.' or js[jp] == 'e' or js[jp] == 'E'): jp += 1
    v = json_new(.num)
    jn[v].s = js[start..jp)
    t = js[start..jp)
    d = find_byte(t, '.')
    if d >= 0: t = t[..d)
    jn[v].n = to_int(t) ?? 0
    v

jget = (o: int, key: str) -> int:
    if o == 0 or jn[o].kind != .obj: return 0
    c = int(jn[o].first)
    loop c != 0:
        if jn[c].key == key: return c
        c = int(jn[c].next)
    0

jpath = (o: int, a: str, b: str) -> int: jget(jget(o, a), b)
jstr = (v: int) -> str:
    if v == 0 or jn[v].kind != .str_: return ""
    jn[v].s
jint = (v: int) -> int:
    if v == 0: return 0
    jn[v].n
jbool = (v: int) -> bool: v != 0 and jn[v].kind == .bool_ and jn[v].n != 0
jitems = (v: int) -> int[]:
    out: int[]
    if v == 0: return out
    c = int(jn[v].first)
    loop c != 0:
        out.push(c)
        c = int(jn[c].next)
    out

# a JSON string literal
jq = (s: str) -> str:
    clean = true
    loop c in s:
        if c < 32 or c == '"' or c == '\\':
            clean = false
            break
    if clean: return "\"" + s + "\""
    out: u8[]
    out.push('"')
    hexd = "0123456789abcdef"
    loop c in s:
        if c == '"' or c == '\\':
            out.push('\\')
            out.push(c)
        else if c == '\n':
            out.push('\\')
            out.push('n')
        else if c == '\t':
            out.push('\\')
            out.push('t')
        else if c == '\r':
            out.push('\\')
            out.push('r')
        else if c < 32:
            loop b in "\\u00": out.push(b)
            out.push(hexd[int(c) >> 4])
            out.push(hexd[int(c) & 15])
        else: out.push(c)
    out.push('"')
    str_from_bytes(out)

# ---------------- messages ----------------
inbuf: u8[]
inpos = 0
in_eof = false

lsp_fill = () -> bool:
    if inpos > 0 and inpos == inbuf.len():
        inbuf.clear()
        inpos = 0
    n = inbuf.len()
    inbuf.resize(n + 65536)
    r = syscall(0, 0, data(inbuf) + n, 65536)
    if r <= 0:
        inbuf.resize(n)
        in_eof = true
        return false
    inbuf.resize(n + r)
    true

# the end of the headers of the next message (after \r\n\r\n), or -1
lsp_header_end = () -> int:
    i = inpos
    n = inbuf.len()
    loop i + 3 < n:
        if inbuf[i] == '\r' and inbuf[i + 1] == '\n' and inbuf[i + 2] == '\r' and inbuf[i + 3] == '\n': return i + 4
        i += 1
    -1

lsp_body_len = (h0: int, h1: int) -> int:
    hs = lower(str_from_bytes(inbuf[h0..h1)))
    k = find(hs, "content-length:")
    if k < 0: return 0
    e = find_byte(hs, '\r', k)
    to_int(trim(hs[k + 15..e))) ?? 0

# is a whole message waiting?
lsp_have_msg = () -> bool:
    he = lsp_header_end()
    if he < 0: return false
    inbuf.len() - he >= lsp_body_len(inpos, he)

# input waiting (without blocking)?
lsp_input_ready = () -> bool: lsp_wait_input(0)

# input waiting, or arriving within ms milliseconds?
lsp_wait_input = (ms: int) -> bool:
    if lsp_have_msg(): return true
    fds = [0 | (1 << 32)]                   # struct pollfd: fd 0, events POLLIN
    syscall(7, data(fds), 1, ms) > 0

lsp_read = () -> str?:
    loop true:
        he = lsp_header_end()
        if he >= 0:
            n = lsp_body_len(inpos, he)
            if inbuf.len() - he >= n:
                body = str_from_bytes(inbuf[he..he + n))
                inpos = he + n
                return body
        if in_eof or not lsp_fill(): return none
    none

lsp_send = (body: str):
    msg = "Content-Length: {len(body)}\r\n\r\n{body}"
    __write_fd(1, data(msg), len(msg))

# (requests are answered with `return lsp_reply(...)`: handlers return 0)
lsp_reply = (id: int, result: str) -> int:
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":{jn_raw(id)},\"result\":{result}\}")
    0

lsp_error = (id: int, code: int, msg: str) -> int:
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":{jn_raw(id)},\"error\":\{\"code\":{code},\"message\":{jq(msg)}\}\}")
    0

lsp_notify = (method: str, params: str):
    lsp_send("\{\"jsonrpc\":\"2.0\",\"method\":{jq(method)},\"params\":{params}\}")

# a request id as it was sent (a number or a string)
jn_raw = (v: int) -> str:
    if v == 0: return "null"
    if jn[v].kind == .str_: return jq(jn[v].s)
    jn[v].s

lsp_log = (s: str): eprint("sloppy lsp: {s}")

# ---------------- positions ----------------
# LSP positions are lines and UTF-16 code units

line_starts_of = (text: str) -> int[]:
    ls = [0]
    loop i in 0.. and c in text:
        if c == '\n': ls.push(i + 1)
    ls

struct LPos:
    line: int
    ch: int

# the line holding byte offset off (binary search in line starts ls)
line_of = (ls: int[], off: int) -> int:
    lo = 0
    hi = ls.len() - 1
    loop lo < hi:
        mid = (lo + hi + 1) / 2
        if ls[mid] <= off: lo = mid
        else: hi = mid - 1
    lo

utf16_units = (text: str, a: int, b: int) -> int:
    n = 0
    loop i in [a..min(b, len(text))):
        c = text[i]
        if c < 0x80 or c >= 0xC0 and c < 0xF0: n += 1
        else if c >= 0xF0: n += 2
    n

lpos_of = (text: str, ls: int[], off: int) -> LPos:
    o = max(0, min(off, len(text)))
    l = line_of(ls, o)
    LPos(l, utf16_units(text, ls[l], o))

off_of = (text: str, ls: int[], line: int, ch: int) -> int:
    if line < 0: return 0
    if line >= ls.len(): return len(text)
    i = ls[line]
    u = 0
    loop i < len(text) and text[i] != '\n' and u < ch:
        c = text[i]
        if c >= 0xF0: u += 2
        else: u += 1
        i += 1
        loop i < len(text) and text[i] >= 0x80 and text[i] < 0xC0: i += 1
    i

jpos = (p: LPos) -> str: "\{\"line\":{p.line},\"character\":{p.ch}\}"

# ---------------- documents and check results ----------------

struct Ref:
    file: int
    off: int
    len: int
    decl: str       # "file:offset" of the declaration ("" if none)
    info: str

struct Decl:
    file: int
    off: int
    len: int
    kind: int
    name: str
    snippet: str
    doc: str

struct Diag:
    path: str
    off: int
    msg: str
    warning: bool

struct Hint:
    file: int
    off: int
    label: str

# what a check found
struct Result:
    paths: str[]                # by file number
    refs: Ref[]
    decls: {str: Decl}
    hints: Hint[]
    diags: Diag[]
    comps: str[][]              # completions: label, kind, detail
    texts: {str: str}           # the text of the edited files when checked
    skips: str[]                # functions with errors (child positions), skipped in later rounds

struct Doc:
    uri: str
    path: str
    text: str
    version: int
    open: bool
    dirty: bool
    lowered: bool               # checked with lowering (which finds a few more errors)
    res: Result
    good: Result                # the last result with the most references (for broken code)
    has_good: bool
    wide: Result                # the latest result indexing all of the program's files
    has_wide: bool
    diag_uris: str[]            # files this document's errors were published to

docs: Doc[]
doc_by_uri: {str: int} = {}
root_lib = ""
empty_main = "/tmp/.sloppy-lsp-empty-main.jo"

uri_to_path = (uri: str) -> str:
    s = uri
    if starts_with(s, "file://"): s = s[7..]
    out: u8[]
    i = 0
    loop i < len(s):
        c = s[i]
        if c == '%' and i + 2 < len(s):
            out.push(u8(json_hex(s[i + 1]) * 16 + json_hex(s[i + 2])))
            i += 3
            continue
        out.push(c)
        i += 1
    ide_norm(str_from_bytes(out))

path_to_uri = (path: str) -> str:
    hexd = "0123456789ABCDEF"
    out: u8[]
    loop b in "file://": out.push(b)
    loop c in path:
        if is_alnum(c) or c == '/' or c == '-' or c == '.' or c == '_' or c == '~':
            out.push(c)
        else:
            out.push('%')
            out.push(hexd[int(c) >> 4])
            out.push(hexd[int(c) & 15])
    str_from_bytes(out)

# a file's URI (an open document's as the editor wrote it)
uri_of = (path: str) -> str:
    loop dc in docs:
        if dc.path == path: return dc.uri
    path_to_uri(path)

# the text of a file: an open document's, else the file's
text_of = (path: str) -> str:
    if let t = ide_texts.get(path): return t
    read_file(path) ?? ""

esc_split = (line: str) -> str[]:
    out: str[]
    cur: u8[]
    i = 0
    loop i < len(line):
        c = line[i]
        if c == '\t':
            out.push(str_from_bytes(cur))
            cur.clear()
        else if c == '\\' and i + 1 < len(line):
            i += 1
            e = line[i]
            if e == 't': cur.push('\t')
            else if e == 'n': cur.push('\n')
            else: cur.push(e)
        else: cur.push(c)
        i += 1
    out.push(str_from_bytes(cur))
    out

# "file:offset"
split_pos = (s: str) -> (int, int):
    c = find_byte(s, ':')
    if c < 0: return (-1, -1)
    (to_int(s[..c)) ?? -1, to_int(s[c + 1..]) ?? -1)

struct RunOut:
    lines: str[]
    ok: bool

# check the program in a child process; its findings, as lines
run_child = (main_path: str, doc_path: str, sentinel: bool, skips: str[], lower: bool, wide: bool) -> RunOut:
    fds = [0]
    if syscall(293, data(fds), 0x80000) != 0: return RunOut([], false)          # pipe2(O_CLOEXEC)
    rfd = fds[0] & 0xFFFFFFFF
    wfd = fds[0] >> 32
    pid = syscall(57)                                   # fork
    if pid < 0: return RunOut([], false)
    if pid == 0:
        syscall(3, rfd)
        ide_on = true
        ide_fd = wfd
        ide_doc = doc_path
        ide_wide = wide
        if sentinel: ide_sentinel = intern("__sloppy_complete__")
        # (file numbers are the same in every check of the same texts)
        loop s in skips:
            fp = split_pos(s)
            ide_skip[mkpos(fp.0, fp.1)] = true
        test_mode = true
        if lower:
            # (lowering finds some errors too: in shader code, data races)
            lower_only = true
            compile(main_path, "")
        else:
            scan_build_block(main_path)
            target_wasm = build_target == "wasm"
            if target_wasm: ptr_size = 4
            init_types()
            check_program(main_path)
        ide_finish()
        exit(0)
    syscall(3, wfd)
    out: u8[]
    deadline = time() + 20.0
    killed = false
    loop true:
        pfd = [rfd | (1 << 32)]
        left = int((deadline - time()) * 1000.0)
        if left <= 0:
            syscall(62, pid, 9)                         # kill
            killed = true
            break
        pr = syscall(7, data(pfd), 1, left)
        if pr < 0: continue
        if pr == 0: continue
        n = out.len()
        out.resize(n + 65536)
        r = syscall(0, rfd, data(out) + n, 65536)
        if r <= 0:
            out.resize(n)
            break
        out.resize(n + r)
    syscall(3, rfd)
    status = [0]
    syscall(61, pid, data(status), 0, 0)                # wait4
    if killed:
        lsp_log("checking {doc_path} took too long")
        return RunOut([], false)
    st = status[0] & 0xFFFF
    text = str_from_bytes(out)
    ok = st == 0
    if not ok:
        sig = st & 127
        lsp_log("the checker failed on {doc_path} (status {st}, signal {sig})")
    RunOut(split(text, "\n"), ok)

# parse a child's lines into r (files are renumbered into r.paths)
take_lines = (r: mut Result, lines_: str[]):
    fmap: int[]
    # (files first: an error comes before them)
    loop line in lines_:
        if not starts_with(line, "F\t"): continue
        f = esc_split(line)
        if f.len() >= 3:
            i = to_int(f[1]) ?? 0
            loop fmap.len() <= i: fmap.push(-1)
            p = ide_norm(f[2])
            j = -1
            loop q in 0.. and pp in r.paths:
                if pp == p: j = q
            if j < 0:
                r.paths.push(p)
                j = r.paths.len() - 1
            fmap[i] = j
    loop line in lines_:
        if len(line) < 2: continue
        f = esc_split(line)
        k = f[0]
        if k == "R" and f.len() >= 5:
            p = remap(fmap, f[1])
            d = ""
            if len(f[3]) > 0: d = remap_key(fmap, f[3])
            r.refs.push(Ref(p.0, p.1, to_int(f[2]) ?? 0, d, f[4]))
        else if k == "D" and f.len() >= 7:
            p = remap(fmap, f[1])
            key = "{p.0}:{p.1}"
            if r.decls.get(key) == none: r.decls[key] = Decl(p.0, p.1, to_int(f[2]) ?? 0, to_int(f[3]) ?? 0, f[4], f[5], f[6])
        else if k == "H" and f.len() >= 3:
            p = remap(fmap, f[1])
            r.hints.push(Hint(p.0, p.1, f[2]))
        else if k == "C" and f.len() >= 4:
            r.comps.push([f[1], f[2], f[3]])
        else if (k == "E" or k == "W") and f.len() >= 3:
            path = ""
            off = 0
            if f[1] != "-1":
                p = remap(fmap, f[1])
                if p.0 >= 0 and p.0 < r.paths.len(): path = r.paths[p.0]
                off = p.1
            r.diags.push(Diag(path, off, f[2], k == "W"))
            if k == "E" and f.len() >= 4 and f[3] != "-1": r.skips.push(f[3])

remap = (fmap: int[], s: str) -> (int, int):
    p = split_pos(s)
    f = -1
    if p.0 >= 0 and p.0 < fmap.len(): f = fmap[p.0]
    (f, p.1)

remap_key = (fmap: int[], s: str) -> str:
    p = remap(fmap, s)
    "{p.0}:{p.1}"

struct Item:
    a: int
    b: int
    name: str

# the top-level item (declaration or statement) around offset off: [a, b) and its name
top_item = (text: str, off: int) -> Item:
    a = max(0, min(off, len(text)))
    loop a > 0 and text[a - 1] != '\n': a -= 1
    loop true:
        e = a
        loop e < len(text) and text[e] != '\n': e += 1
        t = text[a..e)
        if len(t) > 0 and t[0] != ' ' and t[0] != '\t' and t[0] != '#' and not starts_with(t, "else"): break
        if a == 0: return Item(-1, -1, "")
        a -= 1
        loop a > 0 and text[a - 1] != '\n': a -= 1
    first = a
    # (with its @attributes)
    loop a > 0:
        p = a - 1
        loop p > 0 and text[p - 1] != '\n': p -= 1
        if p < a and text[p] == '@': a = p
        else: break
    e = first
    loop e < len(text) and text[e] != '\n': e += 1
    line = text[first..e)
    if starts_with(line, "use ") or starts_with(line, "import ") or starts_with(line, "build:"): return Item(-1, -1, "")
    b = e
    loop b < len(text):
        n = b + 1
        if n >= len(text):
            b = len(text)
            break
        c = text[n]
        if c != ' ' and c != '\t' and c != '\n' and c != '#' and not starts_with(text[n..min(n + 4, len(text))), "else"): break
        b = n
        loop b < len(text) and text[b] != '\n': b += 1
    if b < len(text): b += 1
    name = ""
    t = line
    loop kw in ["struct ", "enum ", "const ", "type ", "extern "]:
        if starts_with(t, kw): t = trim(t[len(kw)..])
    name = ident_prefix(t)
    Item(a, b, name)

# text with [a, b) made blank (spaces; line breaks kept, so positions after it do not move)
blank_out = (text: str, a: int, b: int) -> str:
    out: u8[]
    loop i in 0.. and c in text:
        if i >= a and i < b and c != '\n': out.push(' ')
        else: out.push(c)
    str_from_bytes(out)

# check a document; after an error in a function, again without checking that function's body
# (and after other errors in the program's files, again without that top-level item), for more
# errors and for names and types in the rest of the program. completing >= 0: completions at that
# offset of path are wanted (the item there is never left out)
check_doc = (path: str, completing: int, lower: bool, wide: bool) -> Result:
    r = Result()
    sentinel = completing >= 0
    main_path = path
    if starts_with(path, root_lib + "/"): main_path = empty_main
    skips: str[]
    blanked: str[]                  # names of the items left out
    saved: {str: str} = {}          # texts replaced while checking (to restore)
    unsaved: str[]                  # (paths that had no text in ide_texts)
    t0 = time()
    loop rnd in [0..10):
        o = run_child(main_path, path, sentinel, skips, lower, wide)
        nd = r.diags.len()
        nskips = r.skips.len()
        take_lines(r, o.lines)
        if not o.ok and r.diags.len() == nd:
            r.diags.push(Diag(path, 0, "internal compiler error while checking this file", false))
            break
        if sentinel and r.comps.len() > 0: break
        ei = -1
        loop i in [nd..r.diags.len()):
            if not r.diags[i].warning: ei = i
        if ei < 0: break
        e = r.diags[ei]
        # (errors that follow from leaving something out are not the program's)
        follows = rnd > 0 and contains(e.msg, "never")
        loop nm in blanked:
            if contains(e.msg, "'{nm}'"): follows = true
        if follows:
            r.diags.remove(ei)
            # (in a function: go on without it)
            if r.skips.len() == nskips or skips.contains(r.skips[r.skips.len() - 1]): break
        if r.skips.len() > nskips:
            sk = r.skips[r.skips.len() - 1]
            if skips.contains(sk):
                r.diags.remove(ei)
                break
            skips.push(sk)
        else:
            if len(e.path) == 0 or e.path == empty_main or starts_with(e.path, root_lib + "/") and e.path != path: break
            text = text_of(e.path)
            it = top_item(text, e.off)
            if it.a < 0 or e.path == path and completing >= it.a and completing < it.b: break
            if saved.get(e.path) == none:
                if let old = ide_texts.get(e.path): saved[e.path] = old
                else:
                    saved[e.path] = text
                    unsaved.push(e.path)
            ide_texts[e.path] = blank_out(text, it.a, it.b)
            if len(it.name) > 0: blanked.push(it.name)
        if time() - t0 > 1.5: break
    loop p, t in saved:
        if unsaved.contains(p): ide_texts.remove(p)
        else: ide_texts[p] = t
    r

# ---------------- requests ----------------

doc_of = (uri: str) -> int:
    if let i = doc_by_uri.get(uri): return i
    -1

text_params_doc = (params: int) -> int: doc_of(jstr(jpath(params, "textDocument", "uri")))

# the byte offset of a request's position in document d
req_off = (d: int, params: int) -> int:
    p = jget(params, "position")
    text = docs[d].text
    off_of(text, line_starts_of(text), jint(jget(p, "line")), jint(jget(p, "character")))

ensure_checked = (d: int):
    if not docs[d].dirty: return
    refresh(d)

# check document d and publish its errors
refresh = (d: int):
    docs[d].dirty = false
    docs[d].lowered = false
    r = check_doc(docs[d].path, -1, false, false)
    r.texts = ide_texts
    docs[d].res = r
    if not docs[d].has_good or r.diags.len() == 0 or r.refs.len() >= docs[d].good.refs.len():
        docs[d].good = r
        docs[d].has_good = true
    publish(d)

# check document d again, lowering it too (when the editor has been quiet for a moment)
refresh_lowered = (d: int):
    docs[d].lowered = true
    r = check_doc(docs[d].path, -1, true, false)
    r.texts = ide_texts
    if r.diags.len() == 0 and docs[d].res.diags.len() == 0: return
    docs[d].res = r
    publish(d)

publish = (d: int):
    r = docs[d].res
    by_path: {str: str[]} = {}
    loop x0 in r.diags:
        x = x0
        if len(x.path) == 0 or x.path == empty_main: x = Diag(docs[d].path, 0, x.msg, x.warning)
        text = text_of(x.path)
        ls = line_starts_of(text)
        a = x.off
        b = a
        loop b < len(text) and (is_alnum(text[b]) or text[b] == '_'): b += 1
        if b == a and a < len(text) and text[a] != '\n': b = a + 1
        sev = 1
        if x.warning: sev = 2
        item = "\{\"range\":\{\"start\":{jpos(lpos_of(text, ls, a))},\"end\":{jpos(lpos_of(text, ls, b))}\},\"severity\":{sev},\"source\":\"sloppy\",\"message\":{jq(x.msg)}\}"
        lst = by_path.get(x.path) ?? []
        lst.push(item)
        by_path[x.path] = lst
    if by_path.get(docs[d].path) == none: by_path[docs[d].path] = []
    sent: str[]
    loop p, items in by_path: sent.push(uri_of(p))
    # (first clear errors published before to files that have none now)
    loop u in docs[d].diag_uris:
        if not sent.contains(u): lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":{jq(u)},\"diagnostics\":[]\}")
    loop p, items in by_path:
        u = uri_of(p)
        ver = ""
        if u == docs[d].uri: ver = ",\"version\":{docs[d].version}"
        lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":{jq(u)}{ver},\"diagnostics\":[{join(items, ",")}]\}")
    docs[d].diag_uris = sent

# the file number of path in result r (-1 if it is not there)
file_in = (r: Result, path: str) -> int:
    loop i in 0.. and p in r.paths:
        if p == path: return i
    -1

# map an offset in the current text of path to the text result r was made from (-1: changed)
map_off = (r: Result, path: str, off: int) -> int:
    cur = text_of(path)
    old = r.texts.get(path) ?? cur
    if old == cur: return off
    n = min(len(old), len(cur))
    pre = 0
    loop pre < n and old[pre] == cur[pre]: pre += 1
    if off < pre: return off
    suf = 0
    loop suf < n - pre and old[len(old) - 1 - suf] == cur[len(cur) - 1 - suf]: suf += 1
    if off >= len(cur) - suf: return off - len(cur) + len(old)
    -1

# and back: an offset in the old text of path to the current one
unmap_off = (r: Result, path: str, off: int) -> int:
    cur = text_of(path)
    old = r.texts.get(path) ?? cur
    if old == cur: return off
    n = min(len(old), len(cur))
    pre = 0
    loop pre < n and old[pre] == cur[pre]: pre += 1
    if off < pre: return off
    suf = 0
    loop suf < n - pre and old[len(old) - 1 - suf] == cur[len(cur) - 1 - suf]: suf += 1
    if off >= len(old) - suf: return off - len(old) + len(cur)
    -1

struct Hit:
    found: bool
    ref: Ref
    res: Result

# the reference at offset off of document d (in its latest result, else in the last good one)
ref_at = (d: int, off: int) -> Hit:
    loop which in [0..2):
        r = docs[d].res
        if which == 1:
            if not docs[d].has_good: break
            r = docs[d].good
        f = file_in(r, docs[d].path)
        if f < 0: continue
        o = map_off(r, docs[d].path, off)
        if o < 0: continue
        best = -1
        loop i in 0.. and x in r.refs:
            if x.file == f and o >= x.off and o <= x.off + x.len:
                # (prefer the one starting closest, and one with a declaration)
                if best < 0 or x.off > r.refs[best].off or x.off == r.refs[best].off and len(r.refs[best].decl) == 0: best = i
        if best >= 0: return Hit(true, r.refs[best], r)
    Hit(false, Ref(), Result())

loc_json = (r: Result, f: int, off: int, n: int) -> str:
    path = r.paths[f]
    o = unmap_off(r, path, off)
    if o < 0: o = off
    text = text_of(path)
    ls = line_starts_of(text)
    "\{\"uri\":{jq(uri_of(path))},\"range\":\{\"start\":{jpos(lpos_of(text, ls, o))},\"end\":{jpos(lpos_of(text, ls, o + n))}\}\}"

kind_name = (k: int) -> str:
    if k == IK_LOCAL: return "variable"
    if k == IK_PARAM: return "parameter"
    if k == IK_GLOBAL: return "global"
    if k == IK_CONST: return "constant"
    if k == IK_FN: return "function"
    if k == IK_STRUCT: return "struct"
    if k == IK_ENUM: return "enum"
    if k == IK_FIELD: return "field"
    if k == IK_VARIANT: return "variant"
    if k == IK_MODULE: return "module"
    "type"

on_hover = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    ensure_checked(d)
    h = ref_at(d, req_off(d, params))
    if not h.found: return lsp_reply(id, "null")
    x = h.ref
    code = ""
    doc = ""
    if let dc = h.res.decls.get(x.decl):
        code = dc.snippet
        doc = dc.doc
        k = dc.kind
        if k == IK_FN and len(x.info) > 0:
            # the types it was used with (the result's when inferred; generic parameters')
            hdr = dc.snippet
            ip = x.info
            ar = find(ip, ") -> ")
            if ar >= 0: ip = ip[..ar + 1)
            if contains(hdr, ip):
                if not contains(hdr, "->") and ar >= 0: code = hdr + x.info[ar + 1..]
            else: code = hdr + "\n# here: " + dc.name + x.info
        else if (k == IK_LOCAL or k == IK_PARAM or k == IK_GLOBAL) and len(x.info) > 0:
            code = "{dc.name}: {x.info}"
        else if k == IK_FIELD and len(x.info) > 0 and not contains(code, ":"): code = "{code}: {x.info}"
        if k != IK_FN and k != IK_STRUCT and k != IK_ENUM: code = "({kind_name(k)}) {code}"
    else if len(x.info) > 0: code = x.info
    if len(code) == 0: return lsp_reply(id, "null")
    md = "```sloppy\n{code}\n```"
    if len(doc) > 0: md += "\n---\n" + doc
    lsp_reply(id, "\{\"contents\":\{\"kind\":\"markdown\",\"value\":{jq(md)}\}\}")

on_definition = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    ensure_checked(d)
    off = req_off(d, params)
    # use 'file.jo': the file
    u = use_target(d, off)
    if len(u) > 0: return lsp_reply(id, "\{\"uri\":{jq(path_to_uri(u))},\"range\":\{\"start\":\{\"line\":0,\"character\":0\},\"end\":\{\"line\":0,\"character\":0\}\}\}")
    h = ref_at(d, off)
    if not h.found or len(h.ref.decl) == 0: return lsp_reply(id, "null")
    p = split_pos(h.ref.decl)
    if p.0 < 0 or p.0 >= h.res.paths.len(): return lsp_reply(id, "null")
    n = 0
    if let dc = h.res.decls.get(h.ref.decl): n = dc.len
    lsp_reply(id, loc_json(h.res, p.0, p.1, n))

# the file named by a `use` line at off, or ""
use_target = (d: int, off: int) -> str:
    text = docs[d].text
    a = off
    loop a > 0 and text[a - 1] != '\n': a -= 1
    b = off
    loop b < len(text) and text[b] != '\n': b += 1
    line = trim(text[a..b))
    if not starts_with(line, "use ") and not starts_with(line, "import ") and not starts_with(line, "from "): return ""
    # (from m import a, b: on a name, that name's definition)
    if starts_with(line, "from "):
        im = find(text[a..b), " import ")
        if im >= 0 and off > a + im: return ""
    dir = docs[d].path
    s = rfind(dir, "/")
    if s >= 0: dir = dir[..s)
    q = find_byte(line, '\'')
    if q < 0: q = find_byte(line, '"')
    if q >= 0:
        e = find_byte(line, line[q], q + 1)
        if e < 0: return ""
        rel = line[q + 1..e)
        if starts_with(rel, "/"): return ide_norm(rel)
        return ide_norm("{dir}/{rel}")
    nm = trim(line[find_byte(line, ' ') + 1..])
    k = find(nm, " as ")
    if k >= 0: nm = nm[..k)
    rel = replace(nm, ".", "/")
    loop cand in ["{dir}/{rel}.jo", "{root_lib}/{rel}.jo", "{root_lib}/std/{rel}.jo", "{root_lib}/game/{rel}.jo", "{root_lib}/core/{rel}.jo"]:
        if file_exists(cand): return ide_norm(cand)
    ""

struct Uses:
    found: bool
    res: Result
    decl: str           # the declaration's key in res

# the declaration under the cursor, and a result with all its uses: when the program has more
# files than the document, one that indexed them all
uses_of = (d: int, off: int) -> Uses:
    h = ref_at(d, off)
    if not h.found or len(h.ref.decl) == 0: return Uses(false, Result(), "")
    n = 0
    loop p in h.res.paths:
        if not starts_with(p, root_lib + "/") and p != empty_main: n += 1
    if n <= 1 and not starts_with(docs[d].path, root_lib + "/"): return Uses(true, h.res, h.ref.decl)
    if not docs[d].has_wide:
        w = check_doc(docs[d].path, -1, false, true)
        w.texts = ide_texts
        docs[d].wide = w
        docs[d].has_wide = true
    w = docs[d].wide
    p = split_pos(h.ref.decl)
    if p.0 < 0 or p.0 >= h.res.paths.len(): return Uses(false, Result(), "")
    f = file_in(w, h.res.paths[p.0])
    if f < 0: return Uses(false, Result(), "")
    Uses(true, w, "{f}:{p.1}")

# every reference to the declaration under the cursor
refs_of = (d: int, off: int, with_decl: bool) -> str[]:
    out: str[]
    u = uses_of(d, off)
    if not u.found: return out
    seen: {str: bool} = {}
    loop x in u.res.refs:
        if x.decl != u.decl: continue
        k = "{x.file}:{x.off}"
        if not with_decl and k == x.decl: continue
        if seen.get(k) != none: continue
        seen[k] = true
        out.push(loc_json(u.res, x.file, x.off, x.len))
    out

on_references = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    ensure_checked(d)
    inc = jbool(jpath(params, "context", "includeDeclaration"))
    lsp_reply(id, "[{join(refs_of(d, req_off(d, params), inc), ",")}]")

on_highlight = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    ensure_checked(d)
    h = ref_at(d, req_off(d, params))
    if not h.found or len(h.ref.decl) == 0: return lsp_reply(id, "[]")
    f = file_in(h.res, docs[d].path)
    out: str[]
    seen: {int: bool} = {}
    text = docs[d].text
    ls = line_starts_of(text)
    loop x in h.res.refs:
        if x.decl != h.ref.decl or x.file != f or seen.get(x.off) != none: continue
        seen[x.off] = true
        o = unmap_off(h.res, docs[d].path, x.off)
        if o < 0: continue
        out.push("\{\"range\":\{\"start\":{jpos(lpos_of(text, ls, o))},\"end\":{jpos(lpos_of(text, ls, o + x.len))}\}\}")
    lsp_reply(id, "[{join(out, ",")}]")

on_prepare_rename = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    ensure_checked(d)
    h = ref_at(d, req_off(d, params))
    if not h.found or len(h.ref.decl) == 0: return lsp_error(id, -32803, "nothing to rename here")
    p = split_pos(h.ref.decl)
    if p.0 >= 0 and starts_with(h.res.paths[p.0], root_lib + "/") and h.res.paths[p.0] != docs[d].path: return lsp_error(id, -32803, "this is declared in the standard library")
    text = docs[d].text
    ls = line_starts_of(text)
    o = unmap_off(h.res, docs[d].path, h.ref.off)
    lsp_reply(id, "\{\"start\":{jpos(lpos_of(text, ls, o))},\"end\":{jpos(lpos_of(text, ls, o + h.ref.len))}\}")

on_rename = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    refresh(d)
    nn = jstr(jget(params, "newName"))
    if len(nn) == 0 or not is_alpha(nn[0]): return lsp_error(id, -32602, "'{nn}' is not a name")
    loop c in nn:
        if not is_alnum(c): return lsp_error(id, -32602, "'{nn}' is not a name")
    if docs[d].res.diags.len() > 0:
        loop x in docs[d].res.diags:
            if not x.warning: return lsp_error(id, -32803, "the program has errors; fix them first (a rename might miss uses)")
    us = uses_of(d, req_off(d, params))
    if not us.found: return lsp_error(id, -32803, "nothing to rename here")
    by_uri: {str: str[]} = {}
    seen: {str: bool} = {}
    loop x in us.res.refs:
        if x.decl != us.decl: continue
        k = "{x.file}:{x.off}"
        if seen.get(k) != none: continue
        seen[k] = true
        u = uri_of(us.res.paths[x.file])
        loc = loc_json(us.res, x.file, x.off, x.len)
        rg = loc[find(loc, "\"range\":") + 8..len(loc) - 1)
        lst = by_uri.get(u) ?? []
        lst.push("\{\"range\":{rg},\"newText\":{jq(nn)}\}")
        by_uri[u] = lst
    parts: str[]
    loop u, edits in by_uri: parts.push("{jq(u)}:[{join(edits, ",")}]")
    lsp_reply(id, "\{\"changes\":\{{join(parts, ",")}\}\}")

# where a name ends / starts around off
name_start = (text: str, off: int) -> int:
    a = off
    loop a > 0 and (is_alnum(text[a - 1]) or text[a - 1] >= 0x80): a -= 1
    a

name_end = (text: str, off: int) -> int:
    b = off
    loop b < len(text) and (is_alnum(text[b]) or text[b] >= 0x80): b += 1
    b

# is off inside a comment or a string (outside its {interpolations})?
in_comment_or_str = (text: str, off: int) -> bool:
    a = off
    loop a > 0 and text[a - 1] != '\n': a -= 1
    q: u8 = 0
    brace = 0
    i = a
    loop i < off:
        c = text[i]
        if q != 0 and brace == 0:
            if c == '\\': i += 1
            else if c == q: q = 0
            else if c == '{{' and q == '"': brace = 1
        else if brace > 0:
            if c == '{{': brace += 1
            else if c == '}}': brace -= 1
        else if c == '"' or c == '\'': q = c
        else if c == '#': return true
        i += 1
    q != 0 and brace == 0

no_items = "\{\"isIncomplete\":false,\"items\":[]\}"

keywords = ["if", "else", "loop", "in", "break", "continue", "return", "match", "struct", "enum", "const", "use", "import", "as", "and", "or", "not", "xor", "is", "mut", "when", "defer", "extern", "test", "build", "true", "false", "none", "null", "type", "pass"]

comp_kind = (k: int) -> int:
    if k == IK_LOCAL or k == IK_PARAM or k == IK_GLOBAL: return 6
    if k == IK_CONST: return 21
    if k == IK_FN: return 3
    if k == IK_STRUCT: return 22
    if k == IK_ENUM: return 13
    if k == IK_FIELD: return 5
    if k == IK_VARIANT: return 20
    if k == IK_MODULE: return 9
    7

on_completion = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    text = docs[d].text
    off = req_off(d, params)
    if in_comment_or_str(text, off): return lsp_reply(id, no_items)
    a = name_start(text, off)
    b = name_end(text, off)
    prefix = text[a..off)
    member = a > 0 and text[a - 1] == '.'
    if member and a > 1 and text[a - 2] == '.': return lsp_reply(id, no_items)     # a range: 0..
    if not member and len(prefix) > 0 and is_digit(prefix[0]): return lsp_reply(id, no_items)
    sent = "__sloppy_complete__"
    saved = text
    tries: str[]
    tries.push(text[..a) + sent + text[b..])
    # (an unfinished line: end it after the name, closing what it opened)
    le = b
    loop le < len(text) and text[le] != '\n': le += 1
    ls0 = a
    loop ls0 > 0 and text[ls0 - 1] != '\n': ls0 -= 1
    closers = ""
    loop c in text[ls0..a):
        if c == '(': closers = ")" + closers
        else if c == '[': closers = "]" + closers
        else if c == '{{': closers = "\}" + closers
        else if (c == ')' or c == ']' or c == '}}') and len(closers) > 0: closers = closers[1..]
    line0 = trim(text[ls0..a))
    # (the names after `from m import` are the module's, not statements)
    if starts_with(line0, "from ") and find(line0, " import") >= 0: member = true
    tail = closers
    if (starts_with(line0, "if ") or starts_with(line0, "else if ") or starts_with(line0, "loop ") or starts_with(line0, "match ") or starts_with(line0, "while ")) and find_byte(text[a..le), ':') < 0: tail += ": pass"
    tries.push(text[..a) + sent + tail + text[le..])
    r = Result()
    loop t in tries:
        ide_texts[docs[d].path] = t
        r = check_doc(docs[d].path, a, false, false)
        if r.comps.len() > 0: break
    ide_texts[docs[d].path] = saved
    items: str[]
    seen: {str: bool} = {}
    loop c in r.comps:
        label = c[0]
        if seen.get(label) != none or label == sent: continue
        if starts_with(label, "__") and not starts_with(prefix, "_"): continue
        seen[label] = true
        k = to_int(c[1]) ?? 0
        # (the program's own names and fields first, then the library's)
        so = "1"
        if k == IK_LOCAL or k == IK_PARAM or k == IK_FIELD or k == IK_VARIANT: so = "0"
        items.push("\{\"label\":{jq(label)},\"kind\":{comp_kind(k)},\"detail\":{jq(c[2])},\"sortText\":{jq(so + label)}\}")
    if not member and r.comps.len() > 0 or not member and items.len() == 0:
        loop kw in keywords:
            if seen.get(kw) == none: items.push("\{\"label\":{jq(kw)},\"kind\":14,\"sortText\":{jq("2" + kw)}\}")
    lsp_reply(id, "\{\"isIncomplete\":false,\"items\":[{join(items, ",")}]\}")

on_signature = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    text = docs[d].text
    off = req_off(d, params)
    # the call the cursor is in: back to its unmatched (
    i = off
    depth = 0
    commas = 0
    stop = max(0, off - 4000)
    loop i > stop:
        i -= 1
        c = text[i]
        if c == ')' or c == ']' or c == '}}': depth += 1
        else if c == '(' or c == '[' or c == '{{':
            if depth == 0:
                if c != '(': return lsp_reply(id, "null")
                break
            depth -= 1
        else if c == ',' and depth == 0: commas += 1
    if i <= stop or text[i] != '(': return lsp_reply(id, "null")
    e = i
    loop e > 0 and text[e - 1] == ' ': e -= 1
    s = name_start(text, e)
    if s == e: return lsp_reply(id, "null")
    if docs[d].dirty and not lsp_input_ready(): refresh(d)
    h = ref_at(d, s)
    if not h.found: return lsp_reply(id, "null")
    dc = h.res.decls.get(h.ref.decl) ?? Decl()
    if dc.kind != IK_FN or len(dc.snippet) == 0: return lsp_reply(id, "null")
    label = dc.snippet
    # the parameters: label offsets of each
    a = find_byte(label, '(')
    if a < 0: return lsp_reply(id, "null")
    ps: str[]
    k = a + 1
    dep = 0
    st = k
    loop k < len(label):
        c = label[k]
        if c == '(' or c == '[' or c == '{{': dep += 1
        else if c == ')' or c == ']' or c == '}}':
            if dep == 0:
                if k > st and len(trim(label[st..k))) > 0: ps.push("[{utf16_units(label, 0, st + count_lead(label, st))},{utf16_units(label, 0, k - count_trail(label, k))}]")
                break
            dep -= 1
        else if c == ',' and dep == 0:
            ps.push("[{utf16_units(label, 0, st + count_lead(label, st))},{utf16_units(label, 0, k)}]")
            st = k + 1
        k += 1
    # x.f(a): the receiver is the first argument
    active = commas
    if s > 0 and text[s - 1] == '.': active += 1
    pj: str[]
    loop p in ps: pj.push("\{\"label\":{p}\}")
    sig = "\{\"label\":{jq(label)},\"parameters\":[{join(pj, ",")}]"
    if len(dc.doc) > 0: sig += ",\"documentation\":{jq(dc.doc)}"
    sig += "\}"
    lsp_reply(id, "\{\"signatures\":[{sig}],\"activeSignature\":0,\"activeParameter\":{active}\}")

count_lead = (s: str, i: int) -> int:
    n = 0
    loop i + n < len(s) and s[i + n] == ' ': n += 1
    n

count_trail = (s: str, i: int) -> int:
    n = 0
    loop i - n - 1 >= 0 and s[i - n - 1] == ' ': n += 1
    n

on_inlay = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    if docs[d].dirty and not lsp_input_ready(): refresh(d)
    text = docs[d].text
    ls = line_starts_of(text)
    rg = jget(params, "range")
    a = off_of(text, ls, jint(jpath(rg, "start", "line")), jint(jpath(rg, "start", "character")))
    b = off_of(text, ls, jint(jpath(rg, "end", "line")), jint(jpath(rg, "end", "character")))
    r = docs[d].res
    f = file_in(r, docs[d].path)
    out: str[]
    if f >= 0:
        loop h in r.hints:
            if h.file != f: continue
            o = unmap_off(r, docs[d].path, h.off)
            if o < a or o > b or o < 0: continue
            lbl = h.label
            pad = "false"
            if starts_with(lbl, " "):
                lbl = trim(lbl)
                pad = "true"
            out.push("\{\"position\":{jpos(lpos_of(text, ls, o))},\"label\":{jq(lbl)},\"kind\":1,\"paddingLeft\":{pad}\}")
    lsp_reply(id, "[{join(out, ",")}]")

# ---------------- document symbols (from the text: they work while it does not parse) ----------------

struct Sym2:
    name: str
    kind: int
    line: int
    col: int
    end: int        # last line
    kids: int[]

on_symbols = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    text = docs[d].text
    lines_ = split(text, "\n")
    out = symbols_in(lines_, 0, lines_.len(), 0)
    lsp_reply(id, "[{join(out, ",")}]")

indent_of = (s: str) -> int:
    n = 0
    loop n < len(s) and (s[n] == ' ' or s[n] == '\t'): n += 1
    n

# the last line of the block that starts at line i (its indented lines)
block_end = (lines_: str[], i: int, ind: int) -> int:
    e = i
    j = i + 1
    loop j < lines_.len():
        t = trim(lines_[j])
        if len(t) > 0:
            if indent_of(lines_[j]) <= ind: break
            e = j
        j += 1
    e

ident_prefix = (s: str) -> str:
    n = 0
    loop n < len(s) and is_alnum(s[n]): n += 1
    s[..n)

sym_json = (name: str, kind: int, line: int, col: int, endl: int, endc: int, kids: str[]) -> str:
    rg = "\{\"start\":\{\"line\":{line},\"character\":0\},\"end\":\{\"line\":{endl},\"character\":{endc}\}\}"
    sel = "\{\"start\":\{\"line\":{line},\"character\":{col}\},\"end\":\{\"line\":{line},\"character\":{col + len(name)}\}\}"
    s = "\{\"name\":{jq(name)},\"kind\":{kind},\"range\":{rg},\"selectionRange\":{sel}"
    if kids.len() > 0: s += ",\"children\":[{join(kids, ",")}]"
    s + "\}"

symbols_in = (lines_: str[], from: int, to: int, ind: int) -> str[]:
    out: str[]
    i = from
    loop i < to:
        raw = lines_[i]
        t = trim(raw)
        if len(t) == 0 or t[0] == '#' or indent_of(raw) != ind:
            i += 1
            continue
        col = indent_of(raw)
        e = block_end(lines_, i, ind)
        ec = len(lines_[e])
        if starts_with(t, "@"):
            i += 1
            continue
        if starts_with(t, "when ") and ends_with(t, ":"):
            j = i + 1
            loop j <= e and len(trim(lines_[j])) == 0: j += 1
            if j <= e:
                loop x in symbols_in(lines_, j, e + 1, indent_of(lines_[j])): out.push(x)
            i = e + 1
            continue
        if starts_with(t, "else:") or starts_with(t, "else "):
            j = i + 1
            loop j <= e and len(trim(lines_[j])) == 0: j += 1
            if j <= e and ind == 0:
                loop x in symbols_in(lines_, j, e + 1, indent_of(lines_[j])): out.push(x)
            i = e + 1
            continue
        if starts_with(t, "struct ") or starts_with(t, "enum "):
            isst = starts_with(t, "struct ")
            rest = t[find_byte(t, ' ') + 1..]
            nm = ident_prefix(rest)
            kids: str[]
            # (enum E: a, b on one line)
            colon = find_byte(t, ':')
            if not isst and colon >= 0 and len(trim(t[colon + 1..])) > 0:
                loop part in split(t[colon + 1..], ","):
                    pn = ident_prefix(trim(part))
                    if len(pn) > 0: kids.push(sym_json(pn, 22, i, col + max(0, find(t, pn, colon)), i, len(raw), []))
            loop j in [i + 1..e + 1):
                ft = trim(lines_[j])
                if len(ft) == 0 or ft[0] == '#': continue
                fc = indent_of(lines_[j])
                if isst:
                    fnm = ident_prefix(ft)
                    if len(fnm) > 0: kids.push(sym_json(fnm, 8, j, fc, j, len(lines_[j]), []))
                else:
                    loop part in split(ft, ","):
                        pn = ident_prefix(trim(part))
                        if len(pn) > 0: kids.push(sym_json(pn, 22, j, fc + max(0, find(ft, pn)), j, len(lines_[j]), []))
            k = 23
            if not isst: k = 10
            out.push(sym_json(nm, k, i, col + find(t, nm), e, ec, kids))
        else if starts_with(t, "const "):
            nm = ident_prefix(t[6..])
            if len(nm) > 0: out.push(sym_json(nm, 14, i, col + 6, e, ec, []))
        else if starts_with(t, "type "):
            nm = ident_prefix(t[5..])
            if len(nm) > 0: out.push(sym_json(nm, 5, i, col + 5, e, ec, []))
        else if starts_with(t, "test "):
            q = trim(t[5..])
            if ends_with(q, ":"): q = q[..len(q) - 1)
            out.push(sym_json("test " + q, 24, i, col, e, ec, []))
        else if starts_with(t, "extern "):
            nm = ident_prefix(t[7..])
            if len(nm) > 0: out.push(sym_json(nm, 12, i, col + 7, e, ec, []))
        else:
            nm = ident_prefix(t)
            rest = trim(t[len(nm)..])
            if len(nm) > 0 and not keywords.contains(nm):
                # name = (params) ...: a function; name = value or name: T: a variable
                if starts_with(rest, "[") and find(rest, "= (") >= 0 or starts_with(rest, "= ("):
                    out.push(sym_json(nm, 12, i, col, e, ec, []))
                else if starts_with(rest, "=") and not starts_with(rest, "==") or starts_with(rest, ":") and not ends_with(rest, ":"):
                    out.push(sym_json(nm, 13, i, col, e, ec, []))
        i = e + 1
    out

# ---------------- the main loop ----------------

on_open = (params: int):
    td = jget(params, "textDocument")
    uri = jstr(jget(td, "uri"))
    path = uri_to_path(uri)
    text = jstr(jget(td, "text"))
    d = doc_of(uri)
    if d < 0:
        docs.push(Doc(uri = uri, path = path))
        d = docs.len() - 1
        doc_by_uri[uri] = d
    docs[d].text = text
    docs[d].version = jint(jget(td, "version"))
    docs[d].open = true
    docs[d].dirty = true
    ide_texts[path] = text

on_change = (params: int):
    d = text_params_doc(params)
    if d < 0: return
    loop ch in jitems(jget(params, "contentChanges")):
        if jget(ch, "range") == 0: docs[d].text = jstr(jget(ch, "text"))
        else:
            # (incremental change: the client did not take the full-text offer)
            text = docs[d].text
            ls = line_starts_of(text)
            rg = jget(ch, "range")
            a = off_of(text, ls, jint(jpath(rg, "start", "line")), jint(jpath(rg, "start", "character")))
            b = off_of(text, ls, jint(jpath(rg, "end", "line")), jint(jpath(rg, "end", "character")))
            docs[d].text = text[..a) + jstr(jget(ch, "text")) + text[b..]
    docs[d].version = jint(jpath(params, "textDocument", "version"))
    docs[d].dirty = true
    loop i in [0..docs.len()): docs[i].has_wide = false
    ide_texts[docs[d].path] = docs[d].text

on_close = (params: int):
    d = text_params_doc(params)
    if d < 0: return
    docs[d].open = false
    docs[d].dirty = false
    ide_texts.remove(docs[d].path)
    loop u in docs[d].diag_uris: lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":{jq(u)},\"diagnostics\":[]\}")
    docs[d].diag_uris = []

capabilities = "\{\"textDocumentSync\":\{\"openClose\":true,\"change\":1,\"save\":\{\"includeText\":false\}\},\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"documentSymbolProvider\":true,\"renameProvider\":\{\"prepareProvider\":true\},\"completionProvider\":\{\"triggerCharacters\":[\".\"]\},\"signatureHelpProvider\":\{\"triggerCharacters\":[\"(\",\",\"],\"retriggerCharacters\":[\",\"]\},\"inlayHintProvider\":true\}"

lsp_main = ():
    root_lib = ide_norm(lib_dir)
    ide_texts[empty_main] = ""
    a = args()
    if a.len() >= 4 and a[2] == "--dump":
        # (debugging: what a check of a file reports)
        path = ide_norm(a[3])
        if not starts_with(path, "/"): path = ide_norm((env("PWD") ?? ".") + "/" + a[3])
        main_path = path
        if starts_with(path, root_lib + "/"): main_path = empty_main
        sk: str[]
        if let s = env("SLOPPY_SKIP"): sk.push(s)
        o = run_child(main_path, path, env("SLOPPY_SENTINEL") != none, sk, env("SLOPPY_LOWER") != none, env("SLOPPY_WIDE") != none)
        loop l in o.lines: print(l)
        exit(0)
    shutdown = false
    loop true:
        # check edited documents once the editor has said everything it had to say
        if not lsp_input_ready():
            loop i in [0..docs.len()):
                if docs[i].open and docs[i].dirty:
                    refresh(i)
                    if lsp_input_ready(): break
        # and lower them when it has been quiet for a moment
        loop i in [0..docs.len()):
            if docs[i].open and not docs[i].dirty and not docs[i].lowered:
                if lsp_wait_input(300): break
                refresh_lowered(i)
        m = lsp_read()
        if m == none: exit(0)
        root = json_parse(m!)
        method = jstr(jget(root, "method"))
        id = jget(root, "id")
        params = jget(root, "params")
        if method == "initialize":
            lsp_reply(id, "\{\"capabilities\":{capabilities},\"serverInfo\":\{\"name\":\"sloppy\"\}\}")
        else if method == "initialized": pass
        else if method == "shutdown":
            shutdown = true
            lsp_reply(id, "null")
        else if method == "exit":
            if shutdown: exit(0)
            exit(1)
        else if method == "textDocument/didOpen": on_open(params)
        else if method == "textDocument/didChange": on_change(params)
        else if method == "textDocument/didClose": on_close(params)
        else if method == "textDocument/didSave":
            # other open files may use this one
            loop i in [0..docs.len()):
                if docs[i].open: docs[i].dirty = true
                docs[i].has_wide = false
        else if method == "textDocument/hover": on_hover(id, params)
        else if method == "textDocument/definition": on_definition(id, params)
        else if method == "textDocument/references": on_references(id, params)
        else if method == "textDocument/documentHighlight": on_highlight(id, params)
        else if method == "textDocument/prepareRename": on_prepare_rename(id, params)
        else if method == "textDocument/rename": on_rename(id, params)
        else if method == "textDocument/completion": on_completion(id, params)
        else if method == "textDocument/signatureHelp": on_signature(id, params)
        else if method == "textDocument/inlayHint": on_inlay(id, params)
        else if method == "textDocument/documentSymbol": on_symbols(id, params)
        else if id != 0: lsp_error(id, -32601, "unsupported: {method}")
