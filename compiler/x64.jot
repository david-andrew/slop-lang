# x86-64 backend: IR -> machine code. Calling convention follows SysV for scalars:
# integer args in rdi, rsi, rdx, rcx, r8, r9; float args in xmm0-7; the rest on the stack.

use util
use ir
use lower
use types
use check
use ast
use elf

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

code: [u8]
fn_addr: [int]            # lfunc index -> code offset (-1 = not yet)
call_fix: [(int, int)]    # (position of rel32, lfunc)
data_fix: [(int, int, int)]  # (position of rel32, kind 0=rodata 1=data, offset)
int_arg_regs := [RDI, RSI, RDX, RCX, R8, R9]

fn b(x: int): code.push(u8(x & 255))
fn b32(x: int):
    b(x)
    b(x >> 8)
    b(x >> 16)
    b(x >> 24)
fn b64(x: int):
    b32(x)
    b32(x >> 32)
fn patch32(pos: int, v: int):
    code[pos] = u8(v & 255)
    code[pos + 1] = u8((v >> 8) & 255)
    code[pos + 2] = u8((v >> 16) & 255)
    code[pos + 3] = u8((v >> 24) & 255)

rip_kind := 0
fn rex(w: bool, r: int, x: int, bb0: int, force: bool):
    bb := bb0
    if bb == RIPREL: bb = 0
    v := 0x40
    if w: v |= 8
    if r & 8 != 0: v |= 4
    if x & 8 != 0: v |= 2
    if bb & 8 != 0: v |= 1
    if v != 0x40 or force: b(v)

# ModRM + optional SIB + displacement for [base + disp]
fn mem(reg: int, base: int, disp: int):
    r := reg & 7
    if base == RIPREL:
        b((r << 3) | 5)
        b32(0)
        data_fix.push((code.len() - 4, rip_kind, disp))
        return
    bs := base & 7
    if disp == 0 and bs != 5:
        b((r << 3) | bs)
        if bs == 4: b(0x24)
    else if disp >= -128 and disp <= 127:
        b(0x40 | (r << 3) | bs)
        if bs == 4: b(0x24)
        b(disp)
    else:
        b(0x80 | (r << 3) | bs)
        if bs == 4: b(0x24)
        b32(disp)

fn modrr(reg: int, rm: int): b(0xC0 | ((reg & 7) << 3) | (rm & 7))

# op r64, [base+disp]   (e.g. 0x8B mov, 0x03 add ...)
fn op_rm(opc: int, w: bool, reg: int, base: int, disp: int):
    rex(w, reg, 0, base, false)
    b(opc)
    mem(reg, base, disp)

fn op_rr(opc: int, w: bool, reg: int, rm: int):
    rex(w, reg, 0, rm, false)
    b(opc)
    modrr(reg, rm)

fn mov_rm(r: int, base: int, disp: int): op_rm(0x8B, true, r, base, disp)     # mov r, [m]
fn mov_mr(base: int, disp: int, r: int): op_rm(0x89, true, r, base, disp)     # mov [m], r
fn mov_rr(d: int, s: int): op_rr(0x89, true, s, d)
fn lea(r: int, base: int, disp: int): op_rm(0x8D, true, r, base, disp)

fn mov_imm(r: int, v: int):
    if v >= 0 and v <= 0xFFFFFFFF:
        rex(false, 0, 0, r, false)
        b(0xB8 + (r & 7))
        b32(v)
    else if v >= -2147483648 and v <= 2147483647:
        rex(true, 0, 0, r, false)
        b(0xC7)
        modrr(0, r)
        b32(v)
    else:
        rex(true, 0, 0, r, false)
        b(0xB8 + (r & 7))
        b64(v)

# sized load from [base+disp] into r (zero/sign extended to 64 bits)
fn load_sized(r: int, base: int, disp: int, size: int, signed: bool):
    if size == 8: mov_rm(r, base, disp)
    else if size == 4:
        if signed: op_rm(0x63, true, r, base, disp)       # movsxd
        else: op_rm(0x8B, false, r, base, disp)           # mov r32
    else if size == 2:
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBF)
        else: b(0xB7)
        mem(r, base, disp)
    else:
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBE)
        else: b(0xB6)
        mem(r, base, disp)

fn store_sized(base: int, disp: int, r: int, size: int):
    if size == 8: mov_mr(base, disp, r)
    else if size == 4: op_rm(0x89, false, r, base, disp)
    else if size == 2:
        b(0x66)
        op_rm(0x89, false, r, base, disp)
    else:
        rex(false, r, 0, base, r >= 4)
        b(0x88)
        mem(r, base, disp)

# SSE: prefix (F2 for sd, F3 for ss, 66 for pd), 0F, opc, modrm mem
fn sse_rm(prefix: int, opc: int, x: int, base: int, disp: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, base, false)
    b(0x0F)
    b(opc)
    mem(x, base, disp)
fn sse_rr(prefix: int, opc: int, x: int, y: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, y, false)
    b(0x0F)
    b(opc)
    modrr(x, y)

fn jmp32() -> int:
    b(0xE9)
    b32(0)
    code.len() - 4
fn jcc32(cc: int) -> int:
    b(0x0F)
    b(0x80 + cc)
    b32(0)
    code.len() - 4
fn patch_here(pos: int): patch32(pos, code.len() - (pos + 4))
fn jmp_back(target: int):
    b(0xE9)
    b32(target - (code.len() + 4))

const CC_E = 4
const CC_NE = 5
const CC_L = 0xC
const CC_GE = 0xD
const CC_LE = 0xE
const CC_G = 0xF
const CC_B = 2
const CC_AE = 3
const CC_BE = 6
const CC_A = 7
const CC_P = 0xA
const CC_NP = 0xB

fn setcc(cc: int):
    b(0x0F)
    b(0x90 + cc)
    b(0xC0)        # al
    b(0x0F)
    b(0xB6)
    b(0xC0)        # movzx eax, al


# ---------------- register allocation ----------------
# vreg locations: >= 0 register (0-15 general, 16+n = xmm n); or one of:
const LOC_SPILL = -1
const LOC_CONST = -2
const LOC_SLOT = -3
const LOC_NONE = -4
const LOC_GLOBAL = -5
const RIPREL = 99            # pseudo base register for rip-relative addressing
vgkind: [int]
vgoff: [int]
const XMM = 16
const INF_POS = 1 << 60

vloc: [int]
vspill: [int]
vcval: [int]
vslot: [int]
vsoff: [int]
slot_off: [int]
frame_size := 0
callee_off: [int]          # save offset per register (0 = not used)
ra_on := true              # false: spill everything (fast debug codegen)
callee_pool := [RBX, 12, 13, 14, 15]
caller_pool := [RSI, RDI, R8, R9, R10, R11]

v_first: [int]
v_last: [int]
v_ndef: [int]
v_nuse: [int]
call_pos: [int]
loop_s: [int]
loop_e: [int]
use_buf: [int]

fn call_like(ins: Ins) -> bool:
    op := ins.op
    if op == .intr and ins.imm >= 2: return true
    if op == .call and ins.c == 1: return false      # never returns
    if op == .call or op == .calli or op == .callc or op == .syscall or op == .memcpy or op == .memset: return true
    if op == .copy or op == .zero: return not (ins.imm <= 64 and ins.imm % 8 == 0)
    false

# fills use_buf with used vregs; returns the defined vreg or -1
fn operands(ins: Ins) -> int:
    use_buf.clear()
    op := ins.op
    a := int(ins.a)
    bb := int(ins.b)
    d := int(ins.dst)
    match op:
        nop, block, loop, end, else_, br, trap: return -1
        iconst, fconst, slot, gaddr, daddr, faddr: return d
        intr:
            for k in 0..bb: use_buf.push(int(ir.args[a + k]))
            return d
        if_, brif:
            use_buf.push(a)
            return -1
        ret:
            if a >= 0: use_buf.push(a)
            return -1
        store, copy:
            use_buf.push(a)
            use_buf.push(bb)
            return -1
        zero:
            use_buf.push(a)
            return -1
        memcpy, memset:
            use_buf.push(a)
            use_buf.push(bb)
            use_buf.push(int(ins.c))
            return -1
        zeroslots:
            # defines vreg items (handled by caller via args)
            return -1
        call, syscall:
            for k in 0..bb: use_buf.push(int(ir.args[a + k]))
            return d
        calli, callc:
            for k in 0..bb: use_buf.push(int(ir.args[a + k]))
            use_buf.push(int(ins.c))
            return d
        load, mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            use_buf.push(a)
            return d
        _:
            use_buf.push(a)
            use_buf.push(bb)
            return d

fn fits32(v: int) -> bool: v >= -2147483648 and v <= 2147483647

fn analyze():
    nv := ir.vtypes.len()
    v_first = [INF_POS; nv]
    v_last = [-1; nv]
    v_ndef = [0; nv]
    v_nuse = [0; nv]
    vloc = [LOC_SPILL; nv]
    vcval = [0; nv]
    vslot = [-1; nv]
    vsoff = [0; nv]
    vgkind = [0; nv]
    vgoff = [0; nv]
    call_pos = []
    loop_s = []
    loop_e = []
    kinds: [int]
    starts: [int]
    for p in 0..ir.nparams:
        v_first[p] = 0
        v_last[p] = 0
        v_ndef[p] = 1
    for pos, ins in ir.code:
        d := operands(ins)
        for u in use_buf:
            if pos < v_first[u]: v_first[u] = pos
            if pos > v_last[u]: v_last[u] = pos
            v_nuse[u] += 1
        if d >= 0:
            if pos < v_first[d]: v_first[d] = pos
            if pos > v_last[d]: v_last[d] = pos
            v_ndef[d] += 1
            if v_ndef[d] == 1:
                op := ins.op
                if op == .iconst and fits32(ins.imm):
                    vloc[d] = LOC_CONST
                    vcval[d] = ins.imm
                else if op == .slot:
                    vloc[d] = LOC_SLOT
                    vslot[d] = int(ins.a)
                else if op == .gaddr or op == .daddr:
                    vloc[d] = LOC_GLOBAL
                    vgoff[d] = int(ins.imm)
                    if op == .gaddr: vgkind[d] = 1
                else if op == .add and vloc[int(ins.a)] == LOC_SLOT and vloc[int(ins.b)] == LOC_CONST and v_ndef[int(ins.a)] == 1 and v_ndef[int(ins.b)] == 1:
                    vloc[d] = LOC_SLOT
                    vslot[d] = vslot[int(ins.a)]
                    vsoff[d] = vsoff[int(ins.a)] + vcval[int(ins.b)]
        if ins.op == .zeroslots:
            for k in 0..int(ins.b):
                item := int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    v := item >> 1
                    if pos < v_first[v]: v_first[v] = pos
                    if pos > v_last[v]: v_last[v] = pos
                    v_ndef[v] += 2
        if call_like(ins): call_pos.push(pos)
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(int(ins.op))
            starts.push(pos)
        else if ins.op == .end:
            k := kinds.pop()
            s := starts.pop()
            if k == int(Op.loop):
                loop_s.push(s)
                loop_e.push(pos)
    # a vreg defined more than once can't stay a constant/address
    for v in 0..nv:
        if v_ndef[v] != 1 and (vloc[v] == LOC_CONST or vloc[v] == LOC_SLOT or vloc[v] == LOC_GLOBAL): vloc[v] = LOC_SPILL
    # loops in order of their start
    nl := loop_s.len()
    order: [int]
    for i in 0..nl: order.push(i)
    order.sort_by(fn(i: int): loop_s[i])
    ls: [int]
    le: [int]
    for i in order:
        ls.push(loop_s[i])
        le.push(loop_e[i])
    loop_s = ls
    loop_e = le
    # extend intervals of values live around loops
    for v in 0..nv:
        if v_last[v] < 0: continue
        f := v_first[v]
        # first loop starting after f
        lo := 0
        hi := nl
        while lo < hi:
            mid := (lo + hi) / 2
            if loop_s[mid] <= f: lo = mid + 1
            else: hi = mid
        i := lo
        while i < nl and loop_s[i] <= v_last[v]:
            if loop_e[i] > v_last[v]: v_last[v] = loop_e[i]
            i += 1

fn crosses_call(s: int, e: int) -> bool:
    lo := 0
    hi := call_pos.len()
    while lo < hi:
        mid := (lo + hi) / 2
        if call_pos[mid] <= s: lo = mid + 1
        else: hi = mid
    lo < call_pos.len() and call_pos[lo] < e

fn allocate():
    nv := ir.vtypes.len()
    callee_off = [0; 16]
    if not ra_on:
        for v in 0..nv:
            if vloc[v] != LOC_CONST and vloc[v] != LOC_SLOT and vloc[v] != LOC_GLOBAL: vloc[v] = LOC_SPILL
        return
    # bucket vregs by interval start
    n := ir.code.len() + 1
    head := [-1; n]
    nxt := [-1; nv]
    for v in 0..nv:
        if vloc[v] == LOC_CONST or vloc[v] == LOC_SLOT or vloc[v] == LOC_GLOBAL: continue
        if v_last[v] < 0:
            vloc[v] = LOC_NONE
            continue
        if v_nuse[v] == 0 and v >= ir.nparams:
            vloc[v] = LOC_NONE
            continue
        f := v_first[v]
        nxt[v] = head[f]
        head[f] = v
    free := [true; 32]
    for r in [RAX, RCX, RDX, RSP, RBP]: free[r] = false
    free[XMM + 0] = false
    free[XMM + 1] = false
    free[XMM + 15] = false
    active: [int]
    for pos in 0..n:
        v := head[pos]
        while v >= 0:
            # expire old intervals
            k := 0
            while k < active.len():
                a := active[k]
                if v_last[a] < pos:
                    free[vloc[a]] = true
                    active.remove(k)
                else: k += 1
            crosses := crosses_call(v_first[v], v_last[v])
            reg := -1
            if vtype(v) != VI:
                if not crosses:
                    for x in 2..15:
                        if free[XMM + x]:
                            reg = XMM + x
                            break
            else:
                if not crosses:
                    for r in caller_pool:
                        if free[r]:
                            reg = r
                            break
                if reg < 0:
                    for r in callee_pool:
                        if free[r]:
                            reg = r
                            break
            if reg < 0:
                # steal from the active interval that ends last, if that helps
                best := -1
                for a in active:
                    if v_last[a] <= v_last[v]: continue
                    ra := vloc[a]
                    if (ra >= XMM) != (vtype(v) != VI): continue
                    if crosses and ra < XMM and not callee_pool.contains(ra): continue
                    if crosses and ra >= XMM: continue
                    if best < 0 or v_last[a] > v_last[best]: best = a
                if best >= 0:
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    active.remove(active.index_of(best))
            if reg >= 0:
                vloc[v] = reg
                free[reg] = false
                active.push(v)
                if callee_pool.contains(reg): callee_off[reg] = 1
            else: vloc[v] = LOC_SPILL
            v = nxt[v]

fn layout_frame():
    off := 0
    for r in 0..16:
        if callee_off[r] != 0:
            off += 8
            callee_off[r] = -off
    nv := ir.vtypes.len()
    vspill = [0; nv]
    for v in 0..nv:
        if vloc[v] == LOC_SPILL:
            off += 8
            vspill[v] = -off
    slot_off = [0; ir.slot_size.len()]
    for s in 0..ir.slot_size.len():
        sz := int(ir.slot_size[s])
        al := int(ir.slot_align[s])
        off = align_up(off + sz, al)
        slot_off[s] = -off
    frame_size = align_up(off, 16)

# ---------------- operand access ----------------
fn is_xmm(r: int) -> bool: r >= XMM
fn slot_disp(v: int) -> int: slot_off[vslot[v]] + vsoff[v]

# value of int vreg v into register r
fn ld(r: int, v: int):
    l := vloc[v]
    if l >= 0:
        if l != r: mov_rr(r, l)
    else if l == LOC_SPILL: mov_rm(r, RBP, vspill[v])
    else if l == LOC_CONST: mov_imm(r, vcval[v])
    else if l == LOC_SLOT: lea(r, RBP, slot_disp(v))
    else if l == LOC_GLOBAL: rel_fixup_lea(r, vgkind[v], vgoff[v])
    else: mov_imm(r, 0)

# register holding int vreg v (loads into scratch if needed)
fn reg_of(v: int, scratch: int) -> int:
    l := vloc[v]
    if l >= 0 and l < XMM: return l
    ld(scratch, v)
    scratch

# store register r into vreg v
fn st(v: int, r: int):
    l := vloc[v]
    if l >= 0:
        if l != r: mov_rr(l, r)
    else if l == LOC_SPILL: mov_mr(RBP, vspill[v], r)

# destination register for v (its own register, or scratch)
fn dreg(v: int, scratch: int) -> int:
    l := vloc[v]
    if l >= 0 and l < XMM: return l
    scratch

fn movsd_rr(x: int, y: int, ty: int):
    if x == y: return
    if ty == VS: sse_rr(0xF3, 0x10, x, y)
    else: sse_rr(0xF2, 0x10, x, y)

fn lds(x: int, v: int, ty: int):
    l := vloc[v]
    if l >= XMM: movsd_rr(x, l - XMM, ty)
    else if l == LOC_SPILL:
        if ty == VS: sse_rm(0xF3, 0x10, x, RBP, vspill[v])
        else: sse_rm(0xF2, 0x10, x, RBP, vspill[v])
    else:
        ld(RAX, v)
        movq_xr(x, RAX)
fn sts(v: int, x: int, ty: int):
    l := vloc[v]
    if l >= XMM: movsd_rr(l - XMM, x, ty)
    else if l == LOC_SPILL:
        if ty == VS: sse_rm(0xF3, 0x11, x, RBP, vspill[v])
        else: sse_rm(0xF2, 0x11, x, RBP, vspill[v])
fn xreg_of(v: int, scratch: int, ty: int) -> int:
    l := vloc[v]
    if l >= XMM: return l - XMM
    lds(scratch, v, ty)
    scratch
fn xdreg(v: int, scratch: int) -> int:
    l := vloc[v]
    if l >= XMM: return l - XMM
    scratch

fn movq_xr(x: int, r: int):
    b(0x66)
    rex(true, x, 0, r, false)
    b(0x0F)
    b(0x6E)
    modrr(x, r)
fn movq_rx(r: int, x: int):
    b(0x66)
    rex(true, x, 0, r, false)
    b(0x0F)
    b(0x7E)
    modrr(x, r)

# ALU r, operand(v): register / memory / imm32 forms
# opc_rr: "op r/m64, r64" opcode (e.g. 0x01 add); ext: /digit for 0x81 imm form
fn alu_v(opc_rr: int, ext: int, r: int, v: int):
    l := vloc[v]
    if l >= 0 and l < XMM: op_rr(opc_rr, true, l, r)
    else if l == LOC_CONST:
        c := vcval[v]
        rex(true, 0, 0, r, false)
        if c >= -128 and c <= 127:
            b(0x83)
            modrr(ext, r)
            b(c)
        else:
            b(0x81)
            modrr(ext, r)
            b32(c)
    else if l == LOC_SPILL: op_rm(opc_rr + 2, true, r, RBP, vspill[v])
    else:
        ld(RCX, v)
        op_rr(opc_rr, true, RCX, r)

# memory base for an address vreg: returns (base register, displacement)
fn addr_of(v: int, scratch: int) -> (int, int):
    if vloc[v] == LOC_SLOT: return (RBP, slot_disp(v))
    if vloc[v] == LOC_GLOBAL:
        rip_kind = vgkind[v]
        return (RIPREL, vgoff[v])
    (reg_of(v, scratch), 0)

# like addr_of, but never rip-relative (for instructions with two memory operands)
fn addr_reg(v: int, scratch: int) -> (int, int):
    if vloc[v] == LOC_SLOT: return (RBP, slot_disp(v))
    (reg_of(v, scratch), 0)

# ---------------- parallel moves ----------------
# moves of values into registers: dst register <- vreg
struct PMove:
    dst: int
    v: int

fn src_reg(v: int) -> int:
    l := vloc[v]
    if l >= 0: return l
    -1

fn emit_parallel(moves: [PMove]):
    pending := moves
    # register to register moves first (with cycle breaking via the stack)
    while true:
        progress := false
        any_reg := false
        k := 0
        while k < pending.len():
            m := pending[k]
            s := src_reg(m.v)
            if s < 0 or s == m.dst:
                k += 1
                continue
            any_reg = true
            blocked := false
            for o in pending:
                if src_reg(o.v) == m.dst and o.dst != m.dst: blocked = true
            if not blocked:
                if is_xmm(m.dst): movsd_rr(m.dst - XMM, s - XMM, VF)
                else: mov_rr(m.dst, s)
                pending.remove(k)
                progress = true
            else: k += 1
        if not any_reg: break
        if not progress:
            # cycle: save one source on the stack, redirect its readers
            for i, m in pending:
                s := src_reg(m.v)
                if s >= 0 and s != m.dst:
                    if is_xmm(s):
                        movq_rx(RAX, s - XMM)
                        b(0x50)
                    else:
                        rex(false, 0, 0, s, false)
                        b(0x50 + (s & 7))
                    # pop into destination after everything else
                    cyc_dst := m.dst
                    pending.remove(i)
                    emit_parallel(pending)
                    if is_xmm(cyc_dst):
                        b(0x58)
                        movq_xr(cyc_dst - XMM, RAX)
                    else:
                        rex(false, 0, 0, cyc_dst, false)
                        b(0x58 + (cyc_dst & 7))
                    return
    # remaining: sources in memory, constants, slot addresses (or already in place)
    for m in pending:
        if src_reg(m.v) == m.dst: continue
        if is_xmm(m.dst): lds(m.dst - XMM, m.v, vtype(m.v))
        else: ld(m.dst, m.v)

# ---------------- function body ----------------
struct XCtl:
    kind: int     # 0 block, 1 loop, 2 if
    start: int
    fixups: [int]
    ifx: [int]    # jumps to the else branch

xctl: [XCtl]
call_stack_bytes := 0

fn emit_prologue():
    b(0x55)                        # push rbp
    mov_rr(RBP, RSP)
    if frame_size > 0:
        rex(true, 0, 0, RSP, false)
        b(0x81)
        modrr(5, RSP)
        b32(frame_size)            # sub rsp, frame
    for r in 0..16:
        if callee_off[r] != 0: mov_mr(RBP, callee_off[r], r)
    # incoming parameters
    ni := 0
    nf := 0
    stack_k := 0
    moves: [PMove]
    stack_params: [(int, int)]
    reg_spills: [(int, int)]
    for p in 0..ir.nparams:
        ty := vtype(p)
        src := -1
        if ty == VI:
            if ni < 6:
                src = int_arg_regs[ni]
                ni += 1
        else:
            if nf < 8:
                src = XMM + nf
                nf += 1
        if src < 0:
            stack_params.push((p, 16 + 8 * stack_k))
            stack_k += 1
            continue
        l := vloc[p]
        if l == LOC_NONE: continue
        if l == LOC_SPILL: reg_spills.push((p, src))
        else: moves.push(PMove(l, p))
        # record the incoming register as the temporary source location
        pin_src.push((p, src))
    # spills first (they read incoming registers)
    for rs in reg_spills:
        if is_xmm(rs.1):
            if vtype(rs.0) == VS: sse_rm(0xF3, 0x11, rs.1 - XMM, RBP, vspill[rs.0])
            else: sse_rm(0xF2, 0x11, rs.1 - XMM, RBP, vspill[rs.0])
        else: mov_mr(RBP, vspill[rs.0], rs.1)
    # register moves: sources are the incoming registers
    saved := vloc
    for ps in pin_src: vloc[ps.0] = ps.1
    real: [PMove]
    for m in moves: real.push(m)
    emit_parallel(real)
    vloc = saved
    pin_src.clear()
    for sp in stack_params:
        p := sp.0
        l := vloc[p]
        if l == LOC_NONE: continue
        if vtype(p) == VI:
            mov_rm(RAX, RBP, sp.1)
            st(p, RAX)
        else:
            sse_rm(0xF2, 0x10, 0, RBP, sp.1)
            sts(p, 0, vtype(p))

pin_src: [(int, int)]

fn emit_epilogue():
    for r in 0..16:
        if callee_off[r] != 0: mov_rm(r, RBP, callee_off[r])
    mov_rr(RSP, RBP)
    b(0x5D)       # pop rbp
    b(0xC3)       # ret

fn emit_call_args(start: int, n: int, extra: int, extra_dst: int):
    ni := 0
    nf := 0
    stack_args: [int]
    moves: [PMove]
    for k in 0..n:
        v := int(ir.args[start + k])
        ty := vtype(v)
        if ty == VI:
            if ni < 6:
                moves.push(PMove(int_arg_regs[ni], v))
                ni += 1
                continue
        else:
            if nf < 8:
                moves.push(PMove(XMM + nf, v))
                nf += 1
                continue
        stack_args.push(v)
    if extra >= 0: moves.push(PMove(extra_dst, extra))
    pad := (stack_args.len() % 2) * 8
    if pad > 0:
        rex(true, 0, 0, RSP, false)
        b(0x83)
        modrr(5, RSP)
        b(8)
    i := stack_args.len() - 1
    while i >= 0:
        v := stack_args[i]
        if vtype(v) == VI: ld(RAX, v)
        else:
            lds(0, v, vtype(v))
            movq_rx(RAX, 0)
        b(0x50)
        i -= 1
    emit_parallel(moves)
    call_stack_bytes = pad + stack_args.len() * 8

fn pop_call_stack():
    if call_stack_bytes > 0:
        rex(true, 0, 0, RSP, false)
        b(0x81)
        modrr(0, RSP)
        b32(call_stack_bytes)

fn store_result(ins: Ins):
    d := int(ins.dst)
    if d < 0 or vloc[d] == LOC_NONE: return
    ty := vtype(d)
    if ty == VI: st(d, RAX)
    else: sts(d, 0, ty)

fn fpre(ty: int) -> int:
    if ty == VS: return 0xF3
    0xF2

fn rel_fixup_lea(r: int, kind: int, off: int):
    rex(true, r, 0, 0, false)
    b(0x8D)
    b(((r & 7) << 3) | 5)
    b32(0)
    data_fix.push((code.len() - 4, kind, off))

fn branch_target_fix(depth: int):
    c := xctl.len() - 1 - depth
    if xctl[c].kind == 1: jmp_back(xctl[c].start)
    else: xctl[c].fixups.push(jmp32())

fn branch_target_jcc(depth: int, cc: int):
    c := xctl.len() - 1 - depth
    if xctl[c].kind == 1:
        target := xctl[c].start
        b(0x0F)
        b(0x80 + cc)
        b32(target - (code.len() + 4))
    else: xctl[c].fixups.push(jcc32(cc))

fn int_bin(opc_rr: int, ext: int, ins: Ins):
    d := int(ins.dst)
    if vloc[d] == LOC_NONE: return
    a := int(ins.a)
    bb := int(ins.b)
    r := dreg(d, RAX)
    if vloc[bb] == r and r != vloc[a]: r = RAX
    ld(r, a)
    alu_v(opc_rr, ext, r, bb)
    st(d, r)

fn cmp_ops(a: int, bb: int):
    ra := reg_of(a, RAX)
    alu_v(0x39, 7, ra, bb)

fn icc(op: Op) -> int:
    match op:
        eq: CC_E
        ne: CC_NE
        lts: CC_L
        les: CC_LE
        gts: CC_G
        ges: CC_GE
        ltu: CC_B
        leu: CC_BE
        gtu: CC_A
        geu: CC_AE
        _: -1

fn is_icmp(op: Op) -> bool: icc(op) >= 0
fn is_fcmp(op: Op) -> bool: op == .feq or op == .fne or op == .flt or op == .fle or op == .fgt or op == .fge

# emit float compare flags; returns condition code for "true"
fn fcmp_flags(ins: Ins) -> int:
    ty := int(ins.ty)
    pre := 0
    if ty == VF: pre = 0x66
    a := int(ins.a)
    bb := int(ins.b)
    op := ins.op
    if op == .flt or op == .fle:
        x := a
        a = bb
        bb = x
    xa := xreg_of(a, 0, ty)
    xb := xreg_of(bb, 1, ty)
    if pre != 0: b(pre)
    rex(false, xa, 0, xb, false)
    b(0x0F)
    b(0x2E)
    modrr(xa, xb)
    if op == .flt or op == .fgt: return CC_A
    if op == .fle or op == .fge: return CC_AE
    if op == .feq: return 100
    101

fn falu(opc: int, ins: Ins):
    ty := int(ins.ty)
    d := int(ins.dst)
    x := xdreg(d, 0)
    xb := xreg_of(int(ins.b), 1, ty)
    if x == xb and x != 0:
        lds(0, int(ins.a), ty)
        sse_rr(fpre(ty), opc, 0, xb)
        sts(d, 0, ty)
        return
    lds(x, int(ins.a), ty)
    sse_rr(fpre(ty), opc, x, xb)
    sts(d, x, ty)

fn x_unary(prefix: int, opc: int, ins: Ins, src_ty: int, dst_ty: int):
    d := int(ins.dst)
    x := xdreg(d, 0)
    xa := xreg_of(int(ins.a), 1, src_ty)
    sse_rr(prefix, opc, x, xa)
    sts(d, x, dst_ty)

# fused compare + branch: next instruction consumes the flag
fused_cc := -1

fn emit_ins(pos: int, ins: Ins):
    op := ins.op
    d := int(ins.dst)
    a := int(ins.a)
    bb := int(ins.b)
    if is_icmp(op) or is_fcmp(op):
        # fuse with a following if/brif that is the only user
        if pos + 1 < ir.code.len() and v_nuse[d] == 1:
            nx := ir.code[pos + 1]
            if (nx.op == .if_ or nx.op == .brif) and int(nx.a) == d:
                if is_icmp(op):
                    cmp_ops(a, bb)
                    fused_cc = icc(op)
                else: fused_cc = fcmp_flags(ins)
                return
    match op:
        nop: pass
        iconst:
            if vloc[d] == LOC_CONST or vloc[d] == LOC_NONE: return
            r := dreg(d, RAX)
            mov_imm(r, ins.imm)
            st(d, r)
        fconst:
            if vloc[d] == LOC_NONE: return
            mov_imm(RAX, ins.imm)
            if vloc[d] >= XMM: movq_xr(vloc[d] - XMM, RAX)
            else: st(d, RAX)
        mov:
            if vloc[d] == LOC_NONE: return
            if vtype(d) == VI:
                r := dreg(d, RAX)
                ld(r, a)
                st(d, r)
            else:
                x := xdreg(d, 0)
                lds(x, a, vtype(d))
                sts(d, x, vtype(d))
        add:
            if vloc[d] == LOC_NONE or vloc[d] == LOC_SLOT: return
            int_bin(0x01, 0, ins)
        sub: int_bin(0x29, 5, ins)
        and_: int_bin(0x21, 4, ins)
        or_: int_bin(0x09, 1, ins)
        xor: int_bin(0x31, 6, ins)
        mul:
            if vloc[d] == LOC_NONE: return
            r := dreg(d, RAX)
            if vloc[bb] == r and r != vloc[a]: r = RAX
            ld(r, a)
            l := vloc[bb]
            if l == LOC_CONST:
                c := vcval[bb]
                rex(true, r, 0, r, false)
                b(0x69)
                modrr(r, r)
                b32(c)
            else:
                rb := reg_of(bb, RCX)
                rex(true, r, 0, rb, false)
                b(0x0F)
                b(0xAF)
                modrr(r, rb)
            st(d, r)
        divs, rems, divu, remu:
            ld(RAX, a)
            rb := reg_of(bb, RCX)
            if rb == RDX:
                mov_rr(RCX, RDX)
                rb = RCX
            if op == .divs or op == .rems:
                b(0x48)
                b(0x99)               # cqo
            else:
                b(0x31)
                b(0xD2)               # xor edx, edx
            rex(true, 0, 0, rb, false)
            b(0xF7)
            if op == .divs or op == .rems: modrr(7, rb)
            else: modrr(6, rb)
            if op == .rems or op == .remu: st(d, RDX)
            else: st(d, RAX)
        shl, shrs, shru:
            ld(RCX, bb)
            r := dreg(d, RAX)
            if r == RCX: r = RAX
            ld(r, a)
            rex(true, 0, 0, r, false)
            b(0xD3)
            if op == .shl: modrr(4, r)
            else if op == .shru: modrr(5, r)
            else: modrr(7, r)
            st(d, r)
        neg, not_:
            r := dreg(d, RAX)
            ld(r, a)
            rex(true, 0, 0, r, false)
            b(0xF7)
            if op == .neg: modrr(3, r)
            else: modrr(2, r)
            st(d, r)
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu:
            cmp_ops(a, bb)
            setcc(icc(op))
            st(d, RAX)
        fadd: falu(0x58, ins)
        fsub: falu(0x5C, ins)
        fmul: falu(0x59, ins)
        fdiv: falu(0x5E, ins)
        fmin: falu(0x5D, ins)
        fmax: falu(0x5F, ins)
        fsqrt: x_unary(fpre(int(ins.ty)), 0x51, ins, int(ins.ty), int(ins.ty))
        ffloor, fceil, ftrunc:
            ty := int(ins.ty)
            mode := 1
            if op == .fceil: mode = 2
            if op == .ftrunc: mode = 3
            x := xdreg(d, 0)
            xa := xreg_of(a, 1, ty)
            b(0x66)
            rex(false, x, 0, xa, false)
            b(0x0F)
            b(0x3A)
            if ty == VS: b(0x0A)
            else: b(0x0B)
            modrr(x, xa)
            b(mode)
            sts(d, x, ty)
        fneg, fabs:
            ty := int(ins.ty)
            xa := xreg_of(a, 0, ty)
            movq_rx(RAX, xa)
            bit := 63
            if ty == VS: bit = 31
            rex(true, 0, 0, RAX, false)
            b(0x0F)
            b(0xBA)
            if op == .fneg: modrr(7, RAX)
            else: modrr(6, RAX)
            b(bit)
            x := xdreg(d, 0)
            movq_xr(x, RAX)
            sts(d, x, ty)
        feq, fne, flt, fle, fgt, fge:
            cc := fcmp_flags(ins)
            if cc == 100:
                b(0x0F); b(0x94); b(0xC0)        # sete al
                b(0x0F); b(0x9B); b(0xC1)        # setnp cl
                b(0x20); b(0xC8)                  # and al, cl
                b(0x0F); b(0xB6); b(0xC0)
            else if cc == 101:
                b(0x0F); b(0x95); b(0xC0)        # setne al
                b(0x0F); b(0x9A); b(0xC1)        # setp cl
                b(0x08); b(0xC8)                  # or al, cl
                b(0x0F); b(0xB6); b(0xC0)
            else: setcc(cc)
            st(d, RAX)
        sext8, sext16, sext32, zext8, zext16, zext32:
            ra := reg_of(a, RAX)
            r := dreg(d, RAX)
            if op == .sext32: op_rr(0x63, true, r, ra)      # movsxd r, ra32
            else if op == .zext32: op_rr(0x8B, false, r, ra) # mov r32, ra32
            else:
                w := op == .sext8 or op == .zext8
                sg := op == .sext8 or op == .sext16
                rex(true, r, 0, ra, false)
                b(0x0F)
                if w:
                    if sg: b(0xBE)
                    else: b(0xB6)
                else:
                    if sg: b(0xBF)
                    else: b(0xB7)
                modrr(r, ra)
            st(d, r)
        i2f:
            ty := int(ins.ty)
            ra := reg_of(a, RAX)
            x := xdreg(d, 0)
            b(fpre(ty))
            rex(true, x, 0, ra, false)
            b(0x0F)
            b(0x2A)
            modrr(x, ra)
            sts(d, x, ty)
        u2f:
            ty := int(ins.ty)
            ld(RAX, a)
            b(0x48); b(0x85); b(0xC0)          # test rax, rax
            j1 := jcc32(0x8)                     # js
            b(fpre(ty)); b(0x48); b(0x0F); b(0x2A); b(0xC0)    # cvtsi2sd xmm0, rax
            j2 := jmp32()
            patch_here(j1)
            mov_rr(RCX, RAX)
            b(0x48); b(0xD1); b(0xE9)          # shr rcx, 1
            b(0x83); b(0xE0); b(0x01)          # and eax, 1
            b(0x48); b(0x09); b(0xC1)          # or rcx, rax
            b(fpre(ty)); b(0x48); b(0x0F); b(0x2A); b(0xC1)    # cvtsi2sd xmm0, rcx
            b(fpre(ty)); b(0x0F); b(0x58); b(0xC0)             # addsd xmm0, xmm0
            patch_here(j2)
            sts(d, 0, ty)
        f2i:
            ty := int(ins.ty)
            xa := xreg_of(a, 0, ty)
            r := dreg(d, RAX)
            b(fpre(ty))
            rex(true, r, 0, xa, false)
            b(0x0F)
            b(0x2C)
            modrr(r, xa)
            st(d, r)
        f2f:
            # ins.ty is the destination type
            if int(ins.ty) == VF: x_unary(0xF3, 0x5A, ins, VS, VF)
            else: x_unary(0xF2, 0x5A, ins, VF, VS)
        bits2f:
            ra := reg_of(a, RAX)
            x := xdreg(d, 0)
            movq_xr(x, ra)
            sts(d, x, int(ins.ty))
        f2bits:
            ty := int(ins.ty)
            xa := xreg_of(a, 0, ty)
            r := dreg(d, RAX)
            movq_rx(r, xa)
            if ty == VS: op_rr(0x8B, false, r, r)          # zero upper half
            st(d, r)
        load:
            if vloc[d] == LOC_NONE: return
            mode := int(ins.c)
            size := mode & 15
            base, disp := addr_of(a, RCX)
            disp += int(ins.imm)
            if mode & M_FLOAT != 0:
                x := xdreg(d, 0)
                if size == 4: sse_rm(0xF3, 0x10, x, base, disp)
                else: sse_rm(0xF2, 0x10, x, base, disp)
                sts(d, x, vtype(d))
            else:
                r := dreg(d, RAX)
                load_sized(r, base, disp, size, mode & M_SIGNED != 0)
                st(d, r)
        store:
            mode := int(ins.c)
            size := mode & 15
            base, disp := addr_of(a, RCX)
            disp += int(ins.imm)
            if vtype(bb) != VI:
                xb := xreg_of(bb, 0, vtype(bb))
                if size == 4: sse_rm(0xF3, 0x11, xb, base, disp)
                else: sse_rm(0xF2, 0x11, xb, base, disp)
            else if vloc[bb] == LOC_CONST and size >= 4 and base != RIPREL:
                rex(size == 8, 0, 0, base, false)
                b(0xC7)
                mem(0, base, disp)
                b32(vcval[bb])
            else:
                rb := reg_of(bb, RAX)
                store_sized(base, disp, rb, size)
        slot:
            if vloc[d] == LOC_SLOT or vloc[d] == LOC_NONE: return
            r := dreg(d, RAX)
            lea(r, RBP, slot_off[a])
            st(d, r)
        gaddr, daddr:
            if vloc[d] == LOC_GLOBAL or vloc[d] == LOC_NONE: return
            r := dreg(d, RAX)
            kind := 1
            if op == .daddr: kind = 0
            rel_fixup_lea(r, kind, int(ins.imm))
            st(d, r)
        faddr:
            r := dreg(d, RAX)
            rex(true, r, 0, 0, false)
            b(0x8D)
            b(((r & 7) << 3) | 5)
            b32(0)
            call_fix.push((code.len() - 4, int(ins.imm)))
            st(d, r)
        copy:
            size := int(ins.imm)
            if size <= 64 and size % 8 == 0:
                db, dd := addr_reg(a, RDX)
                sb, sd := addr_reg(bb, RCX)
                k := 0
                while k < size:
                    mov_rm(RAX, sb, sd + k)
                    mov_mr(db, dd + k, RAX)
                    k += 8
            else:
                emit_parallel([PMove(RDI, a), PMove(RSI, bb)])
                mov_imm(RCX, size)
                b(0xF3); b(0xA4)          # rep movsb
        zero:
            size := int(ins.imm)
            if size <= 64 and size % 8 == 0:
                db, dd := addr_reg(a, RDX)
                b(0x31); b(0xC0)          # xor eax, eax
                k := 0
                while k < size:
                    mov_mr(db, dd + k, RAX)
                    k += 8
            else:
                ld(RDI, a)
                mov_imm(RCX, size)
                b(0x31); b(0xC0)
                b(0xF3); b(0xAA)          # rep stosb
        memcpy:
            moves := [PMove(RDI, a), PMove(RSI, bb), PMove(RCX, int(ins.c))]
            emit_parallel(moves)
            b(0xF3); b(0xA4)
        memset:
            moves := [PMove(RDI, a), PMove(RAX, bb), PMove(RCX, int(ins.c))]
            emit_parallel(moves)
            b(0xF3); b(0xAA)
        zeroslots:
            b(0x31); b(0xC0)
            for k in 0..bb:
                item := int(ir.args[a + k])
                if item & 1 == 1:
                    v := item >> 1
                    if vloc[v] != LOC_NONE: st(v, RAX)
                else:
                    s := item >> 1
                    size := int(ir.slot_size[s])
                    off := slot_off[s]
                    j := 0
                    while j < size:
                        mov_mr(RBP, off + j, RAX)
                        j += 8
        call:
            emit_call_args(a, bb, -1, 0)
            b(0xE8)
            b32(0)
            call_fix.push((code.len() - 4, int(ins.imm)))
            pop_call_stack()
            store_result(ins)
        calli, callc:
            emit_call_args(a, bb, int(ins.c), R11)
            b(0x41); b(0xFF); b(0xD3)     # call r11
            pop_call_stack()
            store_result(ins)
        syscall:
            regs := [RAX, RDI, RSI, RDX, R10, R8, R9]
            moves: [PMove]
            for k in 0..bb: moves.push(PMove(regs[k], int(ir.args[a + k])))
            emit_parallel(moves)
            b(0x0F); b(0x05)
            st(d, RAX)
        intr:
            if ins.imm == 1:
                r := dreg(d, RAX)
                rel_fixup_lea(r, 1, 0)
                mov_rm(r, r, 0)
                st(d, r)
            else:
                # setjmp / longjmp / jump: arguments in rdi, rsi then a call to a machine-code stub
                emit_call_args(a, bb, -1, 0)
                b(0xE8)
                b32(0)
                stub_fix.push((code.len() - 4, int(ins.imm)))
                pop_call_stack()
                if ins.imm == 2: st(d, RAX)
        block: xctl.push(XCtl(0, code.len(), [], []))
        loop: xctl.push(XCtl(1, code.len(), [], []))
        if_:
            fx: [int]
            if fused_cc >= 0:
                cc := fused_cc
                fused_cc = -1
                jfalse(cc, fx)
            else:
                ra := reg_of(a, RAX)
                rex(true, ra, 0, ra, false)
                b(0x85)
                modrr(ra, ra)                   # test r, r
                fx.push(jcc32(CC_E))
            xctl.push(XCtl(2, code.len(), [], fx))
        else_:
            c := xctl.len() - 1
            xctl[c].fixups.push(jmp32())
            for f in xctl[c].ifx: patch_here(f)
            xctl[c].ifx = []
        end:
            c := xctl.pop()
            for f in c.fixups: patch_here(f)
            for f in c.ifx: patch_here(f)
        br: branch_target_fix(int(ins.imm))
        brif:
            if fused_cc >= 0:
                cc := fused_cc
                fused_cc = -1
                if cc == 100:
                    # equal and ordered: jump only when ZF=1 and PF=0
                    skip := jcc32(CC_P)
                    branch_target_jcc(int(ins.imm), CC_E)
                    patch_here(skip)
                else if cc == 101:
                    branch_target_jcc(int(ins.imm), CC_P)
                    branch_target_jcc(int(ins.imm), CC_NE)
                else: branch_target_jcc(int(ins.imm), cc)
            else:
                ra := reg_of(a, RAX)
                rex(true, ra, 0, ra, false)
                b(0x85)
                modrr(ra, ra)
                branch_target_jcc(int(ins.imm), CC_NE)
        ret:
            if a >= 0:
                ty := vtype(a)
                if ty == VI: ld(RAX, a)
                else: lds(0, a, ty)
            emit_epilogue()
        trap: b(0x0F); b(0x0B)
        select: ice("select not supported")

# jumps taken when condition `cc` is false (fixup positions appended to fx)
fn jfalse(cc: int, fx: mut [int]):
    if cc == 100:
        # not (ZF and !PF): jump if PF or !ZF
        fx.push(jcc32(CC_P))
        fx.push(jcc32(CC_NE))
        return
    if cc == 101:
        # not (!ZF or PF): jump if ZF and !PF
        skip := jcc32(CC_P)
        fx.push(jcc32(CC_E))
        patch_here(skip)
        return
    fx.push(jcc32(cc ^ 1))

fn x64_function():
    while fn_addr.len() <= ir.fn_index: fn_addr.push(-1)
    while code.len() % 16 != 0: b(0xCC)
    fn_addr[ir.fn_index] = code.len()
    fn_start := code.len()
    analyze()
    allocate()
    layout_frame()
    xctl = []
    fused_cc = -1
    emit_prologue()
    for pos, ins in ir.code: emit_ins(pos, ins)
    elf_syms.push((ir.name, fn_start, code.len() - fn_start))

# entry point: runs module initializers and main
fn x64_entry(inits: [int], main_lf: int) -> int:
    while code.len() % 16 != 0: b(0xCC)
    start := code.len()
    rel_fixup_lea(RAX, 1, 0)
    mov_mr(RAX, 0, RSP)                       # save initial stack pointer (argc/argv)
    rex(true, 0, 0, RSP, false)
    b(0x83)
    modrr(4, RSP)
    b(0xF0)                                   # and rsp, -16
    for f in inits:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, f))
    if main_lf >= 0:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, main_lf))
    b(0x31); b(0xFF)                          # xor edi, edi
    mov_imm(RAX, 231)
    b(0x0F); b(0x05)                          # exit_group
    start

stub_fix: [(int, int)]
stub_addr: [int] = [-1, -1, -1, -1, -1]

# machine code stubs for non-local control transfer
fn x64_stubs():
    while code.len() % 16 != 0: b(0xCC)
    # setjmp(rdi = buf): save callee-saved registers, stack pointer and return address
    stub_addr[2] = code.len()
    for i, r in [RBX, RBP, 12, 13, 14, 15]: mov_mr(RDI, 8 * i, r)
    lea(RAX, RSP, 8)
    mov_mr(RDI, 48, RAX)
    mov_rm(RAX, RSP, 0)
    mov_mr(RDI, 56, RAX)
    b(0x31); b(0xC0)                     # xor eax, eax
    b(0xC3)
    # longjmp(rdi = buf, rsi = value)
    while code.len() % 16 != 0: b(0xCC)
    stub_addr[3] = code.len()
    for i, r in [RBX, RBP, 12, 13, 14, 15]: mov_rm(r, RDI, 8 * i)
    mov_rm(RSP, RDI, 48)
    mov_rr(RAX, RSI)
    rex(false, 0, 0, RDI, false)
    b(0xFF)
    mem(4, RDI, 56)                       # jmp [rdi+56]
    # jump(rdi = entry, rsi = stack): switch stacks and jump (rdx = 0 for ld.so)
    while code.len() % 16 != 0: b(0xCC)
    stub_addr[4] = code.len()
    mov_rr(RSP, RSI)
    b(0x31); b(0xD2)                     # xor edx, edx
    rex(false, 0, 0, RDI, false)
    b(0xFF)
    modrr(4, RDI)                          # jmp rdi

fn x64_resolve(text_addr: int, ro_addr: int, data_addr: int):
    if stub_fix.len() > 0 and stub_addr[2] < 0: ice("stubs not emitted")
    for f in stub_fix: patch32(f.0, stub_addr[f.1] - (f.0 + 4))
    for f in call_fix:
        target := fn_addr[f.1]
        if target < 0: ice("unresolved function {lfuncs[f.1].name}")
        patch32(f.0, target - (f.0 + 4))
    for f in data_fix:
        base := ro_addr
        if f.1 == 1: base = data_addr
        target := base + f.2
        patch32(f.0, target - (text_addr + f.0 + 4))
