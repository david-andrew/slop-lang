# x86-64 backend: IR -> machine code. Calling convention follows SysV for scalars:
# integer args in rdi, rsi, rdx, rcx, r8, r9; float args in xmm0-7; the rest on the stack.

use util
use ir
use lower
use types
use check
use ast
use elf

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

code: [u8]
fn_addr: [int]            # lfunc index -> code offset (-1 = not yet)
call_fix: [(int, int)]    # (position of rel32, lfunc)
data_fix: [(int, int, int)]  # (position of rel32, kind 0=rodata 1=data, offset)
int_arg_regs := [RDI, RSI, RDX, RCX, R8, R9]

fn b(x: int): code.push(u8(x & 255))
fn b32(x: int):
    b(x)
    b(x >> 8)
    b(x >> 16)
    b(x >> 24)
fn b64(x: int):
    b32(x)
    b32(x >> 32)
fn patch32(pos: int, v: int):
    code[pos] = u8(v & 255)
    code[pos + 1] = u8((v >> 8) & 255)
    code[pos + 2] = u8((v >> 16) & 255)
    code[pos + 3] = u8((v >> 24) & 255)

fn rex(w: bool, r: int, x: int, bb: int, force: bool):
    v := 0x40
    if w: v |= 8
    if r & 8 != 0: v |= 4
    if x & 8 != 0: v |= 2
    if bb & 8 != 0: v |= 1
    if v != 0x40 or force: b(v)

# ModRM + optional SIB + displacement for [base + disp]
fn mem(reg: int, base: int, disp: int):
    r := reg & 7
    bs := base & 7
    if disp == 0 and bs != 5:
        b((r << 3) | bs)
        if bs == 4: b(0x24)
    else if disp >= -128 and disp <= 127:
        b(0x40 | (r << 3) | bs)
        if bs == 4: b(0x24)
        b(disp)
    else:
        b(0x80 | (r << 3) | bs)
        if bs == 4: b(0x24)
        b32(disp)

fn modrr(reg: int, rm: int): b(0xC0 | ((reg & 7) << 3) | (rm & 7))

# op r64, [base+disp]   (e.g. 0x8B mov, 0x03 add ...)
fn op_rm(opc: int, w: bool, reg: int, base: int, disp: int):
    rex(w, reg, 0, base, false)
    b(opc)
    mem(reg, base, disp)

fn op_rr(opc: int, w: bool, reg: int, rm: int):
    rex(w, reg, 0, rm, false)
    b(opc)
    modrr(reg, rm)

fn mov_rm(r: int, base: int, disp: int): op_rm(0x8B, true, r, base, disp)     # mov r, [m]
fn mov_mr(base: int, disp: int, r: int): op_rm(0x89, true, r, base, disp)     # mov [m], r
fn mov_rr(d: int, s: int): op_rr(0x89, true, s, d)
fn lea(r: int, base: int, disp: int): op_rm(0x8D, true, r, base, disp)

fn mov_imm(r: int, v: int):
    if v >= 0 and v <= 0xFFFFFFFF:
        rex(false, 0, 0, r, false)
        b(0xB8 + (r & 7))
        b32(v)
    else if v >= -2147483648 and v <= 2147483647:
        rex(true, 0, 0, r, false)
        b(0xC7)
        modrr(0, r)
        b32(v)
    else:
        rex(true, 0, 0, r, false)
        b(0xB8 + (r & 7))
        b64(v)

# sized load from [base+disp] into r (zero/sign extended to 64 bits)
fn load_sized(r: int, base: int, disp: int, size: int, signed: bool):
    if size == 8: mov_rm(r, base, disp)
    else if size == 4:
        if signed: op_rm(0x63, true, r, base, disp)       # movsxd
        else: op_rm(0x8B, false, r, base, disp)           # mov r32
    else if size == 2:
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBF)
        else: b(0xB7)
        mem(r, base, disp)
    else:
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBE)
        else: b(0xB6)
        mem(r, base, disp)

fn store_sized(base: int, disp: int, r: int, size: int):
    if size == 8: mov_mr(base, disp, r)
    else if size == 4: op_rm(0x89, false, r, base, disp)
    else if size == 2:
        b(0x66)
        op_rm(0x89, false, r, base, disp)
    else:
        rex(false, r, 0, base, r >= 4)
        b(0x88)
        mem(r, base, disp)

# SSE: prefix (F2 for sd, F3 for ss, 66 for pd), 0F, opc, modrm mem
fn sse_rm(prefix: int, opc: int, x: int, base: int, disp: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, base, false)
    b(0x0F)
    b(opc)
    mem(x, base, disp)
fn sse_rr(prefix: int, opc: int, x: int, y: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, y, false)
    b(0x0F)
    b(opc)
    modrr(x, y)

fn jmp32() -> int:
    b(0xE9)
    b32(0)
    code.len() - 4
fn jcc32(cc: int) -> int:
    b(0x0F)
    b(0x80 + cc)
    b32(0)
    code.len() - 4
fn patch_here(pos: int): patch32(pos, code.len() - (pos + 4))
fn jmp_back(target: int):
    b(0xE9)
    b32(target - (code.len() + 4))

const CC_E = 4
const CC_NE = 5
const CC_L = 0xC
const CC_GE = 0xD
const CC_LE = 0xE
const CC_G = 0xF
const CC_B = 2
const CC_AE = 3
const CC_BE = 6
const CC_A = 7
const CC_P = 0xA
const CC_NP = 0xB

fn setcc(cc: int):
    b(0x0F)
    b(0x90 + cc)
    b(0xC0)        # al
    b(0x0F)
    b(0xB6)
    b(0xC0)        # movzx eax, al

# ---------------- per-function state ----------------
vreg_off: [int]
slot_off: [int]
frame_size := 0

struct XCtl:
    kind: int     # 0 block, 1 loop, 2 if
    start: int
    fixups: [int]
    if_fix: int

xctl: [XCtl]

fn voff(v: int) -> int: vreg_off[v]

fn ld(r: int, v: int): mov_rm(r, RBP, voff(v))
fn st(v: int, r: int): mov_mr(RBP, voff(v), r)

fn lds(x: int, v: int, ty: int):
    if ty == VS: sse_rm(0xF3, 0x10, x, RBP, voff(v))
    else: sse_rm(0xF2, 0x10, x, RBP, voff(v))
fn sts(v: int, x: int, ty: int):
    if ty == VS: sse_rm(0xF3, 0x11, x, RBP, voff(v))
    else: sse_rm(0xF2, 0x11, x, RBP, voff(v))

fn layout_frame():
    off := 0
    vreg_off = [0; ir.vtypes.len()]
    for v in 0..ir.vtypes.len():
        off += 8
        vreg_off[v] = -off
    slot_off = [0; ir.slot_size.len()]
    for s in 0..ir.slot_size.len():
        sz := int(ir.slot_size[s])
        al := int(ir.slot_align[s])
        off = align_up(off + sz, al)
        slot_off[s] = -off
    frame_size = align_up(off, 16)

fn emit_prologue():
    b(0x55)                        # push rbp
    mov_rr(RBP, RSP)
    if frame_size > 0:
        rex(true, 0, 0, RSP, false)
        b(0x81)
        modrr(5, RSP)
        b32(frame_size)            # sub rsp, frame
    ni := 0
    nf := 0
    stack_k := 0
    for p in 0..ir.nparams:
        ty := vtype(p)
        if ty == VI:
            if ni < 6:
                st(p, int_arg_regs[ni])
                ni += 1
                continue
        else:
            if nf < 8:
                sts(p, nf, ty)
                nf += 1
                continue
        # stack argument
        mov_rm(RAX, RBP, 16 + 8 * stack_k)
        st(p, RAX)
        stack_k += 1

fn emit_epilogue():
    mov_rr(RSP, RBP)
    b(0x5D)       # pop rbp
    b(0xC3)       # ret

fn emit_call_args(start: int, n: int):
    # place call arguments; returns via globals the number of stack bytes pushed
    ni := 0
    nf := 0
    stack_args: [int]
    for k in 0..n:
        v := int(ir.args[start + k])
        ty := vtype(v)
        if ty == VI:
            if ni < 6:
                ni += 1
                continue
        else:
            if nf < 8:
                nf += 1
                continue
        stack_args.push(v)
    pad := (stack_args.len() % 2) * 8
    if pad > 0:
        rex(true, 0, 0, RSP, false)
        b(0x83)
        modrr(5, RSP)
        b(8)
    i := stack_args.len() - 1
    while i >= 0:
        ld(RAX, stack_args[i])
        b(0x50)   # push rax
        i -= 1
    ni = 0
    nf = 0
    for k in 0..n:
        v := int(ir.args[start + k])
        ty := vtype(v)
        if ty == VI:
            if ni < 6:
                ld(int_arg_regs[ni], v)
                ni += 1
        else:
            if nf < 8:
                lds(nf, v, ty)
                nf += 1
    call_stack_bytes = pad + stack_args.len() * 8

call_stack_bytes := 0

fn pop_call_stack():
    if call_stack_bytes > 0:
        rex(true, 0, 0, RSP, false)
        b(0x81)
        modrr(0, RSP)
        b32(call_stack_bytes)

fn store_result(ins: Ins):
    d := int(ins.dst)
    if d < 0: return
    ty := vtype(d)
    if ty == VI: st(d, RAX)
    else: sts(d, 0, ty)

fn int_alu(opc: int, ins: Ins):
    ld(RAX, int(ins.a))
    op_rm(opc, true, RAX, RBP, voff(int(ins.b)))
    st(int(ins.dst), RAX)

fn icmp(cc: int, ins: Ins):
    ld(RAX, int(ins.a))
    op_rm(0x3B, true, RAX, RBP, voff(int(ins.b)))   # cmp rax, [b]
    setcc(cc)
    st(int(ins.dst), RAX)

fn fpre(ty: int) -> int:
    if ty == VS: return 0xF3
    0xF2

fn falu(opc: int, ins: Ins):
    ty := int(ins.ty)
    lds(0, int(ins.a), ty)
    sse_rm(fpre(ty), opc, 0, RBP, voff(int(ins.b)))
    sts(int(ins.dst), 0, ty)

fn fcmp(op: Op, ins: Ins):
    ty := int(ins.ty)
    ucomi := 0x2E
    pre := 0
    if ty == VF: pre = 0x66
    a := int(ins.a)
    bb := int(ins.b)
    if op == .flt or op == .fle:
        # a < b  <=>  b > a
        x := a
        a = bb
        bb = x
    lds(0, a, ty)
    sse_rm(pre, ucomi, 0, RBP, voff(bb))
    if op == .feq:
        b(0x0F); b(0x94); b(0xC0)        # sete al
        b(0x0F); b(0x9B); b(0xC1)        # setnp cl
        b(0x20); b(0xC8)                  # and al, cl
        b(0x0F); b(0xB6); b(0xC0)
    else if op == .fne:
        b(0x0F); b(0x95); b(0xC0)        # setne al
        b(0x0F); b(0x9A); b(0xC1)        # setp cl
        b(0x08); b(0xC8)                  # or al, cl
        b(0x0F); b(0xB6); b(0xC0)
    else if op == .flt or op == .fgt: setcc(CC_A)
    else: setcc(CC_AE)
    st(int(ins.dst), RAX)

fn rel_fixup_lea(r: int, kind: int, off: int):
    rex(true, r, 0, 0, false)
    b(0x8D)
    b(((r & 7) << 3) | 5)
    b32(0)
    data_fix.push((code.len() - 4, kind, off))

fn branch_target_fix(depth: int):
    # emit jmp to the construct `depth` levels out
    c := xctl.len() - 1 - depth
    if xctl[c].kind == 1: jmp_back(xctl[c].start)
    else: xctl[c].fixups.push(jmp32())

fn emit_ins(ins: Ins):
    op := ins.op
    d := int(ins.dst)
    a := int(ins.a)
    bb := int(ins.b)
    match op:
        nop: pass
        iconst:
            v := ins.imm
            if v >= -2147483648 and v <= 2147483647:
                rex(true, 0, 0, RBP, false)
                b(0xC7)
                mem(0, RBP, voff(d))
                b32(v)
            else:
                mov_imm(RAX, v)
                st(d, RAX)
        fconst:
            mov_imm(RAX, ins.imm)
            st(d, RAX)
        mov:
            ld(RAX, a)
            st(d, RAX)
        add: int_alu(0x03, ins)
        sub: int_alu(0x2B, ins)
        and_: int_alu(0x23, ins)
        or_: int_alu(0x0B, ins)
        xor: int_alu(0x33, ins)
        mul:
            ld(RAX, a)
            rex(true, RAX, 0, RBP, false)
            b(0x0F)
            b(0xAF)
            mem(RAX, RBP, voff(bb))
            st(d, RAX)
        divs, rems, divu, remu:
            ld(RAX, a)
            if op == .divs or op == .rems: b(0x48); b(0x99)               # cqo
            else: b(0x31); b(0xD2)                                         # xor edx, edx
            rex(true, 0, 0, RBP, false)
            b(0xF7)
            if op == .divs or op == .rems: mem(7, RBP, voff(bb))        # idiv
            else: mem(6, RBP, voff(bb))                                  # div
            if op == .rems or op == .remu: st(d, RDX)
            else: st(d, RAX)
        shl, shrs, shru:
            ld(RAX, a)
            ld(RCX, bb)
            rex(true, 0, 0, RAX, false)
            b(0xD3)
            if op == .shl: modrr(4, RAX)
            else if op == .shru: modrr(5, RAX)
            else: modrr(7, RAX)
            st(d, RAX)
        neg, not_:
            ld(RAX, a)
            rex(true, 0, 0, RAX, false)
            b(0xF7)
            if op == .neg: modrr(3, RAX)
            else: modrr(2, RAX)
            st(d, RAX)
        eq: icmp(CC_E, ins)
        ne: icmp(CC_NE, ins)
        lts: icmp(CC_L, ins)
        les: icmp(CC_LE, ins)
        gts: icmp(CC_G, ins)
        ges: icmp(CC_GE, ins)
        ltu: icmp(CC_B, ins)
        leu: icmp(CC_BE, ins)
        gtu: icmp(CC_A, ins)
        geu: icmp(CC_AE, ins)
        fadd: falu(0x58, ins)
        fsub: falu(0x5C, ins)
        fmul: falu(0x59, ins)
        fdiv: falu(0x5E, ins)
        fmin: falu(0x5D, ins)
        fmax: falu(0x5F, ins)
        fsqrt:
            ty := int(ins.ty)
            sse_rm(fpre(ty), 0x51, 0, RBP, voff(a))
            sts(d, 0, ty)
        ffloor, fceil, ftrunc:
            ty := int(ins.ty)
            mode := 1
            if op == .fceil: mode = 2
            if op == .ftrunc: mode = 3
            # roundsd/roundss xmm0, [m], mode
            b(0x66)
            rex(false, 0, 0, RBP, false)
            b(0x0F)
            b(0x3A)
            if ty == VS: b(0x0A)
            else: b(0x0B)
            mem(0, RBP, voff(a))
            b(mode)
            sts(d, 0, ty)
        fneg, fabs:
            ld(RAX, a)
            bit := 63
            if int(ins.ty) == VS: bit = 31
            rex(true, 0, 0, RAX, false)
            b(0x0F)
            b(0xBA)
            if op == .fneg: modrr(7, RAX)      # btc
            else: modrr(6, RAX)                # btr
            b(bit)
            st(d, RAX)
        feq, fne, flt, fle, fgt, fge: fcmp(op, ins)
        sext8:
            load_sized(RAX, RBP, voff(a), 1, true)
            st(d, RAX)
        sext16:
            load_sized(RAX, RBP, voff(a), 2, true)
            st(d, RAX)
        sext32:
            load_sized(RAX, RBP, voff(a), 4, true)
            st(d, RAX)
        zext8:
            load_sized(RAX, RBP, voff(a), 1, false)
            st(d, RAX)
        zext16:
            load_sized(RAX, RBP, voff(a), 2, false)
            st(d, RAX)
        zext32:
            load_sized(RAX, RBP, voff(a), 4, false)
            st(d, RAX)
        i2f:
            # cvtsi2sd/ss xmm0, qword [m]
            ty := int(ins.ty)
            b(fpre(ty))
            rex(true, 0, 0, RBP, false)
            b(0x0F)
            b(0x2A)
            mem(0, RBP, voff(a))
            sts(d, 0, ty)
        u2f:
            ty := int(ins.ty)
            ld(RAX, a)
            # if negative as signed: (x >> 1 | x & 1) converted then doubled
            b(0x48); b(0x85); b(0xC0)          # test rax, rax
            j1 := jcc32(0x8)                     # js
            b(fpre(ty)); b(0x48); b(0x0F); b(0x2A); b(0xC0)    # cvtsi2sd xmm0, rax
            j2 := jmp32()
            patch_here(j1)
            mov_rr(RCX, RAX)
            b(0x48); b(0xD1); b(0xE9)          # shr rcx, 1
            b(0x83); b(0xE0); b(0x01)          # and eax, 1
            b(0x48); b(0x09); b(0xC1)          # or rcx, rax
            b(fpre(ty)); b(0x48); b(0x0F); b(0x2A); b(0xC1)    # cvtsi2sd xmm0, rcx
            b(fpre(ty)); b(0x0F); b(0x58); b(0xC0)             # addsd xmm0, xmm0
            patch_here(j2)
            sts(d, 0, ty)
        f2i:
            ty := int(ins.ty)
            b(fpre(ty))
            rex(true, RAX, 0, RBP, false)
            b(0x0F)
            b(0x2C)
            mem(RAX, RBP, voff(a))
            st(d, RAX)
        f2f:
            # ins.ty is the destination type
            if int(ins.ty) == VF: sse_rm(0xF3, 0x5A, 0, RBP, voff(a))   # cvtss2sd
            else: sse_rm(0xF2, 0x5A, 0, RBP, voff(a))                  # cvtsd2ss
            sts(d, 0, int(ins.ty))
        bits2f, f2bits:
            if int(ins.ty) == VS: load_sized(RAX, RBP, voff(a), 4, false)
            else: ld(RAX, a)
            st(d, RAX)
        load:
            mode := int(ins.c)
            size := mode & 15
            ld(RCX, a)
            if mode & M_FLOAT != 0:
                if size == 4: load_sized(RAX, RCX, int(ins.imm), 4, false)
                else: mov_rm(RAX, RCX, int(ins.imm))
            else: load_sized(RAX, RCX, int(ins.imm), size, mode & M_SIGNED != 0)
            st(d, RAX)
        store:
            mode := int(ins.c)
            ld(RCX, a)
            ld(RAX, bb)
            store_sized(RCX, int(ins.imm), RAX, mode & 15)
        slot:
            lea(RAX, RBP, slot_off[a])
            st(d, RAX)
        gaddr:
            rel_fixup_lea(RAX, 1, int(ins.imm))
            st(d, RAX)
        daddr:
            rel_fixup_lea(RAX, 0, int(ins.imm))
            st(d, RAX)
        faddr:
            rex(true, RAX, 0, 0, false)
            b(0x8D)
            b(0x05)
            b32(0)
            call_fix.push((code.len() - 4, int(ins.imm)))
            st(d, RAX)
        copy:
            size := int(ins.imm)
            ld(RDI, a)
            ld(RSI, bb)
            if size <= 64 and size % 8 == 0:
                k := 0
                while k < size:
                    mov_rm(RAX, RSI, k)
                    mov_mr(RDI, k, RAX)
                    k += 8
            else:
                mov_imm(RCX, size)
                b(0xF3); b(0xA4)          # rep movsb
        zero:
            size := int(ins.imm)
            ld(RDI, a)
            if size <= 64 and size % 8 == 0:
                b(0x31); b(0xC0)          # xor eax, eax
                k := 0
                while k < size:
                    mov_mr(RDI, k, RAX)
                    k += 8
            else:
                mov_imm(RCX, size)
                b(0x31); b(0xC0)
                b(0xF3); b(0xAA)          # rep stosb
        memcpy:
            ld(RDI, a)
            ld(RSI, bb)
            ld(RCX, int(ins.c))
            b(0xF3); b(0xA4)
        memset:
            ld(RDI, a)
            ld(RAX, bb)
            ld(RCX, int(ins.c))
            b(0xF3); b(0xAA)
        zeroslots:
            b(0x31); b(0xC0)
            for k in 0..bb:
                item := int(ir.args[a + k])
                if item & 1 == 1: st(item >> 1, RAX)
                else:
                    s := item >> 1
                    size := int(ir.slot_size[s])
                    off := slot_off[s]
                    j := 0
                    while j < size:
                        mov_mr(RBP, off + j, RAX)
                        j += 8
        call:
            emit_call_args(a, bb)
            b(0xE8)
            b32(0)
            call_fix.push((code.len() - 4, int(ins.imm)))
            pop_call_stack()
            store_result(ins)
        calli, callc:
            emit_call_args(a, bb)
            ld(R11, int(ins.c))
            b(0x41); b(0xFF); b(0xD3)     # call r11
            pop_call_stack()
            store_result(ins)
        syscall:
            regs := [RAX, RDI, RSI, RDX, R10, R8, R9]
            for k in 0..bb: ld(regs[k], int(ir.args[a + k]))
            b(0x0F); b(0x05)
            st(d, RAX)
        intr:
            if ins.imm == 1:
                rel_fixup_lea(RAX, 1, 0)
                mov_rm(RAX, RAX, 0)
                st(d, RAX)
        block: xctl.push(XCtl(0, code.len(), [], -1))
        loop: xctl.push(XCtl(1, code.len(), [], -1))
        if_:
            ld(RAX, a)
            b(0x48); b(0x85); b(0xC0)     # test rax, rax
            xctl.push(XCtl(2, code.len(), [], jcc32(CC_E)))
        else_:
            c := xctl.len() - 1
            xctl[c].fixups.push(jmp32())
            patch_here(xctl[c].if_fix)
            xctl[c].if_fix = -1
        end:
            c := xctl.pop()
            for f in c.fixups: patch_here(f)
            if c.if_fix >= 0: patch_here(c.if_fix)
        br: branch_target_fix(int(ins.imm))
        brif:
            ld(RAX, a)
            b(0x48); b(0x85); b(0xC0)
            j := jcc32(CC_E)
            branch_target_fix(int(ins.imm))
            patch_here(j)
        ret:
            if a >= 0:
                ty := vtype(a)
                if ty == VI: ld(RAX, a)
                else: lds(0, a, ty)
            emit_epilogue()
        trap: b(0x0F); b(0x0B)
        select: ice("select not supported")

fn x64_function():
    while fn_addr.len() <= ir.fn_index: fn_addr.push(-1)
    # align function starts to 16 bytes
    while code.len() % 16 != 0: b(0xCC)
    fn_addr[ir.fn_index] = code.len()
    fn_start := code.len()
    layout_frame()
    xctl = []
    emit_prologue()
    for ins in ir.code: emit_ins(ins)
    elf_syms.push((ir.name, fn_start, code.len() - fn_start))

# entry point: runs module initializers and main
fn x64_entry(inits: [int], main_lf: int) -> int:
    while code.len() % 16 != 0: b(0xCC)
    start := code.len()
    rel_fixup_lea(RAX, 1, 0)
    mov_mr(RAX, 0, RSP)                       # save initial stack pointer (argc/argv)
    rex(true, 0, 0, RSP, false)
    b(0x83)
    modrr(4, RSP)
    b(0xF0)                                   # and rsp, -16
    for f in inits:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, f))
    if main_lf >= 0:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, main_lf))
    b(0x31); b(0xFF)                          # xor edi, edi
    mov_imm(RAX, 231)
    b(0x0F); b(0x05)                          # exit_group
    start

fn x64_resolve(text_addr: int, ro_addr: int, data_addr: int):
    for f in call_fix:
        target := fn_addr[f.1]
        if target < 0: ice("unresolved function {lfuncs[f.1].name}")
        patch32(f.0, target - (f.0 + 4))
    for f in data_fix:
        base := ro_addr
        if f.1 == 1: base = data_addr
        target := base + f.2
        patch32(f.0, target - (text_addr + f.0 + 4))
