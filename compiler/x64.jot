# x86-64 backend: IR -> machine code. Calling convention follows SysV for scalars:
# integer args in rdi, rsi, rdx, rcx, r8, r9; float args in xmm0-7; the rest on the stack.

use 'util.jot'
use 'ir.jot'
use 'lower.jot'
use 'types.jot'
use 'check.jot'
use 'ast.jot'
use 'elf.jot'

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

code: u8[]
fn_addr: int[]            # lfunc index -> code offset (-1 = not yet)
call_fix: (int, int)[]    # (position of rel32, lfunc)
data_fix: (int, int, int)[]  # (position of rel32, kind 0=rodata 1=data, offset)
int_arg_regs = [RDI, RSI, RDX, RCX, R8, R9]

b = (x: int): code.push(u8(x & 255))
b32 = (x: int):
    b(x)
    b(x >> 8)
    b(x >> 16)
    b(x >> 24)
b64 = (x: int):
    b32(x)
    b32(x >> 32)
patch32 = (pos: int, v: int):
    code[pos] = u8(v & 255)
    code[pos + 1] = u8((v >> 8) & 255)
    code[pos + 2] = u8((v >> 16) & 255)
    code[pos + 3] = u8((v >> 24) & 255)

rip_kind = 0
# index register for the next memory operand ([base + index << scale + disp]); -1: none
cur_index = -1
cur_scale = 0

use_index = (ix: int, scale: int):
    cur_index = ix
    cur_scale = scale

# an indexed access needs a real base register (rip-relative addressing takes no index)
indexed_base = (base: int, disp: int, imm: int) -> (int, int):
    if base != RIPREL: return (base, disp)
    rel_fixup_lea(RCX, rip_kind, disp - imm)
    (RCX, imm)

rex = (w: bool, r: int, x: int, bb0: int, force: bool):
    bb = bb0
    if bb == RIPREL: bb = 0
    v = 0x40
    if w: v |= 8
    if r & 8 != 0: v |= 4
    if x & 8 != 0 or (cur_index >= 0 and cur_index & 8 != 0): v |= 2
    if bb & 8 != 0: v |= 1
    if v != 0x40 or force: b(v)

# ModRM + optional SIB + displacement for [base + disp]
mem = (reg: int, base: int, disp: int):
    r = reg & 7
    if cur_index >= 0:
        sib = (cur_scale << 6) | ((cur_index & 7) << 3) | (base & 7)
        if disp == 0 and base & 7 != 5:
            b((r << 3) | 4)
            b(sib)
        else if disp >= -128 and disp <= 127:
            b(0x40 | (r << 3) | 4)
            b(sib)
            b(disp)
        else:
            b(0x80 | (r << 3) | 4)
            b(sib)
            b32(disp)
        return
    if base == RIPREL:
        b((r << 3) | 5)
        b32(0)
        data_fix.push((code.len() - 4, rip_kind, disp))
        return
    bs = base & 7
    if disp == 0 and bs != 5:
        b((r << 3) | bs)
        if bs == 4: b(0x24)
    else if disp >= -128 and disp <= 127:
        b(0x40 | (r << 3) | bs)
        if bs == 4: b(0x24)
        b(disp)
    else:
        b(0x80 | (r << 3) | bs)
        if bs == 4: b(0x24)
        b32(disp)

modrr = (reg: int, rm: int): b(0xC0 | ((reg & 7) << 3) | (rm & 7))

# op r64, [base+disp]   (e.g. 0x8B mov, 0x03 add ...)
op_rm = (opc: int, w: bool, reg: int, base: int, disp: int):
    rex(w, reg, 0, base, false)
    b(opc)
    mem(reg, base, disp)

op_rr = (opc: int, w: bool, reg: int, rm: int):
    rex(w, reg, 0, rm, false)
    b(opc)
    modrr(reg, rm)

mov_rm = (r: int, base: int, disp: int): op_rm(0x8B, true, r, base, disp)     # mov r, [m]
mov_mr = (base: int, disp: int, r: int): op_rm(0x89, true, r, base, disp)     # mov [m], r
mov_rr = (d: int, s: int): op_rr(0x89, true, s, d)
lea = (r: int, base: int, disp: int): op_rm(0x8D, true, r, base, disp)

mov_imm = (r: int, v: int):
    if v >= 0 and v <= 0xFFFFFFFF:
        rex(false, 0, 0, r, false)
        b(0xB8 + (r & 7))
        b32(v)
    else if v >= -2147483648 and v <= 2147483647:
        rex(true, 0, 0, r, false)
        b(0xC7)
        modrr(0, r)
        b32(v)
    else:
        rex(true, 0, 0, r, false)
        b(0xB8 + (r & 7))
        b64(v)

# sized load from [base+disp] into r (zero/sign extended to 64 bits)
load_sized = (r: int, base: int, disp: int, size: int, signed: bool):
    if size == 8: mov_rm(r, base, disp)
    else if size == 4:
        if signed: op_rm(0x63, true, r, base, disp)       # movsxd
        else: op_rm(0x8B, false, r, base, disp)           # mov r32
    else if size == 2:
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBF)
        else: b(0xB7)
        mem(r, base, disp)
    else:
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBE)
        else: b(0xB6)
        mem(r, base, disp)

store_sized = (base: int, disp: int, r: int, size: int):
    if size == 8: mov_mr(base, disp, r)
    else if size == 4: op_rm(0x89, false, r, base, disp)
    else if size == 2:
        b(0x66)
        op_rm(0x89, false, r, base, disp)
    else:
        rex(false, r, 0, base, r >= 4)
        b(0x88)
        mem(r, base, disp)

# SSE: prefix (F2 for sd, F3 for ss, 66 for pd), 0F, opc, modrm mem
sse_rm = (prefix: int, opc: int, x: int, base: int, disp: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, base, false)
    b(0x0F)
    b(opc)
    mem(x, base, disp)
sse_rr = (prefix: int, opc: int, x: int, y: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, y, false)
    b(0x0F)
    b(opc)
    modrr(x, y)

jmp32 = () -> int:
    b(0xE9)
    b32(0)
    code.len() - 4
jcc32 = (cc: int) -> int:
    b(0x0F)
    b(0x80 + cc)
    b32(0)
    code.len() - 4
patch_here = (pos: int): patch32(pos, code.len() - (pos + 4))
jmp_back = (target: int):
    b(0xE9)
    b32(target - (code.len() + 4))

const CC_E = 4
const CC_NE = 5
const CC_L = 0xC
const CC_GE = 0xD
const CC_LE = 0xE
const CC_G = 0xF
const CC_B = 2
const CC_AE = 3
const CC_BE = 6
const CC_A = 7
const CC_P = 0xA
const CC_NP = 0xB

setcc = (cc: int):
    b(0x0F)
    b(0x90 + cc)
    b(0xC0)        # al
    b(0x0F)
    b(0xB6)
    b(0xC0)        # movzx eax, al


# ---------------- register allocation ----------------
# vreg locations: >= 0 register (0-15 general, 16+n = xmm n); or one of:
const LOC_SPILL = -1
const LOC_CONST = -2
const LOC_SLOT = -3
const LOC_NONE = -4
const LOC_GLOBAL = -5
const RIPREL = 99            # pseudo base register for rip-relative addressing
vgkind: int[]
vgoff: int[]
const XMM = 16
const INF_POS = 1 << 60

vloc: int[]
vspill: int[]
vcval: int[]
vslot: int[]
vsoff: int[]
slot_off: int[]
frame_size = 0
callee_off: int[]          # save offset per register (0 = not used)
ra_on = true              # false: spill everything (fast debug codegen)
callee_pool = [RBX, 12, 13, 14, 15]
is_callee = [false, false, false, true, false, false, false, false, false, false, false, false, true, true, true, true]
caller_pool = [RSI, RDI, R8, R9, R10, R11]

vsave: bool[]              # in a caller-saved register, saved/restored around calls
save_list: int[]
v_first: int[]
v_last: int[]
v_ndef: int[]
v_nuse: int[]
call_pos: int[]
loop_s: int[]
loop_e: int[]
use_buf: int[]

# struct copies/clears up to this size are emitted inline
const INLINE_COPY = 256

call_like = (ins: Ins) -> bool:
    op = ins.op
    if op == .intr and ins.imm >= 2: return true
    if op == .call and ins.c == 1: return false      # never returns
    if op == .call or op == .calli or op == .callc or op == .syscall or op == .memcpy or op == .memset: return true
    if op == .copy or op == .zero: return ins.imm > INLINE_COPY
    false

# fills use_buf with used vregs; returns the defined vreg or -1
operands = (ins: Ins) -> int:
    use_buf.clear()
    op = ins.op
    a = int(ins.a)
    bb = int(ins.b)
    d = int(ins.dst)
    match op:
        nop, block, loop, end, else_, br, trap: return -1
        iconst, fconst, slot, gaddr, daddr, faddr: return d
        intr:
            loop k in [0..bb): use_buf.push(int(ir.args[a + k]))
            return d
        if_, brif, brtable, assume:
            use_buf.push(a)
            return -1
        ret:
            if a >= 0: use_buf.push(a)
            return -1
        store, copy:
            use_buf.push(a)
            use_buf.push(bb)
            if op == .store and int(ins.c) & M_INDEX != 0: use_buf.push(d)
            return -1
        zero:
            use_buf.push(a)
            return -1
        memcpy, memset, vop:
            use_buf.push(a)
            use_buf.push(bb)
            use_buf.push(int(ins.c))
            return -1
        zeroslots:
            # defines vreg items (handled by caller via args)
            return -1
        call, syscall:
            loop k in [0..bb): use_buf.push(int(ir.args[a + k]))
            return d
        calli, callc:
            loop k in [0..bb): use_buf.push(int(ir.args[a + k]))
            use_buf.push(int(ins.c))
            return d
        load:
            use_buf.push(a)
            if int(ins.c) & M_INDEX != 0: use_buf.push(bb)
            return d
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            use_buf.push(a)
            return d
        _:
            use_buf.push(a)
            use_buf.push(bb)
            return d

fits32 = (v: int) -> bool: v >= -2147483648 and v <= 2147483647

# a vector operand into xmm x: n f32 lanes from memory, or a scalar repeated in every lane
vop_operand = (x: int, v: int, splat: bool, n: int, scratch: int):
    if splat:
        s = xreg_of(v, x, VS)
        if s != x: sse_rr(0, 0x28, x, s)                                 # movaps
        sse_rr(0, 0xC6, x, x)                                            # shufps x, x, 0
        b(0)
        return
    base, disp = addr_reg(v, scratch)
    if n == 4: sse_rm(0, 0x10, x, base, disp)                            # movups
    else:
        sse_rm(0xF2, 0x10, x, base, disp)                                # movsd
        if n == 3:
            sse_rm(0xF3, 0x10, 15, base, disp + 8)                       # movss
            sse_rr(0, 0x16, x, 15)                                       # movlhps x, xmm15

analyze = ():
    nv = ir.vtypes.len()
    v_first = fill(INF_POS, nv)
    v_last = fill(-1, nv)
    v_ndef = fill(0, nv)
    v_nuse = fill(0, nv)
    vloc = fill(LOC_SPILL, nv)
    vcval = fill(0, nv)
    vslot = fill(-1, nv)
    vsoff = fill(0, nv)
    vgkind = fill(0, nv)
    vgoff = fill(0, nv)
    call_pos = []
    loop_s = []
    loop_e = []
    kinds: int[]
    starts: int[]
    loop p in [0..ir.nparams):
        v_first[p] = 0
        v_last[p] = 0
        v_ndef[p] = 1
    loop v in [0..ir.kval.len()):
        if is_kv(v):
            v_ndef[v] = 1
            vloc[v] = LOC_CONST
            vcval[v] = ir.kval[v]
    loop pos in 0.. and ins in ir.code:
        d = operands(ins)
        loop u in use_buf:
            if pos < v_first[u]: v_first[u] = pos
            if pos > v_last[u]: v_last[u] = pos
            v_nuse[u] += 1
        if d >= 0:
            if pos < v_first[d]: v_first[d] = pos
            if pos > v_last[d]: v_last[d] = pos
            v_ndef[d] += 1
            if v_ndef[d] == 1:
                op = ins.op
                if op == .iconst and fits32(ins.imm):
                    vloc[d] = LOC_CONST
                    vcval[d] = ins.imm
                else if op == .slot:
                    vloc[d] = LOC_SLOT
                    vslot[d] = int(ins.a)
                else if op == .gaddr or op == .daddr:
                    vloc[d] = LOC_GLOBAL
                    vgoff[d] = int(ins.imm)
                    if op == .gaddr: vgkind[d] = 1
                else if op == .add and vloc[int(ins.a)] == LOC_SLOT and vloc[int(ins.b)] == LOC_CONST and v_ndef[int(ins.a)] == 1 and v_ndef[int(ins.b)] == 1:
                    vloc[d] = LOC_SLOT
                    vslot[d] = vslot[int(ins.a)]
                    vsoff[d] = vsoff[int(ins.a)] + vcval[int(ins.b)]
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    v = item >> 1
                    if pos < v_first[v]: v_first[v] = pos
                    if pos > v_last[v]: v_last[v] = pos
                    v_ndef[v] += 2
        if call_like(ins): call_pos.push(pos)
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(int(ins.op))
            starts.push(pos)
        else if ins.op == .end:
            k = kinds.pop()
            s = starts.pop()
            if k == int(Op.loop):
                loop_s.push(s)
                loop_e.push(pos)
    # a vreg defined more than once can't stay a constant/address
    loop v in [0..nv):
        if v_ndef[v] != 1 and (vloc[v] == LOC_CONST or vloc[v] == LOC_SLOT or vloc[v] == LOC_GLOBAL): vloc[v] = LOC_SPILL
    # loops in order of their start
    nl = loop_s.len()
    order: int[]
    loop i in [0..nl): order.push(i)
    order.sort_by((i: int): loop_s[i])
    ls: int[]
    le: int[]
    loop i in order:
        ls.push(loop_s[i])
        le.push(loop_e[i])
    loop_s = ls
    loop_e = le
    # extend intervals of values live around loops
    loop v in [0..nv):
        if v_last[v] < 0: continue
        f = live_start(v)
        # first loop starting after f
        lo = 0
        hi = nl
        loop lo < hi:
            mid = (lo + hi) / 2
            if loop_s[mid] <= f: lo = mid + 1
            else: hi = mid
        i = lo
        loop i < nl and loop_s[i] <= v_last[v]:
            if loop_e[i] > v_last[v]: v_last[v] = loop_e[i]
            i += 1

hint_op = (op: Op) -> bool:
    match op:
        mov, add, sub, mul, and_, or_, xor, shl, shrs, shru, neg, not_, load: true
        fadd, fsub, fmul, fdiv, fmin, fmax, fneg, fabs: true
        sext8, sext16, sext32, zext8, zext16, zext32: true
        _: false

# operand whose register the value defined at pos can reuse (-1: none)
hint_operand = (v: int, pos: int) -> int:
    if v < ir.nparams or pos >= ir.code.len(): return -1
    ins = ir.code[pos]
    if int(ins.dst) != v or not hint_op(ins.op): return -1
    a = int(ins.a)
    if a < 0 or a == v or vloc[a] < 0 or v_last[a] != pos: return -1
    if (vloc[a] >= XMM) != (vtype(v) != VI): return -1
    a

# params are live on entry, before the first instruction
live_start = (v: int) -> int:
    if v < ir.nparams: return -1
    v_first[v]

crosses_call = (s: int, e: int) -> bool:
    lo = 0
    hi = call_pos.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if call_pos[mid] <= s: lo = mid + 1
        else: hi = mid
    lo < call_pos.len() and call_pos[lo] < e

allocate = ():
    nv = ir.vtypes.len()
    callee_off = fill(0, 16)
    vsave = fill(false, nv)
    if not ra_on:
        loop v in [0..nv):
            if vloc[v] != LOC_CONST and vloc[v] != LOC_SLOT and vloc[v] != LOC_GLOBAL: vloc[v] = LOC_SPILL
        return
    # bucket vregs by interval start
    n = ir.code.len() + 1
    head = fill(-1, n)
    nxt = fill(-1, nv)
    loop v in [0..nv):
        if vloc[v] == LOC_CONST or vloc[v] == LOC_SLOT or vloc[v] == LOC_GLOBAL: continue
        if v_last[v] < 0:
            vloc[v] = LOC_NONE
            continue
        if v_nuse[v] == 0 and v >= ir.nparams:
            vloc[v] = LOC_NONE
            continue
        f = v_first[v]
        nxt[v] = head[f]
        head[f] = v
    free = fill(true, 32)
    loop r in [RAX, RCX, RDX, RSP, RBP]: free[r] = false
    free[XMM + 0] = false
    free[XMM + 1] = false
    free[XMM + 15] = false
    active: int[]
    in_active = fill(false, nv)
    min_end = INF_POS      # earliest end among active intervals
    loop pos in [0..n):
        v = head[pos]
        if v >= 0 and min_end < pos:
            # expire old intervals
            min_end = INF_POS
            k = 0
            loop k < active.len():
                a = active[k]
                if v_last[a] < pos:
                    free[vloc[a]] = true
                    in_active[a] = false
                    active[k] = active[active.len() - 1]
                    active.pop()
                else:
                    if v_last[a] < min_end: min_end = v_last[a]
                    k += 1
        loop v >= 0:
            crosses = crosses_call(live_start(v), v_last[v])
            reg = -1
            # two-operand forms: take over the register of a first operand that dies here
            h = hint_operand(v, pos)
            if h >= 0 and in_active[h]:
                reg = vloc[h]
                active.remove(active.index_of(h))
                in_active[h] = false
                vsave[v] = crosses and (reg >= XMM or not is_callee[reg])
                if reg < XMM and is_callee[reg]: callee_off[reg] = 1
            else if vtype(v) != VI:
                # all xmm registers are caller-saved: values living across calls are saved around them
                loop x in [2..15):
                    if free[XMM + x]:
                        reg = XMM + x
                        vsave[v] = crosses
                        break
            else:
                if not crosses:
                    loop r in caller_pool:
                        if free[r]:
                            reg = r
                            break
                if reg < 0:
                    loop r in callee_pool:
                        if free[r]:
                            reg = r
                            break
                if reg < 0 and crosses:
                    loop r in caller_pool:
                        if free[r]:
                            reg = r
                            vsave[v] = true
                            break
            if reg < 0:
                # steal from the active interval that ends last, if that helps
                best = -1
                loop a in active:
                    if v_last[a] <= v_last[v]: continue
                    ra = vloc[a]
                    if (ra >= XMM) != (vtype(v) != VI): continue
                    if crosses and ra < XMM and not is_callee[ra]: continue
                    if best < 0 or v_last[a] > v_last[best]: best = a
                if best >= 0:
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    vsave[v] = crosses and reg >= XMM
                    active.remove(active.index_of(best))
                    in_active[best] = false
            if reg >= 0:
                vloc[v] = reg
                free[reg] = false
                active.push(v)
                in_active[v] = true
                if v_last[v] < min_end: min_end = v_last[v]
                if reg < XMM and is_callee[reg]: callee_off[reg] = 1
            else: vloc[v] = LOC_SPILL
            v = nxt[v]

layout_frame = ():
    off = 0
    loop r in [0..16):
        if callee_off[r] != 0:
            off += 8
            callee_off[r] = -off
    nv = ir.vtypes.len()
    vspill = fill(0, nv)
    save_list = []
    loop v in [0..nv):
        if vloc[v] == LOC_SPILL or (vsave[v] and vloc[v] >= 0):
            off += 8
            vspill[v] = -off
            if vloc[v] >= 0: save_list.push(v)
    slot_off = fill(0, ir.slot_size.len())
    loop s in [0..ir.slot_size.len()):
        sz = int(ir.slot_size[s])
        al = int(ir.slot_align[s])
        off = align_up(off + sz, al)
        slot_off[s] = -off
    frame_size = align_up(off, 16)

# ---------------- operand access ----------------
is_xmm = (r: int) -> bool: r >= XMM
slot_disp = (v: int) -> int: slot_off[vslot[v]] + vsoff[v]

# value of int vreg v into register r
ld = (r: int, v: int):
    l = vloc[v]
    if l >= 0:
        if l != r: mov_rr(r, l)
    else if l == LOC_SPILL: mov_rm(r, RBP, vspill[v])
    else if l == LOC_CONST: mov_imm(r, vcval[v])
    else if l == LOC_SLOT: lea(r, RBP, slot_disp(v))
    else if l == LOC_GLOBAL: rel_fixup_lea(r, vgkind[v], vgoff[v])
    else: mov_imm(r, 0)

# register holding int vreg v (loads into scratch if needed)
reg_of = (v: int, scratch: int) -> int:
    l = vloc[v]
    if l >= 0 and l < XMM: return l
    ld(scratch, v)
    scratch

# store register r into vreg v
st = (v: int, r: int):
    l = vloc[v]
    if l >= 0:
        if l != r: mov_rr(l, r)
    else if l == LOC_SPILL: mov_mr(RBP, vspill[v], r)

# destination register for v (its own register, or scratch)
dreg = (v: int, scratch: int) -> int:
    l = vloc[v]
    if l >= 0 and l < XMM: return l
    scratch

# register copies use movaps: movsd/movss would merge into (and wait for) the old destination
movsd_rr = (x: int, y: int, ty: int):
    if x == y: return
    sse_rr(0, 0x28, x, y)

# break the false dependency of scalar sqrt/convert instructions on their destination
xzero = (x: int): sse_rr(0, 0x57, x, x)          # xorps x, x

lds = (x: int, v: int, ty: int):
    l = vloc[v]
    if l >= XMM: movsd_rr(x, l - XMM, ty)
    else if l == LOC_SPILL:
        if ty == VS: sse_rm(0xF3, 0x10, x, RBP, vspill[v])
        else: sse_rm(0xF2, 0x10, x, RBP, vspill[v])
    else:
        ld(RAX, v)
        movq_xr(x, RAX)
sts = (v: int, x: int, ty: int):
    l = vloc[v]
    if l >= XMM: movsd_rr(l - XMM, x, ty)
    else if l == LOC_SPILL:
        if ty == VS: sse_rm(0xF3, 0x11, x, RBP, vspill[v])
        else: sse_rm(0xF2, 0x11, x, RBP, vspill[v])
xreg_of = (v: int, scratch: int, ty: int) -> int:
    l = vloc[v]
    if l >= XMM: return l - XMM
    lds(scratch, v, ty)
    scratch
xdreg = (v: int, scratch: int) -> int:
    l = vloc[v]
    if l >= XMM: return l - XMM
    scratch

movq_xr = (x: int, r: int):
    b(0x66)
    rex(true, x, 0, r, false)
    b(0x0F)
    b(0x6E)
    modrr(x, r)
movq_rx = (r: int, x: int):
    b(0x66)
    rex(true, x, 0, r, false)
    b(0x0F)
    b(0x7E)
    modrr(x, r)

# ALU r, operand(v): register / memory / imm32 forms
# opc_rr: "op r/m64, r64" opcode (e.g. 0x01 add); ext: /digit for 0x81 imm form
alu_v = (opc_rr: int, ext: int, r: int, v: int):
    l = vloc[v]
    if l >= 0 and l < XMM: op_rr(opc_rr, true, l, r)
    else if l == LOC_CONST:
        c = vcval[v]
        rex(true, 0, 0, r, false)
        if c >= -128 and c <= 127:
            b(0x83)
            modrr(ext, r)
            b(c)
        else:
            b(0x81)
            modrr(ext, r)
            b32(c)
    else if l == LOC_SPILL: op_rm(opc_rr + 2, true, r, RBP, vspill[v])
    else:
        ld(RCX, v)
        op_rr(opc_rr, true, RCX, r)

# memory base for an address vreg: returns (base register, displacement)
addr_of = (v: int, scratch: int) -> (int, int):
    if vloc[v] == LOC_SLOT: return (RBP, slot_disp(v))
    if vloc[v] == LOC_GLOBAL:
        rip_kind = vgkind[v]
        return (RIPREL, vgoff[v])
    (reg_of(v, scratch), 0)

# like addr_of, but never rip-relative (for instructions with two memory operands)
addr_reg = (v: int, scratch: int) -> (int, int):
    if vloc[v] == LOC_SLOT: return (RBP, slot_disp(v))
    (reg_of(v, scratch), 0)

# ---------------- parallel moves ----------------
# moves of values into registers: dst register <- vreg
struct PMove:
    dst: int
    v: int

src_reg = (v: int) -> int:
    l = vloc[v]
    if l >= 0: return l
    -1

emit_parallel = (moves: PMove[]):
    pending = moves
    # register to register moves first (with cycle breaking via the stack)
    loop true:
        progress = false
        any_reg = false
        k = 0
        loop k < pending.len():
            m = pending[k]
            s = src_reg(m.v)
            if s < 0 or s == m.dst:
                k += 1
                continue
            any_reg = true
            blocked = false
            loop o in pending:
                if src_reg(o.v) == m.dst and o.dst != m.dst: blocked = true
            if not blocked:
                if is_xmm(m.dst): movsd_rr(m.dst - XMM, s - XMM, VF)
                else: mov_rr(m.dst, s)
                pending.remove(k)
                progress = true
            else: k += 1
        if not any_reg: break
        if not progress:
            # cycle: save one source on the stack, redirect its readers
            loop i in 0.. and m in pending:
                s = src_reg(m.v)
                if s >= 0 and s != m.dst:
                    if is_xmm(s):
                        movq_rx(RAX, s - XMM)
                        b(0x50)
                    else:
                        rex(false, 0, 0, s, false)
                        b(0x50 + (s & 7))
                    # pop into destination after everything else
                    cyc_dst = m.dst
                    pending.remove(i)
                    emit_parallel(pending)
                    if is_xmm(cyc_dst):
                        b(0x58)
                        movq_xr(cyc_dst - XMM, RAX)
                    else:
                        rex(false, 0, 0, cyc_dst, false)
                        b(0x58 + (cyc_dst & 7))
                    return
    # remaining: sources in memory, constants, slot addresses (or already in place)
    loop m in pending:
        if src_reg(m.v) == m.dst: continue
        if is_xmm(m.dst): lds(m.dst - XMM, m.v, vtype(m.v))
        else: ld(m.dst, m.v)

# ---------------- function body ----------------
struct XCtl:
    kind: int     # 0 block, 1 loop, 2 if
    start: int
    fixups: int[]
    ifx: int[]    # jumps to the else branch

xctl: XCtl[]
call_stack_bytes = 0

emit_prologue = ():
    b(0x55)                        # push rbp
    mov_rr(RBP, RSP)
    if frame_size > 0:
        rex(true, 0, 0, RSP, false)
        b(0x81)
        modrr(5, RSP)
        b32(frame_size)            # sub rsp, frame
    loop r in [0..16):
        if callee_off[r] != 0: mov_mr(RBP, callee_off[r], r)
    # incoming parameters
    ni = 0
    nf = 0
    stack_k = 0
    moves: PMove[]
    stack_params: (int, int)[]
    reg_spills: (int, int)[]
    loop p in [0..ir.nparams):
        ty = vtype(p)
        src = -1
        if ty == VI:
            if ni < 6:
                src = int_arg_regs[ni]
                ni += 1
        else:
            if nf < 8:
                src = XMM + nf
                nf += 1
        if src < 0:
            stack_params.push((p, 16 + 8 * stack_k))
            stack_k += 1
            continue
        l = vloc[p]
        if l == LOC_NONE: continue
        if l == LOC_SPILL: reg_spills.push((p, src))
        else: moves.push(PMove(l, p))
        # record the incoming register as the temporary source location
        pin_src.push((p, src))
    # spills first (they read incoming registers)
    loop rs in reg_spills:
        if is_xmm(rs.1):
            if vtype(rs.0) == VS: sse_rm(0xF3, 0x11, rs.1 - XMM, RBP, vspill[rs.0])
            else: sse_rm(0xF2, 0x11, rs.1 - XMM, RBP, vspill[rs.0])
        else: mov_mr(RBP, vspill[rs.0], rs.1)
    # register moves: sources are the incoming registers
    saved = vloc
    loop ps in pin_src: vloc[ps.0] = ps.1
    real: PMove[]
    loop m in moves: real.push(m)
    emit_parallel(real)
    vloc = saved
    pin_src.clear()
    loop sp in stack_params:
        p = sp.0
        l = vloc[p]
        if l == LOC_NONE: continue
        if vtype(p) == VI:
            mov_rm(RAX, RBP, sp.1)
            st(p, RAX)
        else:
            sse_rm(0xF2, 0x10, 0, RBP, sp.1)
            sts(p, 0, vtype(p))

pin_src: (int, int)[]

emit_epilogue = ():
    loop r in [0..16):
        if callee_off[r] != 0: mov_rm(r, RBP, callee_off[r])
    mov_rr(RSP, RBP)
    b(0x5D)       # pop rbp
    b(0xC3)       # ret

emit_call_args = (start: int, n: int, extra: int, extra_dst: int):
    ni = 0
    nf = 0
    stack_args: int[]
    moves: PMove[]
    loop k in [0..n):
        v = int(ir.args[start + k])
        ty = vtype(v)
        if ty == VI:
            if ni < 6:
                moves.push(PMove(int_arg_regs[ni], v))
                ni += 1
                continue
        else:
            if nf < 8:
                moves.push(PMove(XMM + nf, v))
                nf += 1
                continue
        stack_args.push(v)
    if extra >= 0: moves.push(PMove(extra_dst, extra))
    pad = (stack_args.len() % 2) * 8
    if pad > 0:
        rex(true, 0, 0, RSP, false)
        b(0x83)
        modrr(5, RSP)
        b(8)
    i = stack_args.len() - 1
    loop i >= 0:
        v = stack_args[i]
        if vtype(v) == VI: ld(RAX, v)
        else:
            lds(0, v, vtype(v))
            movq_rx(RAX, 0)
        b(0x50)
        i -= 1
    emit_parallel(moves)
    call_stack_bytes = pad + stack_args.len() * 8

pop_call_stack = ():
    if call_stack_bytes > 0:
        rex(true, 0, 0, RSP, false)
        b(0x81)
        modrr(0, RSP)
        b32(call_stack_bytes)

store_result = (ins: Ins):
    d = int(ins.dst)
    if d < 0 or vloc[d] == LOC_NONE: return
    ty = vtype(d)
    if ty == VI: st(d, RAX)
    else: sts(d, 0, ty)

fpre = (ty: int) -> int:
    if ty == VS: return 0xF3
    0xF2

ro_consts: {int: int} = {}

# offset of an 8-byte constant in read-only data (shared between uses)
ro_const = (bits: int) -> int:
    if let o = ro_consts.get(bits): return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    loop k in [0..8): rodata.push(u8((bits >> (8 * k)) & 255))
    ro_consts[bits] = o
    o

rel_fixup_lea = (r: int, kind: int, off: int):
    rex(true, r, 0, 0, false)
    b(0x8D)
    b(((r & 7) << 3) | 5)
    b32(0)
    data_fix.push((code.len() - 4, kind, off))

branch_target_fix = (depth: int):
    c = xctl.len() - 1 - depth
    if xctl[c].kind == 1: jmp_back(xctl[c].start)
    else: xctl[c].fixups.push(jmp32())

branch_target_jcc = (depth: int, cc: int):
    c = xctl.len() - 1 - depth
    if xctl[c].kind == 1:
        target = xctl[c].start
        b(0x0F)
        b(0x80 + cc)
        b32(target - (code.len() + 4))
    else: xctl[c].fixups.push(jcc32(cc))

int_bin = (opc_rr: int, ext: int, ins: Ins):
    d = int(ins.dst)
    if vloc[d] == LOC_NONE: return
    a = int(ins.a)
    bb = int(ins.b)
    r = dreg(d, RAX)
    if vloc[bb] == r and r != vloc[a]: r = RAX
    ld(r, a)
    alu_v(opc_rr, ext, r, bb)
    st(d, r)

cmp_ops = (a: int, bb: int):
    ra = reg_of(a, RAX)
    alu_v(0x39, 7, ra, bb)

icc = (op: Op) -> int:
    match op:
        eq: CC_E
        ne: CC_NE
        lts: CC_L
        les: CC_LE
        gts: CC_G
        ges: CC_GE
        ltu: CC_B
        leu: CC_BE
        gtu: CC_A
        geu: CC_AE
        _: -1

is_icmp = (op: Op) -> bool: icc(op) >= 0
is_fcmp = (op: Op) -> bool: op == .feq or op == .fne or op == .flt or op == .fle or op == .fgt or op == .fge

# emit float compare flags; returns condition code for "true"
fcmp_flags = (ins: Ins) -> int:
    ty = int(ins.ty)
    pre = 0
    if ty == VF: pre = 0x66
    a = int(ins.a)
    bb = int(ins.b)
    op = ins.op
    if op == .flt or op == .fle:
        x = a
        a = bb
        bb = x
    xa = xreg_of(a, 0, ty)
    xb = xreg_of(bb, 1, ty)
    if pre != 0: b(pre)
    rex(false, xa, 0, xb, false)
    b(0x0F)
    b(0x2E)
    modrr(xa, xb)
    if op == .flt or op == .fgt: return CC_A
    if op == .fle or op == .fge: return CC_AE
    if op == .feq: return 100
    101

falu = (opc: int, ins: Ins):
    ty = int(ins.ty)
    d = int(ins.dst)
    x = xdreg(d, 0)
    xb = xreg_of(int(ins.b), 1, ty)
    if x == xb and x != 0:
        lds(0, int(ins.a), ty)
        sse_rr(fpre(ty), opc, 0, xb)
        sts(d, 0, ty)
        return
    lds(x, int(ins.a), ty)
    sse_rr(fpre(ty), opc, x, xb)
    sts(d, x, ty)

x_unary = (prefix: int, opc: int, ins: Ins, src_ty: int, dst_ty: int):
    d = int(ins.dst)
    x = xdreg(d, 0)
    xa = xreg_of(int(ins.a), 1, src_ty)
    if x != xa: xzero(x)
    sse_rr(prefix, opc, x, xa)
    sts(d, x, dst_ty)

# fused compare + branch: next instruction consumes the flag
fused_cc = -1

emit_ins = (pos: int, ins: Ins):
    op = ins.op
    d = int(ins.dst)
    a = int(ins.a)
    bb = int(ins.b)
    if is_icmp(op) or is_fcmp(op):
        # fuse with a following if/brif that is the only user
        if pos + 1 < ir.code.len() and v_nuse[d] == 1:
            nx = ir.code[pos + 1]
            if (nx.op == .if_ or nx.op == .brif) and int(nx.a) == d:
                if is_icmp(op):
                    cmp_ops(a, bb)
                    fused_cc = icc(op)
                else: fused_cc = fcmp_flags(ins)
                return
    match op:
        nop, assume: pass
        iconst:
            if vloc[d] == LOC_CONST or vloc[d] == LOC_NONE: return
            r = dreg(d, RAX)
            mov_imm(r, ins.imm)
            st(d, r)
        fconst:
            if vloc[d] == LOC_NONE: return
            if vloc[d] >= XMM:
                x = vloc[d] - XMM
                if ins.imm == 0: xzero(x)
                else:
                    # float constants live in read-only data: one load, no integer register
                    rip_kind = 0
                    sse_rm(fpre(int(ins.ty)), 0x10, x, RIPREL, ro_const(ins.imm))
                return
            mov_imm(RAX, ins.imm)
            st(d, RAX)
        mov:
            if vloc[d] == LOC_NONE: return
            if vtype(d) == VI:
                r = dreg(d, RAX)
                ld(r, a)
                st(d, r)
            else:
                x = xdreg(d, 0)
                lds(x, a, vtype(d))
                sts(d, x, vtype(d))
        add:
            if vloc[d] == LOC_NONE or vloc[d] == LOC_SLOT: return
            int_bin(0x01, 0, ins)
        sub: int_bin(0x29, 5, ins)
        and_: int_bin(0x21, 4, ins)
        or_: int_bin(0x09, 1, ins)
        xor: int_bin(0x31, 6, ins)
        mul:
            if vloc[d] == LOC_NONE: return
            r = dreg(d, RAX)
            if vloc[bb] == r and r != vloc[a]: r = RAX
            ld(r, a)
            l = vloc[bb]
            if l == LOC_CONST:
                c = vcval[bb]
                rex(true, r, 0, r, false)
                b(0x69)
                modrr(r, r)
                b32(c)
            else:
                rb = reg_of(bb, RCX)
                rex(true, r, 0, rb, false)
                b(0x0F)
                b(0xAF)
                modrr(r, rb)
            st(d, r)
        divs, rems, divu, remu:
            ld(RAX, a)
            rb = reg_of(bb, RCX)
            if rb == RDX:
                mov_rr(RCX, RDX)
                rb = RCX
            if op == .divs or op == .rems:
                b(0x48)
                b(0x99)               # cqo
            else:
                b(0x31)
                b(0xD2)               # xor edx, edx
            rex(true, 0, 0, rb, false)
            b(0xF7)
            if op == .divs or op == .rems: modrr(7, rb)
            else: modrr(6, rb)
            if op == .rems or op == .remu: st(d, RDX)
            else: st(d, RAX)
        shl, shrs, shru:
            if vloc[d] == LOC_NONE: return
            ext = 7
            if op == .shl: ext = 4
            else if op == .shru: ext = 5
            if vloc[bb] == LOC_CONST:
                r = dreg(d, RAX)
                ld(r, a)
                rex(true, 0, 0, r, false)
                b(0xC1)
                modrr(ext, r)
                b(vcval[bb] & 63)
                st(d, r)
                return
            ld(RCX, bb)
            r = dreg(d, RAX)
            if r == RCX: r = RAX
            ld(r, a)
            rex(true, 0, 0, r, false)
            b(0xD3)
            if op == .shl: modrr(4, r)
            else if op == .shru: modrr(5, r)
            else: modrr(7, r)
            st(d, r)
        neg, not_:
            r = dreg(d, RAX)
            ld(r, a)
            rex(true, 0, 0, r, false)
            b(0xF7)
            if op == .neg: modrr(3, r)
            else: modrr(2, r)
            st(d, r)
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu:
            cmp_ops(a, bb)
            setcc(icc(op))
            st(d, RAX)
        fadd: falu(0x58, ins)
        fsub: falu(0x5C, ins)
        fmul: falu(0x59, ins)
        fdiv: falu(0x5E, ins)
        fmin: falu(0x5D, ins)
        fmax: falu(0x5F, ins)
        fsqrt: x_unary(fpre(int(ins.ty)), 0x51, ins, int(ins.ty), int(ins.ty))
        ffloor, fceil, ftrunc:
            ty = int(ins.ty)
            mode = 1
            if op == .fceil: mode = 2
            if op == .ftrunc: mode = 3
            x = xdreg(d, 0)
            xa = xreg_of(a, 1, ty)
            b(0x66)
            rex(false, x, 0, xa, false)
            b(0x0F)
            b(0x3A)
            if ty == VS: b(0x0A)
            else: b(0x0B)
            modrr(x, xa)
            b(mode)
            sts(d, x, ty)
        fneg, fabs:
            ty = int(ins.ty)
            xa = xreg_of(a, 0, ty)
            movq_rx(RAX, xa)
            bit = 63
            if ty == VS: bit = 31
            rex(true, 0, 0, RAX, false)
            b(0x0F)
            b(0xBA)
            if op == .fneg: modrr(7, RAX)
            else: modrr(6, RAX)
            b(bit)
            x = xdreg(d, 0)
            movq_xr(x, RAX)
            sts(d, x, ty)
        feq, fne, flt, fle, fgt, fge:
            cc = fcmp_flags(ins)
            if cc == 100:
                b(0x0F); b(0x94); b(0xC0)        # sete al
                b(0x0F); b(0x9B); b(0xC1)        # setnp cl
                b(0x20); b(0xC8)                  # and al, cl
                b(0x0F); b(0xB6); b(0xC0)
            else if cc == 101:
                b(0x0F); b(0x95); b(0xC0)        # setne al
                b(0x0F); b(0x9A); b(0xC1)        # setp cl
                b(0x08); b(0xC8)                  # or al, cl
                b(0x0F); b(0xB6); b(0xC0)
            else: setcc(cc)
            st(d, RAX)
        sext8, sext16, sext32, zext8, zext16, zext32:
            ra = reg_of(a, RAX)
            r = dreg(d, RAX)
            if op == .sext32: op_rr(0x63, true, r, ra)      # movsxd r, ra32
            else if op == .zext32: op_rr(0x8B, false, r, ra) # mov r32, ra32
            else:
                w = op == .sext8 or op == .zext8
                sg = op == .sext8 or op == .sext16
                rex(true, r, 0, ra, false)
                b(0x0F)
                if w:
                    if sg: b(0xBE)
                    else: b(0xB6)
                else:
                    if sg: b(0xBF)
                    else: b(0xB7)
                modrr(r, ra)
            st(d, r)
        i2f:
            ty = int(ins.ty)
            ra = reg_of(a, RAX)
            x = xdreg(d, 0)
            xzero(x)
            b(fpre(ty))
            rex(true, x, 0, ra, false)
            b(0x0F)
            b(0x2A)
            modrr(x, ra)
            sts(d, x, ty)
        u2f:
            ty = int(ins.ty)
            ld(RAX, a)
            xzero(0)
            b(0x48); b(0x85); b(0xC0)          # test rax, rax
            j1 = jcc32(0x8)                     # js
            b(fpre(ty)); b(0x48); b(0x0F); b(0x2A); b(0xC0)    # cvtsi2sd xmm0, rax
            j2 = jmp32()
            patch_here(j1)
            mov_rr(RCX, RAX)
            b(0x48); b(0xD1); b(0xE9)          # shr rcx, 1
            b(0x83); b(0xE0); b(0x01)          # and eax, 1
            b(0x48); b(0x09); b(0xC1)          # or rcx, rax
            b(fpre(ty)); b(0x48); b(0x0F); b(0x2A); b(0xC1)    # cvtsi2sd xmm0, rcx
            b(fpre(ty)); b(0x0F); b(0x58); b(0xC0)             # addsd xmm0, xmm0
            patch_here(j2)
            sts(d, 0, ty)
        f2i:
            # saturating, like wasm's trunc_sat: NaN -> 0, too large -> max, too small -> min
            ty = int(ins.ty)
            xa = xreg_of(a, 0, ty)
            r = dreg(d, RAX)
            b(fpre(ty))
            rex(true, r, 0, xa, false)
            b(0x0F)
            b(0x2C)
            modrr(r, xa)
            # cvttsd2si gives INT64_MIN when out of range; `cmp r, 1` overflows only for that value
            rex(true, 0, 0, r, false)
            b(0x83)
            modrr(7, r)
            b(1)
            done = jcc32(1)                       # jno
            if ty == VS: sse_rr(0, 0x2E, xa, xa)   # ucomiss
            else: sse_rr(0x66, 0x2E, xa, xa)       # ucomisd
            nan = jcc32(CC_P)
            sse_rr(0, 0x57, XMM + 15, XMM + 15)    # xorps xmm15, xmm15
            if ty == VS: sse_rr(0, 0x2E, xa, XMM + 15)
            else: sse_rr(0x66, 0x2E, xa, XMM + 15)
            neg = jcc32(CC_BE)
            mov_imm(r, 0x7FFFFFFFFFFFFFFF)
            done2 = jmp32()
            patch_here(nan)
            op_rr(0x31, false, r, r)               # xor r32, r32
            patch_here(done)
            patch_here(neg)
            patch_here(done2)
            st(d, r)
        f2f:
            # ins.ty is the destination type
            if int(ins.ty) == VF: x_unary(0xF3, 0x5A, ins, VS, VF)
            else: x_unary(0xF2, 0x5A, ins, VF, VS)
        bits2f:
            ra = reg_of(a, RAX)
            x = xdreg(d, 0)
            movq_xr(x, ra)
            sts(d, x, int(ins.ty))
        f2bits:
            ty = int(ins.ty)
            xa = xreg_of(a, 0, ty)
            r = dreg(d, RAX)
            movq_rx(r, xa)
            if ty == VS: op_rr(0x8B, false, r, r)          # zero upper half
            st(d, r)
        load:
            if vloc[d] == LOC_NONE: return
            mode = int(ins.c)
            size = mode & 15
            base, disp = addr_of(a, RCX)
            disp += int(ins.imm)
            ix = -1
            if mode & M_INDEX != 0:
                base, disp = indexed_base(base, disp, int(ins.imm))
                ix = reg_of(int(ins.b), RDX)
            if mode & M_FLOAT != 0:
                x = xdreg(d, 0)
                use_index(ix, mem_scale(ins))
                if size == 4: sse_rm(0xF3, 0x10, x, base, disp)
                else: sse_rm(0xF2, 0x10, x, base, disp)
                cur_index = -1
                sts(d, x, vtype(d))
            else:
                r = dreg(d, RAX)
                use_index(ix, mem_scale(ins))
                load_sized(r, base, disp, size, mode & M_SIGNED != 0)
                cur_index = -1
                st(d, r)
        store:
            mode = int(ins.c)
            size = mode & 15
            base, disp = addr_of(a, RCX)
            disp += int(ins.imm)
            ix = -1
            if mode & M_INDEX != 0:
                base, disp = indexed_base(base, disp, int(ins.imm))
                ix = reg_of(int(ins.dst), RDX)
            if vtype(bb) != VI:
                xb = xreg_of(bb, 0, vtype(bb))
                use_index(ix, mem_scale(ins))
                if size == 4: sse_rm(0xF3, 0x11, xb, base, disp)
                else: sse_rm(0xF2, 0x11, xb, base, disp)
            else if vloc[bb] == LOC_CONST and size >= 4 and base != RIPREL:
                use_index(ix, mem_scale(ins))
                rex(size == 8, 0, 0, base, false)
                b(0xC7)
                mem(0, base, disp)
                b32(vcval[bb])
            else:
                rb = reg_of(bb, RAX)
                use_index(ix, mem_scale(ins))
                store_sized(base, disp, rb, size)
            cur_index = -1
        slot:
            if vloc[d] == LOC_SLOT or vloc[d] == LOC_NONE: return
            r = dreg(d, RAX)
            lea(r, RBP, slot_off[a])
            st(d, r)
        gaddr, daddr:
            if vloc[d] == LOC_GLOBAL or vloc[d] == LOC_NONE: return
            r = dreg(d, RAX)
            kind = 1
            if op == .daddr: kind = 0
            rel_fixup_lea(r, kind, int(ins.imm))
            st(d, r)
        faddr:
            r = dreg(d, RAX)
            rex(true, r, 0, 0, false)
            b(0x8D)
            b(((r & 7) << 3) | 5)
            b32(0)
            call_fix.push((code.len() - 4, int(ins.imm)))
            st(d, r)
        copy:
            size = int(ins.imm)
            if size <= INLINE_COPY:
                db, dd = addr_reg(a, RDX)
                sb, sd = addr_reg(bb, RCX)
                k = 0
                loop k + 16 <= size:
                    sse_rm(0xF3, 0x6F, XMM + 15, sb, sd + k)      # movdqu
                    sse_rm(0xF3, 0x7F, XMM + 15, db, dd + k)
                    k += 16
                loop w in [8, 4, 2, 1]:
                    if k + w <= size:
                        load_sized(RAX, sb, sd + k, w, false)
                        store_sized(db, dd + k, RAX, w)
                        k += w
            else:
                emit_parallel([PMove(RDI, a), PMove(RSI, bb)])
                mov_imm(RCX, size)
                b(0xF3); b(0xA4)          # rep movsb
        zero:
            size = int(ins.imm)
            if size <= INLINE_COPY:
                db, dd = addr_reg(a, RDX)
                b(0x31); b(0xC0)          # xor eax, eax
                k = 0
                if size >= 16: sse_rr(0x66, 0xEF, XMM + 15, XMM + 15)      # pxor
                loop k + 16 <= size:
                    sse_rm(0xF3, 0x7F, XMM + 15, db, dd + k)
                    k += 16
                loop w in [8, 4, 2, 1]:
                    if k + w <= size:
                        store_sized(db, dd + k, RAX, w)
                        k += w
            else:
                ld(RDI, a)
                mov_imm(RCX, size)
                b(0x31); b(0xC0)
                b(0xF3); b(0xAA)          # rep stosb
        vop:
            # packed float vector arithmetic, memory to memory (xmm0, xmm1, xmm15 are scratch)
            let code = int(ins.imm)
            n = (code >> 4) & 7
            vop_operand(0, bb, code & VOP_SPLAT_B != 0, n, RCX)
            vop_operand(1, int(ins.c), code & VOP_SPLAT_C != 0, n, RAX)
            sse_rr(0, [0x58, 0x5C, 0x59, 0x5E][code & 3], 0, 1)          # addps subps mulps divps
            db, dd = addr_reg(a, RDX)
            if n == 4: sse_rm(0, 0x11, 0, db, dd)                        # movups
            else:
                sse_rm(0xF2, 0x11, 0, db, dd)                            # movsd: lanes 0-1
                if n == 3:
                    sse_rr(0, 0x12, 15, 0)                               # movhlps xmm15, xmm0
                    sse_rm(0xF3, 0x11, 15, db, dd + 8)                   # movss: lane 2
        memcpy:
            moves = [PMove(RDI, a), PMove(RSI, bb), PMove(RCX, int(ins.c))]
            emit_parallel(moves)
            b(0xF3); b(0xA4)
        memset:
            moves = [PMove(RDI, a), PMove(RAX, bb), PMove(RCX, int(ins.c))]
            emit_parallel(moves)
            b(0xF3); b(0xAA)
        zeroslots:
            b(0x31); b(0xC0)
            loop k in [0..bb):
                item = int(ir.args[a + k])
                if item & 1 == 1:
                    v = item >> 1
                    if vloc[v] != LOC_NONE: st(v, RAX)
                else:
                    s = item >> 1
                    size = int(ir.slot_size[s])
                    off = slot_off[s]
                    j = 0
                    loop j < size:
                        mov_mr(RBP, off + j, RAX)
                        j += 8
        call:
            emit_call_args(a, bb, -1, 0)
            b(0xE8)
            b32(0)
            call_fix.push((code.len() - 4, int(ins.imm)))
            pop_call_stack()
            store_result(ins)
        calli, callc:
            emit_call_args(a, bb, int(ins.c), R11)
            b(0x41); b(0xFF); b(0xD3)     # call r11
            pop_call_stack()
            store_result(ins)
        syscall:
            regs = [RAX, RDI, RSI, RDX, R10, R8, R9]
            moves: PMove[]
            loop k in [0..bb): moves.push(PMove(regs[k], int(ir.args[a + k])))
            emit_parallel(moves)
            b(0x0F); b(0x05)
            st(d, RAX)
        intr:
            if ins.imm == 1:
                r = dreg(d, RAX)
                rel_fixup_lea(r, 1, 0)
                mov_rm(r, r, 0)
                st(d, r)
            else:
                # setjmp / longjmp / jump: arguments in rdi, rsi then a call to a machine-code stub
                emit_call_args(a, bb, -1, 0)
                b(0xE8)
                b32(0)
                stub_fix.push((code.len() - 4, int(ins.imm)))
                pop_call_stack()
                if d >= 0 and vloc[d] != LOC_NONE: st(d, RAX)
        block: xctl.push(XCtl(0, code.len(), [], []))
        loop: xctl.push(XCtl(1, code.len(), [], []))
        if_:
            fx: int[]
            if fused_cc >= 0:
                cc = fused_cc
                fused_cc = -1
                jfalse(cc, fx)
            else:
                ra = reg_of(a, RAX)
                rex(true, ra, 0, ra, false)
                b(0x85)
                modrr(ra, ra)                   # test r, r
                fx.push(jcc32(CC_E))
            xctl.push(XCtl(2, code.len(), [], fx))
        else_:
            c = xctl.len() - 1
            xctl[c].fixups.push(jmp32())
            loop f in xctl[c].ifx: patch_here(f)
            xctl[c].ifx = []
        end:
            c = xctl.pop()
            loop f in c.fixups: patch_here(f)
            loop f in c.ifx: patch_here(f)
        br: branch_target_fix(int(ins.imm))
        brif:
            if fused_cc >= 0:
                cc = fused_cc
                fused_cc = -1
                if cc == 100:
                    # equal and ordered: jump only when ZF=1 and PF=0
                    skip = jcc32(CC_P)
                    branch_target_jcc(int(ins.imm), CC_E)
                    patch_here(skip)
                else if cc == 101:
                    branch_target_jcc(int(ins.imm), CC_P)
                    branch_target_jcc(int(ins.imm), CC_NE)
                else: branch_target_jcc(int(ins.imm), cc)
            else:
                ra = reg_of(a, RAX)
                rex(true, ra, 0, ra, false)
                b(0x85)
                modrr(ra, ra)
                branch_target_jcc(int(ins.imm), CC_NE)
        brtable:
            # bounds check, then jump into a table of 5-byte jmp instructions
            ld(RAX, a)
            b(0x48); b(0x81); modrr(7, RAX); b32(bb)          # cmp rax, n
            branch_target_jcc(int(ins.imm), CC_AE)
            b(0x48); b(0x8D); b(0x0C); b(0x80)                # lea rcx, [rax + rax*4]
            b(0x48); b(0x8D); b(0x05); b32(5)                 # lea rax, [rip + 5]
            b(0x48); b(0x01); b(0xC8)                         # add rax, rcx
            b(0xFF); b(0xE0)                                  # jmp rax
            loop k in [0..bb): branch_target_fix(int(ir.args[int(ins.c) + k]))
        ret:
            if a >= 0:
                ty = vtype(a)
                if ty == VI: ld(RAX, a)
                else: lds(0, a, ty)
            emit_epilogue()
        trap: b(0x0F); b(0x0B)
        select: ice("select not supported")

# jumps taken when condition `cc` is false (fixup positions appended to fx)
jfalse = (cc: int, fx: mut int[]):
    if cc == 100:
        # not (ZF and !PF): jump if PF or !ZF
        fx.push(jcc32(CC_P))
        fx.push(jcc32(CC_NE))
        return
    if cc == 101:
        # not (!ZF or PF): jump if ZF and !PF
        skip = jcc32(CC_P)
        fx.push(jcc32(CC_E))
        patch_here(skip)
        return
    fx.push(jcc32((cc xor 1)))

x64_function = ():
    loop fn_addr.len() <= ir.fn_index: fn_addr.push(-1)
    loop code.len() % 16 != 0: b(0xCC)
    fn_addr[ir.fn_index] = code.len()
    fn_start = code.len()
    analyze()
    allocate()
    layout_frame()
    xctl = []
    fused_cc = -1
    emit_prologue()
    ci = 0
    save_list.sort_by((v: int): live_start(v))
    save_next = 0
    save_active.clear()
    loop pos in 0.. and ins in ir.code:
        if ci < call_pos.len() and call_pos[ci] == pos and save_list.len() > 0:
            # values in caller-saved registers live across this call (a sweep: calls come in order)
            loop save_next < save_list.len() and live_start(save_list[save_next]) < pos:
                save_active.push(save_list[save_next])
                save_next += 1
            k = 0
            loop k < save_active.len():
                if v_last[save_active[k]] <= pos:
                    save_active[k] = save_active[save_active.len() - 1]
                    save_active.pop()
                else: k += 1
            save_around_call(pos, true, -1)
            emit_ins(pos, ins)
            d = -1
            if ins.op == .call or ins.op == .calli or ins.op == .callc or ins.op == .syscall or ins.op == .intr: d = int(ins.dst)
            save_around_call(pos, false, d)
        else: emit_ins(pos, ins)
        if ci < call_pos.len() and call_pos[ci] == pos: ci += 1
    elf_syms.push((ir.name, fn_start, code.len() - fn_start))

# store (before) or reload (after) caller-saved registers holding values live across the call at pos
save_next = 0
save_active: int[]

save_around_call = (pos: int, before: bool, dst: int):
    loop v in save_active:
        if v != dst:
            r = vloc[v]
            if r >= XMM:
                op = 0x10
                if before: op = 0x11
                sse_rm(fpre(vtype(v)), op, r - XMM, RBP, vspill[v])
            else if before: mov_mr(RBP, vspill[v], r)
            else: mov_rm(r, RBP, vspill[v])

# entry point: runs module initializers and main
x64_entry = (inits: int[], main_lf: int) -> int:
    loop code.len() % 16 != 0: b(0xCC)
    start = code.len()
    rel_fixup_lea(RAX, 1, 0)
    mov_mr(RAX, 0, RSP)                       # save initial stack pointer (argc/argv)
    rex(true, 0, 0, RSP, false)
    b(0x83)
    modrr(4, RSP)
    b(0xF0)                                   # and rsp, -16
    loop f in inits:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, f))
    if main_lf >= 0:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, main_lf))
    b(0x31); b(0xFF)                          # xor edi, edi
    mov_imm(RAX, 231)
    b(0x0F); b(0x05)                          # exit_group
    start

stub_fix: (int, int)[]
stub_addr: int[] = [-1, -1, -1, -1, -1, -1, -1, -1, -1]

# machine code stubs for non-local control transfer
x64_stubs = ():
    loop code.len() % 16 != 0: b(0xCC)
    # setjmp(rdi = buf): save callee-saved registers, stack pointer and return address
    stub_addr[2] = code.len()
    loop i in 0.. and r in [RBX, RBP, 12, 13, 14, 15]: mov_mr(RDI, 8 * i, r)
    lea(RAX, RSP, 8)
    mov_mr(RDI, 48, RAX)
    mov_rm(RAX, RSP, 0)
    mov_mr(RDI, 56, RAX)
    b(0x31); b(0xC0)                     # xor eax, eax
    b(0xC3)
    # longjmp(rdi = buf, rsi = value)
    loop code.len() % 16 != 0: b(0xCC)
    stub_addr[3] = code.len()
    loop i in 0.. and r in [RBX, RBP, 12, 13, 14, 15]: mov_rm(r, RDI, 8 * i)
    mov_rm(RSP, RDI, 48)
    mov_rr(RAX, RSI)
    rex(false, 0, 0, RDI, false)
    b(0xFF)
    mem(4, RDI, 56)                       # jmp [rdi+56]
    # jump(rdi = entry, rsi = stack): switch stacks and jump (rdx = 0 for ld.so)
    loop code.len() % 16 != 0: b(0xCC)
    stub_addr[4] = code.len()
    mov_rr(RSP, RSI)
    b(0x31); b(0xD2)                     # xor edx, edx
    rex(false, 0, 0, RDI, false)
    b(0xFF)
    modrr(4, RDI)                          # jmp rdi
    # clone_thread(rdi = entry, rsi = arg, rdx = stack top): the child calls entry(arg) on the
    # new stack, then exits the thread; the parent gets the thread id (or -errno)
    loop code.len() % 16 != 0: b(0xCC)
    stub_addr[5] = code.len()
    loop x in [0x48, 0x83, 0xEA, 0x10,        # sub rdx, 16
              0x48, 0x89, 0x3A,              # mov [rdx], rdi
              0x48, 0x89, 0x72, 0x08,        # mov [rdx+8], rsi
              0x48, 0x89, 0xD6,              # mov rsi, rdx
              0xBF, 0x00, 0x0F, 0x05, 0x00,  # mov edi, CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM
              0x31, 0xD2,                    # xor edx, edx
              0x45, 0x31, 0xD2,              # xor r10d, r10d
              0x45, 0x31, 0xC0,              # xor r8d, r8d
              0xB8, 0x38, 0x00, 0x00, 0x00,  # mov eax, 56 (clone)
              0x0F, 0x05,                    # syscall
              0x48, 0x85, 0xC0,              # test rax, rax
              0x74, 0x01,                    # jz child
              0xC3,                          # ret
              0x58,                          # child: pop rax
              0x5F,                          # pop rdi
              0xFF, 0xD0,                    # call rax
              0xB8, 0x3C, 0x00, 0x00, 0x00,  # mov eax, 60 (exit this thread)
              0x31, 0xFF,                    # xor edi, edi
              0x0F, 0x05,                    # syscall
              0x0F, 0x0B]: b(x)              # ud2
    # atomic_add(rdi = p, rsi = v) -> old value
    loop code.len() % 16 != 0: b(0xCC)
    stub_addr[6] = code.len()
    loop x in [0x48, 0x89, 0xF0, 0xF0, 0x48, 0x0F, 0xC1, 0x07, 0xC3]: b(x)     # mov rax, rsi; lock xadd [rdi], rax; ret
    # atomic_cas(rdi = p, rsi = expected, rdx = desired) -> old value
    loop code.len() % 16 != 0: b(0xCC)
    stub_addr[7] = code.len()
    loop x in [0x48, 0x89, 0xF0, 0xF0, 0x48, 0x0F, 0xB1, 0x17, 0xC3]: b(x)     # mov rax, rsi; lock cmpxchg [rdi], rdx; ret
    # stack_ptr() -> the caller's stack pointer
    loop code.len() % 16 != 0: b(0xCC)
    stub_addr[8] = code.len()
    loop x in [0x48, 0x8D, 0x44, 0x24, 0x08, 0xC3]: b(x)                        # lea rax, [rsp+8]; ret

x64_resolve = (text_addr: int, ro_addr: int, data_addr: int):
    if stub_fix.len() > 0 and stub_addr[2] < 0: ice("stubs not emitted")
    loop f in stub_fix: patch32(f.0, stub_addr[f.1] - (f.0 + 4))
    loop f in call_fix:
        target = fn_addr[f.1]
        if target < 0: ice("unresolved function {lfuncs[f.1].name}")
        patch32(f.0, target - (f.0 + 4))
    loop f in data_fix:
        base = ro_addr
        if f.1 == 1: base = data_addr
        target = base + f.2
        patch32(f.0, target - (text_addr + f.0 + 4))
