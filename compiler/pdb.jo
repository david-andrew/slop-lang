# Program databases (.pdb) for Windows programs that `sloppy build` writes: what Visual Studio,
# WinDbg and RemedyBG read for function names and source lines (as DWARF is on Linux:
# dwarf.jo). The program names it in its debug directory (pe.jo: a CodeView record with the
# same GUID and age).
#
# A PDB is an MSF file: fixed-size blocks, a directory of streams (each a list of blocks). The
# streams written here:
#   1 PDB info: version, GUID, age, the named streams ("/names": 9)
#   2 TPI, 4 IPI: type records (none: functions are described by name and place only)
#   3 DBI: one module (all the code), the section contribution and map, the source files
#   5 the module's symbols (a procedure per function) and C13 line tables
#   6 globals, 7 publics: hash tables of the records in 8, the symbol records
#   9 /names: the source files' names, 10 the PE section headers
# (The formats as LLVM documents and writes them: llvm.org/docs/PDB.)

use 'util.jo'
use 'ir.jo'
use 'elf.jo'
use 'x64.jo'

const PDB_BLOCK = 4096

# hashStringV1 (Microsoft's LHashPbCb): the hash of names in /names and of symbols
pdb_hash = (s: str) -> int:
    r = 0
    n = len(s)
    i = 0
    loop i + 4 <= n:
        r = r xor (int(s[i]) | (int(s[i + 1]) << 8) | (int(s[i + 2]) << 16) | (int(s[i + 3]) << 24))
        i += 4
    if n - i >= 2:
        r = r xor (int(s[i]) | (int(s[i + 1]) << 8))
        i += 2
    if n - i == 1: r = r xor int(s[i])
    r = r | 0x20202020
    r = r xor (r >> 11)
    (r xor (r >> 16)) & 0xFFFFFFFF

# what the program's debug directory names: the PDB's file name (debuggers look for it beside
# the program; a full path would make the same program differ by where it was built)
pdb_name = (path: str) -> str:
    s = rfind(path, "/")
    if s >= 0: return path[s + 1..]
    path

pdb_cstr = (out: mut u8[], s: str):
    loop c in s: out.push(c)
    out.push(0)

pdb_align4 = (out: mut u8[]):
    loop out.len() % 4 != 0: out.push(0)

# a symbol record: its length, kind and body, padded to 4 bytes
pdb_record = (out: mut u8[], kind: int, body: u8[]):
    pad = (4 - (body.len() + 4) % 4) % 4
    put16(out, body.len() + 2 + pad)
    put16(out, kind)
    append_bytes(out, body)
    loop i in [0..pad): out.push(0)

# a string table (/names, and the DBI's EC names): header, the strings, a hash table of their
# offsets, the count; offsets of the strings given
struct PdbStrings:
    bytes: u8[]
    offsets: {str: int}
    names: str[]

pdb_strings = () -> PdbStrings:
    t = PdbStrings()
    t.bytes.push(0)
    t

pdb_string = (t: mut PdbStrings, s: str) -> int:
    if let o = t.offsets.get(s): return o
    o = t.bytes.len()
    pdb_cstr(t.bytes, s)
    t.offsets[s] = o
    t.names.push(s)
    o

pdb_string_table = (t: PdbStrings) -> u8[]:
    out: u8[]
    put32(out, 0xEFFEEFFE)
    put32(out, 1)                                  # hash version
    put32(out, t.bytes.len())
    append_bytes(out, t.bytes)
    nb = max(1, t.names.len() * 2)
    buckets = fill(0, nb)
    loop s in t.names:
        h = pdb_hash(s) % nb
        loop buckets[h] != 0: h = (h + 1) % nb
        buckets[h] = t.offsets[s]
    put32(out, nb)
    loop b in buckets: put32(out, b)
    put32(out, t.names.len())
    out

# the TPI and IPI streams' header, for no records
pdb_types = () -> u8[]:
    out: u8[]
    put32(out, 20040203)                           # V80
    put32(out, 56)
    put32(out, 0x1000)
    put32(out, 0x1000)
    put32(out, 0)
    put16(out, 0xFFFF)                             # no hash stream
    put16(out, 0xFFFF)
    put32(out, 4)
    put32(out, 0x3FFFF)
    loop i in [0..6): put32(out, 0)
    out

# a GSI hash (globals, publics): the records (offsets into the symbol records + 1) by bucket,
# a bitmap of the buckets used, where each starts
pdb_gsi = (syms: (str, int)[]) -> u8[]:
    nb = 4096
    by: (int, str, int)[]
    # (within a bucket: shorter names first, then without regard to case)
    loop s in syms: by.push((pdb_hash(s.0) % nb, "{len(s.0):8}{lower(s.0)}", s.1))
    by.sort_by((x: (int, str, int)): x.0)
    # (each bucket's run sorted)
    k = 0
    loop k < by.len():
        e = k
        loop e < by.len() and by[e].0 == by[k].0: e += 1
        run = by[k..e)
        run.sort_by((x: (int, str, int)): x.1)
        loop j in [k..e): by[j] = run[j - k]
        k = e
    out: u8[]
    put32(out, 0xFFFFFFFF)
    put32(out, 0xEFFE0000 + 19990810)
    put32(out, 8 * by.len())
    words = (nb + 32) / 32
    starts: int[]
    bitmap = fill(0, words)
    loop i in 0.. and x in by:
        if i == 0 or by[i - 1].0 != x.0:
            bitmap[x.0 / 32] = bitmap[x.0 / 32] | (1 << (x.0 % 32))
            starts.push(i * 12)
    put32(out, 4 * words + 4 * starts.len())
    loop x in by:
        put32(out, x.2 + 1)
        put32(out, 1)
    loop w in bitmap: put32(out, w)
    loop s in starts: put32(out, s)
    out

# the 128-bit GUID and the signature (a hash of the code: the same program, the same PDB)
pdb_guid = (text: u8[]) -> u8[]:
    h1 = 0x6A09E667F3BCC908
    h2 = 0x3C6EF372FE94F82B
    loop i in [0..text.len()):
        h1 = (h1 xor int(text[i])) * 0x100000001B3
        h2 = (h2 + int(text[i]) + 1) * 0x5851F42D4C957F2D
    out: u8[]
    put64(out, h1)
    put64(out, h2 xor text.len())
    out

# write the PDB for the code just compiled (functions: elf_syms; lines: line_rows; sections:
# their headers as in the program)
write_pdb = (path: str, guid: u8[], text_len: int, sections: u8[], main_path: str, producer: str) -> bool:
    dir = os_path(cwd())
    abs = (p: str) -> str:
        q = p
        if not is_abs_path(q): q = "{dir}/{q}"
        replace(q, "/", "\\")
    strtab = pdb_strings()
    # the source files: their strtab in /strtab, a checksum entry each (no checksum)
    fidx = fill(-1, files.len())
    file_names: str[]
    chk: u8[]
    k = 0
    loop k < line_rows.len():
        if line_rows[k + 1] != 0:
            f = pos_file(ir_positions[line_rows[k + 1]])
            if f >= 0 and f < files.len() and fidx[f] < 0:
                fidx[f] = chk.len()
                nm = abs(files[f].path)
                file_names.push(nm)
                put32(chk, pdb_string(strtab, nm))
                put32(chk, 0)                      # checksum size and kind: none
        k += 2
    # the module's symbols: a compile record, then a procedure (and its end) per function
    msyms: u8[]
    put32(msyms, 4)                                 # C13
    ob: u8[]
    put32(ob, 0)
    pdb_cstr(ob, abs(main_path))
    pdb_record(msyms, 0x1101, ob)                   # S_OBJNAME
    cp: u8[]
    put32(cp, 0)                                   # language: C (the closest a debugger knows)
    put16(cp, 0xD0)                                # x64
    loop i in [0..8): put16(cp, 0)                 # front and back end versions
    pdb_cstr(cp, producer)
    pdb_record(msyms, 0x113C, cp)                   # S_COMPILE3
    pfns = elf_syms
    pfns.sort_by((s: (str, int, int)): s.1)
    proc_at: int[]
    loop s in pfns:
        at = msyms.len()
        proc_at.push(at)
        body: u8[]
        put32(body, 0)                             # parent
        end_at = body.len()
        put32(body, 0)                             # end (below)
        put32(body, 0)                             # next
        put32(body, s.2)                           # code size
        put32(body, 0)                             # debug start, end
        put32(body, s.2)
        put32(body, 0)                             # type: none
        put32(body, s.1)                           # offset in .text
        put16(body, 1)                             # section
        body.push(1)                               # flags: a frame pointer
        pdb_cstr(body, s.0)
        pdb_record(msyms, 0x1110, body)             # S_GPROC32
        e = msyms.len()
        put32_at(msyms, at + 4 + end_at, e)
        pdb_record(msyms, 0x0006, [])               # S_END
    # the lines: per function, its rows by file (each line a statement)
    lines: u8[]
    pdb_subsection(lines, 0xF4, chk)               # DEBUG_S_FILECHKSMS
    rows = 0
    loop s in pfns:
        lo = s.1
        hi = s.1 + s.2
        loop rows < line_rows.len() and line_rows[rows] < lo: rows += 2
        blocks: u8[]
        cur = -1
        ents: u8[]
        n = 0
        last_line = -1
        r = rows
        loop r < line_rows.len() and line_rows[r] < hi:
            if line_rows[r + 1] != 0:
                p = ir_positions[line_rows[r + 1]]
                f = pos_file(p)
                if f >= 0 and f < files.len() and fidx[f] >= 0:
                    l = ir_line(line_rows[r + 1])
                    if fidx[f] != cur:
                        pdb_line_block(blocks, cur, n, ents)
                        cur = fidx[f]
                        ents = []
                        n = 0
                        last_line = -1
                    if l != last_line:
                        put32(ents, line_rows[r] - lo)
                        put32(ents, 0x80000000 | (l & 0xFFFFFF))
                        n += 1
                        last_line = l
            r += 2
        pdb_line_block(blocks, cur, n, ents)
        if blocks.len() == 0: continue
        sub: u8[]
        put32(sub, lo)
        put16(sub, 1)
        put16(sub, 0)                              # no columns
        put32(sub, s.2)
        append_bytes(sub, blocks)
        pdb_subsection(lines, 0xF2, sub)           # DEBUG_S_LINES
    module: u8[]
    append_bytes(module, msyms)
    append_bytes(module, lines)
    put32(module, 0)                               # global references: none
    # the symbol records: a public and a reference to the procedure per function
    recs: u8[]
    pubs: (str, int)[]
    globs: (str, int)[]
    addr_map: int[]
    loop i in 0.. and s in pfns:
        pubs.push((s.0, recs.len()))
        addr_map.push(recs.len())
        pb: u8[]
        put32(pb, 2)                               # a function
        put32(pb, s.1)
        put16(pb, 1)
        pdb_cstr(pb, s.0)
        pdb_record(recs, 0x110E, pb)               # S_PUB32
        globs.push((s.0, recs.len()))
        rb: u8[]
        put32(rb, 0)
        put32(rb, proc_at[i])
        put16(rb, 1)                               # module 1 (counting from 1)
        pdb_cstr(rb, s.0)
        pdb_record(recs, 0x1125, rb)               # S_PROCREF
    gsi = pdb_gsi(globs)
    pgsi = pdb_gsi(pubs)
    publics: u8[]
    put32(publics, pgsi.len())
    put32(publics, 4 * addr_map.len())
    loop i in [0..5): put32(publics, 0)            # thunks, sections: none
    append_bytes(publics, pgsi)
    loop a in addr_map: put32(publics, a)          # (by address: pfns are)
    # DBI: the module, the contribution of .text, the section map, the files
    sc: u8[]
    put16(sc, 1)
    put16(sc, 0)
    put32(sc, 0)
    put32(sc, text_len)
    put32(sc, 0x60000020)
    put16(sc, 0)
    put16(sc, 0)
    put32(sc, 0)
    put32(sc, 0)
    mi: u8[]
    put32(mi, 0)
    append_bytes(mi, sc)
    put16(mi, 0)                                   # flags
    put16(mi, 5)                                   # its symbols' stream
    put32(mi, msyms.len())
    put32(mi, 0)                                   # C11 lines
    put32(mi, lines.len())
    put16(mi, file_names.len())
    put16(mi, 0)
    put32(mi, 0)
    put32(mi, 0)
    put32(mi, 0)
    pdb_cstr(mi, abs(main_path))
    pdb_cstr(mi, abs(main_path))
    pdb_align4(mi)
    contrib: u8[]
    put32(contrib, 0xEFFE0000 + 19970605)
    append_bytes(contrib, sc)
    nsec = sections.len() / 40
    secmap: u8[]
    put16(secmap, nsec + 1)
    put16(secmap, nsec + 1)
    loop i in [0..nsec):
        ch = __u32_le(sections, 40 * i + 36)
        fl = 0x108                                 # a selector, 32-bit addresses
        if ch & 0x40000000 != 0: fl = fl | 1
        if ch & 0x80000000 != 0: fl = fl | 2
        if ch & 0x20000000 != 0: fl = fl | 4
        put16(secmap, fl)
        put16(secmap, 0)
        put16(secmap, 0)
        put16(secmap, i + 1)
        put16(secmap, 0xFFFF)
        put16(secmap, 0xFFFF)
        put32(secmap, 0)
        put32(secmap, __u32_le(sections, 40 * i + 8))
    put16(secmap, 0x208)                           # the absolute "section"
    put16(secmap, 0)
    put16(secmap, 0)
    put16(secmap, nsec + 1)
    put16(secmap, 0xFFFF)
    put16(secmap, 0xFFFF)
    put32(secmap, 0)
    put32(secmap, 0xFFFFFFFF)
    finfo: u8[]
    put16(finfo, 1)
    put16(finfo, file_names.len())
    put16(finfo, 0)
    put16(finfo, file_names.len())
    fbuf: u8[]
    loop nm in file_names:
        put32(finfo, fbuf.len())
        pdb_cstr(fbuf, nm)
    append_bytes(finfo, fbuf)
    pdb_align4(finfo)
    ec = pdb_string_table(pdb_strings())
    dbg: u8[]
    loop i in [0..11):
        if i == 5: put16(dbg, 10)                  # the section headers' stream
        else: put16(dbg, 0xFFFF)
    dbi: u8[]
    put32(dbi, 0xFFFFFFFF)
    put32(dbi, 19990903)                           # V70
    put32(dbi, 1)                                  # age
    put16(dbi, 6)                                  # globals
    put16(dbi, 0x8E00)                             # build number: new format, 14.0
    put16(dbi, 7)                                  # publics
    put16(dbi, 0)
    put16(dbi, 8)                                  # symbol records
    put16(dbi, 0)
    put32(dbi, mi.len())
    put32(dbi, contrib.len())
    put32(dbi, secmap.len())
    put32(dbi, finfo.len())
    put32(dbi, 0)                                  # type server map
    put32(dbi, 0)
    put32(dbi, dbg.len())
    put32(dbi, ec.len())
    put16(dbi, 0)                                  # flags
    put16(dbi, 0x8664)
    put32(dbi, 0)
    append_bytes(dbi, mi)
    append_bytes(dbi, contrib)
    append_bytes(dbi, secmap)
    append_bytes(dbi, finfo)
    append_bytes(dbi, ec)
    append_bytes(dbi, dbg)
    # the PDB info stream: version, signature, age, GUID, then the named streams ("/names")
    info: u8[]
    put32(info, 20000404)                          # VC70
    put32(info, __u32_le(guid, 0))
    put32(info, 1)
    append_bytes(info, guid)
    nm_buf: u8[]
    pdb_cstr(nm_buf, "/names")
    put32(info, nm_buf.len())
    append_bytes(info, nm_buf)
    cap = 8
    put32(info, 1)                                 # entries
    put32(info, cap)
    put32(info, 1)                                 # present: one word
    put32(info, 1 << ((pdb_hash("/names") & 0xFFFF) % cap))
    put32(info, 0)                                 # deleted: none
    put32(info, 0)                                 # "/names" (at 0) is stream 9
    put32(info, 9)
    put32(info, 20140508)                          # VC140
    streams: u8[][] = [[], info, pdb_types(), dbi, pdb_types(), module, gsi, publics, recs, pdb_string_table(strtab), sections]
    write_bytes(path, msf(streams))

put32_at = (b: mut u8[], at: int, v: int):
    loop i in [0..4): b[at + i] = u8((v >> (8 * i)) & 255)

__u32_le = (b: u8[], at: int) -> int: int(b[at]) | (int(b[at + 1]) << 8) | (int(b[at + 2]) << 16) | (int(b[at + 3]) << 24)

# a C13 subsection: kind, length, the data padded to 4 bytes
pdb_subsection = (out: mut u8[], kind: int, body: u8[]):
    put32(out, kind)
    put32(out, body.len())
    append_bytes(out, body)
    pdb_align4(out)

# a block of a function's lines in one file (file: where its checksum entry is)
pdb_line_block = (out: mut u8[], file: int, n: int, ents: u8[]):
    if file < 0 or n == 0: return
    put32(out, file)
    put32(out, n)
    put32(out, 12 + ents.len())
    append_bytes(out, ents)

# the first block from k that is not a free block map's
msf_free = (k: int) -> int:
    i = k
    loop i % PDB_BLOCK == 1 or i % PDB_BLOCK == 2: i += 1
    i

# the MSF container: the superblock, the free block maps (blocks 1 and 2 of every 4096), the
# streams' blocks, the directory (stream sizes, then each one's blocks) and the block that
# lists the directory's blocks
msf = (streams: u8[][]) -> u8[]:
    next = 3
    blocks: int[][]
    loop s in streams:
        bl: int[]
        loop i in [0..(s.len() + PDB_BLOCK - 1) / PDB_BLOCK):
            next = msf_free(next)
            bl.push(next)
            next += 1
        blocks.push(bl)
    dir: u8[]
    put32(dir, streams.len())
    loop s in streams: put32(dir, s.len())
    loop bl in blocks:
        loop x in bl: put32(dir, x)
    dir_blocks: int[]
    loop i in [0..(dir.len() + PDB_BLOCK - 1) / PDB_BLOCK):
        next = msf_free(next)
        dir_blocks.push(next)
        next += 1
    map_block = msf_free(next)
    n = map_block + 1
    out = fill(u8(0), n * PDB_BLOCK)
    magic = "Microsoft C/C++ MSF 7.00\r\n\x1a\x44\x53\0\0\0"
    loop i in [0..32): out[i] = magic[i]
    put32_at(out, 32, PDB_BLOCK)
    put32_at(out, 36, 1)                           # the free block map in use
    put32_at(out, 40, n)
    put32_at(out, 44, dir.len())
    put32_at(out, 52, map_block)
    # free block maps: a bit per block, set if free (those past the end)
    fpm = 1
    loop fpm < n:
        loop half in [0..2):
            mb = (fpm + half) * PDB_BLOCK
            if mb + PDB_BLOCK > out.len(): continue
            loop i in [0..PDB_BLOCK): out[mb + i] = 0xFF
            # (this map's bits cover blocks from (fpm - 1) * 8)
            first = (fpm - 1) * 8
            loop blk in [first..min(n, first + PDB_BLOCK * 8)):
                o = blk - first
                out[mb + o / 8] = out[mb + o / 8] & u8(~(1 << (o % 8)) & 255)
        fpm += PDB_BLOCK
    loop i in 0.. and s in streams:
        loop j in 0.. and x in blocks[i]:
            m = min(PDB_BLOCK, s.len() - j * PDB_BLOCK)
            mem_copy(data(out) + x * PDB_BLOCK, data(s) + j * PDB_BLOCK, m)
    loop j in 0.. and x in dir_blocks:
        m = min(PDB_BLOCK, dir.len() - j * PDB_BLOCK)
        mem_copy(data(out) + x * PDB_BLOCK, data(dir) + j * PDB_BLOCK, m)
    loop j in 0.. and x in dir_blocks: put32_at(out, map_block * PDB_BLOCK + 4 * j, x)
    out
