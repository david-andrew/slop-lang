# Parser: tokens -> AST (nodes in ast.jot).

use util
use lex
use ast

toks: [Token]
ti := 0
p_file := 0
p_src := ""
p_no_tuple := false
p_when_top := false

fn pk() -> Tok: toks[ti].kind
fn pkn(k: int) -> Tok:
    j := ti + k
    if j >= toks.len(): j = toks.len() - 1
    toks[j].kind
fn cur_pos() -> int: toks[ti].pos
fn advance() -> int:
    i := ti
    if ti < toks.len() - 1: ti += 1
    i
fn accept(k: Tok) -> bool:
    if toks[ti].kind == k:
        advance()
        return true
    false
fn tok_src(i: int) -> str:
    s := int(toks[i].start)
    p_src[s..s + int(toks[i].len)]
fn expect(k: Tok, what: str) -> int:
    if toks[ti].kind != k:
        w := what
        if len(w) == 0: w = tok_name(k)
        tk := toks[ti].kind
        if tk == .ident or tk == .int_lit: fatal(cur_pos(), "expected {w}, found '{tok_src(ti)}'")
        fatal(cur_pos(), "expected {w}, found {tok_name(tk)}")
    advance()
fn expect_ident(what: str) -> int: intern(tok_src(expect(.ident, what)))
fn skip_newlines():
    while pk() == .newline: advance()

# ---------------- types ----------------
fn parse_type_primary() -> int:
    pos := cur_pos()
    k := pk()
    if k == .ident:
        n := mk(.tname, pos)
        nodes[n].name = i32(expect_ident(""))
        if accept(.dot):
            nodes[n].sval = nodes[n].name
            nodes[n].name = i32(expect_ident("type name"))
        if pk() == .lbrack:
            advance()
            args: [int]
            while true:
                args.push(parse_type())
                if not accept(.comma): break
            expect(.rbrack, "")
            set_list(n, args)
        return n
    if k == .lbrack:
        advance()
        n := mk(.tarray, pos)
        nodes[n].a = i32(parse_type())
        if accept(.semi): nodes[n].b = i32(parse_expr())
        expect(.rbrack, "")
        return n
    if k == .lbrace:
        advance()
        n := mk(.tmap, pos)
        nodes[n].a = i32(parse_type())
        expect(.colon, "")
        nodes[n].b = i32(parse_type())
        expect(.rbrace, "")
        return n
    if k == .lparen:
        advance()
        n := mk(.ttuple, pos)
        elems: [int]
        while pk() != .rparen:
            elems.push(parse_type())
            if not accept(.comma): break
        expect(.rparen, "")
        if elems.len() == 1: return elems[0]
        set_list(n, elems)
        return n
    if k == .star:
        advance()
        n := mk(.tptr, pos)
        nodes[n].a = i32(parse_type_primary())
        return n
    if k == .kw_fn:
        advance()
        n := mk(.tfn, pos)
        expect(.lparen, "")
        ps: [int]
        while pk() != .rparen:
            m := accept(.kw_mut)
            pt := parse_type()
            if m: add_flag(pt, NF_MUT)
            ps.push(pt)
            if not accept(.comma): break
        expect(.rparen, "")
        set_list(n, ps)
        if accept(.arrow): nodes[n].a = i32(parse_type())
        return n
    if k == .ident and tok_src(ti) == "cfn": pass
    fatal(pos, "expected a type, found {tok_name(k)}")
    0

fn parse_type() -> int:
    t := parse_type_primary()
    while pk() == .question:
        o := mk(.topt, cur_pos())
        advance()
        nodes[o].a = i32(t)
        t = o
    t

# ---------------- strings ----------------
fn decode_str(s: str, pos: int, raw: bool) -> str:
    if raw: return s
    if find_byte(s, '\\') < 0 and find(s, "\{\{") < 0 and find(s, "}}") < 0: return s
    buf: [u8]
    n := len(s)
    i := 0
    while i < n:
        c := s[i]
        if c == '\\':
            i += 1
            e := s[i]
            if e == 'n': buf.push(10)
            else if e == 't': buf.push(9)
            else if e == 'r': buf.push(13)
            else if e == '0': buf.push(0)
            else if e == '\\': buf.push('\\')
            else if e == '"': buf.push('"')
            else if e == '\'': buf.push('\'')
            else if e == '{': buf.push('{')
            else if e == '}': buf.push('}')
            else if e == 'e': buf.push(27)
            else if e == 'x':
                h := hexval(s[i + 1])
                l := hexval(s[i + 2])
                if h < 0 or l < 0: fatal(pos, "bad \\x escape")
                buf.push(u8(h * 16 + l))
                i += 2
            else if e == '\n':
                while i + 1 < n and (s[i + 1] == ' ' or s[i + 1] == '\t'): i += 1
            else: fatal(pos, "unknown escape \\{chr(int(e))}")
        else if (c == '{' or c == '}') and i + 1 < n and s[i + 1] == c:
            buf.push(c)
            i += 1
        else: buf.push(c)
        i += 1
    str_from_bytes(buf)

fn dedent_triple(s0: str) -> str:
    s := s0
    if len(s) > 0 and s[0] == '\n': s = s[1..]
    else if len(s) > 1 and s[0] == '\r' and s[1] == '\n': s = s[2..]
    e := len(s)
    while e > 0 and (s[e - 1] == ' ' or s[e - 1] == '\t'): e -= 1
    if e > 0 and s[e - 1] == '\n': s = s[..e - 1]
    common := -1
    for line in split(s, "\n"):
        ind := 0
        while ind < len(line) and (line[ind] == ' ' or line[ind] == '\t'): ind += 1
        if ind < len(line):
            if common < 0 or ind < common: common = ind
    if common <= 0: return s
    out: [str]
    for line in split(s, "\n"):
        k := 0
        while k < common and k < len(line) and (line[k] == ' ' or line[k] == '\t'): k += 1
        out.push(line[k..])
    join(out, "\n")

fn parse_string_token(t: int) -> int:
    pos := toks[t].pos
    s := tok_src(t)
    flags := int(toks[t].flags)
    raw := flags & STRF_RAW != 0
    if flags & STRF_TRIPLE != 0: s = dedent_triple(s)
    n := mk(.str_lit, pos)
    n_len := len(s)
    i := 0
    lit_start := 0
    has_interp := false
    parts: [int]
    while i < n_len and not raw:
        c := s[i]
        if c == '\\':
            i += 2
            continue
        if c == '{' and i + 1 < n_len and s[i + 1] == '{':
            i += 2
            continue
        if c == '}' and i + 1 < n_len and s[i + 1] == '}':
            i += 2
            continue
        if c == '{':
            has_interp = true
            if i > lit_start:
                lit := mk(.str_lit, pos)
                nodes[lit].sval = i32(intern(decode_str(s[lit_start..i], pos, raw)))
                parts.push(lit)
            depth := 1
            j := i + 1
            colon := -1
            while j < n_len and depth > 0:
                cj := s[j]
                if cj == '{': depth += 1
                else if cj == '}':
                    depth -= 1
                    if depth == 0: break
                else if cj == '"':
                    j += 1
                    while j < n_len and s[j] != '"':
                        if s[j] == '\\': j += 1
                        j += 1
                else if cj == ':' and depth == 1 and colon < 0 and not (j + 1 < n_len and s[j + 1] == '='): colon = j
                j += 1
            eend := j
            if colon >= 0: eend = colon
            expr_src := s[i + 1..eend]
            # lex and parse the embedded expression
            fidx := files.len()
            files.push(SrcFile(files[p_file].path, files[p_file].dir, expr_src))
            saved_toks := toks
            saved_ti := ti
            saved_src := p_src
            saved_file := p_file
            toks = lex(fidx, expr_src)
            # report errors at the string's position
            for mut tk in toks: tk.pos = pos
            ti = 0
            p_src = expr_src
            p_file = fidx
            e := parse_expr()
            skip_newlines()
            if pk() != .eof: fatal(pos, "invalid expression in string interpolation")
            toks = saved_toks
            ti = saved_ti
            p_src = saved_src
            p_file = saved_file
            part := mk(.pair, pos)
            nodes[part].a = i32(e)
            if colon >= 0: nodes[part].sval = i32(intern(s[colon + 1..j]))
            else: nodes[part].sval = -1
            parts.push(part)
            i = j + 1
            lit_start = i
            continue
        i += 1
    if not has_interp:
        nodes[n].sval = i32(intern(decode_str(s, pos, raw)))
        return n
    if lit_start < n_len:
        lit := mk(.str_lit, pos)
        nodes[lit].sval = i32(intern(decode_str(s[lit_start..], pos, raw)))
        parts.push(lit)
    nodes[n].aux = 1
    set_list(n, parts)
    n

# ---------------- expressions ----------------
fn parse_args(call: int):
    args: [int]
    while pk() != .rparen:
        pos := cur_pos()
        if pk() == .ident and pkn(1) == .assign:
            na := mk(.namedarg, pos)
            nodes[na].name = i32(expect_ident(""))
            advance()
            nodes[na].a = i32(parse_expr())
            args.push(na)
        else:
            m := accept(.kw_mut)
            e := parse_expr()
            if m: add_flag(e, NF_MUT)
            args.push(e)
        if not accept(.comma): break
    expect(.rparen, "")
    set_list(call, args)

fn parse_primary() -> int:
    t := ti
    pos := cur_pos()
    k := pk()
    if k == .int_lit:
        advance()
        n := mk(.int_lit, pos)
        nodes[n].ival = toks[t].ival
        add_flag(n, NF_LITERAL)
        if int(toks[t].flags) & INTF_CHAR != 0: nodes[n].aux = 1
        return n
    if k == .float_lit:
        advance()
        n := mk(.float_lit, pos)
        nodes[n].fval = toks[t].fval
        add_flag(n, NF_LITERAL)
        return n
    if k == .str_lit:
        advance()
        return parse_string_token(t)
    if k == .kw_true or k == .kw_false:
        advance()
        n := mk(.bool_lit, pos)
        if k == .kw_true: nodes[n].ival = 1
        return n
    if k == .kw_none:
        advance()
        return mk(.none_lit, pos)
    if k == .kw_null:
        advance()
        return mk(.null_lit, pos)
    if k == .ident:
        advance()
        if toks[t].len == 1 and p_src[int(toks[t].start)] == '_': return mk(.hole, pos)
        n := mk(.ident, pos)
        nodes[n].name = i32(intern(tok_src(t)))
        return n
    if k == .dot:
        advance()
        n := mk(.dotname, pos)
        nodes[n].name = i32(expect_ident("name after '.'"))
        return n
    if k == .lparen:
        advance()
        if accept(.rparen): return mk(.tuple, pos)
        e := parse_expr()
        if pk() == .comma:
            n := mk(.tuple, pos)
            elems := [e]
            while accept(.comma):
                if pk() == .rparen: break
                elems.push(parse_expr())
            expect(.rparen, "")
            set_list(n, elems)
            return n
        expect(.rparen, "")
        return e
    if k == .lbrack:
        advance()
        n := mk(.array, pos)
        elems: [int]
        while pk() != .rbrack:
            elems.push(parse_expr())
            if accept(.semi):
                nodes[n].b = i32(parse_expr())
                break
            if not accept(.comma): break
        expect(.rbrack, "")
        set_list(n, elems)
        return n
    if k == .lbrace:
        advance()
        n := mk(.map_lit, pos)
        pairs: [int]
        while pk() != .rbrace:
            pr := mk(.pair, cur_pos())
            nodes[pr].a = i32(parse_expr())
            expect(.colon, "")
            nodes[pr].b = i32(parse_expr())
            pairs.push(pr)
            if not accept(.comma): break
        expect(.rbrace, "")
        set_list(n, pairs)
        return n
    if k == .kw_fn: return parse_fn(true)
    if k == .kw_if: return parse_if()
    if k == .kw_match: return parse_match()
    if k == .ident or k == .int_lit: fatal(pos, "unexpected '{tok_src(t)}'")
    fatal(pos, "expected an expression, found {tok_name(k)}")
    0

fn parse_postfix(e0: int) -> int:
    e := e0
    while true:
        pos := cur_pos()
        k := pk()
        if k == .lparen:
            advance()
            c := mk(.call, pos)
            nodes[c].a = i32(e)
            parse_args(c)
            e = c
        else if k == .lbrack:
            advance()
            ix := mk(.index, pos)
            nodes[ix].a = i32(e)
            if pk() == .dotdot or pk() == .dotdoteq:
                r := mk(.range, pos)
                if toks[advance()].kind == .dotdoteq: add_flag(r, NF_INCLUSIVE)
                if pk() != .rbrack: nodes[r].b = i32(parse_expr())
                nodes[ix].b = i32(r)
            else:
                b := parse_expr()
                if pk() == .comma:
                    targs := [b]
                    while accept(.comma): targs.push(parse_expr())
                    set_list(ix, targs)
                else: nodes[ix].b = i32(b)
            expect(.rbrack, "")
            e = ix
        else if k == .dot:
            advance()
            f := mk(.field, pos)
            nodes[f].a = i32(e)
            if pk() == .int_lit:
                t := advance()
                nodes[f].name = i32(intern(tok_src(t)))
                nodes[f].aux = -2
                nodes[f].ival = toks[t].ival
            else if pk() == .float_lit:
                # x.0.1 lexes as a float "0.1"
                t := advance()
                txt := tok_src(t)
                d := find_byte(txt, '.')
                nodes[f].name = i32(intern(txt[..d]))
                nodes[f].aux = -2
                nodes[f].ival = to_int(txt[..d]) ?? 0
                f2 := mk(.field, pos)
                nodes[f2].a = i32(f)
                nodes[f2].name = i32(intern(txt[d + 1..]))
                nodes[f2].aux = -2
                nodes[f2].ival = to_int(txt[d + 1..]) ?? 0
                e = f2
                continue
            else: nodes[f].name = i32(expect_ident("field name"))
            e = f
        else if k == .bang:
            advance()
            u := mk(.unwrap, pos)
            nodes[u].a = i32(e)
            e = u
        else: return e
    e

fn parse_prefix() -> int:
    pos := cur_pos()
    k := pk()
    if k == .minus or k == .tilde or k == .amp:
        advance()
        operand := parse_prefix()
        ok := nodes[operand].kind
        if k == .minus and (ok == .int_lit or ok == .float_lit) and has_flag(operand, NF_LITERAL) and nodes[operand].aux2 == 0:
            nodes[operand].ival = -nodes[operand].ival
            nodes[operand].fval = -nodes[operand].fval
            nodes[operand].pos = pos
            nodes[operand].aux2 = 1
            return operand
        kind := NK.unary
        if k == .amp: kind = .addr
        n := mk(kind, pos)
        nodes[n].op = i32(int(k))
        nodes[n].a = i32(operand)
        return n
    parse_postfix(parse_primary())

fn parse_unary() -> int:
    e := parse_prefix()
    while pk() == .kw_as:
        c := mk(.cast, cur_pos())
        advance()
        nodes[c].a = i32(e)
        nodes[c].b = i32(parse_type())
        e = c
    e

fn binprec(k: Tok) -> int:
    match k:
        star, slash, percent: 10
        plus, minus: 9
        shl, shr: 8
        amp: 7
        caret: 6
        pipe: 5
        dotdot, dotdoteq: 4
        qq: 3
        eq, ne, lt, le, gt, ge, kw_in: 2
        _: -1

fn parse_binary(minprec: int) -> int:
    lhs := parse_unary()
    while true:
        k := pk()
        if k == .kw_not and pkn(1) == .kw_in: k = .kw_in
        prec := binprec(k)
        if prec < minprec: return lhs
        pos := cur_pos()
        negate := false
        if pk() == .kw_not:
            advance()
            negate = true
        advance()
        if k == .dotdot or k == .dotdoteq:
            r := mk(.range, pos)
            nodes[r].a = i32(lhs)
            if k == .dotdoteq: add_flag(r, NF_INCLUSIVE)
            nk := pk()
            if nk != .rbrack and nk != .rparen and nk != .comma and nk != .colon: nodes[r].b = i32(parse_binary(prec + 1))
            lhs = r
            continue
        rp := prec + 1
        if k == .qq: rp = prec
        rhs := parse_binary(rp)
        b := 0
        if k == .qq: b = mk(.coalesce, pos)
        else:
            b = mk(.binary, pos)
            nodes[b].op = i32(int(k))
        nodes[b].a = i32(lhs)
        nodes[b].b = i32(rhs)
        if negate:
            nn := mk(.not_, pos)
            nodes[nn].a = i32(b)
            b = nn
        lhs = b
    lhs

fn parse_not() -> int:
    if pk() == .kw_not:
        pos := cur_pos()
        advance()
        n := mk(.not_, pos)
        nodes[n].a = i32(parse_not())
        return n
    parse_binary(0)

fn parse_and() -> int:
    l := parse_not()
    while pk() == .kw_and:
        n := mk(.and_, cur_pos())
        advance()
        nodes[n].a = i32(l)
        nodes[n].b = i32(parse_not())
        l = n
    l

fn parse_or() -> int:
    l := parse_and()
    while pk() == .kw_or:
        n := mk(.or_, cur_pos())
        advance()
        nodes[n].a = i32(l)
        nodes[n].b = i32(parse_and())
        l = n
    l

fn parse_expr() -> int: parse_or()

# ---------------- blocks / statements ----------------
fn parse_block() -> int:
    b := mk(.block, cur_pos())
    stmts: [int]
    if pk() == .newline:
        advance()
        if pk() != .indent: fatal(cur_pos(), "expected an indented block")
        advance()
        while pk() != .dedent and pk() != .eof:
            s := parse_stmt()
            if s != 0: stmts.push(s)
        expect(.dedent, "end of block")
        add_flag(b, NF_TERMINATED)
        set_list(b, stmts)
        return b
    stmts.push(parse_simple_stmt())
    while pk() == .semi and pkn(1) != .newline:
        advance()
        stmts.push(parse_simple_stmt())
    set_list(b, stmts)
    b

fn parse_if() -> int:
    pos := cur_pos()
    expect(.kw_if, "")
    n := mk(.if_, pos)
    if pk() == .ident and pkn(1) == .decl:
        nodes[n].kind = .iflet
        nodes[n].name = i32(expect_ident(""))
        advance()
    nodes[n].a = i32(parse_expr())
    expect(.colon, "")
    nodes[n].b = i32(parse_block())
    save := ti
    if pk() == .newline and pkn(1) == .kw_else and not has_flag(int(nodes[n].b), NF_TERMINATED): advance()
    if pk() == .kw_else:
        advance()
        if pk() == .kw_if:
            b := mk(.block, cur_pos())
            inner := parse_if()
            set_list(b, [inner])
            if has_flag(inner, NF_TERMINATED): add_flag(b, NF_TERMINATED)
            nodes[n].c = i32(b)
        else:
            expect(.colon, "")
            nodes[n].c = i32(parse_block())
        if has_flag(int(nodes[n].c), NF_TERMINATED): add_flag(n, NF_TERMINATED)
    else:
        ti = save
        if has_flag(int(nodes[n].b), NF_TERMINATED): add_flag(n, NF_TERMINATED)
    n

fn parse_pattern() -> int:
    pos := cur_pos()
    if pk() == .ident and toks[ti].len == 1 and p_src[int(toks[ti].start)] == '_':
        advance()
        return mk(.pwild, pos)
    if pk() == .dot or (pk() == .ident and (pkn(1) == .lparen or pkn(1) == .colon or pkn(1) == .comma)):
        if pk() == .dot: advance()
        v := mk(.pvariant, pos)
        nodes[v].name = i32(expect_ident("variant name"))
        if accept(.lparen):
            binds: [int]
            while pk() != .rparen:
                b := mk(.ident, cur_pos())
                nodes[b].name = i32(expect_ident("binding name"))
                binds.push(b)
                if not accept(.comma): break
            expect(.rparen, "")
            set_list(v, binds)
            nodes[v].aux = 1
        return v
    e := parse_binary(3)
    if nodes[e].kind == .range:
        nodes[e].kind = .prange
        return e
    l := mk(.plit, pos)
    nodes[l].a = i32(e)
    l

fn parse_match() -> int:
    pos := cur_pos()
    expect(.kw_match, "")
    m := mk(.match_, pos)
    nodes[m].a = i32(parse_expr())
    expect(.colon, "")
    expect(.newline, "")
    expect(.indent, "indented match arms")
    arms: [int]
    while pk() != .dedent and pk() != .eof:
        arm := mk(.arm, cur_pos())
        pats: [int]
        if pk() == .kw_else:
            advance()
            pats.push(mk(.pwild, nodes[arm].pos))
        else:
            while true:
                pats.push(parse_pattern())
                if not accept(.comma): break
        set_list(arm, pats)
        expect(.colon, "")
        nodes[arm].b = i32(parse_block())
        if not has_flag(int(nodes[arm].b), NF_TERMINATED):
            if pk() != .dedent: expect(.newline, "")
        arms.push(arm)
    expect(.dedent, "")
    set_list(m, arms)
    add_flag(m, NF_TERMINATED)
    m

fn parse_params(f: int):
    expect(.lparen, "")
    ps: [int]
    while pk() != .rparen:
        p := mk(.param, cur_pos())
        if accept(.kw_mut): add_flag(p, NF_MUT)
        nodes[p].name = i32(expect_ident("parameter name"))
        if accept(.colon):
            if accept(.kw_mut): add_flag(p, NF_MUT)
            nodes[p].a = i32(parse_type())
        if accept(.assign): nodes[p].b = i32(parse_expr())
        ps.push(p)
        if not accept(.comma): break
    expect(.rparen, "")
    set_list(f, ps)

fn is_op_token(k: Tok) -> bool:
    match k:
        plus, minus, star, slash, percent, eq, lt, le, gt, ge, amp, pipe, caret, shl, shr, ne, lbrack: true
        _: false

fn parse_fn(lambda: bool) -> int:
    pos := cur_pos()
    expect(.kw_fn, "")
    kind := NK.fn_
    if lambda: kind = .lambda
    f := mk(kind, pos)
    if not lambda:
        if pk() == .ident: nodes[f].name = i32(expect_ident(""))
        else:
            if not is_op_token(pk()): fatal(pos, "expected function name")
            t := advance()
            if toks[t].kind == .lbrack:
                expect(.rbrack, "")
                nodes[f].name = i32(intern("[]"))
                if accept(.assign): nodes[f].name = i32(intern("[]="))
            else: nodes[f].name = i32(intern(tok_src(t)))
            nodes[f].aux2 = 1
        if pk() == .lbrack:
            advance()
            tps: [int]
            while pk() != .rbrack:
                tp := mk(.ident, cur_pos())
                nodes[tp].name = i32(expect_ident("type parameter"))
                tps.push(tp)
                if not accept(.comma): break
            expect(.rbrack, "")
            set_list2(f, tps)
            add_flag(f, NF_GENERIC)
    parse_params(f)
    if accept(.arrow): nodes[f].a = i32(parse_type())
    if pk() == .colon:
        advance()
        saved := p_no_tuple
        p_no_tuple = lambda and pk() != .newline
        nodes[f].b = i32(parse_block())
        p_no_tuple = saved
        if has_flag(int(nodes[f].b), NF_TERMINATED): add_flag(f, NF_TERMINATED)
    else if not lambda and pk() == .newline: pass
    else: fatal(cur_pos(), "expected ':' and function body")
    for i in 0..nkids(f):
        if nodes[kid(f, i)].a == 0: add_flag(f, NF_GENERIC)
    f

fn is_assign_op(k: Tok) -> bool:
    match k:
        assign, pluseq, minuseq, stareq, slasheq, percenteq, ampeq, pipeeq, careteq, shleq, shreq: true
        _: false

fn tuple_from(first: int) -> int:
    t := mk(.tuple, nodes[first].pos)
    elems := [first]
    while accept(.comma): elems.push(parse_expr())
    set_list(t, elems)
    t

fn parse_simple_stmt() -> int:
    pos := cur_pos()
    k := pk()
    if k == .kw_return:
        advance()
        r := mk(.return_, pos)
        nk := pk()
        if nk != .newline and nk != .semi and nk != .dedent and nk != .eof and nk != .kw_else and nk != .rparen and nk != .comma:
            e := parse_expr()
            if pk() == .comma and not p_no_tuple: e = tuple_from(e)
            nodes[r].a = i32(e)
        return r
    if k == .kw_break:
        advance()
        return mk(.break_, pos)
    if k == .kw_continue:
        advance()
        return mk(.continue_, pos)
    if k == .kw_pass:
        advance()
        return mk(.block, pos)
    if k == .kw_defer:
        advance()
        d := mk(.defer_, pos)
        if pk() == .colon:
            advance()
            nodes[d].a = i32(parse_block())
        else: nodes[d].a = i32(parse_simple_stmt())
        return d
    # typed declaration: name: Type [= expr]
    if k == .ident and pkn(1) == .colon:
        d := mk(.vardecl, pos)
        nodes[d].name = i32(expect_ident(""))
        advance()
        nodes[d].a = i32(parse_type())
        if accept(.assign): nodes[d].b = i32(parse_expr())
        return d
    e := parse_expr()
    if p_no_tuple:
        s := mk(.exprstmt, pos)
        nodes[s].a = i32(e)
        return s
    if pk() == .comma: e = tuple_from(e)
    if pk() == .decl:
        advance()
        d := mk(.vardecl, pos)
        ek := nodes[e].kind
        if ek == .ident: nodes[d].name = nodes[e].name
        else if ek == .tuple:
            for i in 0..nkids(e):
                ck := nodes[kid(e, i)].kind
                if ck != .ident and ck != .hole: fatal(nodes[kid(e, i)].pos, "expected a name")
            nodes[d].list = nodes[e].list
            nodes[d].nlist = nodes[e].nlist
        else: fatal(nodes[e].pos, "left side of ':=' must be a name")
        v := parse_expr()
        if pk() == .comma: v = tuple_from(v)
        nodes[d].b = i32(v)
        return d
    if is_assign_op(pk()):
        a := mk(.assign, cur_pos())
        nodes[a].op = i32(int(toks[advance()].kind))
        nodes[a].a = i32(e)
        v := parse_expr()
        if pk() == .comma: v = tuple_from(v)
        nodes[a].b = i32(v)
        return a
    if nodes[e].kind == .tuple and nkids(e) > 1 and pk() != .newline: fatal(nodes[e].pos, "unexpected ','")
    s := mk(.exprstmt, pos)
    nodes[s].a = i32(e)
    if has_flag(e, NF_TERMINATED): add_flag(s, NF_TERMINATED)
    s

fn end_stmt(s: int):
    if s != 0 and has_flag(s, NF_TERMINATED):
        accept(.newline)
        return
    if pk() == .semi:
        advance()
        accept(.newline)
        return
    if pk() == .dedent or pk() == .eof: return
    if ti > 0 and toks[ti - 1].kind == .dedent: return
    expect(.newline, "end of statement")

fn parse_top_block() -> int:
    b := mk(.block, cur_pos())
    expect(.newline, "newline")
    if pk() != .indent: fatal(cur_pos(), "expected an indented block")
    advance()
    items: [int]
    while pk() != .dedent and pk() != .eof:
        s := parse_toplevel()
        if s != 0: items.push(s)
        skip_newlines()
    expect(.dedent, "end of block")
    add_flag(b, NF_TERMINATED)
    set_list(b, items)
    b

fn parse_when() -> int:
    pos := cur_pos()
    expect(.kw_when, "")
    w := mk(.when_, pos)
    nodes[w].a = i32(parse_expr())
    expect(.colon, "")
    if p_when_top: nodes[w].b = i32(parse_top_block())
    else: nodes[w].b = i32(parse_block())
    save := ti
    if pk() == .newline and pkn(1) == .kw_else: advance()
    if pk() == .kw_else:
        advance()
        if pk() == .kw_when or pk() == .kw_if:
            if pk() == .kw_if: toks[ti].kind = .kw_when
            b := mk(.block, cur_pos())
            set_list(b, [parse_when()])
            add_flag(b, NF_TERMINATED)
            nodes[w].c = i32(b)
        else:
            expect(.colon, "")
            if p_when_top: nodes[w].c = i32(parse_top_block())
            else: nodes[w].c = i32(parse_block())
    else: ti = save
    add_flag(w, NF_TERMINATED)
    w

fn parse_stmt() -> int:
    pos := cur_pos()
    k := pk()
    s := 0
    if k == .newline:
        advance()
        return 0
    if k == .kw_if:
        s = parse_if()
        add_flag(s, NF_STMT)
    else if k == .kw_when: s = parse_when()
    else if k == .kw_while:
        advance()
        s = mk(.while_, pos)
        if pk() == .ident and pkn(1) == .decl:
            nodes[s].name = i32(expect_ident(""))
            advance()
            nodes[s].aux = 1
        nodes[s].a = i32(parse_expr())
        expect(.colon, "")
        nodes[s].b = i32(parse_block())
        if has_flag(int(nodes[s].b), NF_TERMINATED): add_flag(s, NF_TERMINATED)
    else if k == .kw_for:
        advance()
        s = mk(.for_, pos)
        if accept(.kw_mut): add_flag(s, NF_MUT)
        vars: [int]
        while true:
            v := mk(.ident, cur_pos())
            nodes[v].name = i32(expect_ident("loop variable"))
            vars.push(v)
            if not accept(.comma): break
        if vars.len() > 2: fatal(pos, "too many loop variables")
        set_list(s, vars)
        expect(.kw_in, "")
        nodes[s].a = i32(parse_expr())
        expect(.colon, "")
        nodes[s].b = i32(parse_block())
        if has_flag(int(nodes[s].b), NF_TERMINATED): add_flag(s, NF_TERMINATED)
    else if k == .kw_match:
        s = mk(.exprstmt, pos)
        m := parse_match()
        add_flag(m, NF_STMT)
        nodes[s].a = i32(m)
        add_flag(s, NF_TERMINATED)
    else if k == .kw_fn and pkn(1) == .ident:
        f := parse_fn(false)
        s = mk(.vardecl, pos)
        nodes[s].name = nodes[f].name
        nodes[f].kind = .lambda
        nodes[s].b = i32(f)
        if has_flag(f, NF_TERMINATED): add_flag(s, NF_TERMINATED)
    else if k == .kw_const:
        advance()
        s = mk(.const_, pos)
        nodes[s].name = i32(expect_ident("constant name"))
        if accept(.colon): nodes[s].a = i32(parse_type())
        expect(.assign, "")
        nodes[s].b = i32(parse_expr())
    else:
        s = parse_simple_stmt()
        sk := nodes[s].kind
        if (sk == .vardecl or sk == .assign) and nodes[s].b != 0 and has_flag(int(nodes[s].b), NF_TERMINATED): add_flag(s, NF_TERMINATED)
        if sk == .return_ and nodes[s].a != 0 and has_flag(int(nodes[s].a), NF_TERMINATED): add_flag(s, NF_TERMINATED)
    end_stmt(s)
    s

fn parse_struct() -> int:
    pos := cur_pos()
    expect(.kw_struct, "")
    s := mk(.struct_, pos)
    nodes[s].name = i32(expect_ident("struct name"))
    if accept(.lbrack):
        tps: [int]
        while pk() != .rbrack:
            tp := mk(.ident, cur_pos())
            nodes[tp].name = i32(expect_ident("type parameter"))
            tps.push(tp)
            if not accept(.comma): break
        expect(.rbrack, "")
        set_list2(s, tps)
        add_flag(s, NF_GENERIC)
    expect(.colon, "")
    body := parse_block()
    fields: [int]
    for i in 0..nkids(body):
        f := kid(body, i)
        if nodes[f].kind != .vardecl or nodes[f].nlist > 0: fatal(nodes[f].pos, "expected a field declaration (name: Type or name := default)")
        fields.push(f)
    set_list(s, fields)
    add_flag(s, NF_TERMINATED)
    s

fn parse_variant() -> int:
    v := mk(.variant, cur_pos())
    nodes[v].name = i32(expect_ident("variant name"))
    if accept(.lparen):
        idx := 0
        fs: [int]
        while pk() != .rparen:
            f := mk(.vardecl, cur_pos())
            if pk() == .ident and pkn(1) == .colon:
                nodes[f].name = i32(expect_ident(""))
                advance()
            else: nodes[f].name = i32(intern("{idx}"))
            nodes[f].a = i32(parse_type())
            fs.push(f)
            idx += 1
            if not accept(.comma): break
        expect(.rparen, "")
        set_list(v, fs)
    if accept(.assign): nodes[v].a = i32(parse_expr())
    v

fn parse_enum() -> int:
    pos := cur_pos()
    expect(.kw_enum, "")
    e := mk(.enum_, pos)
    nodes[e].name = i32(expect_ident("enum name"))
    if accept(.lbrack):
        tps: [int]
        while pk() != .rbrack:
            tp := mk(.ident, cur_pos())
            nodes[tp].name = i32(expect_ident("type parameter"))
            tps.push(tp)
            if not accept(.comma): break
        expect(.rbrack, "")
        set_list2(e, tps)
        add_flag(e, NF_GENERIC)
    expect(.colon, "")
    vs: [int]
    if accept(.newline):
        expect(.indent, "")
        while pk() != .dedent:
            vs.push(parse_variant())
            if accept(.comma):
                if pk() == .newline: advance()
                continue
            if pk() != .dedent: expect(.newline, "")
        expect(.dedent, "")
        add_flag(e, NF_TERMINATED)
    else:
        while true:
            vs.push(parse_variant())
            if not accept(.comma): break
    set_list(e, vs)
    e

fn parse_toplevel() -> int:
    pos := cur_pos()
    attrs: [int]
    while pk() == .at:
        advance()
        at := mk(.ident, cur_pos())
        nodes[at].name = i32(expect_ident("attribute name"))
        if accept(.lparen):
            nodes[at].a = i32(parse_expr())
            expect(.rparen, "")
        attrs.push(at)
        skip_newlines()
    k := pk()
    d := 0
    if k == .kw_fn: d = parse_fn(false)
    else if k == .kw_extern:
        advance()
        d = parse_fn(false)
        add_flag(d, NF_EXTERN)
    else if k == .kw_struct: d = parse_struct()
    else if k == .kw_enum: d = parse_enum()
    else if k == .kw_import or k == .kw_use:
        is_use := toks[advance()].kind == .kw_use
        d = mk(.import_, pos)
        if is_use: nodes[d].aux = 1
        nm := expect_ident("module name")
        path := name_of(nm)
        last := nm
        while accept(.dot):
            last = expect_ident("module name")
            path = path + "/" + name_of(last)
        nodes[d].sval = i32(intern(path))
        nodes[d].name = i32(last)
        if accept(.kw_as): nodes[d].name = i32(expect_ident("alias"))
    else if k == .kw_test:
        advance()
        d = mk(.test_, pos)
        t := expect(.str_lit, "test name")
        nodes[d].sval = i32(intern(tok_src(t)))
        expect(.colon, "")
        nodes[d].b = i32(parse_block())
        add_flag(d, NF_TERMINATED)
    else if k == .kw_build:
        advance()
        d = mk(.build_, pos)
        expect(.colon, "")
        nodes[d].b = i32(parse_block())
        add_flag(d, NF_TERMINATED)
    else if k == .kw_when:
        saved := p_when_top
        p_when_top = true
        d = parse_when()
        p_when_top = saved
        return d
    else:
        return parse_stmt()
    if attrs.len() > 0:
        ab := mk(.block, pos)
        set_list(ab, attrs)
        nodes[d].c = i32(ab)
    end_stmt(d)
    d

fn parse_file(file: int) -> [int]:
    toks = lex(file, files[file].src)
    ti = 0
    p_file = file
    p_src = files[file].src
    decls: [int]
    skip_newlines()
    while pk() != .eof:
        d := parse_toplevel()
        if d != 0: decls.push(d)
        skip_newlines()
    toks = []
    decls
