# WebAssembly backend: IR -> wasm binary module, packaged into a self-contained HTML file.
# Memory layout: [0,1024) unused | rodata | data (globals) | shadow stack (grows down) | heap

use util
use ast
use types
use check
use ir
use lower

const RO_BASE = 1024
const STACK_SIZE = 1 << 20

wfuncs: [IrFn]            # lowered functions, by lfunc index
wf_present: [bool]

fn wasm_collect():
    while wfuncs.len() <= ir.fn_index:
        wfuncs.push(IrFn())
        wf_present.push(false)
    wfuncs[ir.fn_index] = ir
    wf_present[ir.fn_index] = true

# ---------------- encoding helpers ----------------
fn uleb(o: mut [u8], v0: int):
    v := v0
    while true:
        byte := v & 0x7F
        v = v >> 7
        if v == 0:
            o.push(u8(byte))
            return
        o.push(u8(byte | 0x80))

fn sleb(o: mut [u8], v0: int):
    v := v0
    while true:
        byte := v & 0x7F
        v = v >> 7
        if (v == 0 and byte & 0x40 == 0) or (v == -1 and byte & 0x40 != 0):
            o.push(u8(byte))
            return
        o.push(u8(byte | 0x80))

fn wstr(o: mut [u8], s: str):
    uleb(o, len(s))
    for c in s: o.push(c)

fn section(out: mut [u8], id: int, body: [u8]):
    out.push(u8(id))
    uleb(out, body.len())
    append_bytes(out, body)

const WT_I32 = 0x7F
const WT_I64 = 0x7E
const WT_F32 = 0x7D
const WT_F64 = 0x7C

fn wt(vt: int) -> int:
    if vt == VF: return WT_F64
    if vt == VS: return WT_F32
    WT_I64

# wasm value type for an import parameter of Jot type t
fn import_wt(t0: int) -> int:
    t := prune(t0)
    k := types[t].kind
    if k == .float_:
        if int(types[t].bits) == 32: return WT_F32
        return WT_F64
    if k == .int_ and int(types[t].bits) == 64: return WT_I64
    WT_I32

# ---------------- function types ----------------
type_sigs: [[u8]]
type_index: {str: int} = {}

fn sig_index(params: [int], results: [int]) -> int:
    key := "{params}:{results}"
    if i := type_index.get(key): return i
    s: [u8] = [0x60]
    uleb(s, params.len())
    for p in params: s.push(u8(p))
    uleb(s, results.len())
    for r in results: s.push(u8(r))
    type_sigs.push(s)
    i := type_sigs.len() - 1
    type_index[key] = i
    i

fn fn_sig_of(f: IrFn) -> int:
    ps: [int]
    for p in 0..f.nparams: ps.push(wt(int(f.vtypes[p])))
    rs: [int]
    if f.ret >= 0: rs.push(wt(f.ret))
    sig_index(ps, rs)

fn is_import(lf: int) -> bool:
    l := lfuncs[lf]
    l.kind == LK_INST and fns[l.inst].decl != 0 and has_flag(int(fns[l.inst].decl), NF_EXTERN)

fn import_sig(lf: int) -> int:
    f := lfuncs[lf].inst
    ps: [int]
    for t in fns[f].ptypes: ps.push(import_wt(t))
    rs: [int]
    if tkind(int(fns[f].ret)) != .void_: rs.push(import_wt(int(fns[f].ret)))
    sig_index(ps, rs)

# ---------------- module state ----------------
wfn_index: [int]          # lfunc -> wasm function index
table_index: {int: int} = {}
table_funcs: [int]
data_base := 0
stack_top := 0

fn tbl(lf: int) -> int:
    if i := table_index.get(lf): return i
    table_funcs.push(lf)
    i := table_funcs.len()      # index 0 stays null
    table_index[lf] = i
    i

# ---------------- function body ----------------
wb: [u8]
loc_of: [int]             # vreg -> local index
fp_local := 0
cur_frame := 0
cur_wf: IrFn

fn op(x: int): wb.push(u8(x))
fn lget(v: int):
    if int(cur_wf.vtypes[v]) == VK:
        i64c(cur_wf.kval[v])
        return
    op(0x20)
    uleb(wb, loc_of[v])
fn lset(v: int):
    op(0x21)
    uleb(wb, loc_of[v])
fn i64c(v: int):
    op(0x42)
    sleb(wb, v)
fn i32c(v: int):
    op(0x41)
    sleb(wb, v)
# push the i32 address of a load/store; returns the static offset for its memarg
fn waddr(ins: Ins) -> int:
    lget(int(ins.a))
    ix := mem_index(ins)
    if ix >= 0:
        lget(ix)
        sc := mem_scale(ins)
        if sc > 0:
            i64c(sc)
            op(0x86)            # i64.shl
        op(0x7C)                # i64.add
    off := int(ins.imm)
    if off < 0:
        i64c(off)
        op(0x7C)
        off = 0
    op(0xA7)                    # i32.wrap_i64
    off

fn addr32(v: int):
    lget(v)
    op(0xA7)              # i32.wrap_i64
fn memarg(align: int, off: int):
    uleb(wb, align)
    uleb(wb, off)
fn to_i64_from_i32(): op(0xAD)    # i64.extend_i32_u
fn restore_sp():
    if cur_frame > 0:
        op(0x20)
        uleb(wb, fp_local)
        i32c(cur_frame)
        op(0x6A)          # i32.add
        op(0x24)
        uleb(wb, 0)       # global.set $sp

fn bin64(code: int, ins: Ins):
    lget(int(ins.a))
    lget(int(ins.b))
    op(code)
    lset(int(ins.dst))

fn cmp_res(): to_i64_from_i32()

fn emit_call_args(start: int, n: int, lf: int):
    imp := lf >= 0 and is_import(lf)
    pts: [int]
    if imp:
        for t in fns[lfuncs[lf].inst].ptypes: pts.push(import_wt(t))
    for k in 0..n:
        v := int(cur_wf.args[start + k])
        lget(v)
        if imp and pts[k] == WT_I32: op(0xA7)

fn call_result(ins: Ins, lf: int):
    d := int(ins.dst)
    imp := lf >= 0 and is_import(lf)
    if imp:
        f := lfuncs[lf].inst
        rt := int(fns[f].ret)
        if tkind(rt) != .void_:
            if import_wt(rt) == WT_I32: to_i64_from_i32()
            if d >= 0: lset(d)
            else: op(0x1A)            # drop
        return
    if d >= 0: lset(d)
    else if int(ins.ty) >= 0: op(0x1A)

fn emit_wins(ins: Ins):
    o := ins.op
    d := int(ins.dst)
    a := int(ins.a)
    bb := int(ins.b)
    match o:
        nop, assume: pass
        iconst:
            i64c(ins.imm)
            lset(d)
        fconst:
            if int(ins.ty) == VS:
                op(0x43)
                bits := ins.imm
                for k in 0..4: wb.push(u8((bits >> (8 * k)) & 255))
            else:
                op(0x44)
                bits := ins.imm
                for k in 0..8: wb.push(u8((bits >> (8 * k)) & 255))
            lset(d)
        mov:
            lget(a)
            lset(d)
        add: bin64(0x7C, ins)
        sub: bin64(0x7D, ins)
        mul: bin64(0x7E, ins)
        divs: bin64(0x7F, ins)
        divu: bin64(0x80, ins)
        rems: bin64(0x81, ins)
        remu: bin64(0x82, ins)
        and_: bin64(0x83, ins)
        or_: bin64(0x84, ins)
        xor: bin64(0x85, ins)
        shl: bin64(0x86, ins)
        shrs: bin64(0x87, ins)
        shru: bin64(0x88, ins)
        neg:
            i64c(0)
            lget(a)
            op(0x7D)
            lset(d)
        not_:
            lget(a)
            i64c(-1)
            op(0x85)
            lset(d)
        eq, ne, lts, ltu, gts, gtu, les, leu, ges, geu:
            lget(a)
            lget(bb)
            c := 0x51
            if o == .ne: c = 0x52
            else if o == .lts: c = 0x53
            else if o == .ltu: c = 0x54
            else if o == .gts: c = 0x55
            else if o == .gtu: c = 0x56
            else if o == .les: c = 0x57
            else if o == .leu: c = 0x58
            else if o == .ges: c = 0x59
            else if o == .geu: c = 0x5A
            op(c)
            cmp_res()
            lset(d)
        fadd, fsub, fmul, fdiv, fmin, fmax:
            f32 := int(ins.ty) == VS
            lget(a)
            lget(bb)
            base := 0xA0
            if f32: base = 0x92
            k := 0
            if o == .fsub: k = 1
            else if o == .fmul: k = 2
            else if o == .fdiv: k = 3
            else if o == .fmin: k = 4
            else if o == .fmax: k = 5
            op(base + k)
            lset(d)
        fneg, fabs, fsqrt, ffloor, fceil, ftrunc:
            f32 := int(ins.ty) == VS
            lget(a)
            c := 0
            if o == .fabs: c = 0x99
            else if o == .fneg: c = 0x9A
            else if o == .fceil: c = 0x9B
            else if o == .ffloor: c = 0x9C
            else if o == .ftrunc: c = 0x9D
            else: c = 0x9F
            if f32: c -= 14
            op(c)
            lset(d)
        feq, fne, flt, fle, fgt, fge:
            f32 := int(ins.ty) == VS
            lget(a)
            lget(bb)
            c := 0x61
            if o == .fne: c = 0x62
            else if o == .flt: c = 0x63
            else if o == .fgt: c = 0x64
            else if o == .fle: c = 0x65
            else if o == .fge: c = 0x66
            if f32: c -= 6
            op(c)
            cmp_res()
            lset(d)
        sext8, sext16, sext32:
            lget(a)
            if o == .sext8: op(0xC2)
            else if o == .sext16: op(0xC3)
            else: op(0xC4)
            lset(d)
        zext8, zext16, zext32:
            lget(a)
            if o == .zext32:
                op(0xA7)
                op(0xAD)
            else:
                if o == .zext8: i64c(0xFF)
                else: i64c(0xFFFF)
                op(0x83)
            lset(d)
        i2f, u2f:
            lget(a)
            if int(ins.ty) == VS:
                if o == .i2f: op(0xB4)
                else: op(0xB5)
            else:
                if o == .i2f: op(0xB9)
                else: op(0xBA)
            lset(d)
        f2i:
            lget(a)
            op(0xFC)
            if int(ins.ty) == VS: uleb(wb, 4)
            else: uleb(wb, 6)
            lset(d)
        f2f:
            lget(a)
            if int(ins.ty) == VF: op(0xBB)
            else: op(0xB6)
            lset(d)
        bits2f:
            lget(a)
            if int(ins.ty) == VS:
                op(0xA7)
                op(0xBE)
            else: op(0xBF)
            lset(d)
        f2bits:
            lget(a)
            if int(ins.ty) == VS:
                op(0xBC)
                op(0xAD)
            else: op(0xBD)
            lset(d)
        load:
            mode := int(ins.c)
            size := mode & 15
            off := waddr(ins)
            if mode & M_FLOAT != 0:
                if size == 4:
                    op(0x2A)
                    memarg(2, off)
                else:
                    op(0x2B)
                    memarg(3, off)
            else:
                sg := mode & M_SIGNED != 0
                if size == 8:
                    op(0x29)
                    memarg(3, off)
                else if size == 4:
                    if sg: op(0x34)
                    else: op(0x35)
                    memarg(2, off)
                else if size == 2:
                    if sg: op(0x32)
                    else: op(0x33)
                    memarg(1, off)
                else:
                    if sg: op(0x30)
                    else: op(0x31)
                    memarg(0, off)
            lset(d)
        store:
            mode := int(ins.c)
            size := mode & 15
            off := waddr(ins)
            lget(bb)
            vt := vtype_of(bb)
            if vt == VF:
                op(0x39)
                memarg(3, off)
            else if vt == VS:
                op(0x38)
                memarg(2, off)
            else if size == 8:
                op(0x37)
                memarg(3, off)
            else if size == 4:
                op(0x3E)
                memarg(2, off)
            else if size == 2:
                op(0x3D)
                memarg(1, off)
            else:
                op(0x3C)
                memarg(0, off)
        slot:
            op(0x20)
            uleb(wb, fp_local)
            to_i64_from_i32()
            i64c(slot_offs[a])
            op(0x7C)
            lset(d)
        gaddr:
            i64c(data_base + int(ins.imm))
            lset(d)
        daddr:
            i64c(RO_BASE + int(ins.imm))
            lset(d)
        faddr:
            i64c(tbl(int(ins.imm)))
            lset(d)
        copy:
            addr32(a)
            addr32(bb)
            i32c(int(ins.imm))
            op(0xFC)
            uleb(wb, 10)
            op(0)
            op(0)
        zero:
            addr32(a)
            i32c(0)
            i32c(int(ins.imm))
            op(0xFC)
            uleb(wb, 11)
            op(0)
        memcpy:
            addr32(a)
            addr32(bb)
            addr32(int(ins.c))
            op(0xFC)
            uleb(wb, 10)
            op(0)
            op(0)
        memset:
            addr32(a)
            addr32(bb)
            addr32(int(ins.c))
            op(0xFC)
            uleb(wb, 11)
            op(0)
        zeroslots:
            for k in 0..bb:
                item := int(cur_wf.args[a + k])
                if item & 1 == 1:
                    v := item >> 1
                    if vtype_of(v) == VF:
                        op(0x44)
                        for z in 0..8: op(0)
                    else if vtype_of(v) == VS:
                        op(0x43)
                        for z in 0..4: op(0)
                    else: i64c(0)
                    lset(v)
                else:
                    s := item >> 1
                    op(0x20)
                    uleb(wb, fp_local)
                    i32c(slot_offs[s])
                    op(0x6A)
                    i32c(0)
                    i32c(int(cur_wf.slot_size[s]))
                    op(0xFC)
                    uleb(wb, 11)
                    op(0)
        call:
            lf := int(ins.imm)
            if is_import(lf) and name_of(int(nodes[int(fns[lfuncs[lf].inst].decl)].name)) == "__wasm_grow":
                lget(int(cur_wf.args[a]))
                op(0xA7)
                op(0x40)
                op(0)
                op(0xAC)                 # i64.extend_i32_s
                if d >= 0: lset(d)
                else: op(0x1A)
                return
            emit_call_args(a, bb, lf)
            op(0x10)
            uleb(wb, wfn_index[lf])
            call_result(ins, lf)
        calli, callc:
            emit_call_args(a, bb, -1)
            addr32(int(ins.c))
            ps: [int]
            for k in 0..bb: ps.push(wt(vtype_of(int(cur_wf.args[a + k]))))
            rs: [int]
            if int(ins.ty) >= 0: rs.push(wt(int(ins.ty)))
            op(0x11)
            uleb(wb, sig_index(ps, rs))
            op(0)
            call_result(ins, -1)
        syscall:
            op(0x00)
        intr:
            i64c(0)
            lset(d)
        block:
            op(0x02)
            op(0x40)
        loop:
            op(0x03)
            op(0x40)
        if_:
            lget(a)
            op(0x50)       # i64.eqz
            op(0x45)       # i32.eqz
            op(0x04)
            op(0x40)
        else_: op(0x05)
        end: op(0x0B)
        br:
            op(0x0C)
            uleb(wb, int(ins.imm))
        brif:
            lget(a)
            op(0x50)
            op(0x45)
            op(0x0D)
            uleb(wb, int(ins.imm))
        brtable:
            # out-of-range indices (unsigned) select the default entry
            lget(a)
            op(0xA7)                    # i32.wrap_i64
            i32c(bb)
            lget(a)
            i64c(bb)
            op(0x54)                    # i64.lt_u
            op(0x1B)                    # select
            op(0x0E)
            uleb(wb, bb)
            for k in 0..bb: uleb(wb, int(cur_wf.args[int(ins.c) + k]))
            uleb(wb, int(ins.imm))
        ret:
            if a >= 0: lget(a)
            restore_sp()
            op(0x0F)
        trap: op(0x00)
        select: op(0x00)

fn vtype_of(v: int) -> int:
    t := int(cur_wf.vtypes[v])
    if t == VK: return VI
    t

slot_offs: [int]

fn wasm_body(f: IrFn) -> [u8]:
    cur_wf = f
    wb = []
    nv := f.vtypes.len()
    loc_of = [0; nv]
    # locals: params keep their indices, others grouped by type
    for p in 0..f.nparams: loc_of[p] = p
    next := f.nparams
    groups: [(int, int)]
    for t in [VI, VF, VS]:
        cnt := 0
        for v in f.nparams..nv:
            if int(f.vtypes[v]) == t:
                loc_of[v] = next
                next += 1
                cnt += 1
        if cnt > 0: groups.push((cnt, wt(t)))
    fp_local = next
    next += 1
    groups.push((1, WT_I32))
    # frame
    slot_offs = [0; f.slot_size.len()]
    off := 0
    for s in 0..f.slot_size.len():
        al := int(f.slot_align[s])
        off = align_up(off, al)
        slot_offs[s] = off
        off += int(f.slot_size[s])
    cur_frame = align_up(off, 16)
    uleb(wb, groups.len())
    for g in groups:
        uleb(wb, g.0)
        wb.push(u8(g.1))
    if cur_frame > 0:
        op(0x23)
        uleb(wb, 0)          # global.get $sp
        i32c(cur_frame)
        op(0x6B)             # i32.sub
        op(0x22)
        uleb(wb, fp_local)   # local.tee $fp
        op(0x24)
        uleb(wb, 0)          # global.set $sp
    for ins in f.code: emit_wins(ins)
    op(0x0B)
    out := wb
    wb = []
    out

# ---------------- module ----------------
fn wasm_module(inits: [int], main_lf: int, frame_lf: int) -> [u8]:
    nf := lfuncs.len()
    wfn_index = [-1; nf]
    imports: [int]
    defined: [int]
    for lf in 0..nf:
        if is_import(lf): imports.push(lf)
        else if lf < wf_present.len() and wf_present[lf]: defined.push(lf)
    k := 0
    for lf in imports:
        wfn_index[lf] = k
        k += 1
    for lf in defined:
        wfn_index[lf] = k
        k += 1
    start_index := k
    # exported functions get adapters with JavaScript-friendly parameter types (i32/f32/f64)
    exp_lfs: [int]
    for lf in defined:
        if len(wfuncs[lf].export_name) > 0: exp_lfs.push(lf)
    adapter_base := start_index + 1
    data_base = align_up(RO_BASE + rodata.len(), 16)
    stack_top = align_up(data_base + data_size + STACK_SIZE, 16)
    pages := (stack_top + 65535) / 65536 + 1
    # bodies (this also registers table entries and signatures)
    bodies: [[u8]]
    for lf in defined: bodies.push(wasm_body(wfuncs[lf]))
    # entry function: initializers then main
    eb: [u8] = [0]
    for f in inits:
        eb.push(0x10)
        uleb(eb, wfn_index[f])
    if main_lf >= 0:
        eb.push(0x10)
        uleb(eb, wfn_index[main_lf])
    eb.push(0x0B)
    start_sig := sig_index([], [])
    adapter_sigs: [int]
    adapter_bodies: [[u8]]
    for lf in exp_lfs:
        f := lfuncs[lf].inst
        ps: [int]
        for t in fns[f].ptypes: ps.push(import_wt(t))
        rs: [int]
        rt := int(fns[f].ret)
        if tkind(rt) != .void_: rs.push(import_wt(rt))
        adapter_sigs.push(sig_index(ps, rs))
        ab: [u8] = [0]
        for i, t in fns[f].ptypes:
            ab.push(0x20)
            uleb(ab, i)
            if import_wt(t) == WT_I32:
                tt := prune(t)
                if types[tt].kind == .int_ and types[tt].sign: ab.push(0xAC)
                else: ab.push(0xAD)
        ab.push(0x10)
        uleb(ab, wfn_index[lf])
        if tkind(rt) != .void_ and import_wt(rt) == WT_I32: ab.push(0xA7)
        ab.push(0x0B)
        adapter_bodies.push(ab)
    sigs: [int]
    for lf in imports: sigs.push(import_sig(lf))
    for lf in defined: sigs.push(fn_sig_of(wfuncs[lf]))
    out: [u8] = [0, 'a', 's', 'm', 1, 0, 0, 0]
    # type section
    s: [u8]
    uleb(s, type_sigs.len())
    for t in type_sigs:
        append_bytes(s, t)
    section(out, 1, s)
    # imports
    s = []
    uleb(s, imports.len())
    for i, lf in imports:
        wstr(s, "env")
        wstr(s, name_of(int(nodes[int(fns[lfuncs[lf].inst].decl)].name)))
        s.push(0)
        uleb(s, sigs[i])
    section(out, 2, s)
    # functions
    s = []
    uleb(s, defined.len() + 1 + exp_lfs.len())
    for i in 0..defined.len(): uleb(s, sigs[imports.len() + i])
    uleb(s, start_sig)
    for a in adapter_sigs: uleb(s, a)
    section(out, 3, s)
    # table
    s = [1, 0x70, 0]
    uleb(s, table_funcs.len() + 1)
    section(out, 4, s)
    # memory
    s = [1, 0]
    uleb(s, pages)
    section(out, 5, s)
    # globals: $sp
    s = [1, WT_I32, 1, 0x41]
    sleb(s, stack_top)
    s.push(0x0B)
    section(out, 6, s)
    # exports
    s = []
    exports: [(str, int)]
    exports.push(("__start", start_index))
    for i, lf in exp_lfs: exports.push((wfuncs[lf].export_name, adapter_base + i))
    uleb(s, exports.len() + 2)
    wstr(s, "memory")
    s.push(2)
    uleb(s, 0)
    wstr(s, "table")
    s.push(1)
    uleb(s, 0)
    for e in exports:
        wstr(s, e.0)
        s.push(0)
        uleb(s, e.1)
    section(out, 7, s)
    # elements: table[1..] = address-taken functions
    s = [1, 0, 0x41, 1, 0x0B]
    uleb(s, table_funcs.len())
    for lf in table_funcs:
        if wfn_index[lf] < 0: ice("function {lfuncs[lf].name} used as a value but not generated")
        uleb(s, wfn_index[lf])
    section(out, 9, s)
    # code
    s = []
    uleb(s, defined.len() + 1 + exp_lfs.len())
    for bd in bodies:
        uleb(s, bd.len())
        append_bytes(s, bd)
    uleb(s, eb.len())
    append_bytes(s, eb)
    for ab in adapter_bodies:
        uleb(s, ab.len())
        for c in ab: s.push(c)
    section(out, 10, s)
    # data: rodata
    s = [1, 0, 0x41]
    sleb(s, RO_BASE)
    s.push(0x0B)
    uleb(s, rodata.len())
    for c in rodata: s.push(c)
    section(out, 11, s)
    out

# ---------------- HTML packaging ----------------
fn base64(b: [u8]) -> str:
    tbl_ := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out: [u8]
    out.reserve(b.len() * 4 / 3 + 4)
    i := 0
    n := b.len()
    while i + 2 < n:
        v := (int(b[i]) << 16) | (int(b[i + 1]) << 8) | int(b[i + 2])
        out.push(tbl_[(v >> 18) & 63])
        out.push(tbl_[(v >> 12) & 63])
        out.push(tbl_[(v >> 6) & 63])
        out.push(tbl_[v & 63])
        i += 3
    if n - i == 1:
        v := int(b[i]) << 16
        out.push(tbl_[(v >> 18) & 63])
        out.push(tbl_[(v >> 12) & 63])
        out.push('=')
        out.push('=')
    else if n - i == 2:
        v := (int(b[i]) << 16) | (int(b[i + 1]) << 8)
        out.push(tbl_[(v >> 18) & 63])
        out.push(tbl_[(v >> 12) & 63])
        out.push(tbl_[(v >> 6) & 63])
        out.push('=')
    str_from_bytes(out)

fn write_html(path: str, wasm: [u8], title: str) -> bool:
    js := ""
    for part in ["runtime.js", "gfx.js", "audio.js", "boot.js"]:
        src := read_file("{lib_dir}/web/{part}") ?? ""
        if len(src) == 0 and part != "audio.js": ice("missing {lib_dir}/web/{part}")
        js += src + "\n"
    html := "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>{title}</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>html,body\{margin:0;height:100%;background:#111;color:#ddd;font:14px monospace}canvas\{display:block;margin:auto;outline:none}#log\{white-space:pre-wrap;margin:8px;max-height:40vh;overflow:auto}</style>\n</head><body><canvas id=\"jot-canvas\" tabindex=\"1\" width=\"0\" height=\"0\"></canvas><div id=\"log\"></div>\n<script>\nconst JOT_WASM = \"{base64(wasm)}\";\n{js}\n</script></body></html>\n"
    write_file(path, html)
