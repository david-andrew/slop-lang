# IR cleanup run on every function after lowering, for both targets: constant folding,
# strength reduction, copy propagation and dead code removal. It is a couple of linear
# passes over the code, so it pays for itself in faster register allocation and emission.

use ir

const MIN_INT = -9223372036854775807 - 1

o_ndef: [i32]       # static definitions per vreg (params count as one)
o_defpos: [i32]     # position of the (last) definition
o_first: [i32]      # first use position
o_nuse: [i32]
o_const: [bool]     # single-def iconst
o_cval: [int]
o_repl: [i32]       # copy propagation: use this vreg instead
o_dop: [i32]        # defining op of a stable vreg with stable operands (-1: unknown)
o_da: [i32]
o_db: [i32]
o_buf: [int]

# fills o_buf with the vregs used by ins; returns the defined vreg or -1
fn o_operands(ins: Ins) -> int:
    o_buf.clear()
    a := int(ins.a)
    bb := int(ins.b)
    d := int(ins.dst)
    match ins.op:
        nop, block, loop, end, else_, br, trap, zeroslots: return -1
        iconst, fconst, slot, gaddr, daddr, faddr: return d
        intr, call, syscall:
            for k in 0..bb: o_buf.push(int(ir.args[a + k]))
            return d
        calli, callc:
            for k in 0..bb: o_buf.push(int(ir.args[a + k]))
            o_buf.push(int(ins.c))
            return d
        if_, brif, brtable, assume:
            o_buf.push(a)
            return -1
        ret:
            if a >= 0: o_buf.push(a)
            return -1
        store:
            o_buf.push(a)
            o_buf.push(bb)
            if int(ins.c) & M_INDEX != 0: o_buf.push(d)
            return -1
        copy:
            o_buf.push(a)
            o_buf.push(bb)
            return -1
        zero:
            o_buf.push(a)
            return -1
        memcpy, memset:
            o_buf.push(a)
            o_buf.push(bb)
            o_buf.push(int(ins.c))
            return -1
        select:
            o_buf.push(a)
            o_buf.push(bb)
            o_buf.push(int(ins.c))
            return d
        load:
            o_buf.push(a)
            if int(ins.c) & M_INDEX != 0: o_buf.push(bb)
            return d
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            o_buf.push(a)
            return d
        _:
            o_buf.push(a)
            o_buf.push(bb)
            return d

# rewrite the used vregs of ins through o_repl
fn o_rewrite(ins: mut Ins):
    a := int(ins.a)
    bb := int(ins.b)
    match ins.op:
        nop, block, loop, end, else_, br, trap, zeroslots, iconst, fconst, slot, gaddr, daddr, faddr: pass
        intr, call, syscall:
            for k in 0..bb: ir.args[a + k] = o_repl[int(ir.args[a + k])]
        calli, callc:
            for k in 0..bb: ir.args[a + k] = o_repl[int(ir.args[a + k])]
            ins.c = o_repl[int(ins.c)]
        if_, brif, zero, brtable, assume:
            ins.a = o_repl[a]
        ret:
            if a >= 0: ins.a = o_repl[a]
        memcpy, memset, select:
            ins.a = o_repl[a]
            ins.b = o_repl[bb]
            ins.c = o_repl[int(ins.c)]
        load:
            ins.a = o_repl[a]
            if int(ins.c) & M_INDEX != 0: ins.b = o_repl[bb]
        store:
            ins.a = o_repl[a]
            ins.b = o_repl[bb]
            if int(ins.c) & M_INDEX != 0: ins.dst = o_repl[int(ins.dst)]
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            ins.a = o_repl[a]
        _:
            ins.a = o_repl[a]
            ins.b = o_repl[bb]

fn o_pure(op: Op) -> bool:
    match op:
        iconst, fconst, mov, slot, gaddr, daddr, faddr, load: true
        add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, neg, not_: true
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: true
        fadd, fsub, fmul, fdiv, fneg, fsqrt, fmin, fmax, ffloor, fceil, fabs, ftrunc: true
        feq, fne, flt, fle, fgt, fge: true
        sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits: true
        _: false

fn o_resize(n: int):
    if o_ndef.len() < n:
        o_ndef.resize(n)
        o_defpos.resize(n)
        o_first.resize(n)
        o_nuse.resize(n)
        o_const.resize(n)
        o_cval.resize(n)
        o_repl.resize(n)
        o_dop.resize(n)
        o_da.resize(n)
        o_db.resize(n)
    for v in 0..n:
        o_dop[v] = -1
        o_ndef[v] = 0
        o_defpos[v] = -1
        o_first[v] = 2147483647
        o_nuse[v] = 0
        o_const[v] = false
        o_repl[v] = i32(v)

fn log2_exact(x: int) -> int:
    if x <= 0 or x & (x - 1) != 0: return -1
    k := 0
    while (1 << k) != x: k += 1
    k

fn shru_val(a: int, k: int) -> int:
    if k == 0: return a
    (a >> k) & ((1 << (64 - k)) - 1)

fn ult(a: int, b: int) -> bool: (a ^ MIN_INT) < (b ^ MIN_INT)

fn is_k(v: int) -> bool: o_const[v]

# fold an integer operation on constants; returns (ok, value)
fn fold(op: Op, x: int, y: int) -> (bool, int):
    match op:
        add: (true, x + y)
        sub: (true, x - y)
        mul: (true, x * y)
        divs:
            if y == 0 or (x == MIN_INT and y == -1): return (false, 0)
            (true, x / y)
        rems:
            if y == 0 or (x == MIN_INT and y == -1): return (false, 0)
            (true, x % y)
        and_: (true, x & y)
        or_: (true, x | y)
        xor: (true, x ^ y)
        shl: (true, x << (y & 63))
        shrs: (true, x >> (y & 63))
        shru: (true, shru_val(x, y & 63))
        eq: (true, int(x == y))
        ne: (true, int(x != y))
        lts: (true, int(x < y))
        les: (true, int(x <= y))
        gts: (true, int(x > y))
        ges: (true, int(x >= y))
        ltu: (true, int(ult(x, y)))
        leu: (true, int(not ult(y, x)))
        gtu: (true, int(ult(y, x)))
        geu: (true, int(not ult(x, y)))
        _: (false, 0)

fn fold_un(op: Op, x: int) -> (bool, int):
    match op:
        neg: (true, -x)
        not_: (true, ~x)
        sext8: (true, (x << 56) >> 56)
        sext16: (true, (x << 48) >> 48)
        sext32: (true, (x << 32) >> 32)
        zext8: (true, x & 255)
        zext16: (true, x & 65535)
        zext32: (true, x & 4294967295)
        _: (false, 0)

# comparison with its operands swapped
fn mirror(op: Op) -> Op:
    match op:
        lts: .gts
        les: .ges
        gts: .lts
        ges: .les
        ltu: .gtu
        leu: .geu
        gtu: .ltu
        geu: .leu
        _: op

fn commutes(op: Op) -> bool:
    op == .add or op == .mul or op == .and_ or op == .or_ or op == .xor or op == .eq or op == .ne

o_out: [Ins]
o_kmap: {int: int} = {}     # constant value -> canonical constant vreg

fn o_kconst(v: int) -> int:
    if ir_fits32(v):
        if c := o_kmap.get(v): return c
        k := k_vreg(v)
        o_resize_one(k)
        o_ndef[k] = 1
        o_const[k] = true
        o_cval[k] = v
        o_kmap[v] = k
        return k
    d := vreg(VI)
    o_resize_one(d)
    o_ndef[d] = 1
    o_const[d] = true
    o_cval[d] = v
    o_emit(Ins(.iconst, VI, i32(d), 0, 0, 0, v))
    int(o_repl[d])

fn o_resize_one(d: int):
    while o_ndef.len() <= d:
        o_ndef.push(0)
        o_defpos.push(-1)
        o_first.push(2147483647)
        o_nuse.push(0)
        o_const.push(false)
        o_cval.push(0)
        o_repl.push(0)
        o_dop.push(-1)
        o_da.push(0)
        o_db.push(0)
    o_repl[d] = i32(d)
    o_dop[d] = -1

# (results may be replaced by an existing equal value)
fn o_bin(op: Op, d: int, a: int, b: int) -> int:
    o_emit(Ins(op, VI, i32(d), i32(a), i32(b), 0, 0))
    int(o_repl[d])

fn o_tmp() -> int:
    d := vreg(VI)
    o_resize_one(d)
    o_ndef[d] = 1
    d

# can uses of d be replaced by s? both must be single-definition values defined before use
fn o_can_alias(d: int, s: int) -> bool:
    if o_ndef[d] != 1 or o_ndef[s] != 1: return false
    if o_first[d] < o_defpos[d]: return false
    if s >= ir.nparams and o_first[s] < o_defpos[s]: return false
    vtype(d) == vtype(s)

# ---------------- common subexpressions ----------------
# A hash table of available values keyed by (op, type, operands, immediate). Entries belong to
# the control construct that was open when they were made and die when it closes; loads also
# die when memory may have changed (any store or call bumps the memory generation).
ht_k1: [int]
ht_k2: [int]
ht_k3: [int]
ht_val: [i32]
ht_scope: [i32]
ht_gen: [int]
ht_epoch: [int]
ht_mask := 0
o_epoch := 0
o_gen := 0              # memory generation for integer data
o_genf := 0             # memory generation for float data (distinct unless raw pointers are used)
o_open: [bool]          # by scope serial
o_scopes: [int]         # open scopes, innermost last

const FACT_FALSE = 255  # pseudo-op key: "this condition is known to be false"

fn ht_setup(n: int):
    size := 64
    while size < n * 4: size *= 2
    if ht_k1.len() < size:
        ht_k1.resize(size)
        ht_k2.resize(size)
        ht_k3.resize(size)
        ht_val.resize(size)
        ht_scope.resize(size)
        ht_gen.resize(size)
        ht_epoch.resize(size)
    ht_mask = size - 1
    o_epoch += 1
    o_gen = 0
    o_genf = 1 << 40
    o_open.clear()
    o_scopes.clear()
    o_scope_open()

fn o_scope_open():
    o_open.push(true)
    o_scopes.push(o_open.len() - 1)

fn o_scope_close():
    o_open[o_scopes.pop()] = false

fn ht_slot(k1: int, k2: int, k3: int) -> int:
    h := (k1 * -7046029254386353131) ^ (k2 * -4417276706812531889) ^ (k3 * 1609587929392839161)
    i := (h >> 29) & ht_mask
    while ht_epoch[i] == o_epoch:
        if ht_k1[i] == k1 and ht_k2[i] == k2 and ht_k3[i] == k3: return i
        i = (i + 1) & ht_mask
    i

# gen: memory generation the entry depends on (-1: none)
fn ht_find(k1: int, k2: int, k3: int, gen: int) -> int:
    i := ht_slot(k1, k2, k3)
    if ht_epoch[i] != o_epoch or not o_open[int(ht_scope[i])]: return -1
    if gen >= 0 and ht_gen[i] != gen: return -1
    int(ht_val[i])

fn mem_gen(mode: int) -> int:
    if mode & M_FLOAT != 0 and not ir.raw_mem: return o_genf
    o_gen

fn kill_mem(mode: int):
    if mode & M_FLOAT == 0 or ir.raw_mem: o_gen += 1
    if mode & M_FLOAT != 0 or ir.raw_mem: o_genf += 1

fn kill_all():
    o_gen += 1
    o_genf += 1

fn ht_put_gen(k1: int, k2: int, k3: int, v: int, gen: int):
    ht_put(k1, k2, k3, v)
    ht_gen[ht_slot(k1, k2, k3)] = gen

fn load_key1(ty: int, mode: int, addr: int) -> int: int(Op.load) | (ty << 8) | ((mode & 4095) << 12) | (addr << 24)

fn ht_put(k1: int, k2: int, k3: int, v: int):
    i := ht_slot(k1, k2, k3)
    ht_epoch[i] = o_epoch
    ht_k1[i] = k1
    ht_k2[i] = k2
    ht_k3[i] = k3
    ht_val[i] = i32(v)
    ht_scope[i] = i32(o_scopes[o_scopes.len() - 1])
    ht_gen[i] = o_gen

# a value that is defined once and never read before its definition
fn stable(v: int) -> bool: o_ndef[v] == 1 and o_first[v] > o_defpos[v]

fn cse_op(op: Op) -> bool:
    match op:
        iconst, fconst, slot, gaddr, daddr, faddr, load: true
        add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, neg, not_: true
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: true
        fadd, fsub, fmul, fdiv, fneg, fsqrt, fmin, fmax, ffloor, fceil, fabs, ftrunc: true
        feq, fne, flt, fle, fgt, fge: true
        sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits: true
        _: false

fn kills_memory(op: Op) -> bool:
    match op:
        store, copy, zero, memcpy, memset, zeroslots, call, calli, callc, syscall, intr: true
        _: false

o_cse := false
o_nbr := 0              # branches emitted so far

fn o_fits32(v: int) -> bool: v >= -2147483648 and v <= 2147483647

fn o_emit(ins0: Ins):
    ins := ins0
    op := ins.op
    if op == .br or op == .brif or op == .brtable: o_nbr += 1
    if o_cse and (op == .load or op == .store):
        # fold constant offsets into the access: [x + k + imm]
        a := int(ins.a)
        while stable(a) and o_dop[a] == i32(int(Op.add)) and o_const[int(o_db[a])] and o_fits32(ins.imm + o_cval[int(o_db[a])]):
            ins.imm += o_cval[int(o_db[a])]
            a = int(o_da[a])
        # [base + index << scale + imm] (x86 addressing; wasm computes it)
        if int(ins.c) & M_INDEX == 0 and stable(a) and o_dop[a] == i32(int(Op.add)) and not o_const[int(o_db[a])] and not o_const[int(o_da[a])]:
            base := int(o_da[a])
            idx := int(o_db[a])
            scale := 0
            if stable(idx) and o_dop[idx] == i32(int(Op.shl)) and o_const[int(o_db[idx])] and o_cval[int(o_db[idx])] <= 3 and o_cval[int(o_db[idx])] >= 0:
                scale = o_cval[int(o_db[idx])]
                idx = int(o_da[idx])
            while stable(base) and o_dop[base] == i32(int(Op.add)) and o_const[int(o_db[base])] and o_fits32(ins.imm + o_cval[int(o_db[base])]):
                ins.imm += o_cval[int(o_db[base])]
                base = int(o_da[base])
            a = base
            ins.c = i32(int(ins.c) | M_INDEX | (scale << 8))
            if op == .store: ins.dst = i32(idx)
            else: ins.b = i32(idx)
        ins.a = i32(a)
    if o_cse:
        if cse_op(op):
            d := int(ins.dst)
            o_operands(ins)
            ok := true
            for u in o_buf:
                if not stable(u): ok = false
            if ok:
                k1 := int(op) | (int(ins.ty) << 8) | ((int(ins.c) & 4095) << 12) | (int(ins.a) << 24)
                k2 := int(ins.b)
                k3 := ins.imm
                gen := -1
                if op == .load: gen = mem_gen(int(ins.c))
                e := ht_find(k1, k2, k3, gen)
                if e >= 0 and vtype(e) == vtype(d):
                    if stable(d):
                        o_repl[d] = i32(e)
                        if o_const[e]:
                            o_const[d] = true
                            o_cval[d] = o_cval[e]
                        return
                    o_out.push(Ins(.mov, i32(vtype(d)), i32(d), i32(e), 0, 0, 0))
                    return
                if stable(d):
                    ht_put_gen(k1, k2, k3, d, gen)
                    o_dop[d] = i32(int(op))
                    o_da[d] = ins.a
                    o_db[d] = ins.b
        else if op == .store:
            mode := int(ins.c)
            kill_mem(mode)
            # store-to-load forwarding for full-width values
            a := int(ins.a)
            v := int(ins.b)
            ix := 0
            if mode & M_INDEX != 0: ix = int(ins.dst)
            if (mode & 15 == 8 or mode & M_FLOAT != 0) and stable(a) and stable(v) and stable(ix):
                ht_put_gen(load_key1(int(ins.ty), mode, a), ix, ins.imm, v, mem_gen(mode))
        else if op == .assume:
            a := int(ins.a)
            if ins.imm == A_RC1 and stable(a):
                ht_put_gen(load_key1(VI, 8, a), 0, 0, o_kconst(1), o_gen)
            return
        else if kills_memory(op) and not (op == .call and ins.c == 1): kill_all()
    o_out.push(ins)

fn fact_false(c: int) -> bool:
    if not o_cse or not stable(c): return false
    ht_find(FACT_FALSE, c, 0, -1) >= 0

fn add_fact_false(c: int):
    if o_cse and stable(c): ht_put(FACT_FALSE, c, 0, c)

# simplify one instruction, appending the result to o_out
fn o_simplify(ins0: Ins, pos: int):
    ins := ins0
    o_rewrite(ins)
    op := ins.op
    d := int(ins.dst)
    a := int(ins.a)
    bb := int(ins.b)
    if op == .iconst:
        if o_ndef[d] == 1 and o_first[d] > o_defpos[d]:
            o_const[d] = true
            o_cval[d] = ins.imm
        o_emit(ins)
        return
    if op == .mov:
        if o_can_alias(d, a):
            o_repl[d] = i32(a)
            if o_const[a]:
                o_const[d] = true
                o_cval[d] = o_cval[a]
            return
        if is_k(a) and vtype(d) == VI:
            o_emit(Ins(.iconst, VI, i32(d), 0, 0, 0, o_cval[a]))
            return
        o_emit(ins)
        return
    if int(ins.ty) != VI or d < 0:
        o_emit(ins)
        return
    # unary integer ops
    if op == .neg or op == .not_ or op == .sext8 or op == .sext16 or op == .sext32 or op == .zext8 or op == .zext16 or op == .zext32:
        if is_k(a):
            ok, v := fold_un(op, o_cval[a])
            if ok:
                o_simplify(Ins(.iconst, VI, i32(d), 0, 0, 0, v), pos)
                return
        o_emit(ins)
        return
    r := fold(op, 0, 1)
    if not r.0 and op != .divu and op != .remu:
        o_emit(ins)
        return
    # binary integer ops
    if is_k(a) and is_k(bb):
        ok, v := fold(op, o_cval[a], o_cval[bb])
        if ok:
            o_simplify(Ins(.iconst, VI, i32(d), 0, 0, 0, v), pos)
            return
    if is_k(a) and not is_k(bb):
        if commutes(op):
            ins.a = i32(bb)
            ins.b = i32(a)
        else if mirror(op) != op:
            ins.op = mirror(op)
            ins.a = i32(bb)
            ins.b = i32(a)
        op = ins.op
        a = int(ins.a)
        bb = int(ins.b)
    if not is_k(bb):
        o_emit(ins)
        return
    k := o_cval[bb]
    # identities: result is a
    if (k == 0 and (op == .add or op == .sub or op == .or_ or op == .xor or op == .shl or op == .shrs or op == .shru)) or (k == 1 and (op == .mul or op == .divs or op == .divu)):
        o_simplify(Ins(.mov, VI, i32(d), i32(a), 0, 0, 0), pos)
        return
    if k == 0 and (op == .mul or op == .and_):
        o_simplify(Ins(.iconst, VI, i32(d), 0, 0, 0, 0), pos)
        return
    if op == .add and stable(a) and o_dop[a] == i32(int(Op.add)) and o_const[int(o_db[a])]:
        o_bin(.add, d, int(o_da[a]), o_kconst(k + o_cval[int(o_db[a])]))
        return
    sh := log2_exact(k)
    if sh > 0:
        if op == .mul:
            o_bin(.shl, d, a, o_kconst(sh))
            return
        if op == .divu:
            o_bin(.shru, d, a, o_kconst(sh))
            return
        if op == .remu:
            o_bin(.and_, d, a, o_kconst(k - 1))
            return
        if op == .divs or op == .rems:
            # round toward zero: add (2^sh - 1) to negative dividends before shifting
            t1 := o_bin(.shrs, o_tmp(), a, o_kconst(63))
            t2 := o_bin(.shru, o_tmp(), t1, o_kconst(64 - sh))
            t3 := o_bin(.add, o_tmp(), a, t2)
            if op == .divs:
                o_bin(.shrs, d, t3, o_kconst(sh))
            else:
                t4 := o_bin(.and_, o_tmp(), t3, o_kconst(-k))
                o_bin(.sub, d, a, t4)
            return
    o_emit(ins)

fn optimize():
    nv := ir.vtypes.len()
    o_resize(nv)
    for p in 0..ir.nparams:
        o_ndef[p] = 1
        o_defpos[p] = -1
    # constant vregs: one canonical vreg per value
    o_kmap.clear()
    for v in 0..ir.kval.len():
        if is_kv(v):
            o_ndef[v] = 1
            o_const[v] = true
            o_cval[v] = ir.kval[v]
            if c := o_kmap.get(ir.kval[v]): o_repl[v] = i32(c)
            else: o_kmap[ir.kval[v]] = v
    for pos, ins in ir.code:
        d := o_operands(ins)
        for u in o_buf:
            if o_first[u] > pos: o_first[u] = i32(pos)
        if d >= 0:
            o_ndef[d] += 1
            o_defpos[d] = i32(pos)
        if ins.op == .zeroslots:
            for k in 0..int(ins.b):
                item := int(ir.args[int(ins.a) + k])
                if item & 1 == 1: o_ndef[item >> 1] += 2
    # forward: fold, propagate copies, eliminate common subexpressions, drop dead branches
    o_out = []
    o_out.reserve(ir.code.len())
    o_cse = true
    ht_setup(ir.code.len() + 16)
    ctl: [int]          # per open construct: 0 normal, 1 if(true), 2 if(false), 3 if(c) with c >= 0 at ctl_c
    ctl_c: [int]        # condition of an open if (-1 otherwise)
    ctl_nbr: [int]      # branch count when the construct was opened
    skip := 0           # nesting depth inside a dead branch
    for pos, ins in ir.code:
        op := ins.op
        if skip > 0:
            if op == .block or op == .loop or op == .if_: skip += 1
            else if op == .else_ and skip == 1 and ctl[ctl.len() - 1] == 2:
                skip = 0
                o_scope_open()
            else if op == .end:
                skip -= 1
                if skip == 0:
                    ctl.pop()
                    ctl_c.pop()
                    ctl_nbr.pop()
                    lop := o_out[o_out.len() - 1].op
                    if lop == .block or lop == .if_: o_out.pop()
                    else: o_out.push(ins)
            continue
        if op == .nop: continue
        if op == .block or op == .loop:
            if op == .loop: kill_all()
            ctl.push(0)
            ctl_c.push(-1)
            ctl_nbr.push(o_nbr)
            o_scope_open()
            o_out.push(ins)
            continue
        if op == .if_:
            c := int(o_repl[int(ins.a)])
            known := o_const[c] or fact_false(c)
            if known:
                # the if becomes a plain block so branch depths inside stay valid
                o_out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
                ctl_c.push(-1)
                ctl_nbr.push(o_nbr)
                if o_const[c] and o_cval[c] != 0:
                    ctl.push(1)
                    o_scope_open()
                else:
                    ctl.push(2)
                    skip = 1
                continue
            ctl.push(0)
            ctl_c.push(c)
            ctl_nbr.push(o_nbr)
            o_scope_open()
            ins2 := ins
            ins2.a = i32(c)
            o_out.push(ins2)
            continue
        if op == .else_:
            ctl_c[ctl_c.len() - 1] = -1
            o_scope_close()
            if ctl[ctl.len() - 1] == 1:
                skip = 1
                continue
            o_scope_open()
            o_out.push(ins)
            continue
        if op == .end:
            # an if whose body never returns (a failed check) leaves its condition known false
            c := ctl_c.pop()
            nbr := ctl_nbr.pop()
            ctl.pop()
            last := o_out[o_out.len() - 1]
            noret := c >= 0 and last.op == .call and last.c == 1 and nbr == o_nbr
            o_scope_close()
            if last.op == .block or last.op == .if_:
                # empty construct: drop it (an if's condition is pure)
                o_out.pop()
                continue
            o_out.push(ins)
            if noret: add_fact_false(c)
            continue
        if op == .zeroslots:
            kill_all()
            o_out.push(ins)
            continue
        o_simplify(ins, pos)
    # backward: drop pure instructions whose results are unused
    nv = ir.vtypes.len()
    for v in 0..nv: o_nuse[v] = 0
    for ins in o_out:
        o_operands(ins)
        for u in o_buf: o_nuse[u] += 1
    keep := [true; o_out.len()]
    i := o_out.len() - 1
    while i >= 0:
        ins := o_out[i]
        if o_pure(ins.op):
            d := int(ins.dst)
            if o_nuse[d] == 0:
                keep[i] = false
                o_operands(ins)
                for u in o_buf: o_nuse[u] -= 1
        i -= 1
    code: [Ins]
    code.reserve(o_out.len())
    for j, ins in o_out:
        if keep[j]: code.push(ins)
    ir.code = o_cleanup(code)

# Final tidying: drop unreachable code after unconditional jumps, branches to the very next
# instruction, and copies of a value that was computed just for the copy (t = a + 1; x = t).
fn o_cleanup(code: [Ins]) -> [Ins]:
    out: [Ins]
    out.reserve(code.len())
    kinds: [Op]          # open constructs
    dead := false
    depth := 0
    for ins in code:
        op := ins.op
        if dead:
            if op == .block or op == .loop or op == .if_:
                depth += 1
                continue
            if op == .end or op == .else_:
                if depth > 0:
                    if op == .end: depth -= 1
                    continue
                dead = false
            else: continue
        if op == .end and out.len() > 0:
            last := out[out.len() - 1]
            if last.op == .br and last.imm == 0 and kinds[kinds.len() - 1] != .loop: out.pop()
        if op == .mov and out.len() > 0:
            last := out[out.len() - 1]
            t := int(ins.a)
            d := int(ins.dst)
            if t != d and int(last.dst) == t and o_nuse[t] == 1 and vtype(t) == vtype(d) and o_retargetable(last.op):
                last.dst = i32(d)
                out[out.len() - 1] = last
                continue
        out.push(ins)
        if op == .block or op == .loop or op == .if_: kinds.push(op)
        else if op == .end: kinds.pop()
        else if op == .br or op == .ret or op == .trap or (op == .call and ins.c == 1):
            dead = true
            depth = 0
    out

# instructions whose result register may be renamed
fn o_retargetable(op: Op) -> bool:
    match op:
        add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, neg, not_, load, mov: true
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: true
        fadd, fsub, fmul, fdiv, fneg, fsqrt, fmin, fmax, ffloor, fceil, fabs, ftrunc: true
        sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, fconst, iconst: true
        _: false
