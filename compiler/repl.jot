# The interactive prompt: `jot` with no file.
#
# The program lives in a session process (lib/std/repl.jot): a program compiled at the start,
# whose main waits for code. This process keeps the compiler's state; for each input it checks
# and compiles just what is new (declarations, statements, the library functions they need for
# the first time) to machine code that calls the session's functions and uses its globals where
# they already are, and sends it there to run. So variables and functions persist, and code runs
# at full speed. An input is first compiled in a copy of this process (fork): if it has errors,
# the compiler's state is as it was. It then runs in a copy of the session: if it panics, the
# session is as it was.

use 'util.jot'
use 'lex.jot'
use 'ast.jot'
use 'parse.jot'
use 'types.jot'
use 'check.jot'
use 'expr.jot'
use 'ir.jot'
use 'lower.jot'
use 'x64.jot'
use 'elf.jot'
use 'main.jot'
use 'ide.jot'

const REPL_REGION = 0x10000000          # where inputs' code goes in the session (within 2 GB of
const REPL_REGION_SIZE = 0x20000000     # its globals: code reaches them by 32-bit offsets)
const REPL_DATA_RESERVE = 64 << 20      # room for globals declared by inputs

repl_mainm = -1
repl_inputs = 0
repl_next = REPL_REGION                 # where the next input's code goes
lf_abs: int[]                           # function (lfunc) -> its address in the session
ro_segs: (int, int, int)[]              # read-only data: (from, to) offsets and their address
ro_shipped = 0
repl_inited: {int: bool} = {}           # library globals initialized in the session
repl_to = -1                            # pipes to and from the session
repl_from = -1

# the session's main: __repl_main in the input module
repl_set_main = ():
    loop i in 0.. and m in modules:
        if m.is_main: repl_mainm = i
    if let s = modules[repl_mainm].names.get(intern("__repl_main")):
        main_fn = get_fn_inst(int(syms[s].decl), [], 0)

# ---- the session ----

repl_start = () -> str:
    src = "__repl_main = (): __repl_serve({REPL_REGION}, {REPL_REGION_SIZE})\n"
    path = "/tmp/jot-cache/repl-{syscall(39)}.bin"
    mkdir("/tmp/jot-cache")
    main_src = "/tmp/jot-cache/<input>"
    ide_texts[main_src] = src
    repl_image = true
    bss_reserve = REPL_DATA_RESERVE
    # (the session's module is the one the inputs add to)
    built = compile(main_src, path)
    if len(built) == 0: return "could not build the session program"
    loop i in 0.. and m in modules:
        if m.is_main: repl_mainm = i
    # (inputs `use` files relative to the current directory)
    cwd = fill(u8(0), 4096)
    n = syscall(79, data(cwd), 4096)
    if n > 0: modules[repl_mainm].dir = str_from_bytes(cwd[..n - 1))
    loop i in [0..lfuncs.len()):
        a = 0
        if i < fn_addr.len() and fn_addr[i] >= 0: a = img_text_addr + fn_addr[i]
        lf_abs.push(a)
    ro_segs.push((0, rodata.len(), img_ro_addr))
    ro_shipped = rodata.len()
    loop g in global_ids:
        if modules[int(globals[g].mod)].is_prelude and global_off.get(g) != none: repl_inited[g] = true
    # start it, with its end of two pipes as fds 3 and 4
    a: i32[] = [-1, -1]
    b: i32[] = [-1, -1]
    syscall(293, data(a), 0)
    syscall(293, data(b), 0)
    pid = syscall(57)
    if pid == 0:
        syscall(33, int(a[0]), 3)
        syscall(33, int(b[1]), 4)
        exec(path, [path])
        syscall(60, 127)
    syscall(3, int(a[0]))
    syscall(3, int(b[1]))
    repl_to = int(a[1])
    repl_from = int(b[0])
    if repl_wait_reply() != 0: return "the session program did not start"
    delete_file(path)
    ""

repl_send = (op: int, addr: int, bytes: u8[]):
    h = [op, addr, bytes.len()]
    __write_fd(repl_to, data(h) as *u8, 24)
    if bytes.len() > 0: __write_fd(repl_to, data(bytes), bytes.len())

# the session's reply to a run (-1: it is gone)
repl_wait_reply = () -> int:
    w = [0]
    got = 0
    loop got < 8:
        r = syscall(0, repl_from, (data(w) as *u8) + got, 8 - got)
        if r <= 0: return -1
        got += r
    # (reap the processes the session left behind)
    st = [0]
    loop syscall(61, -1, data(st), 1, 0) > 0: pass
    w[0]

# ---- compiling an input ----

struct ReplOut:
    show: bool          # the input ends with an expression with a value: show it
    expr_at: int        # (where that expression starts, in the input)
    type: str           # (its type)
    code: u8[]
    entry: int          # the offset of the input's entry point in code
    addr: int           # where the code goes in the session

# compile input text (as input number n); fatal errors end the process (a copy, see repl_check)
repl_compile = (text: str, n: int) -> ReplOut:
    out = ReplOut()
    m = repl_mainm
    fi = files.len()
    files.push(SrcFile("<input>", ".", text))
    decls = parse_file(fi)
    # declaring a name again replaces it (code compiled already keeps the old one)
    loop d in decls:
        k = nodes[d].kind
        if k == .fn_ or k == .struct_ or k == .enum_ or k == .typealias or k == .const_ or k == .vardecl and nodes[d].nlist == 0:
            nm = int(nodes[d].name)
            if modules[m].names.get(nm) != none: modules[m].names.remove(nm)
    n0 = modules[m].inits.len()
    register_decls(m, decls)
    stmts: int[]
    loop i in [n0..modules[m].inits.len()): stmts.push(modules[m].inits[i])
    # check: the statements as a function of their own, and the functions declared
    fb = fns.len()
    ci = new_inst(FK_INIT, m, "input_{n}")
    body = mk(.block, mkpos(fi, 0))
    set_list(body, stmts)
    fns[ci].body = i32(body)
    fns[ci].ret = i32(T_VOID)
    cx = module_ctx[m]
    fns[ci].state = 1
    ctxs[cx].inst = i32(ci)
    mark = scope_mark()
    ctxs[cx].floor = i32(sc_names.len())
    loop s in stmts: check_stmt(s)
    scope_reset(mark)
    zonk_tree(body)
    loop l in fns[ci].locals: locals[l].type = i32(zonk(int(locals[l].type)))
    fns[ci].state = 2
    cx = -1
    loop d in decls:
        if nodes[d].kind == .fn_ and not has_flag(d, NF_EXTERN) and not fn_sig(d).generic: get_fn_inst(d, [], nodes[d].pos)
    k = fb
    loop k < fns.len():
        if fns[k].state == 0 and fns[k].kind == FK_NORMAL: check_fn_body(k)
        k += 1
    # an expression with a value at the end: shown
    if stmts.len() > 0:
        last = stmts[stmts.len() - 1]
        if nodes[last].kind == .exprstmt:
            t = prune(ntype(int(nodes[last].a)))
            if t != 0 and tkind(t) != .void_ and t != T_NEVER:
                out.show = true
                out.expr_at = pos_off(nodes[last].pos)
                out.type = type_str(zonk(t))
    # lower and compile what is new
    lf0 = lfuncs.len()
    init_lf = lf_of_inst(ci)
    code = []
    call_fix = []
    data_fix = []
    stub_fix = []
    elf_syms = []
    pinits: int[]
    i = lf0
    loop true:
        loop i < lfuncs.len():
            if lfuncs[i].kind == LK_INST and fns[lfuncs[i].inst].decl != 0 and has_flag(int(fns[lfuncs[i].inst].decl), NF_EXTERN):
                fx = lfuncs[i].inst
                if len(fns[fx].clib) == 0: fatal(nodes[int(fns[fx].decl)].pos, "extern functions need @lib(\"library.so\") on native targets")
                lower_extern_thunk(i, fx)
                x64_function()
            else:
                lower_function(i)
                x64_function()
            i += 1
        # library globals used for the first time: initialized before the input runs
        decls2: int[]
        loop g in global_ids:
            if modules[int(globals[g].mod)].is_prelude and global_off.get(g) != none and repl_inited.get(g) == none:
                repl_inited[g] = true
                d = int(globals[g].decl)
                if not decls2.contains(d): decls2.push(d)
        if decls2.len() == 0: break
        pi = new_inst(FK_INIT, 0, "input_{n}_lib")
        pb = mk(.block, 0)
        set_list(pb, decls2)
        fns[pi].body = i32(pb)
        fns[pi].ret = i32(T_VOID)
        fns[pi].state = 2
        zonk_tree(pb)
        pinits.push(lf_of_inst(pi))
    # the entry: library globals first (in the order they were found), then the input
    loop code.len() % 16 != 0: b(0xCC)
    out.entry = code.len()
    loop x in [0x48, 0x83, 0xEC, 0x08]: b(x)                     # sub rsp, 8
    loop f in pinits:
        b(0xE8)
        b32(0)
        call_fix.push((code.len() - 4, f))
    b(0xE8)
    b32(0)
    call_fix.push((code.len() - 4, init_lf))
    loop x in [0x48, 0x83, 0xC4, 0x08, 0xC3]: b(x)               # add rsp, 8; ret
    # place it: code, then the new read-only data
    addr = repl_next
    out.addr = addr
    loop lf in [lf0..lfuncs.len()):
        loop lf_abs.len() <= lf: lf_abs.push(0)
        if lf < fn_addr.len() and fn_addr[lf] >= 0: lf_abs[lf] = addr + fn_addr[lf]
    loop code.len() % 16 != 0: b(0)
    ro_at = addr + code.len()
    if rodata.len() > ro_shipped:
        ro_segs.push((ro_shipped, rodata.len(), ro_at))
        loop j in [ro_shipped..rodata.len()): code.push(rodata[j])
        ro_shipped = rodata.len()
    loop f in stub_fix: patch32(f.0, img_text_addr + stub_addr[f.1] - (addr + f.0 + 4))
    loop f in call_fix:
        t = lf_abs[f.1]
        if t == 0: ice("unresolved function {lfuncs[f.1].name}")
        patch32(f.0, t - (addr + f.0 + 4))
    loop f in data_fix:
        t = img_data_addr + f.2
        if f.1 == 0: t = repl_ro_addr(f.2)
        patch32(f.0, t - (addr + f.0 + 4))
    out.code = code
    repl_next = (addr + code.len() + 4095) & ~4095
    out

# the address of read-only data at offset off
repl_ro_addr = (off: int) -> int:
    loop s in ro_segs:
        if off >= s.0 and off < s.1: return s.2 + off - s.0
    ice("read-only data at {off} has no place")
    0

struct ReplCheck:
    ok: bool
    show: bool
    expr_at: int
    type: str

# compile an input in a copy of this process (errors are printed there); what it found
repl_check = (text: str) -> ReplCheck:
    fds: i32[] = [-1, -1]
    syscall(293, data(fds), 0)
    pid = syscall(57)
    if pid == 0:
        syscall(3, int(fds[0]))
        o = repl_compile(text, repl_inputs)
        w = [1, 0, o.expr_at, len(o.type)]
        if o.show: w[1] = 1
        syscall(1, int(fds[1]), data(w), 32)
        if len(o.type) > 0: syscall(1, int(fds[1]), data(o.type), len(o.type))
        syscall(231, 0)
    syscall(3, int(fds[1]))
    w = [0, 0, 0, 0]
    got = syscall(0, int(fds[0]), data(w), 32)
    t = ""
    if got == 32 and w[3] > 0:
        tb = fill(u8(0), w[3])
        if syscall(0, int(fds[0]), data(tb), w[3]) == w[3]: t = str_from_bytes(tb)
    syscall(3, int(fds[0]))
    st = [0]
    syscall(61, pid, data(st), 0, 0)
    if got != 32 or w[0] != 1: return ReplCheck(false, false, 0, "")
    ReplCheck(true, w[1] == 1, w[2], t)

# where the code of a line ends (before a comment)
repl_code_end = (s: str) -> int:
    q: u8 = 0
    i = 0
    loop i < len(s):
        c = s[i]
        if q != 0:
            if c == '\\': i += 1
            else if c == q: q = 0
        else if c == '"' or c == '\'': q = c
        else if c == '#': return i
        i += 1
    len(s)

# run an input: compile (checked first), send, run; false if the session ended
repl_run = (text0: str) -> bool:
    text = text0
    c = repl_check(text)
    if not c.ok: return true
    if c.show:
        # show the value: the last expression becomes __repl_show(expression)
        e = trim_end(text)
        last = e[c.expr_at..]
        code_end = repl_code_end(last)
        shown = e[..c.expr_at) + "__repl_show(" + trim_end(last[..code_end)) + ")\n"
        c2 = repl_check(shown)
        if c2.ok: text = shown
    o = repl_compile(text, repl_inputs)
    repl_inputs += 1
    repl_send(1, o.addr, o.code)
    repl_send(2, o.addr + o.entry, [])
    r = repl_wait_reply()
    if r < 0:
        eprint("the session ended")
        return false
    if r >= 512:
        if r - 512 == 101: return true          # a panic (it said why)
        exit(r - 512)                          # exit() in the input
    if r == 256 + 2: eprint("interrupted; the session is as it was before this input")
    else if r >= 256: eprint("crashed (signal {r - 256}); the session is as it was before this input")
    true

# ---- reading input ----

repl_tty = false
repl_history: str[]
repl_hist_path = ""
__termios_saved: u8[]

repl_raw = (on: bool):
    if not repl_tty: return
    if on:
        t = fill(u8(0), 64)
        syscall(16, 0, 0x5401, data(t))         # TCGETS
        __termios_saved = t
        r = t
        lflag = int(r[12]) | (int(r[13]) << 8)
        lflag = lflag & ~(0x2 | 0x8 | 0x1)      # ICANON, ECHO, ISIG
        r[12] = u8(lflag & 255)
        r[13] = u8((lflag >> 8) & 255)
        iflag = int(r[0]) | (int(r[1]) << 8)
        iflag = iflag & ~(0x100 | 0x400)        # ICRNL, IXON
        r[0] = u8(iflag & 255)
        r[1] = u8((iflag >> 8) & 255)
        r[17 + 6] = 1                           # VMIN
        r[17 + 5] = 0                           # VTIME
        syscall(16, 0, 0x5402, data(r))         # TCSETS
    else if __termios_saved.len() > 0: syscall(16, 0, 0x5402, data(__termios_saved))

repl_out = (s: str): __write_fd(1, data(s), len(s))

repl_getc = () -> int:
    b = [0]
    if syscall(0, 0, data(b), 1) != 1: return -1
    b[0] & 255

# display width of a line's bytes (UTF-8: one column per character)
repl_cols = (s: str, n: int) -> int:
    c = 0
    loop i in [0..min(n, len(s))):
        if s[i] < 0x80 or s[i] >= 0xC0: c += 1
    c

# read a line with editing (arrows, home/end, history, ctrl-a/e/k/u/w/l/c/d); none at the end
repl_edit = (prompt: str, initial: str) -> str?:
    line = initial
    cur = len(line)
    hi = repl_history.len()
    draft = ""
    loop true:
        repl_out("\r{prompt}{line}\x1b[K\r\x1b[{repl_cols(prompt, len(prompt)) + repl_cols(line, cur)}C")
        if len(prompt) + cur == 0: repl_out("\r")
        c = repl_getc()
        if c < 0: return none
        if c == 13 or c == 10:
            repl_out("\r\n")
            return line
        if c == 4:                              # ctrl-d
            if len(line) == 0:
                repl_out("\r\n")
                return none
            if cur < len(line): line = line[..cur) + line[cur + 1..]
        else if c == 3:                         # ctrl-c: drop the line
            repl_out("^C\r\n")
            return "\x03"
        else if c == 127 or c == 8:
            if cur > 0:
                k = cur - 1
                loop k > 0 and line[k] >= 0x80 and line[k] < 0xC0: k -= 1
                line = line[..k) + line[cur..]
                cur = k
        else if c == 1: cur = 0
        else if c == 5: cur = len(line)
        else if c == 11: line = line[..cur)
        else if c == 21:
            line = line[cur..]
            cur = 0
        else if c == 23:                        # ctrl-w: the word before the cursor
            k = cur
            loop k > 0 and line[k - 1] == ' ': k -= 1
            loop k > 0 and line[k - 1] != ' ': k -= 1
            line = line[..k) + line[cur..]
            cur = k
        else if c == 12: repl_out("\x1b[H\x1b[2J")
        else if c == 9:
            if len(trim(line[..cur))) == 0:
                # (at the start of a line: indent)
                line = line[..cur) + "    " + line[cur..]
                cur += 4
            else:
                cands = repl_completions(repl_before + line[..cur))
                a = cur
                loop a > 0 and (is_alnum(line[a - 1]) or line[a - 1] >= 0x80): a -= 1
                typed = line[a..cur)
                common = repl_common(cands)
                if cands.len() == 1: common = cands[0]
                if len(common) > len(typed):
                    line = line[..a) + common + line[cur..]
                    cur = a + len(common)
                else if cands.len() > 1:
                    # list them (in columns)
                    w = 0
                    loop x in cands: w = max(w, len(x))
                    w += 2
                    per = max(1, 78 / w)
                    listing = "\r\n"
                    loop i in 0.. and x in cands:
                        if i >= 200:
                            listing += "... ({cands.len()} in all)"
                            break
                        listing += x + repeat(" ", w - len(x))
                        if i % per == per - 1: listing += "\r\n"
                    repl_out(listing + "\r\n")
        else if c == 27:
            c2 = repl_getc()
            c3 = repl_getc()
            if c2 == '[' or c2 == 'O':
                if c3 == 'D' and cur > 0:
                    cur -= 1
                    loop cur > 0 and line[cur] >= 0x80 and line[cur] < 0xC0: cur -= 1
                else if c3 == 'C' and cur < len(line):
                    cur += 1
                    loop cur < len(line) and line[cur] >= 0x80 and line[cur] < 0xC0: cur += 1
                else if c3 == 'H': cur = 0
                else if c3 == 'F': cur = len(line)
                else if c3 == 'A' and hi > 0:
                    if hi == repl_history.len(): draft = line
                    hi -= 1
                    line = repl_history[hi]
                    cur = len(line)
                else if c3 == 'B' and hi < repl_history.len():
                    hi += 1
                    line = draft
                    if hi < repl_history.len(): line = repl_history[hi]
                    cur = len(line)
                else if c3 >= '0' and c3 <= '9':
                    c4 = repl_getc()
                    if c4 == '~':
                        if c3 == '1' or c3 == '7': cur = 0
                        else if c3 == '4' or c3 == '8': cur = len(line)
                        else if c3 == '3' and cur < len(line): line = line[..cur) + line[cur + 1..]
        else if c >= 32:
            line = line[..cur) + chr(c) + line[cur..]
            cur += 1

# a line from standard input without editing (not a terminal); none at the end
repl_plain = () -> str?:
    out: u8[]
    loop true:
        c = repl_getc()
        if c < 0:
            if out.len() == 0: return none
            return str_from_bytes(out)
        if c == 10: return str_from_bytes(out)
        out.push(u8(c))
    none

# names that could go at the end of text (what is typed of the name being completed is dropped):
# the checker, in a copy of this process, at a placeholder name (as the language server does)
repl_completions = (text: str) -> str[]:
    a = len(text)
    loop a > 0 and (is_alnum(text[a - 1]) or text[a - 1] >= 0x80): a -= 1
    probe = text[..a) + "__jot_complete__\n"
    fds: i32[] = [-1, -1]
    syscall(293, data(fds), 0)
    pid = syscall(57)
    if pid == 0:
        syscall(3, int(fds[0]))
        # (errors and the like go nowhere)
        nul = syscall(2, data("/dev/null\0"), 1, 0)
        syscall(33, nul, 2)
        ide_on = true
        ide_fd = int(fds[1])
        ide_sentinel = intern("__jot_complete__")
        repl_compile(probe, repl_inputs)
        syscall(231, 0)
    syscall(3, int(fds[1]))
    got: u8[]
    buf = fill(u8(0), 65536)
    loop true:
        r = syscall(0, int(fds[0]), data(buf), 65536)
        if r <= 0: break
        loop k in [0..r): got.push(buf[k])
    syscall(3, int(fds[0]))
    st = [0]
    syscall(61, pid, data(st), 0, 0)
    prefix = text[a..]
    out: str[]
    loop l in split(str_from_bytes(got), "\n"):
        if not starts_with(l, "C\t"): continue
        e = find_byte(l, '\t', 2)
        if e < 0: e = len(l)
        name = l[2..e)
        if not starts_with(name, prefix) or out.contains(name): continue
        if starts_with(name, "__") and not starts_with(prefix, "_"): continue
        out.push(name)
    out.sort()
    out

# the longest start all of xs share
repl_common = (xs: str[]) -> str:
    if xs.len() == 0: return ""
    c = xs[0]
    loop x in xs:
        n = 0
        loop n < len(c) and n < len(x) and c[n] == x[n]: n += 1
        c = c[..n)
    c

repl_before = ""          # (the lines of the input typed so far, for completion)

# brackets and strings still open at the end of text
repl_open = (text: str) -> int:
    depth = 0
    q: u8 = 0
    i = 0
    loop i < len(text):
        c = text[i]
        if q != 0:
            if c == '\\': i += 1
            else if c == q: q = 0
        else if c == '"' or c == '\'': q = c
        else if c == '#':
            loop i < len(text) and text[i] != '\n': i += 1
            continue
        else if c == '(' or c == '[' or c == '{{': depth += 1
        else if c == ')' or c == ']' or c == '}}': depth -= 1
        i += 1
    if q != 0: return depth + 1
    depth

# one input: a line, or a block (a line ending with ':' and the indented lines after it, up to
# an empty line), or lines with brackets still open
repl_read = () -> str?:
    text = ""
    indent = ""
    block = false
    loop true:
        prompt = ">>> "
        if len(text) > 0: prompt = "... "
        l: str? = none
        if repl_tty: l = repl_edit(prompt, indent)
        else: l = repl_plain()
        if l == none:
            if len(text) > 0: return text
            return none
        line = l!
        if line == "\x03":
            repl_before = ""
            return ""
        if len(text) == 0 and len(trim(line)) == 0: return ""
        # (history keeps lines, as typed)
        if repl_tty and len(trim(line)) > 0 and (repl_history.len() == 0 or repl_history[repl_history.len() - 1] != line): repl_history.push(line)
        text += line + "\n"
        repl_before = text
        line_code = trim_end(line[..repl_code_end(line)))
        if ends_with(line_code, ":"): block = true
        if repl_open(text) > 0:
            indent = ""
            continue
        if block:
            if len(trim(line)) == 0:
                repl_before = ""
                return text
            # (the next line indented like this one, or more after a ':')
            k = 0
            loop k < len(line) and line[k] == ' ': k += 1
            indent = line[..k)
            if ends_with(line_code, ":"): indent += "    "
            continue
        repl_before = ""
        return text
    none

repl_load_history = ():
    home = env("HOME") ?? ""
    if len(home) == 0: return
    repl_hist_path = "{home}/.jot_history"
    if let h = read_file(repl_hist_path):
        loop l in lines(h):
            if len(l) > 0: repl_history.push(l)

repl_save_history = ():
    if len(repl_hist_path) == 0: return
    keep: str[]
    s = max(0, repl_history.len() - 1000)
    loop i in [s..repl_history.len()): keep.push(repl_history[i])
    write_file(repl_hist_path, join(keep, "\n") + "\n")

# ---- the prompt ----

repl_help = "Type Jot: declarations and statements run as you enter them, and the value of an
expression at the end of an input is shown. A line ending with ':' starts a block (functions,
loops, structs...), and an empty line ends it. Names you declare stay, and declaring one again
replaces it. If an input panics or crashes, everything is as it was before it.
  :type expr   the type of an expression (without running it)
  tab          complete a name (or indent, at the start of a line)
  up, down     earlier lines
  ctrl-c       drop the line, or stop what is running
  ctrl-d, exit leave
"

repl_main = ():
    t = fill(u8(0), 64)
    repl_tty = syscall(16, 0, 0x5401, data(t)) == 0
    # (ctrl-c stops what an input is running, not the prompt)
    act = [1, 0, 0, 0]                             # struct sigaction: SIG_IGN
    syscall(13, 2, data(act), 0, 8)                # rt_sigaction(SIGINT)
    why = repl_start()
    if len(why) > 0:
        eprint("jot: {why}")
        exit(1)
    if repl_tty:
        repl_out("Jot (type an expression or a statement; a line ending with ':' starts a block, an empty line ends it; ctrl-d quits)\n")
        repl_load_history()
    loop true:
        repl_raw(true)
        text0 = repl_read()
        repl_raw(false)
        if text0 == none: break
        text = text0!
        if len(trim(text)) == 0: continue
        t1 = trim(text)
        if t1 == "exit" or t1 == "quit" or t1 == ":q": break
        if t1 == ":help" or t1 == ":h" or t1 == "help":
            repl_out(repl_help)
            continue
        if starts_with(t1, ":type ") or starts_with(t1, ":t "):
            c = repl_check(trim(t1[find_byte(t1, ' ') + 1..]) + "\n")
            if c.ok:
                if c.show: repl_out(c.type + "\n")
                else: repl_out("void\n")
            continue
        if not repl_run(text): break
    repl_save_history()
    repl_send(3, 0, [])
    exit(0)
