# The Jot compiler.
#   jot file.jot [args]     compile and run
#   jot build file.jot [-o out] [--target wasm] [--release]

build:
    opt = release

use util
use lex
use ast
use parse
use types
use check
use expr
use ir
use lower
use opt
use inline
use x64
use elf
use wasm

fn usage():
    eprint("usage: jot file.jot [args...]\n       jot test file.jot\n       jot check file.jot\n       jot build file.jot [-o output] [--target native|wasm] [--release] [--ir]")
    exit(2)

fn find_lib_dir() -> str:
    if e := env("JOT_LIB"):
        if len(e) > 0: return e
    exe := exe_path()
    d := exe
    s := rfind(d, "/")
    if s >= 0: d = d[..s]
    s = rfind(d, "/")
    if s >= 0: d = d[..s]
    if not file_exists("{d}/lib/core/rt.jot"):
        eprint("jot: cannot find the standard library next to {exe} (expected {d}/lib); set JOT_LIB to its location")
        exit(2)
    "{d}/lib"

dump := false
cli_release := false
timing := false

# build options written in the program itself:
#   build:
#       target = wasm
#       output = "game"
build_target := ""
build_output := ""
cli_target := ""

fn scan_build_block(path: str):
    src := read_file(path) ?? ""
    # find a top-level `build:` line, then read its indented lines
    at := -1
    if starts_with(src, "build:"): at = 0
    else:
        k := find(src, "\nbuild:")
        if k >= 0: at = k + 1
    if at < 0: return
    i := find_byte(src, '\n', at)
    while i >= 0 and i < len(src):
        j := find_byte(src, '\n', i + 1)
        if j < 0: j = len(src)
        line := src[i + 1..j]
        i = j
        t := trim(line)
        if len(t) == 0 or t[0] == '#': continue
        if line[0] != ' ' and line[0] != '\t': break
        eq := find(t, "=")
        if eq < 0: continue
        key := trim(t[..eq])
        val := trim(t[eq + 1..])
        h := find(val, "#")
        if h >= 0: val = trim(val[..h])
        if len(val) >= 2 and val[0] == '"': val = val[1..len(val) - 1]
        if key == "target": build_target = val
        else if key == "output": build_output = val
        else if key == "opt":
            if val != "debug" and val != "release":
                eprint("error: build option 'opt' must be debug or release\n")
                exit(1)
            opt_release = val == "release"

fn emit_function():
    if dump: dump_ir()
    if target_wasm: wasm_collect()
    else: x64_function()

# release builds: optimize everything, inline small functions, optimize callers again, emit
fn release_pipeline():
    for k in 0..rel_fns.len():
        ir = rel_fns[k]
        optimize()
        rel_fns[k] = ir
    snap := rel_fns
    can := [false; snap.len()]
    for k, f in snap: can[k] = inlinable(f)
    for k in 0..rel_fns.len():
        ir = rel_fns[k]
        if inline_into(k, snap, can): optimize()
        emit_function()
    rel_fns = []

fn compile(path: str, out0: str) -> str:
    t0 := time()
    scan_build_block(path)
    if cli_release: opt_release = true
    tgt := build_target
    if len(cli_target) > 0: tgt = cli_target
    target_wasm = tgt == "wasm"
    if target_wasm: ptr_size = 4
    out := out0
    if target_wasm and not ends_with(out, ".html"): out = out + ".html"
    init_types()
    check_program(path)
    t1 := time()
    roots: [int]
    for f in init_fns: roots.push(lf_of_inst(f))
    # exports from user code are always kept; library exports only when their module is used
    exp_done := [false; export_fns.len()]
    used_mods: {int: bool} = {}
    for k, f in export_fns:
        if not modules[int(fns[f].mod)].is_prelude:
            lf_of_inst(f)
            exp_done[k] = true
    main_lf := -1
    if main_fn != 0: main_lf = lf_of_inst(main_fn)
    pinit := init_fns[0]
    pinit_lf := roots[0]
    i := 0
    while true:
        while i < lfuncs.len():
            if i == pinit_lf:
                i += 1
                continue
            if lfuncs[i].kind == LK_INST:
                fd := int(fns[lfuncs[i].inst].decl)
                if fd != 0 and nodes[fd].mod != 0 or fd != 0:
                    fm := int(nodes[fd].mod)
                    if used_mods.get(fm) == none:
                        used_mods[fm] = true
                        for k, f in export_fns:
                            if not exp_done[k] and nodes[int(fns[f].decl)].mod == i32(fm):
                                exp_done[k] = true
                                lf_of_inst(f)
            if lfuncs[i].kind == LK_INST and fns[lfuncs[i].inst].decl != 0 and has_flag(int(fns[lfuncs[i].inst].decl), NF_EXTERN):
                fi := lfuncs[i].inst
                if target_wasm:
                    i += 1
                    continue
                if len(fns[fi].clib) == 0: fatal(nodes[int(fns[fi].decl)].pos, "extern functions need @lib(\"library.so\") on native targets")
                lower_extern_thunk(i, fi)
                if dump: dump_ir()
                x64_function()
                i += 1
                continue
            lower_function(i)
            if opt_release: rel_collect()
            else: emit_function()
            i += 1

        # library globals: initialize only the ones compiled code refers to (fixed point)
        nglob := global_off.len()
        decls: [int]
        for g in global_ids:
            if not modules[int(globals[g].mod)].is_prelude or global_off.get(g) == none: continue
            d := int(globals[g].decl)
            if not decls.contains(d): decls.push(d)
        set_list(int(fns[pinit].body), decls)
        nl := lfuncs.len()
        lower_function(pinit_lf)
        if lfuncs.len() > nl or global_off.len() > nglob: continue
        if opt_release: rel_collect()
        else: emit_function()
        break
    if opt_release: release_pipeline()
    t2 := time()
    ok := false
    size := 0
    if target_wasm:
        mod := wasm_module(roots, main_lf, -1)
        size = mod.len()
        title := path
        s := rfind(title, "/")
        if s >= 0: title = title[s + 1..]
        ok = write_html(out, mod, title)
    else:
        x64_stubs()
        entry := x64_entry(roots, main_lf)
        text_off, ro_off, data_off := elf_layout(code.len(), rodata.len())
        x64_resolve(ELF_BASE + text_off, ELF_BASE + ro_off, ELF_BASE + data_off)
        ok = write_elf(out, code, entry, rodata, data_size + 8)
        size = code.len()
    t3 := time()
    if timing:
        eprint("check {(t1 - t0) * 1000.0:.1} ms, lower+codegen {(t2 - t1) * 1000.0:.1} ms, write {(t3 - t2) * 1000.0:.1} ms; {lfuncs.len()} functions, {nodes.len()} nodes, {size} bytes of code")
    if not ok: return ""
    out

fn main():
    a := args()
    if a.len() < 2: usage()
    lib_dir = find_lib_dir()
    if a[1] == "build":
        if a.len() < 3: usage()
        path := ""
        out := ""
        i := 2
        while i < a.len():
            x := a[i]
            if x == "-o" and i + 1 < a.len():
                out = a[i + 1]
                i += 1
            else if x == "--target" and i + 1 < a.len():
                cli_target = a[i + 1]
                i += 1
            else if x == "--ir": dump = true
            else if x == "--release": cli_release = true
            else if x == "--time": timing = true
            else: path = x
            i += 1
        if len(path) == 0: usage()
        if len(out) == 0:
            out = path
            if ends_with(out, ".jot"): out = out[..len(out) - 4]
        if len(compile(path, out)) == 0: exit(1)
        return
    if a[1] == "check":
        # type check only
        if a.len() < 3: usage()
        scan_build_block(a[2])
        target_wasm = build_target == "wasm"
        if target_wasm: ptr_size = 4
        init_types()
        check_program(a[2])
        return
    first := 1
    if a[1] == "test":
        if a.len() < 3: usage()
        test_mode = true
        cli_target = "native"         # tests run natively even for web games
        first = 2
    path := a[first]
    mkdir("/tmp/jot-cache")
    base := path
    s := rfind(base, "/")
    if s >= 0: base = base[s + 1..]
    if test_mode: base = base + ".test"
    built := compile(path, "/tmp/jot-cache/{base}.bin")
    if len(built) == 0: exit(1)
    if target_wasm:
        # open the page in the default browser
        exec("/usr/bin/xdg-open", ["xdg-open", built])
        eprint("jot: built {built}; open it in a browser")
        exit(0)
    run_args := [built]
    for i in first + 1..a.len(): run_args.push(a[i])
    exec(built, run_args)
    eprint("jot: failed to run {built}")
    exit(1)
