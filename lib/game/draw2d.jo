# 2D drawing: batched shapes, textured sprites, SDF text, transforms, blend modes and
# render targets. Coordinates are in pixels with (0, 0) at the top-left.

struct Texture:
    id: int
    width: int
    height: int

struct RenderTarget:
    texture: Texture
    fbo: int
    depth: int

enum Blend: alpha, add, multiply, premultiplied

const __VFLOATS = 9          # x, y, u, v, r, g, b, a, mode (0 color/texture, 1 sdf text)
const __BATCH_MAX = 16384

__g_init = false
__b_buf: *f32 = null
__b_count = 0
__b_tex = 0
__b_vbo = 0
__b_vao = 0
__b_prog = 0
__b_loc_proj = 0
__b_loc_tex = 0
__white = Texture(0, 1, 1)
__default_font = Font(Texture(0, 1, 1), {}, fill(-1, 128), [], 16, 48.0, 34.0, 36.0, 6.0)
__font = __default_font          # the one text() draws with (set_font)
__proj = mat4()
__xform = mat4()
__xform_stack: mat4[]
__target_w = 0          # pixels of the current target
__target_h = 0
__view_w = 0.0          # its size in 2D drawing units
__view_h = 0.0
__cur_target = -1
__blend = Blend.alpha

const __VS2D = r"""
#version 300 es
precision highp float;
layout(location=0) in vec2 a_pos;
layout(location=1) in vec2 a_uv;
layout(location=2) in vec4 a_color;
layout(location=3) in float a_mode;
uniform mat4 u_proj;
out vec2 v_uv;
out vec4 v_color;
out float v_mode;
void main() {
    v_uv = a_uv;
    v_color = a_color;
    v_mode = a_mode;
    gl_Position = u_proj * vec4(a_pos, 0.0, 1.0);
}
"""

const __FS2D = r"""
#version 300 es
precision highp float;
in vec2 v_uv;
in vec4 v_color;
in float v_mode;
uniform sampler2D u_tex;
out vec4 frag;
void main() {
    vec4 t = texture(u_tex, v_uv);
    if (v_mode > 0.5) {
        float d = t.r;
        float w = max(fwidth(d), 0.02);
        float a = smoothstep(0.5 - w, 0.5 + w, d);
        frag = vec4(v_color.rgb, v_color.a * a);
    } else {
        frag = t * v_color;
    }
}
"""

__gfx_init = ():
    if __g_init: return
    __g_init = true
    __b_prog = gl_create_program(__VS2D, __FS2D)
    __b_loc_proj = gl_uniform_location(__b_prog, "u_proj")
    __b_loc_tex = gl_uniform_location(__b_prog, "u_tex")
    __b_buf = __alloc(__BATCH_MAX * __VFLOATS * 4) as *f32
    __b_vao = gl_create_vertex_array()
    glBindVertexArray(u32(__b_vao))
    __b_vbo = gl_create_buffer()
    glBindBuffer(GL_ARRAY_BUFFER, u32(__b_vbo))
    glBufferData(GL_ARRAY_BUFFER, __BATCH_MAX * __VFLOATS * 4, null, GL_DYNAMIC_DRAW)
    stride = __VFLOATS * 4
    glEnableVertexAttribArray(0)
    glVertexAttribPointer(0, 2, GL_FLOAT, 0, i32(stride), 0)
    glEnableVertexAttribArray(1)
    glVertexAttribPointer(1, 2, GL_FLOAT, 0, i32(stride), 8)
    glEnableVertexAttribArray(2)
    glVertexAttribPointer(2, 4, GL_FLOAT, 0, i32(stride), 16)
    glEnableVertexAttribArray(3)
    glVertexAttribPointer(3, 1, GL_FLOAT, 0, i32(stride), 32)
    glBindVertexArray(0)
    white = image(1, 1, vec4(1, 1, 1, 1))
    __white = texture(white)
    # default font (signed distance field atlas)
    font_img = load_image(embed("assets/font.png"))
    meta = lines(str_from_bytes(embed("assets/font.txt")))
    head = words(meta[0])
    f = Font(texture(font_img, true), {}, fill(-1, 128), [], to_int(head[1]) ?? 16, to_float(head[0]) ?? 48.0, to_float(head[5]) ?? 34.0, to_float(head[3]) ?? 36.0, to_float(head[4]) ?? 6.0)
    loop i in 0.. and a in words(meta[1]):
        f.adv.push(to_float(a) ?? 10.0)
        f.slots[32 + i] = i
        f.ascii[32 + i] = i
    same = __font.texture.id == __default_font.texture.id
    __default_font = f
    if same: __font = f

__gfx_begin_frame = ():
    __gfx_init()
    __screen_layout()
    __canvas_begin()
    __cur_target = -1
    __set_screen_target()
    __bind_screen()
    __xform = mat4()
    __xform_stack.clear()
    __apply_blend(.alpha)
    glDisable(GL_DEPTH_TEST)
    glDisable(GL_CULL_FACE)
    __post_begin()

__gfx_end_frame = ():
    __render3d()
    flush()
    __post_end()
    __canvas_end()

# a render target: 2D units are its pixels
__set_target_size = (w: int, h: int):
    __target_w = w
    __target_h = h
    __view_w = f64(w)
    __view_h = f64(h)
    __proj = orthographic(0.0, f64(w), f64(h), 0.0, -1.0, 1.0)

# the screen: 2D units are the size the program asked for in window(), mapped to the window as
# screen.jo says (by default scaled uniformly to fit and centered, showing more around it)
__set_screen_target = ():
    __target_w = __screen_px_w()
    __target_h = __screen_px_h()
    u = __screen_units()
    __view_w = __units_w
    __view_h = __units_h
    __proj = orthographic(f64(u.x), f64(u.z), f64(u.w), f64(u.y), -1.0, 1.0)

# the pixels of what stands for the screen: the window, or the canvas this frame
__screen_px_w = () -> int:
    if __canvas_active: return __canvas_w
    __win_w
__screen_px_h = () -> int:
    if __canvas_active: return __canvas_h
    __win_h

__bind_screen = ():
    if __canvas_active: glBindFramebuffer(GL_FRAMEBUFFER, u32(__canvas_rt.fbo))
    else: glBindFramebuffer(GL_FRAMEBUFFER, 0)
    glViewport(0, 0, i32(__screen_px_w()), i32(__screen_px_h()))

# bind what is being drawn to (after something else was bound)
__bind_current = ():
    if __cur_target >= 0:
        glBindFramebuffer(GL_FRAMEBUFFER, u32(__cur_target))
        glViewport(0, 0, i32(__target_w), i32(__target_h))
    else: __bind_screen()

# ---------------- textures ----------------
# upload an image to the GPU
texture = (img: Image, smooth: bool = true) -> Texture:
    __gfx_init_gl_only()
    id = gl_create_texture()
    glBindTexture(GL_TEXTURE_2D, u32(id))
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1)
    gl_tex_image(img.width, img.height, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, data(img.pixels), img.pixels.len())
    f = GL_NEAREST
    if smooth: f = GL_LINEAR
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, i32(f))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, i32(f))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, i32(GL_CLAMP_TO_EDGE))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, i32(GL_CLAMP_TO_EDGE))
    Texture(id, img.width, img.height)

__gfx_init_gl_only = ():
    if not __win_open: window(__win_title, __win_w, __win_h)

set_repeat = (t: Texture, on: bool):
    glBindTexture(GL_TEXTURE_2D, u32(t.id))
    m = GL_CLAMP_TO_EDGE
    if on: m = GL_REPEAT
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, i32(m))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, i32(m))

update_texture = (t: Texture, img: Image):
    flush()
    glBindTexture(GL_TEXTURE_2D, u32(t.id))
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1)
    gl_tex_sub_image(0, 0, img.width, img.height, GL_RGBA, GL_UNSIGNED_BYTE, data(img.pixels), img.pixels.len())

load_texture = (file: u8[], smooth: bool = true) -> Texture: texture(load_image(file), smooth)

# ---------------- render targets ----------------
__targets: RenderTarget[]

render_target = (w: int, h: int, smooth: bool = true) -> RenderTarget:
    __gfx_init_gl_only()
    tex = texture(image(w, h), smooth)
    fbo = gl_create_framebuffer()
    glBindFramebuffer(GL_FRAMEBUFFER, u32(fbo))
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(tex.id), 0)
    rb = gl_create_renderbuffer()
    glBindRenderbuffer(GL_RENDERBUFFER, u32(rb))
    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, i32(w), i32(h))
    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, u32(rb))
    when TARGET != "wasm":
        if __soft: __sw_scale_target(fbo, w, h)
    if __g_init: __bind_current()
    else: glBindFramebuffer(GL_FRAMEBUFFER, 0)
    RenderTarget(tex, fbo, rb)

# give back a render target's memory (it may not be used after)
free_render_target = (rt: RenderTarget):
    if rt.texture.id != 0: gl_delete_texture(rt.texture.id)
    if rt.fbo != 0: gl_delete_framebuffer(rt.fbo)
    if rt.depth != 0: gl_delete_renderbuffer(rt.depth)

# draw into a render target until draw_to_screen() is called
draw_to = (rt: RenderTarget):
    flush()
    glBindFramebuffer(GL_FRAMEBUFFER, u32(rt.fbo))
    glViewport(0, 0, i32(rt.texture.width), i32(rt.texture.height))
    __set_target_size(rt.texture.width, rt.texture.height)
    __cur_target = rt.fbo

draw_to_screen = ():
    flush()
    __cur_target = -1
    __set_screen_target()
    __bind_screen()

# ---------------- state ----------------
clear = (c: vec4 = vec4(0, 0, 0, 1)):
    flush()
    glClearColor(c.x, c.y, c.z, c.w)
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)

__apply_blend = (b: Blend):
    glEnable(GL_BLEND)
    match b:
        alpha: glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA)
        add: glBlendFunc(GL_SRC_ALPHA, GL_ONE)
        multiply: glBlendFunc(GL_DST_COLOR, GL_ONE_MINUS_SRC_ALPHA)
        premultiplied: glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA)
    __blend = b

blend = (b: Blend):
    if b == __blend: return
    flush()
    __apply_blend(b)

push_transform = (): __xform_stack.push(__xform)
pop_transform = ():
    if __xform_stack.len() > 0: __xform = __xform_stack.pop()
translate = (x: f64, y: f64): __xform = __xform * translation(vec3(f32(x), f32(y), 0))
rotate = (angle: f64): __xform = __xform * rotation_z(angle)
scale = (sx: f64, sy: f64): __xform = __xform * scaling(vec3(f32(sx), f32(sy), 1))
reset_transform = (): __xform = mat4()

# 2D camera: `target` appears at the screen center, scaled by zoom
camera2d = (target: vec2, zoom: f64 = 1.0, angle: f64 = 0.0):
    __xform = mat4()
    translate(__view_w / 2.0, __view_h / 2.0)
    rotate(angle)
    scale(zoom, zoom)
    translate(-f64(target.x), -f64(target.y))

# convert a screen position to world coordinates under the current transform
screen_to_world = (p: vec2) -> vec2:
    w = inverse(__xform) * vec4(p, 0, 1)
    vec2(w.x, w.y)

# ---------------- batching ----------------
flush = ():
    if __b_count == 0: return
    when TARGET != "wasm":
        if __soft:
            __sw_draw2d(__b_buf, __b_count, __proj, __b_tex)
            __b_count = 0
            return
    glUseProgram(u32(__b_prog))
    glUniformMatrix4fv(i32(__b_loc_proj), 1, 0, (&__proj) as *u8)
    glActiveTexture(GL_TEXTURE0)
    glBindTexture(GL_TEXTURE_2D, u32(__b_tex))
    glUniform1i(i32(__b_loc_tex), 0)
    glBindVertexArray(u32(__b_vao))
    glBindBuffer(GL_ARRAY_BUFFER, u32(__b_vbo))
    glBufferSubData(GL_ARRAY_BUFFER, 0, __b_count * __VFLOATS * 4, __b_buf as *u8)
    glDrawArrays(GL_TRIANGLES, 0, i32(__b_count))
    glBindVertexArray(0)
    __b_count = 0

__use_tex = (id: int, nverts: int):
    if __draws.len() > 0: __render3d()
    if id != __b_tex or __b_count + nverts > __BATCH_MAX:
        flush()
        __b_tex = id

__v = (p: vec2, uv: vec2, c: vec4, mode: f32):
    q = __xform * vec4(p, 0, 1)
    o = __b_buf + __b_count * __VFLOATS
    o[0] = q.x
    o[1] = q.y
    o[2] = uv.x
    o[3] = uv.y
    o[4] = c.x
    o[5] = c.y
    o[6] = c.z
    o[7] = c.w
    o[8] = mode
    __b_count += 1

__quad = (a: vec2, b: vec2, c: vec2, d: vec2, ua: vec2, ub: vec2, uc: vec2, ud: vec2, col: vec4, mode: f32):
    __v(a, ua, col, mode)
    __v(b, ub, col, mode)
    __v(c, uc, col, mode)
    __v(a, ua, col, mode)
    __v(c, uc, col, mode)
    __v(d, ud, col, mode)

# ---------------- shapes ----------------
rect = (x: f64, y: f64, w: f64, h: f64, c: vec4):
    __use_tex(__white.id, 6)
    z = vec2(0, 0)
    __quad(vec2(f32(x), f32(y)), vec2(f32(x + w), f32(y)), vec2(f32(x + w), f32(y + h)), vec2(f32(x), f32(y + h)), z, z, z, z, c, 0)

rect = (pos: vec2, size: vec2, c: vec4): rect(f64(pos.x), f64(pos.y), f64(size.x), f64(size.y), c)

# rectangle with a vertical color gradient
rect_gradient = (x: f64, y: f64, w: f64, h: f64, top: vec4, bottom: vec4):
    __use_tex(__white.id, 6)
    z = vec2(0, 0)
    a = vec2(f32(x), f32(y))
    b = vec2(f32(x + w), f32(y))
    cc = vec2(f32(x + w), f32(y + h))
    d = vec2(f32(x), f32(y + h))
    __v(a, z, top, 0)
    __v(b, z, top, 0)
    __v(cc, z, bottom, 0)
    __v(a, z, top, 0)
    __v(cc, z, bottom, 0)
    __v(d, z, bottom, 0)

rect_outline = (x: f64, y: f64, w: f64, h: f64, thickness: f64, c: vec4):
    rect(x, y, w, thickness, c)
    rect(x, y + h - thickness, w, thickness, c)
    rect(x, y + thickness, thickness, h - 2.0 * thickness, c)
    rect(x + w - thickness, y + thickness, thickness, h - 2.0 * thickness, c)

triangle = (a: vec2, b: vec2, c: vec2, col: vec4):
    __use_tex(__white.id, 3)
    z = vec2(0, 0)
    __v(a, z, col, 0)
    __v(b, z, col, 0)
    __v(c, z, col, 0)

# triangle with a color per corner (colors blend across it)
triangle_gradient = (a: vec2, b: vec2, c: vec2, ca: vec4, cb: vec4, cc: vec4):
    __use_tex(__white.id, 3)
    z = vec2(0, 0)
    __v(a, z, ca, 0)
    __v(b, z, cb, 0)
    __v(c, z, cc, 0)

# quad (a, b, c, d in order around it) with a color per corner
quad_gradient = (a: vec2, b: vec2, c: vec2, d: vec2, ca: vec4, cb: vec4, cc: vec4, cd: vec4):
    __use_tex(__white.id, 6)
    z = vec2(0, 0)
    __v(a, z, ca, 0)
    __v(b, z, cb, 0)
    __v(c, z, cc, 0)
    __v(a, z, ca, 0)
    __v(c, z, cc, 0)
    __v(d, z, cd, 0)

circle = (center: vec2, radius: f64, c: vec4, segments: int = 0):
    n = segments
    if n <= 0: n = clamp(int(radius * 0.8) + 12, 12, 96)
    __use_tex(__white.id, n * 3)
    z = vec2(0, 0)
    prev = center + vec2(f32(radius), 0)
    loop i in [1..n + 1):
        a = TAU * f64(i) / f64(n)
        p = center + vec2(f32(cos(a) * radius), f32(sin(a) * radius))
        __v(center, z, c, 0)
        __v(prev, z, c, 0)
        __v(p, z, c, 0)
        prev = p

# circle that fades from `inner` color at the center to `outer` at the edge (glows, soft lights)
circle_gradient = (center: vec2, radius: f64, inner: vec4, outer: vec4, segments: int = 48):
    __use_tex(__white.id, segments * 3)
    z = vec2(0, 0)
    prev = center + vec2(f32(radius), 0)
    loop i in [1..segments + 1):
        a = TAU * f64(i) / f64(segments)
        p = center + vec2(f32(cos(a) * radius), f32(sin(a) * radius))
        __v(center, z, inner, 0)
        __v(prev, z, outer, 0)
        __v(p, z, outer, 0)
        prev = p

ring = (center: vec2, radius: f64, thickness: f64, c: vec4, segments: int = 48):
    __use_tex(__white.id, segments * 6)
    z = vec2(0, 0)
    r0 = radius - thickness / 2.0
    r1 = radius + thickness / 2.0
    loop i in [0..segments):
        a0 = TAU * f64(i) / f64(segments)
        a1 = TAU * f64(i + 1) / f64(segments)
        d0 = vec2(f32(cos(a0)), f32(sin(a0)))
        d1 = vec2(f32(cos(a1)), f32(sin(a1)))
        __quad(center + d0 * f32(r0), center + d0 * f32(r1), center + d1 * f32(r1), center + d1 * f32(r0), z, z, z, z, c, 0)

# part of a ring: from angle `start` to `stop` (radians, clockwise on screen)
arc = (center: vec2, radius: f64, thickness: f64, start: f64, stop: f64, c: vec4, segments: int = 0):
    n = segments
    if n <= 0: n = clamp(int(abs(stop - start) * radius / 6.0) + 2, 2, 128)
    __use_tex(__white.id, n * 6)
    z = vec2(0, 0)
    r0 = radius - thickness / 2.0
    r1 = radius + thickness / 2.0
    loop i in [0..n):
        a0 = start + (stop - start) * f64(i) / f64(n)
        a1 = start + (stop - start) * f64(i + 1) / f64(n)
        d0 = vec2(f32(cos(a0)), f32(sin(a0)))
        d1 = vec2(f32(cos(a1)), f32(sin(a1)))
        __quad(center + d0 * f32(r0), center + d0 * f32(r1), center + d1 * f32(r1), center + d1 * f32(r0), z, z, z, z, c, 0)

line = (a: vec2, b: vec2, thickness: f64, c: vec4):
    d = b - a
    l = length(d)
    if l == 0.0: return
    n = perp(d / l) * f32(thickness / 2.0)
    __use_tex(__white.id, 6)
    z = vec2(0, 0)
    __quad(a + n, b + n, b - n, a - n, z, z, z, z, c, 0)

polyline = (points: vec2[], thickness: f64, c: vec4, closed: bool = false):
    loop i in [0..points.len() - 1): line(points[i], points[i + 1], thickness, c)
    if closed and points.len() > 2: line(points[points.len() - 1], points[0], thickness, c)

# convex polygon (triangle fan)
polygon = (points: vec2[], c: vec4):
    if points.len() < 3: return
    __use_tex(__white.id, (points.len() - 2) * 3)
    z = vec2(0, 0)
    loop i in [1..points.len() - 1):
        __v(points[0], z, c, 0)
        __v(points[i], z, c, 0)
        __v(points[i + 1], z, c, 0)

# ---------------- sprites ----------------
# draw a texture at `pos` (top-left), optionally scaled, rotated around its center and tinted
sprite = (t: Texture, pos: vec2, size: vec2 = vec2(0, 0), tint: vec4 = vec4(1, 1, 1, 1), angle: f64 = 0.0):
    sz = size
    if sz.x == 0.0 and sz.y == 0.0: sz = vec2(f32(t.width), f32(t.height))
    sprite_region(t, vec4(0, 0, f32(t.width), f32(t.height)), pos + sz * 0.5, sz, tint, angle)

# draw part of a texture (src = x, y, w, h in pixels) centered at `center`
sprite_region = (t: Texture, src: vec4, center: vec2, size: vec2, tint: vec4 = vec4(1, 1, 1, 1), angle: f64 = 0.0):
    __use_tex(t.id, 6)
    tw = f32(t.width)
    th = f32(t.height)
    u0 = src.x / tw
    v0 = src.y / th
    u1 = (src.x + src.z) / tw
    v1 = (src.y + src.w) / th
    h = size * 0.5
    a = vec2(-h.x, -h.y)
    b = vec2(h.x, -h.y)
    c = vec2(h.x, h.y)
    d = vec2(-h.x, h.y)
    if angle != 0.0:
        a = rotate(a, angle)
        b = rotate(b, angle)
        c = rotate(c, angle)
        d = rotate(d, angle)
    __quad(center + a, center + b, center + c, center + d, vec2(u0, v0), vec2(u1, v0), vec2(u1, v1), vec2(u0, v1), tint, 0)

# draw a render target's texture (flipped: render targets are stored bottom-up)
draw_target = (rt: RenderTarget, pos: vec2 = vec2(0, 0), size: vec2 = vec2(0, 0), tint: vec4 = vec4(1, 1, 1, 1)):
    t = rt.texture
    sz = size
    if sz.x == 0.0: sz = vec2(f32(t.width), f32(t.height))
    __use_tex(t.id, 6)
    __quad(pos, pos + vec2(sz.x, 0), pos + sz, pos + vec2(0, sz.y), vec2(0, 1), vec2(1, 1), vec2(1, 0), vec2(0, 0), tint, 0)

# ---------------- text ----------------
# the font text() and text_width() use (load_font makes one); set_font() goes back to the built-in
set_font = (f: Font): __font = f
set_font = ():
    __gfx_init()
    __font = __default_font

# (the code point at s[i], and where the next one starts: UTF-8)
__next_char = (s: str, i: int) -> (int, int):
    c = int(s[i])
    if c < 0x80: return (c, i + 1)
    n = 0
    if c >= 0xF0:
        c = c & 7
        n = 3
    else if c >= 0xE0:
        c = c & 15
        n = 2
    else if c >= 0xC0:
        c = c & 31
        n = 1
    else: return (0xFFFD, i + 1)
    j = i + 1
    loop n > 0 and j < len(s):
        c = (c << 6) | (int(s[j]) & 63)
        j += 1
        n -= 1
    (c, j)

# a character's cell in the font (-1: it has none)
__glyph = (f: Font, c: int) -> int:
    if c < 128: return f.ascii[c]
    f.slots.get(c, -1)

text_width = (s: str, size: f64 = 20.0) -> f64:
    __gfx_init()
    k = size / __font.px
    w = 0.0
    i = 0
    loop i < len(s):
        r = __next_char(s, i)
        i = r.1
        g = __glyph(__font, r.0)
        if g < 0 and r.0 >= 32: g = __glyph(__font, '?')
        if g >= 0: w += __font.adv[g] * k
    w

# draw text with its top-left corner at `pos` (characters the font does not have show as ?)
text = (s: str, pos: vec2, size: f64 = 20.0, color: vec4 = vec4(1, 1, 1, 1)):
    __gfx_init()
    f = __font
    __use_tex(f.texture.id, len(s) * 6)
    k = f32(size / f.px)
    cell = f32(f.cell)
    pad = f32(f.spread)
    atlas_w = f32(f.texture.width)
    atlas_h = f32(f.texture.height)
    x = pos.x
    y = pos.y + f32(size * 0.82) - f32(f.base) * k
    i = 0
    loop i < len(s):
        r = __next_char(s, i)
        i = r.1
        c = r.0
        if c == '\n':
            x = pos.x
            y += f32(size * 1.25)
            continue
        if c < 32: continue
        g = __glyph(f, c)
        if g < 0: g = __glyph(f, '?')
        if g < 0: continue
        if c != ' ':
            col = f32(g % f.cols)
            row = f32(g / f.cols)
            u0 = col * cell / atlas_w
            v0 = row * cell / atlas_h
            u1 = (col + 1.0) * cell / atlas_w
            v1 = (row + 1.0) * cell / atlas_h
            x0 = x - pad * k
            y0 = y
            s_ = cell * k
            __quad(vec2(x0, y0), vec2(x0 + s_, y0), vec2(x0 + s_, y0 + s_), vec2(x0, y0 + s_), vec2(u0, v0), vec2(u1, v0), vec2(u1, v1), vec2(u0, v1), color, 1)
        x += f32(f.adv[g]) * k

# text centered on `center` (horizontally and vertically)
text_centered = (s: str, center: vec2, size: f64 = 20.0, color: vec4 = vec4(1, 1, 1, 1)):
    text(s, center - vec2(f32(text_width(s, size) / 2.0), f32(size / 2.0)), size, color)
