# Windows, the frame loop and input. Native: X11 + EGL (OpenGL ES 3) loaded from the
# system at runtime. Web: a <canvas> with WebGL2 driven by requestAnimationFrame.

enum Key:
    unknown, a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w, x, y, z,
    n0, n1, n2, n3, n4, n5, n6, n7, n8, n9,
    space, enter, escape, tab, backspace, delete, insert, home, end, page_up, page_down,
    left, right, up, down, shift, ctrl, alt, super,
    f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12,
    minus, equals, comma, period, slash, semicolon, quote, lbracket, rbracket, backslash, grave

enum Mouse: left, middle, right

const __NKEYS = 128

__win_open = false
__win_w = 1280
__win_h = 720
__win_title = "jot"
__win_close = false
__key_down: bool[]
__key_pressed: bool[]
__key_released: bool[]
__mouse_x = 0.0
__mouse_y = 0.0
__mouse_dx = 0.0
__mouse_dy = 0.0
__mouse_wheel = 0.0
__mouse_btn: bool[]
__mouse_pressed: bool[]
__mouse_released: bool[]
__text_input = ""
__time0 = 0.0
__fixed_step = false          # screenshot runs advance exactly 1/60 s per frame
__frame_count = 0
__dt = 0.0
__fps = 0.0

__input_init = ():
    if __key_down.len() == 0:
        __key_down = fill(false, __NKEYS)
        __key_pressed = fill(false, __NKEYS)
        __key_released = fill(false, __NKEYS)
        __mouse_btn = fill(false, 8)
        __mouse_pressed = fill(false, 8)
        __mouse_released = fill(false, 8)

__key_event = (k: int, down: bool):
    if k <= 0 or k >= __NKEYS: return
    if down:
        if not __key_down[k]: __key_pressed[k] = true
        __key_down[k] = true
    else:
        if __key_down[k]: __key_released[k] = true
        __key_down[k] = false

__mouse_event = (b: int, down: bool):
    if b < 0 or b >= 8: return
    if down:
        if not __mouse_btn[b]: __mouse_pressed[b] = true
        __mouse_btn[b] = true
    else:
        if __mouse_btn[b]: __mouse_released[b] = true
        __mouse_btn[b] = false

__input_end_frame = ():
    loop mut x in __key_pressed: x = false
    loop mut x in __key_released: x = false
    loop mut x in __mouse_pressed: x = false
    loop mut x in __mouse_released: x = false
    __mouse_dx = 0.0
    __mouse_dy = 0.0
    __mouse_wheel = 0.0
    __text_input = ""

# ---------------- public input API ----------------
# true while the key is held
key_down = (k: Key) -> bool:
    __input_init()
    __key_down[int(k)]
# true only in the frame the key was pressed
key_pressed = (k: Key) -> bool:
    __input_init()
    __key_pressed[int(k)]
key_released = (k: Key) -> bool:
    __input_init()
    __key_released[int(k)]
# (in the 2D units of the screen: see screen_size)
mouse_pos = () -> vec2:
    s = __view_scale()
    vec2(__mouse_x / s - (f64(__win_w) / s - f64(__design_w)) / 2.0, __mouse_y / s - (f64(__win_h) / s - f64(__design_h)) / 2.0)
mouse_delta = () -> vec2: vec2(__mouse_dx / __view_scale(), __mouse_dy / __view_scale())
mouse_wheel = () -> f64: __mouse_wheel
mouse_down = (b: Mouse) -> bool:
    __input_init()
    __mouse_btn[int(b)]
mouse_pressed = (b: Mouse) -> bool:
    __input_init()
    __mouse_pressed[int(b)]
mouse_released = (b: Mouse) -> bool:
    __input_init()
    __mouse_released[int(b)]
# characters typed this frame
text_input = () -> str: __text_input

# arrows/WASD (or a gamepad's left stick and d-pad) as a direction vector (y down)
input_axis = () -> vec2:
    v = vec2(0, 0)
    if key_down(.left) or key_down(.a) or gamepad_down(.left): v.x -= 1
    if key_down(.right) or key_down(.d) or gamepad_down(.right): v.x += 1
    if key_down(.up) or key_down(.w) or gamepad_down(.up): v.y -= 1
    if key_down(.down) or key_down(.s) or gamepad_down(.down): v.y += 1
    s = left_stick()
    if length(s) > length(v): v = s
    v

# The screen's size in 2D drawing units: the size given to window(), whatever the window's real
# size (2D drawing is scaled to fit it, centered; 3D uses all of it). pixel_size() is the real size.
screen_width = () -> int: __design_w
screen_height = () -> int: __design_h
screen_size = () -> vec2: vec2(f32(__design_w), f32(__design_h))
pixel_size = () -> vec2: vec2(f32(__win_w), f32(__win_h))
# the part of the 2D plane the screen shows, as (x, y, width, height): the area of screen_size()
# centered in a window of any shape (draw backgrounds over this to fill the window)
visible_rect = () -> vec4:
    s = __view_scale()
    w = f64(__win_w) / s
    h = f64(__win_h) / s
    vec4(f32((f64(__design_w) - w) / 2.0), f32((f64(__design_h) - h) / 2.0), f32(w), f32(h))

__design_w = 1280
__design_h = 720
# window pixels per 2D unit
__view_scale = () -> f64:
    if __design_w <= 0 or __design_h <= 0 or __win_w <= 0 or __win_h <= 0: return 1.0
    min(f64(__win_w) / f64(__design_w), f64(__win_h) / f64(__design_h))
frame_time = () -> f64: __dt
fps = () -> f64: __fps
elapsed = () -> f64:
    if __fixed_step: return f64(__frame_count) / 60.0
    time() - __time0
frame_number = () -> int: __frame_count
quit = (): __win_close = true

# Open the game window (called automatically when the program defines update/draw).
window = (title: str = "jot", width: int = 1280, height: int = 720):
    __input_init()
    if __win_open:
        # already opened (e.g. by creating a mesh first): just take the new title
        if title != __win_title:
            __win_title = title
            __platform_title()
        return
    __win_title = title
    __win_w = width
    __win_h = height
    __design_w = width
    __design_h = height
    __platform_open()
    __win_open = true
    __time0 = time()

when TARGET == "wasm":
    extern __web_canvas_open = (title: *u8, title_len: i32, w: i32, h: i32)
    extern __web_canvas_size = (out: *i32)

    extern __web_set_title = (title: *u8, title_len: i32)

    __platform_open = (): __web_canvas_open(data(__win_title), i32(len(__win_title)), i32(__win_w), i32(__win_h))
    __platform_title = (): __web_set_title(data(__win_title), i32(len(__win_title)))

    # the page calls this every animation frame
    __web_update: (f64) -> void
    __web_draw: () -> void
    __web_last = -1.0

    @export("__frame")
    __web_frame = (now_ms: f64):
        now = now_ms / 1000.0
        dt = 0.016
        if __web_last >= 0.0: dt = clamp(now - __web_last, 0.0, 0.1)
        __web_last = now
        sz: (i32, i32)
        __web_canvas_size(&sz as *i32)
        __win_w = int(sz.0)
        __win_h = int(sz.1)
        __run_frame(dt, __web_update, __web_draw)

    @export("__key")
    __web_key = (k: i32, down: i32): __key_event(int(k), down != 0)

    @export("__mouse")
    __web_mouse = (kind: i32, x: f32, y: f32, b: i32):
        if kind == 0:
            __mouse_dx += f64(x) - __mouse_x
            __mouse_dy += f64(y) - __mouse_y
            __mouse_x = f64(x)
            __mouse_y = f64(y)
        else if kind == 1: __mouse_event(int(b), true)
        else if kind == 2: __mouse_event(int(b), false)
        else if kind == 3: __mouse_wheel += f64(y)

    @export("__char")
    __web_char = (c: i32): __text_input += chr(int(c))

    __game_run = (update: (f64) -> void, draw: () -> void):
        window(__win_title, __win_w, __win_h)
        __web_update = update
        __web_draw = draw
else:
    @lib("libX11.so.6")
    extern XOpenDisplay = (name: *u8) -> *u8
    @lib("libX11.so.6")
    extern XDefaultScreen = (d: *u8) -> i32
    @lib("libX11.so.6")
    extern XRootWindow = (d: *u8, screen: i32) -> int
    @lib("libX11.so.6")
    extern XCreateSimpleWindow = (d: *u8, parent: int, x: i32, y: i32, w: u32, h: u32, bw: u32, border: int, bg: int) -> int
    @lib("libX11.so.6")
    extern XStoreName = (d: *u8, w: int, name: *u8) -> i32
    @lib("libX11.so.6")
    extern XSelectInput = (d: *u8, w: int, mask: int) -> i32
    @lib("libX11.so.6")
    extern XMapWindow = (d: *u8, w: int) -> i32
    @lib("libX11.so.6")
    extern XInternAtom = (d: *u8, name: *u8, only_if_exists: i32) -> int
    @lib("libX11.so.6")
    extern XSetWMProtocols = (d: *u8, w: int, protocols: *int, count: i32) -> i32
    @lib("libX11.so.6")
    extern XPending = (d: *u8) -> i32
    @lib("libX11.so.6")
    extern XNextEvent = (d: *u8, ev: *u8) -> i32
    @lib("libX11.so.6")
    extern XLookupKeysym = (ev: *u8, index: i32) -> int
    @lib("libX11.so.6")
    extern XLookupString = (ev: *u8, buf: *u8, n: i32, keysym: *int, status: *u8) -> i32
    @lib("libX11.so.6")
    extern XFlush = (d: *u8) -> i32
    @lib("libX11.so.6")
    extern XSetWMNormalHints = (d: *u8, w: int, hints: *u8)
    @lib("libX11.so.6")
    extern XDefaultVisual = (d: *u8, screen: i32) -> *u8
    @lib("libX11.so.6")
    extern XDefaultDepth = (d: *u8, screen: i32) -> i32
    @lib("libX11.so.6")
    extern XDefaultGC = (d: *u8, screen: i32) -> *u8
    @lib("libX11.so.6")
    extern XCreateImage = (d: *u8, visual: *u8, depth: u32, format: i32, offset: i32, data: *u8, w: u32, h: u32, pad: i32, bpl: i32) -> *u8
    @lib("libX11.so.6")
    extern XPutImage = (d: *u8, win: int, gc: *u8, img: *u8, sx: i32, sy: i32, dx: i32, dy: i32, w: u32, h: u32) -> i32
    @lib("libX11.so.6")
    extern XSync = (d: *u8, discard: i32) -> i32
    @lib("libX11.so.6")
    extern XFree = (p: *u8) -> i32

    @lib("libEGL.so.1")
    extern eglGetDisplay = (native: *u8) -> *u8
    @lib("libEGL.so.1")
    extern eglGetPlatformDisplay = (platform: u32, native: *u8, attribs: *int) -> *u8
    @lib("libEGL.so.1")
    extern eglInitialize = (d: *u8, major: *i32, minor: *i32) -> u32
    @lib("libEGL.so.1")
    extern eglBindAPI = (api: u32) -> u32
    @lib("libEGL.so.1")
    extern eglChooseConfig = (d: *u8, attribs: *i32, configs: **u8, size: i32, num: *i32) -> u32
    @lib("libEGL.so.1")
    extern eglCreateWindowSurface = (d: *u8, config: *u8, win: int, attribs: *i32) -> *u8
    @lib("libEGL.so.1")
    extern eglCreatePlatformWindowSurface = (d: *u8, config: *u8, win: *int, attribs: *int) -> *u8
    @lib("libEGL.so.1")
    extern eglCreateContext = (d: *u8, config: *u8, share: *u8, attribs: *i32) -> *u8
    @lib("libEGL.so.1")
    extern eglMakeCurrent = (d: *u8, draw: *u8, read: *u8, ctx: *u8) -> u32
    @lib("libEGL.so.1")
    extern eglSwapBuffers = (d: *u8, surf: *u8) -> u32
    @lib("libEGL.so.1")
    extern eglSwapInterval = (d: *u8, interval: i32) -> u32
    @lib("libEGL.so.1")
    extern eglGetError = () -> i32

    __xdpy: *u8 = null
    __xwin = 0
    __wm_delete = 0
    __egl_dpy: *u8 = null
    __egl_surf: *u8 = null
    __egl_ctx: *u8 = null
    __xev: *u8 = null
    __xscr: i32 = 0
    __xproto = false             # connected through x11.jot instead of libX11
    __wayland = false            # connected through wayland.jot

    # a missing display or driver is an environment problem, not a program bug: say so and exit
    __need = (ok: bool, what: str):
        if not ok:
            eprint("error: cannot open a window: {what}")
            exit(1)

    __platform_open = ():
        __soft = (env("JOT_SOFTWARE") ?? "") == "1"
        headless = __soft and env("JOT_SCREENSHOT") != none
        # Wayland first where it is running (JOT_PLATFORM=x11 or wayland chooses)
        plat = env("JOT_PLATFORM") ?? ""
        if plat != "x11" and (env("WAYLAND_DISPLAY") != none or plat == "wayland") and not headless:
            why = __wl_open(__win_title, __win_w, __win_h)
            if len(why) == 0:
                __wayland = true
                if not __soft:
                    # (GPU arrays may have made the context already: keep it, their data lives there)
                    why2 = ""
                    if __egl_dpy == null: why2 = __egl_open_surfaceless()
                    else: __gl_screen_resize(__win_w, __win_h)
                    if len(why2) > 0:
                        eprint("note: {why2}; using the software renderer")
                        __soft = true
                if __soft: __sw_init_window(__win_w, __win_h)
                return
            if plat == "wayland": __need(false, why)
        if not lib_available("libX11.so.6") or (env("JOT_X11") ?? "") == "protocol":
            # no Xlib: talk to the X server directly and render in software
            __soft = true
            why = __xp_open(__win_title, __win_w, __win_h)
            if len(why) == 0: __xproto = true
            # a screenshot run can render without any display
            else if not headless: __need(false, "libX11 is not available and {why}")
            __sw_init_window(__win_w, __win_h)
            return
        __xdpy = XOpenDisplay(null)
        if __xdpy == null and headless:
            __sw_init_window(__win_w, __win_h)
            return
        __need(__xdpy != null, "cannot connect to the X server (is DISPLAY set?)")
        __xscr = XDefaultScreen(__xdpy)
        root = XRootWindow(__xdpy, __xscr)
        __xwin = XCreateSimpleWindow(__xdpy, root, 0, 0, u32(__win_w), u32(__win_h), 0, 0, 0)
        XStoreName(__xdpy, __xwin, data(__zstr(__win_title)))
        # key, button, motion, structure and focus events
        XSelectInput(__xdpy, __xwin, 0x1 | 0x2 | 0x4 | 0x8 | 0x40 | 0x20000 | 0x200000)
        __wm_delete = XInternAtom(__xdpy, data("WM_DELETE_WINDOW"), 0)
        XSetWMProtocols(__xdpy, __xwin, &__wm_delete, 1)
        XMapWindow(__xdpy, __xwin)
        XFlush(__xdpy)
        __xev = __alloc(256)
        if not __soft:
            why = __egl_open()
            if len(why) > 0:
                eprint("note: {why}; using the software renderer")
                __soft = true
        if __soft: __sw_init_window(__win_w, __win_h)

    __platform_title = ():
        if __wayland: __wl_set_title(__win_title)
        else if __xproto: __xp_property(39, 31, 8, bytes(__win_title))         # WM_NAME, STRING
        else if __xdpy != null:
            XStoreName(__xdpy, __xwin, data(__zstr(__win_title)))
            XFlush(__xdpy)

    # OpenGL ES without a window surface: drawing goes to an offscreen framebuffer that is
    # copied into the Wayland window's buffers
    __egl_open_surfaceless = () -> str:
        if not lib_available("libEGL.so.1") or not lib_available("libGLESv2.so.2"): return "no OpenGL ES driver (libEGL/libGLESv2) found"
        __egl_dpy = eglGetPlatformDisplay(0x31DD, null, null)        # EGL_PLATFORM_SURFACELESS_MESA
        if __egl_dpy == null: return "no surfaceless EGL display"
        maj: i32 = 0
        mn: i32 = 0
        if eglInitialize(__egl_dpy, &maj, &mn) == 0: return "eglInitialize failed"
        eglBindAPI(0x30A0)
        attrs: i32[] = [0x3033, 0, 0x3040, 0x40, 0x3038]               # any surface type; ES3
        cfg: *u8 = null
        n: i32 = 0
        if eglChooseConfig(__egl_dpy, data(attrs), &cfg, 1, &n) == 0 or n == 0: return "no suitable EGL config"
        cattrs: i32[] = [0x3098, 3, 0x30FB, 0, 0x3038]
        ctx = eglCreateContext(__egl_dpy, cfg, null, data(cattrs))
        if ctx == null: return "eglCreateContext failed (OpenGL ES 3 needed)"
        __egl_ctx = ctx
        if eglMakeCurrent(__egl_dpy, null, null, ctx) == 0: return "the GL driver cannot render without a window surface"
        __gl_screen_resize(__win_w, __win_h)
        ""

    # set up OpenGL ES on the window; returns why that is impossible, or ""
    __egl_open = () -> str:
        if not lib_available("libEGL.so.1") or not lib_available("libGLESv2.so.2"): return "no OpenGL ES driver (libEGL/libGLESv2) found"
        __egl_dpy = eglGetPlatformDisplay(0x31D5, __xdpy, null)      # EGL_PLATFORM_X11_KHR
        if __egl_dpy == null: __egl_dpy = eglGetDisplay(__xdpy)
        if __egl_dpy == null: return "eglGetDisplay failed"
        maj: i32 = 0
        mn: i32 = 0
        if eglInitialize(__egl_dpy, &maj, &mn) == 0: return "eglInitialize failed"
        eglBindAPI(0x30A0)             # EGL_OPENGL_ES_API
        attrs: i32[] = [0x3024, 8, 0x3023, 8, 0x3022, 8, 0x3025, 24, 0x3040, 0x40, 0x3033, 4, 0x3038]
        cfg: *u8 = null
        n: i32 = 0
        if eglChooseConfig(__egl_dpy, data(attrs), &cfg, 1, &n) == 0 or n == 0: return "no suitable EGL config"
        __egl_surf = eglCreateWindowSurface(__egl_dpy, cfg, __xwin, null)
        if __egl_surf == null:
            # try the platform-specific entry point, which takes a pointer to the window id
            __egl_surf = eglCreatePlatformWindowSurface(__egl_dpy, cfg, &__xwin, null)
        if __egl_surf == null: return "eglCreateWindowSurface failed (EGL error 0x{eglGetError():x})"
        cattrs: i32[] = [0x3098, 3, 0x30FB, 0, 0x3038]
        ctx = eglCreateContext(__egl_dpy, cfg, null, data(cattrs))
        if ctx == null: return "eglCreateContext failed (OpenGL ES 3 needed)"
        if eglMakeCurrent(__egl_dpy, __egl_surf, __egl_surf, ctx) == 0: return "eglMakeCurrent failed"
        eglSwapInterval(__egl_dpy, 1)
        ""

    __ximg: *u8 = null
    __ximg_buf: u8[]
    __ximg_w = 0
    __ximg_h = 0

    # show the software renderer's frame
    __sw_present = ():
        w = __win_w
        h = __win_h
        if __xproto:
            if __ximg_buf.len() != w * h * 4: __ximg_buf = fill(u8(0), w * h * 4)
            __sw_present_pixels(data(__ximg_buf), w, h)
            __xp_put_image(__ximg_buf, w, h)
            return
        if __xdpy == null: return
        if __ximg == null or __ximg_w != w or __ximg_h != h:
            if __ximg != null: XFree(__ximg)       # frees the header only; the pixels are ours
            __ximg_buf = fill(u8(0), w * h * 4)
            __ximg = XCreateImage(__xdpy, XDefaultVisual(__xdpy, __xscr), u32(XDefaultDepth(__xdpy, __xscr)), 2, 0, data(__ximg_buf), u32(w), u32(h), 32, 0)
            __ximg_w = w
            __ximg_h = h
        __sw_present_pixels(data(__ximg_buf), w, h)
        XPutImage(__xdpy, __xwin, XDefaultGC(__xdpy, __xscr), __ximg, 0, 0, 0, 0, u32(w), u32(h))
        XSync(__xdpy, 0)

    __xkey = (sym: int) -> int:
        if sym >= 0x61 and sym <= 0x7a: return int(Key.a) + sym - 0x61
        if sym >= 0x41 and sym <= 0x5a: return int(Key.a) + sym - 0x41
        if sym >= 0x30 and sym <= 0x39: return int(Key.n0) + sym - 0x30
        if sym >= 0xffbe and sym <= 0xffc9: return int(Key.f1) + sym - 0xffbe
        match sym:
            0x20: int(Key.space)
            0xff0d: int(Key.enter)
            0xff8d: int(Key.enter)
            0xff1b: int(Key.escape)
            0xff09: int(Key.tab)
            0xff08: int(Key.backspace)
            0xffff: int(Key.delete)
            0xff63: int(Key.insert)
            0xff50: int(Key.home)
            0xff57: int(Key.end)
            0xff55: int(Key.page_up)
            0xff56: int(Key.page_down)
            0xff51: int(Key.left)
            0xff52: int(Key.up)
            0xff53: int(Key.right)
            0xff54: int(Key.down)
            0xffe1, 0xffe2: int(Key.shift)
            0xffe3, 0xffe4: int(Key.ctrl)
            0xffe9, 0xffea: int(Key.alt)
            0xffeb, 0xffec: int(Key.super)
            0x2d: int(Key.minus)
            0x3d: int(Key.equals)
            0x2c: int(Key.comma)
            0x2e: int(Key.period)
            0x2f: int(Key.slash)
            0x3b: int(Key.semicolon)
            0x27: int(Key.quote)
            0x5b: int(Key.lbracket)
            0x5d: int(Key.rbracket)
            0x5c: int(Key.backslash)
            0x60: int(Key.grave)
            _: 0

    __platform_poll = ():
        if __wayland:
            __wl_poll()
            return
        if __xproto:
            __xp_poll()
            return
        if __xdpy == null: return
        loop XPending(__xdpy) > 0:
            XNextEvent(__xdpy, __xev)
            ev = __xev as *i32
            kind = int(ev[0])
            if kind == 2 or kind == 3:
                sym = XLookupKeysym(__xev, 0)
                __key_event(__xkey(sym), kind == 2)
                if kind == 2:
                    buf = __alloc(16)
                    n = XLookupString(__xev, buf, 15, null, null)
                    if n == 1 and buf[0] >= 32 and buf[0] < 127: __text_input += chr(int(buf[0]))
                    __free(buf)
            else if kind == 4 or kind == 5:
                btn = int(ev[21])
                if btn == 1: __mouse_event(0, kind == 4)
                else if btn == 2: __mouse_event(1, kind == 4)
                else if btn == 3: __mouse_event(2, kind == 4)
                else if btn == 4 and kind == 4: __mouse_wheel += 1.0
                else if btn == 5 and kind == 4: __mouse_wheel -= 1.0
            else if kind == 6:
                x = f64(ev[16])
                y = f64(ev[17])
                __mouse_dx += x - __mouse_x
                __mouse_dy += y - __mouse_y
                __mouse_x = x
                __mouse_y = y
            else if kind == 22:
                __win_w = int(ev[14])
                __win_h = int(ev[15])
            else if kind == 33:
                if (__xev as *int)[7] == __wm_delete: __win_close = true
            else if kind == 10:
                loop mut kd in __key_down: kd = false

    __platform_present = ():
        if __wayland:
            if __soft: __wl_present((out: *u8, w: int, h: int): __sw_present_pixels(out, w, h))
            else if not __wl_present_gpu(): __wl_present((out: *u8, w: int, h: int): __gl_screen_copy(out, w, h))
        else if __soft: __sw_present()
        else: eglSwapBuffers(__egl_dpy, __egl_surf)

    __game_run = (update: (f64) -> void, draw: () -> void):
        window(__win_title, __win_w, __win_h)
        __fixed_step = env("JOT_SCREENSHOT") != none
        last = time()
        loop not __win_close:
            __platform_poll()
            now = time()
            dt = clamp(now - last, 0.0, 0.1)
            last = now
            if __fixed_step: dt = 1.0 / 60.0
            if __soft: __sw_init_window(__win_w, __win_h)
            else if __wayland: __gl_screen_resize(__win_w, __win_h)
            __run_frame(dt, update, draw)
            t0 = time()
            __platform_present()
            __last_present = time() - t0
            __frame_present += __last_present
            # without vsync, software frames are paced to 60 per second
            if __soft and not __fixed_step:
                left = 1.0 / 60.0 - (time() - now)
                if left > 0.0: sleep(left)
        exit(0)

__no_update = (dt: f64): pass
__no_draw = (): pass

__fps_acc = 0.0
__fps_n = 0

# testing aid: JOT_INPUT="5:space+,7:space-,10:right+" presses (+) / releases (-) keys at frames
__script: (int, int, bool)[]
__script_loaded = false
__scripted_input = ():
    when TARGET != "wasm":
        if not __script_loaded:
            __script_loaded = true
            if let s = env("JOT_INPUT"):
                loop item in split(s, ","):
                    c = find(item, ":")
                    if c < 0 or len(item) < c + 3: continue
                    fr = to_int(item[..c)) ?? 0
                    name = item[c + 1..len(item) - 1)
                    loop k in [0..__NKEYS):
                        if "{k as Key}" == name: __script.push((fr, k, item[len(item) - 1] == '+'))
        loop e in __script:
            if e.0 == __frame_count: __key_event(e.1, e.2)

__run_frame = (dt: f64, update: (f64) -> void, draw: () -> void):
    __scripted_input()
    __pad_frame()
    __dt = dt
    __fps_acc += dt
    __fps_n += 1
    if __fps_acc >= 0.5:
        __fps = f64(__fps_n) / __fps_acc
        __fps_acc = 0.0
        __fps_n = 0
    t0 = time()
    __gfx_begin_frame()
    update(dt)
    draw()
    __gfx_end_frame()
    __audio_update()
    __frame_cpu += time() - t0
    __stats_record(time() - t0)
    __stats_draw()
    __maybe_screenshot()
    __input_end_frame()
    __frame_count += 1

__frame_cpu = 0.0
__frame_present = 0.0         # time spent handing frames to the screen (and waiting for vsync)

# how frames reach the screen (for diagnostics)
__present_how = () -> str:
    when TARGET == "wasm": return "webgl"
    else:
        if __soft: return "software renderer"
        if __wayland:
            if __wl_gpu > 0: return "wayland dma-buf, scale {__wl_scale:.3}"
            return "wayland shared memory copy, scale {__wl_scale:.3}"
        "egl window surface"

# testing aid: JOT_SCREENSHOT=out.png [JOT_FRAMES=n] saves frame n and exits
# (JOT_FRAME_STATS=1 also reports the average CPU time of a frame: update + draw + submit)
__maybe_screenshot = ():
    when TARGET != "wasm":
        if let path = env("JOT_SCREENSHOT"):
            n = to_int(env("JOT_FRAMES") ?? "5") ?? 5
            if __frame_count == n:
                save_png(screenshot(), path)
                if env("JOT_FRAME_STATS") != none:
                    eprint("frame cpu: {__frame_cpu * 1000.0 / f64(n + 1):.2} ms average over {n + 1} frames, present {__frame_present * 1000.0 / f64(n):.2} ms; {__win_w}x{__win_h} pixels, {__present_how()}")
                exit(0)
