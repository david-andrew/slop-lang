# GPU arrays: numbers kept in GPU memory and computed on by GPU programs.
#
#   g = gpu(xs)                       # upload (f32 values; xs may have up to 4 dimensions)
#   h = g .* 2.0 .+ sin.(g)           # one GPU program, made from the expression at compile time
#   ys = cpu(h)                       # download: an f32[,] of the same shape
#
# A dotted expression whose arrays are GPU arrays runs on the GPU as one fragment program (the
# functions applied with f.(g) are translated to GLSL, like shader functions; numbers in the
# expression become f32 uniforms). Shapes broadcast as on the CPU. Native programs use OpenGL ES
# (without a window, through a windowless EGL context), web builds WebGL 2. Where neither can
# render to float textures (no driver, JOT_SOFTWARE=1, an old browser, node) the same
# expressions run on the CPU, so programs work everywhere; gpu_available() tells which.

struct GpuArray:
    n: int
    w: int
    h: int
    tex: int          # the texture holding the values (0: there is no GPU; they are in host)
    host: f32[]
    token: u8[]       # shared by all copies of this value; see __gpu_alloc
    shape: int[]

__gpu_state = 0       # 0: not tried yet, 1: available, 2: not available
__gpu_fbo = 0
__gpu_vao = 0
__gpu_progs: {str: int} = {}
__gpu_locs: {int: int[]} = {}
__gpu_live: GpuArray[]   # every texture made, in use or free

const __GPU_W = 4096
const __GL_RGBA32F = 0x8814

__GPU_VS = "#version 300 es
void main() \{
    vec2 v = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
    gl_Position = vec4(v * 2.0 - 1.0, 0.0, 1.0);
}
"

when TARGET == "wasm":
    # (lib/web/gfx.js) a WebGL 2 context on the page's canvas; 1 if it renders to float textures
    extern __web_gpu_init = () -> i32

# a GL context that can render to float textures
__gpu_context = () -> bool:
    when TARGET == "wasm": return __web_gpu_init() != 0
    else:
        if (env("JOT_SOFTWARE") ?? "") == "1" or (env("JOT_NO_GPU") ?? "") == "1": return false
        if __win_open: return not __soft
        len(__egl_open_surfaceless()) == 0

gpu_available = () -> bool:
    if __gpu_state == 0:
        __gpu_state = 2
        if __gpu_context():
            __gpu_fbo = gl_create_framebuffer()
            __gpu_vao = gl_create_vertex_array()
            # rendering to float textures needs EXT_color_buffer_float
            probe = __gpu_new_texture(1, 1)
            glBindFramebuffer(GL_FRAMEBUFFER, u32(__gpu_fbo))
            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(probe), 0)
            if glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE: __gpu_state = 1
            gl_delete_texture(probe)
            __gpu_restore()
    __gpu_state == 1

# ---------------- moving data ----------------
gpu = (xs: f32[]) -> GpuArray: __gpu_upload(xs, [xs.len()])
gpu = (m: NDArray[f32]) -> GpuArray: __gpu_upload(m.data, m.shape)
gpu = (m: NDArray[f64]) -> GpuArray: __gpu_upload(f32.(m.data), m.shape)

__gpu_upload = (xs: f32[], shape: int[]) -> GpuArray:
    if shape.len() > 4: panic("GPU arrays have at most 4 dimensions (this one has shape {__shape_str(shape)})")
    if not gpu_available(): return GpuArray(n = xs.len(), host = xs, token = fill(u8(0), 1), shape = shape)
    g = __gpu_alloc(xs.len(), shape)
    buf = fill(f32(0), g.w * g.h * 4)
    loop i in [0..xs.len()): buf[i * 4] = xs[i]
    glBindTexture(GL_TEXTURE_2D, u32(g.tex))
    gl_tex_sub_image(0, 0, g.w, g.h, GL_RGBA, GL_FLOAT, data(buf) as *u8, buf.len() * 4)
    g
gpu = (xs: f64[]) -> GpuArray: gpu(f32.(xs))
gpu = (xs: int[]) -> GpuArray: gpu(f32.(xs))
gpu = (xs: bool[]) -> GpuArray:
    ys: f32[]
    ys.reserve(xs.len())
    loop b in xs:
        if b: ys.push(1.0)
        else: ys.push(0.0)
    gpu(ys)

# the values (an array of the GPU array's shape)
cpu = (g: GpuArray) -> NDArray[f32]: NDArray(__gpu_values(g), g.shape)

__gpu_values = (g: GpuArray) -> f32[]:
    if g.tex == 0: return g.host
    out: f32[]
    buf = fill(f32(0), g.w * g.h * 4)
    glBindFramebuffer(GL_FRAMEBUFFER, u32(__gpu_fbo))
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(g.tex), 0)
    gl_read_pixels_f32(0, 0, g.w, g.h, data(buf) as *u8)
    __gpu_restore()
    out.reserve(g.n)
    loop i in [0..g.n): out.push(buf[i * 4])
    out

len = (g: GpuArray) -> int: g.shape[0]
sum = (g: GpuArray) -> f64:
    s = 0.0
    loop x in __gpu_values(g): s += f64(x)
    s

# the result of a dotted expression computed on the CPU, as a GPU array
__gpu_from[T] = (m: NDArray[T]) -> GpuArray: gpu(__to_f32.(m))
__to_f32 = (x: f32) -> f32: x
__to_f32 = (x: f64) -> f32: f32(x)
__to_f32 = (x: int) -> f32: f32(x)
__to_f32 = (x: bool) -> f32:
    if x: return 1.0
    0.0

__fmt = (buf: mut u8[], g: GpuArray):
    __buf_append_str(buf, "gpu")
    __fmt(buf, cpu(g))

# ---------------- textures ----------------
__gpu_new_texture = (w: int, h: int) -> int:
    t = gl_create_texture()
    glBindTexture(GL_TEXTURE_2D, u32(t))
    gl_tex_image(w, h, __GL_RGBA32F, GL_RGBA, GL_FLOAT, null, 0)
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, i32(GL_NEAREST))
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, i32(GL_NEAREST))
    t

# no copy of the array whose token this is exists any more: only __gpu_live refers to it
__gpu_unused = (token: u8[]) -> bool: (token as *int)[0] == 1

# a texture for n values: one no array uses any more if there is one of the right size
# (others no array uses are deleted), else a new one
__gpu_alloc = (n: int, shape: int[]) -> GpuArray:
    w = min(max(n, 1), __GPU_W)
    h = max((n + w - 1) / w, 1)
    token = fill(u8(0), 1)
    tex = 0
    keep: GpuArray[]
    loop i in [0..__gpu_live.len()):
        if __gpu_unused(__gpu_live[i].token):
            if tex == 0 and __gpu_live[i].w == w and __gpu_live[i].h == h:
                tex = __gpu_live[i].tex
                continue
            gl_delete_texture(__gpu_live[i].tex)
            continue
        keep.push(__gpu_live[i])
    __gpu_live = keep
    if tex == 0: tex = __gpu_new_texture(w, h)
    g = GpuArray(n, w, h, tex, [], token, shape)
    __gpu_live.push(g)
    g

__gpu_restore = ():
    glBindFramebuffer(GL_FRAMEBUFFER, 0)
    if __win_open:
        glViewport(0, 0, i32(__target_w), i32(__target_h))
        glEnable(GL_BLEND)

# ---------------- running programs ----------------
# run a fragment program made by the compiler from a dotted expression (see glsl_kernel): texture
# uniforms t0, t1... hold the arrays, st0, st1... their steps per dimension (0 where they
# stretch), w0, w1... their textures' widths; s0, s1... are the numbers; od is the result's shape
# and ow its texture's width. Shapes have up to 4 dimensions, padded in front with 1s.
__gpu_run = (src: str, ins: GpuArray[], scalars: f32[]) -> GpuArray:
    shapes: int[][]
    loop g in ins: shapes.push(g.shape)
    shp = __bcast_shape(shapes)
    out = __gpu_alloc(__nd_size(shp), shp)
    prog = __gpu_progs.get(src) ?? 0
    if prog == 0:
        prog = gl_create_program(__GPU_VS, src)
        __gpu_progs[src] = prog
        locs = [gl_uniform_location(prog, "od"), gl_uniform_location(prog, "ow")]
        loop i in [0..ins.len()):
            locs.push(gl_uniform_location(prog, "t{i}"))
            locs.push(gl_uniform_location(prog, "st{i}"))
            locs.push(gl_uniform_location(prog, "w{i}"))
        loop i in [0..scalars.len()): locs.push(gl_uniform_location(prog, "s{i}"))
        __gpu_locs[prog] = locs
    locs = __gpu_locs[prog]
    glBindFramebuffer(GL_FRAMEBUFFER, u32(__gpu_fbo))
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(out.tex), 0)
    glViewport(0, 0, i32(out.w), i32(out.h))
    glDisable(GL_BLEND)
    glDisable(GL_DEPTH_TEST)
    glUseProgram(u32(prog))
    od = __pad4(shp, 1)
    gl_uniform4i(locs[0], od[0], od[1], od[2], od[3])
    glUniform1i(i32(locs[1]), i32(out.w))
    loop i in 0.. and g in ins:
        glActiveTexture(GL_TEXTURE0 + u32(i))
        glBindTexture(GL_TEXTURE_2D, u32(g.tex))
        glUniform1i(i32(locs[2 + 3 * i]), i32(i))
        st = __pad4(__bcast_strides(g.shape, shp), 0)
        gl_uniform4i(locs[3 + 3 * i], st[0], st[1], st[2], st[3])
        glUniform1i(i32(locs[4 + 3 * i]), i32(g.w))
    loop i in 0.. and s in scalars: glUniform1f(i32(locs[2 + 3 * ins.len() + i]), s)
    glBindVertexArray(u32(__gpu_vao))
    glDrawArrays(GL_TRIANGLES, 0, 3)
    glBindVertexArray(0)
    glActiveTexture(GL_TEXTURE0)
    __gpu_restore()
    out

# a shape (or strides) as 4 numbers, padded in front
__pad4 = (xs: int[], pad: int) -> int[]:
    if xs.len() > 4: panic("GPU arrays have at most 4 dimensions")
    out = fill(pad, 4 - xs.len())
    out.extend(xs)
    out
