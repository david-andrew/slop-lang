# Audio: a software mixer written in Sloppy. Sounds are float sample buffers (stereo,
# interleaved, at the mixer rate). Each frame the mixer renders just enough samples to
# keep the output device fed. Native: ALSA (loaded at runtime; silent if unavailable).
# Web: WebAudio.

struct Sound:
    samples: f32[]      # interleaved stereo

struct Voice:
    sound: Sound
    pos: f64
    volume: f32
    pan: f32
    pitch: f64
    looping: bool
    id: int

enum Wave: sine, square, triangle, saw, noise

const MIX_RATE = 48000
__voices: Voice[]
__voice_id = 0
__master = 0.8
__mix_buf: f32[]
__audio_state = 0       # 0 not started, 1 running, 2 unavailable

frames = (s: Sound) -> int: s.samples.len() / 2
duration = (s: Sound) -> f64: f64(frames(s)) / f64(MIX_RATE)

# play a sound; returns a voice id for stop()/set_volume()
play = (s: Sound, volume: f64 = 1.0, pan: f64 = 0.0, pitch: f64 = 1.0, looping: bool = false) -> int:
    __audio_start()
    __voice_id += 1
    __voices.push(Voice(s, 0.0, f32(volume), f32(clamp(pan, -1.0, 1.0)), pitch, looping, __voice_id))
    __voice_id

stop = (id: int):
    i = 0
    loop i < __voices.len():
        if __voices[i].id == id: __voices.remove(i)
        else: i += 1

stop_all = (): __voices.clear()
is_playing = (id: int) -> bool:
    loop v in __voices:
        if v.id == id: return true
    false
set_volume = (id: int, volume: f64):
    loop mut v in __voices:
        if v.id == id: v.volume = f32(volume)
set_pitch = (id: int, pitch: f64):
    loop mut v in __voices:
        if v.id == id: v.pitch = pitch
master_volume = (v: f64): __master = clamp(v, 0.0, 1.0)

# mix n stereo frames into __mix_buf
__mix = (n: int):
    __mix_buf.resize(n * 2)
    loop k in [0..n * 2): __mix_buf[k] = 0.0
    out = data(__mix_buf)
    i = 0
    loop i < __voices.len():
        v = __voices[i]
        src = data(v.sound.samples)
        total = v.sound.samples.len() / 2
        if total == 0:
            __voices.remove(i)
            continue
        gl_ = v.volume * f32(__master) * (1.0 - max(v.pan, 0.0))
        gr = v.volume * f32(__master) * (1.0 + min(v.pan, 0.0))
        pos = v.pos
        step = v.pitch
        done = false
        loop f in [0..n):
            ip = int(pos)
            if ip >= total:
                if v.looping:
                    pos -= f64(total)
                    ip = int(pos)
                else:
                    done = true
                    break
            fr = f32(pos - f64(ip))
            nx = ip + 1
            if nx >= total: nx = 0
            l = src[ip * 2] + (src[nx * 2] - src[ip * 2]) * fr
            r = src[ip * 2 + 1] + (src[nx * 2 + 1] - src[ip * 2 + 1]) * fr
            out[f * 2] += l * gl_
            out[f * 2 + 1] += r * gr
            pos += step
        if done: __voices.remove(i)
        else:
            __voices[i].pos = pos
            i += 1
    # soft clip
    loop k in [0..n * 2):
        x = out[k]
        if x > 1.0 or x < -1.0: out[k] = f32(tanh(f64(x)))

tanh = (x: f64) -> f64:
    if x > 20.0: return 1.0
    if x < -20.0: return -1.0
    e = exp(2.0 * x)
    (e - 1.0) / (e + 1.0)

# ---------------- synthesis ----------------
__osc = (w: Wave, phase: f64) -> f64:
    p = phase - floor(phase)
    match w:
        sine: sin(p * TAU)
        square:
            if p < 0.5: return 0.6
            -0.6
        triangle: 4.0 * abs(p - 0.5) - 1.0
        saw: (2.0 * p - 1.0) * 0.7
        noise: random(-1.0, 1.0)

# a single synthesized note: frequency slides from freq to freq * slide over the duration
tone = (freq: f64, seconds: f64, wave: Wave = .sine, volume: f64 = 0.5, attack: f64 = 0.005, release: f64 = 0.1, slide: f64 = 1.0, vibrato: f64 = 0.0) -> Sound:
    n = int(seconds * f64(MIX_RATE))
    s = Sound(fill(f32(0), n * 2))
    phase = 0.0
    loop i in [0..n):
        t = f64(i) / f64(MIX_RATE)
        u = f64(i) / f64(max(n, 1))
        f = freq * pow(slide, u) * (1.0 + vibrato * sin(t * 30.0))
        phase += f / f64(MIX_RATE)
        env = 1.0
        if t < attack: env = t / attack
        rem = seconds - t
        if rem < release: env = env * max(rem / release, 0.0)
        x = f32(__osc(wave, phase) * env * volume)
        s.samples[i * 2] = x
        s.samples[i * 2 + 1] = x
    s

# mix several sounds into one (useful for chords and layered effects)
mix = (sounds: Sound[]) -> Sound:
    n = 0
    loop s in sounds: n = max(n, s.samples.len())
    out = Sound(fill(f32(0), n))
    loop s in sounds:
        loop i in 0.. and x in s.samples: out.samples[i] += x
    out

# sound effect presets
sfx_jump = () -> Sound: tone(320.0, 0.18, .square, 0.25, 0.002, 0.08, 2.2)
sfx_coin = () -> Sound: mix([tone(988.0, 0.08, .square, 0.2, 0.001, 0.02), __delayed(tone(1319.0, 0.25, .square, 0.2, 0.001, 0.2), 0.07)])
sfx_hit = () -> Sound: mix([tone(160.0, 0.15, .noise, 0.4, 0.001, 0.12), tone(110.0, 0.15, .square, 0.3, 0.001, 0.1, 0.5)])
sfx_explosion = () -> Sound: tone(90.0, 0.7, .noise, 0.6, 0.002, 0.6, 0.3)
sfx_laser = () -> Sound: tone(1400.0, 0.2, .saw, 0.25, 0.001, 0.15, 0.25)
sfx_powerup = () -> Sound: tone(300.0, 0.5, .triangle, 0.35, 0.01, 0.2, 4.0, 0.03)
sfx_click = () -> Sound: tone(1800.0, 0.03, .square, 0.15, 0.001, 0.02)
sfx_whoosh = () -> Sound: tone(400.0, 0.4, .noise, 0.2, 0.15, 0.2, 0.4)
sfx_chime = () -> Sound: mix([tone(1046.5, 1.2, .sine, 0.25, 0.002, 1.1), tone(1568.0, 1.0, .sine, 0.15, 0.002, 0.9), tone(2093.0, 0.8, .sine, 0.08, 0.002, 0.7)])

__delayed = (s: Sound, seconds: f64) -> Sound:
    pad = int(seconds * f64(MIX_RATE)) * 2
    out = Sound(fill(f32(0), pad + s.samples.len()))
    loop i in 0.. and x in s.samples: out.samples[pad + i] = x
    out

# note name ("C4", "F#3", "Bb5") to frequency in Hz
note_freq = (name: str) -> f64:
    if len(name) < 2: return 0.0
    base = [9, 11, 0, 2, 4, 5, 7]   # A B C D E F G relative to C
    c = int(name[0])
    if c >= 'a': c -= 32
    if c < 'A' or c > 'G': return 0.0
    semi = base[c - 'A']
    i = 1
    if name[i] == '#':
        semi += 1
        i += 1
    else if name[i] == 'b':
        semi -= 1
        i += 1
    octave = to_int(name[i..]) ?? 4
    midi = (octave + 1) * 12 + semi
    440.0 * pow(2.0, f64(midi - 69) / 12.0)

# render a melody: notes separated by spaces, "-" holds the previous note, "." is a rest
melody = (notes: str, bpm: f64 = 120.0, wave: Wave = .triangle, volume: f64 = 0.3, step: f64 = 0.5) -> Sound:
    beat = 60.0 / bpm * step
    toks = words(notes)
    total = int(f64(toks.len()) * beat * f64(MIX_RATE)) + MIX_RATE / 4
    out = Sound(fill(f32(0), total * 2))
    i = 0
    loop i < toks.len():
        t = toks[i]
        if t == "." or t == "-":
            i += 1
            continue
        held = 1
        loop i + held < toks.len() and toks[i + held] == "-": held += 1
        f = note_freq(t)
        if f > 0.0:
            nt = tone(f, beat * f64(held) * 0.95, wave, volume, 0.01, beat * 0.5)
            start = int(f64(i) * beat * f64(MIX_RATE)) * 2
            loop k in 0.. and x in nt.samples:
                if start + k < out.samples.len(): out.samples[start + k] += x
        i += held
    out

# ---------------- WAV files ----------------
load_wav = (file: u8[]) -> Sound:
    if file.len() < 44 or file[0] != 'R' or file[8] != 'W': panic("not a WAV file")
    pos = 12
    fmt_ = 1
    channels = 2
    rate = 44100
    bits = 16
    loop pos + 8 <= file.len():
        id = str_from_bytes(file[pos..pos + 4))
        n = int(file[pos + 4]) | (int(file[pos + 5]) << 8) | (int(file[pos + 6]) << 16) | (int(file[pos + 7]) << 24)
        b = pos + 8
        if id == "fmt ":
            fmt_ = int(file[b]) | (int(file[b + 1]) << 8)
            channels = int(file[b + 2]) | (int(file[b + 3]) << 8)
            rate = int(file[b + 4]) | (int(file[b + 5]) << 8) | (int(file[b + 6]) << 16)
            bits = int(file[b + 14]) | (int(file[b + 15]) << 8)
        else if id == "data":
            bps = bits / 8
            nframes = n / (bps * channels)
            src: f32[]
            src.reserve(nframes * 2)
            loop f in [0..nframes):
                loop ch in [0..2):
                    c = min(ch, channels - 1)
                    o = b + (f * channels + c) * bps
                    v: f32 = 0.0
                    if fmt_ == 3 and bits == 32: v = ((data(file) + o) as *f32)[0]
                    else if bits == 16:
                        x = int(file[o]) | (int(file[o + 1]) << 8)
                        if x >= 32768: x -= 65536
                        v = f32(x) / 32768.0
                    else if bits == 8: v = (f32(file[o]) - 128.0) / 128.0
                    src.push(v)
            return __resample(src, rate)
        pos = b + n + (n & 1)
    panic("WAV file has no data")
    Sound([])

__resample = (src: f32[], rate: int) -> Sound:
    if rate == MIX_RATE: return Sound(src)
    nin = src.len() / 2
    nout = int(f64(nin) * f64(MIX_RATE) / f64(rate))
    out = Sound(fill(f32(0), nout * 2))
    ratio = f64(rate) / f64(MIX_RATE)
    loop i in [0..nout):
        p = f64(i) * ratio
        ip = int(p)
        fr = f32(p - f64(ip))
        nx = min(ip + 1, nin - 1)
        loop ch in [0..2): out.samples[i * 2 + ch] = src[ip * 2 + ch] + (src[nx * 2 + ch] - src[ip * 2 + ch]) * fr
    out

# ---------------- output ----------------
when TARGET == "wasm":
    extern __web_audio_start = (rate: i32)

    __audio_start = ():
        if __audio_state != 0: return
        __audio_state = 1
        __web_audio_start(i32(MIX_RATE))

    # the page asks for n frames of audio and receives a pointer to interleaved floats
    @export("__audio_fill")
    __web_audio_fill = (n: i32) -> *f32:
        __mix(int(n))
        data(__mix_buf)

    __audio_update = (): pass
else when TARGET == "windows":
    # waveOut (winmm): a few buffers of float samples, refilled as each one finishes playing
    @lib("winmm.dll")
    extern waveOutOpen = (h: **u8, dev: u32, fmt: *u8, cb: int, inst: int, flags: u32) -> u32
    @lib("winmm.dll")
    extern waveOutPrepareHeader = (h: *u8, hdr: *u8, size: u32) -> u32
    @lib("winmm.dll")
    extern waveOutWrite = (h: *u8, hdr: *u8, size: u32) -> u32

    const __WO_BUFS = 4
    const __WO_FRAMES = 1024          # (21 ms each)
    __wo: *u8 = null
    __wo_hdrs: u8[]
    __wo_data: f32[]

    __audio_start = ():
        if __audio_state != 0: return
        __audio_state = 2
        if env("SLOPPY_NO_AUDIO") != none: return
        if not lib_available("winmm.dll"): return
        fmt = fill(u8(0), 20)
        p = data(fmt)
        (p as *u16)[0] = 3                                  # IEEE float
        (p as *u16)[1] = 2                                  # stereo
        ((p + 4) as *u32)[0] = u32(MIX_RATE)
        ((p + 8) as *u32)[0] = u32(MIX_RATE * 8)
        ((p + 12) as *u16)[0] = 8                           # bytes per frame
        ((p + 14) as *u16)[0] = 32
        h: *u8 = null
        if waveOutOpen(&h, u32(0xFFFFFFFF), p, 0, 0, 0) != 0: return      # (WAVE_MAPPER)
        __wo = h
        __wo_hdrs = fill(u8(0), 48 * __WO_BUFS)
        __wo_data = fill(f32(0), __WO_BUFS * __WO_FRAMES * 2)
        loop i in [0..__WO_BUFS):
            hd = data(__wo_hdrs) + 48 * i
            (hd as **u8)[0] = (data(__wo_data) + i * __WO_FRAMES * 2) as *u8
            ((hd + 8) as *u32)[0] = u32(__WO_FRAMES * 8)
            waveOutPrepareHeader(__wo, hd, 48)
            ((hd + 24) as *u32)[0] = ((hd + 24) as *u32)[0] | 1      # (done: to be filled)
        __audio_state = 1

    __audio_update = ():
        if __audio_state != 1: return
        loop i in [0..__WO_BUFS):
            hd = data(__wo_hdrs) + 48 * i
            if ((hd + 24) as *u32)[0] & 1 == 0: continue            # still playing
            __mix(__WO_FRAMES)
            mem_copy((data(__wo_data) + i * __WO_FRAMES * 2) as *u8, data(__mix_buf) as *u8, __WO_FRAMES * 8)
            ((hd + 24) as *u32)[0] = ((hd + 24) as *u32)[0] & ~1
            waveOutWrite(__wo, hd, 48)
else:
    @lib("libasound.so.2")
    extern snd_pcm_open = (pcm: **u8, name: *u8, stream: i32, mode: i32) -> i32
    @lib("libasound.so.2")
    extern snd_pcm_set_params = (pcm: *u8, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency: u32) -> i32
    @lib("libasound.so.2")
    extern snd_pcm_avail_update = (pcm: *u8) -> int
    @lib("libasound.so.2")
    extern snd_pcm_writei = (pcm: *u8, buf: *u8, frames: int) -> int
    @lib("libasound.so.2")
    extern snd_pcm_recover = (pcm: *u8, err: i32, silent: i32) -> i32
    @lib("libasound.so.2")
    extern snd_pcm_prepare = (pcm: *u8) -> i32

    __pcm: *u8 = null

    __audio_start = ():
        if __audio_state != 0: return
        __audio_state = 2
        if env("SLOPPY_NO_AUDIO") != none: return
        if not lib_available("libasound.so.2"): return
        p: *u8 = null
        if snd_pcm_open(&p, data("default"), 0, 1) < 0: return       # playback, non-blocking
        # float32 little endian, interleaved, stereo, ~60 ms of latency
        if snd_pcm_set_params(p, 14, 3, 2, u32(MIX_RATE), 1, 60000) < 0: return
        __pcm = p
        __audio_state = 1

    __audio_update = ():
        if __audio_state != 1: return
        avail = snd_pcm_avail_update(__pcm)
        if avail < 0:
            snd_pcm_recover(__pcm, i32(avail), 1)
            return
        if avail == 0: return
        n = min(avail, 8192)
        __mix(n)
        r = snd_pcm_writei(__pcm, data(__mix_buf) as *u8, n)
        if r < 0: snd_pcm_recover(__pcm, i32(r), 1)
