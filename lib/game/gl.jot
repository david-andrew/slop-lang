    @lib("libGLESv2.so.2")
    extern fn glGenRenderbuffers(n: i32, out: *u32)
    @lib("libGLESv2.so.2")
    extern fn glDeleteRenderbuffers(n: i32, ids: *u32)
    @lib("libGLESv2.so.2")
    extern fn glBindRenderbuffer(target: u32, r: u32)
    @lib("libGLESv2.so.2")
    extern fn glRenderbufferStorage(target: u32, format: u32, w: i32, h: i32)
    @lib("libGLESv2.so.2")
    extern fn glFramebufferRenderbuffer(target: u32, attachment: u32, rbtarget: u32, rb: u32)
    @lib("libGLESv2.so.2")
    extern fn glCheckFramebufferStatus(target: u32) -> u32
    @lib("libGLESv2.so.2")
    extern fn glReadPixels(x: i32, y: i32, w: i32, h: i32, format: u32, ty: u32, data: *u8)

    fn __gl_gen(kind: int) -> int:
        id: u32 = 0
        if kind == 0: glGenBuffers(1, &id)
        else if kind == 1: glGenVertexArrays(1, &id)
        else if kind == 2: glGenTextures(1, &id)
        else if kind == 3: glGenFramebuffers(1, &id)
        else: glGenRenderbuffers(1, &id)
        int(id)
    fn __gl_del(kind: int, x: int):
        id := u32(x)
        if kind == 0: glDeleteBuffers(1, &id)
        else if kind == 1: glDeleteVertexArrays(1, &id)
        else if kind == 2: glDeleteTextures(1, &id)
        else if kind == 3: glDeleteFramebuffers(1, &id)
        else: glDeleteRenderbuffers(1, &id)
    fn gl_create_buffer() -> int: __gl_gen(0)
    fn gl_delete_buffer(b: int): __gl_del(0, b)
    fn gl_create_vertex_array() -> int: __gl_gen(1)
    fn gl_delete_vertex_array(v: int): __gl_del(1, v)
    fn gl_create_texture() -> int: __gl_gen(2)
    fn gl_delete_texture(t: int): __gl_del(2, t)
    fn gl_create_framebuffer() -> int: __gl_gen(3)
    fn gl_delete_framebuffer(f: int): __gl_del(3, f)
    fn gl_create_renderbuffer() -> int: __gl_gen(4)
    fn gl_delete_renderbuffer(r: int): __gl_del(4, r)

    fn __gl_shader(kind: int, src: str) -> int:
        s := glCreateShader(u32(kind))
        p := data(src)
        n := i32(len(src))
        glShaderSource(s, 1, &p, &n)
        glCompileShader(s)
        ok: i32 = 0
        glGetShaderiv(s, GL_COMPILE_STATUS, &ok)
        if ok == 0:
            buf := __alloc(4096)
            ln: i32 = 0
            glGetShaderInfoLog(s, 4095, &ln, buf)
            eprint("shader compile error:\n{__cstr(buf)}\n--- source ---\n{src}")
            panic("shader compilation failed")
        int(s)

    fn gl_create_program(vs: str, fs: str) -> int:
        v := __gl_shader(GL_VERTEX_SHADER, vs)
        f := __gl_shader(GL_FRAGMENT_SHADER, fs)
        p := glCreateProgram()
        glAttachShader(p, u32(v))
        glAttachShader(p, u32(f))
        glLinkProgram(p)
        ok: i32 = 0
        glGetProgramiv(p, GL_LINK_STATUS, &ok)
        if ok == 0:
            buf := __alloc(4096)
            ln: i32 = 0
            glGetProgramInfoLog(p, 4095, &ln, buf)
            eprint("shader link error:\n{__cstr(buf)}")
            panic("shader linking failed")
        glDeleteShader(u32(v))
        glDeleteShader(u32(f))
        int(p)

    fn gl_uniform_location(p: int, name: str) -> int: int(glGetUniformLocation(u32(p), data(__zstr(name))))
    fn gl_tex_image(w: int, h: int, internal: int, format: int, ty: int, pixels: *u8, size: int):
        glTexImage2D(GL_TEXTURE_2D, 0, i32(internal), i32(w), i32(h), 0, u32(format), u32(ty), pixels)
    fn gl_tex_sub_image(x: int, y: int, w: int, h: int, format: int, ty: int, pixels: *u8, size: int):
        glTexSubImage2D(GL_TEXTURE_2D, 0, i32(x), i32(y), i32(w), i32(h), u32(format), u32(ty), pixels)
    fn gl_read_pixels(x: int, y: int, w: int, h: int, out: *u8):
        glReadPixels(i32(x), i32(y), i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, out)
