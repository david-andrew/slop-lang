    extern fn glVertexAttribDivisor(i: u32, d: u32)
    extern fn glDrawArrays(mode: u32, first: i32, count: i32)
    extern fn glDrawElements(mode: u32, count: i32, ty: u32, offset: int)
    extern fn glDrawArraysInstanced(mode: u32, first: i32, count: i32, instances: i32)
    extern fn glDrawElementsInstanced(mode: u32, count: i32, ty: u32, offset: int, instances: i32)
    extern fn glCreateProgramFrom(vs: *u8, vs_len: i32, fs: *u8, fs_len: i32) -> u32
    extern fn glUseProgram(p: u32)
    extern fn glDeleteProgram(p: u32)
    extern fn glGetUniformLocationStr(p: u32, name: *u8, len: i32) -> i32
    extern fn glUniform1i(loc: i32, v: i32)
    extern fn glUniform1f(loc: i32, v: f32)
    extern fn glUniform2f(loc: i32, x: f32, y: f32)
    extern fn glUniform3f(loc: i32, x: f32, y: f32, z: f32)
    extern fn glUniform4f(loc: i32, x: f32, y: f32, z: f32, w: f32)
    extern fn glUniformMatrix4fv(loc: i32, count: i32, transpose: u8, v: *u8)
    extern fn glUniform4fv(loc: i32, count: i32, v: *u8)
    extern fn glCreateTexture() -> u32
    extern fn glDeleteTexture(t: u32)
    extern fn glBindTexture(target: u32, t: u32)
    extern fn glActiveTexture(unit: u32)
    extern fn glTexImage2D(target: u32, level: i32, internal: i32, w: i32, h: i32, border: i32, format: u32, ty: u32, data: *u8, size: i32)
    extern fn glTexSubImage2D(target: u32, level: i32, x: i32, y: i32, w: i32, h: i32, format: u32, ty: u32, data: *u8, size: i32)
    extern fn glTexParameteri(target: u32, pname: u32, v: i32)
    extern fn glGenerateMipmap(target: u32)
    extern fn glPixelStorei(pname: u32, v: i32)
    extern fn glCreateFramebuffer() -> u32
    extern fn glDeleteFramebuffer(f: u32)
    extern fn glBindFramebuffer(target: u32, f: u32)
    extern fn glFramebufferTexture2D(target: u32, attachment: u32, textarget: u32, tex: u32, level: i32)
    extern fn glCreateRenderbuffer() -> u32
    extern fn glDeleteRenderbuffer(r: u32)
    extern fn glBindRenderbuffer(target: u32, r: u32)
    extern fn glRenderbufferStorage(target: u32, format: u32, w: i32, h: i32)
    extern fn glFramebufferRenderbuffer(target: u32, attachment: u32, rbtarget: u32, rb: u32)
    extern fn glCheckFramebufferStatus(target: u32) -> u32
    extern fn glReadPixels(x: i32, y: i32, w: i32, h: i32, format: u32, ty: u32, data: *u8, size: i32)

    fn gl_create_buffer() -> int: int(glCreateBuffer())
    fn gl_delete_buffer(b: int): glDeleteBuffer(u32(b))
    fn gl_create_vertex_array() -> int: int(glCreateVertexArray())
    fn gl_delete_vertex_array(v: int): glDeleteVertexArray(u32(v))
    fn gl_create_texture() -> int: int(glCreateTexture())
    fn gl_delete_texture(t: int): glDeleteTexture(u32(t))
    fn gl_create_framebuffer() -> int: int(glCreateFramebuffer())
    fn gl_delete_framebuffer(f: int): glDeleteFramebuffer(u32(f))
    fn gl_create_renderbuffer() -> int: int(glCreateRenderbuffer())
    fn gl_delete_renderbuffer(r: int): glDeleteRenderbuffer(u32(r))
    fn gl_create_program(vs: str, fs: str) -> int: int(glCreateProgramFrom(data(vs), i32(len(vs)), data(fs), i32(len(fs))))
    fn gl_uniform_location(p: int, name: str) -> int: int(glGetUniformLocationStr(u32(p), data(name), i32(len(name))))
    fn gl_tex_image(w: int, h: int, internal: int, format: int, ty: int, pixels: *u8, size: int):
        glTexImage2D(GL_TEXTURE_2D, 0, i32(internal), i32(w), i32(h), 0, u32(format), u32(ty), pixels, i32(size))
    fn gl_tex_sub_image(x: int, y: int, w: int, h: int, format: int, ty: int, pixels: *u8, size: int):
        glTexSubImage2D(GL_TEXTURE_2D, 0, i32(x), i32(y), i32(w), i32(h), u32(format), u32(ty), pixels, i32(size))
    fn gl_read_pixels(x: int, y: int, w: int, h: int, out: *u8):
        glReadPixels(i32(x), i32(y), i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, out, i32(w * h * 4))
else:
    @lib("libGLESv2.so.2")
    extern fn glClearColor(r: f32, g: f32, b: f32, a: f32)
    @lib("libGLESv2.so.2")
