    # the GL entry points: the driver, or the software renderer (softgl.jot) when there is none
    fn glClearColor(r: f32, g: f32, b: f32, a: f32):
        if __soft:
            sgl_clear_color(r, g, b, a)
            return
        __glClearColor(r, g, b, a)
    fn glClear(mask: u32):
        if __soft:
            sgl_clear(mask)
            return
        __glClear(mask)
    fn glViewport(x: i32, y: i32, w: i32, h: i32):
        if __soft:
            sgl_viewport(x, y, w, h)
            return
        __glViewport(x, y, w, h)
    fn glScissor(x: i32, y: i32, w: i32, h: i32):
        if __soft:
            sgl_scissor(x, y, w, h)
            return
        __glScissor(x, y, w, h)
    fn glEnable(cap: u32):
        if __soft:
            sgl_enable(cap, true)
            return
        __glEnable(cap)
    fn glDisable(cap: u32):
        if __soft:
            sgl_enable(cap, false)
            return
        __glDisable(cap)
    fn glBlendFunc(s: u32, d: u32):
        if __soft:
            sgl_blend_func(s, d, s, d)
            return
        __glBlendFunc(s, d)
    fn glBlendFuncSeparate(s: u32, d: u32, sa: u32, da: u32):
        if __soft:
            sgl_blend_func(s, d, sa, da)
            return
        __glBlendFuncSeparate(s, d, sa, da)
    fn glDepthFunc(f: u32):
        if __soft:
            sgl_depth_func(f)
            return
        __glDepthFunc(f)
    fn glDepthMask(flag: u32):
        if __soft:
            sgl_depth_mask(flag)
            return
        __glDepthMask(flag)
    fn glCullFace(mode: u32):
        if __soft:
            sgl_cull_face(mode)
            return
        __glCullFace(mode)
    fn glFrontFace(mode: u32):
        if __soft: return
        __glFrontFace(mode)
    fn glColorMask(r: u32, g: u32, b: u32, a: u32):
        if __soft:
            sgl_color_mask(r, g, b, a)
            return
        __glColorMask(r, g, b, a)
    fn glBindBuffer(target: u32, b: u32):
        if __soft:
            sgl_bind_buffer(target, b)
            return
        __glBindBuffer(target, b)
    fn glBufferData(target: u32, size: int, data: *u8, usage: u32):
        if __soft:
            sgl_buffer_data(target, size, data)
            return
        __glBufferData(target, size, data, usage)
    fn glBufferSubData(target: u32, offset: int, size: int, data: *u8):
        if __soft:
            sgl_buffer_sub_data(target, offset, size, data)
            return
        __glBufferSubData(target, offset, size, data)
    fn glBindVertexArray(v: u32):
        if __soft: return
        __glBindVertexArray(v)
    fn glEnableVertexAttribArray(i: u32):
        if __soft: return
        __glEnableVertexAttribArray(i)
    fn glDisableVertexAttribArray(i: u32):
        if __soft: return
        __glDisableVertexAttribArray(i)
    fn glVertexAttribPointer(i: u32, size: i32, ty: u32, normalized: u8, stride: i32, offset: int):
        if __soft: return
        __glVertexAttribPointer(i, size, ty, normalized, stride, offset)
    fn glVertexAttribDivisor(i: u32, d: u32):
        if __soft: return
        __glVertexAttribDivisor(i, d)
    fn glDrawArrays(mode: u32, first: i32, count: i32):
        if __soft: return
        __glDrawArrays(mode, first, count)
    fn glDrawElements(mode: u32, count: i32, ty: u32, offset: int):
        if __soft: return
        __glDrawElements(mode, count, ty, offset)
    fn glDrawArraysInstanced(mode: u32, first: i32, count: i32, instances: i32):
        if __soft: return
        __glDrawArraysInstanced(mode, first, count, instances)
    fn glDrawElementsInstanced(mode: u32, count: i32, ty: u32, offset: int, instances: i32):
        if __soft: return
        __glDrawElementsInstanced(mode, count, ty, offset, instances)
    fn glUseProgram(p: u32):
        if __soft: return
        __glUseProgram(p)
    fn glDeleteProgram(p: u32):
        if __soft: return
        __glDeleteProgram(p)
    fn glUniform1i(loc: i32, v: i32):
        if __soft: return
        __glUniform1i(loc, v)
    fn glUniform1f(loc: i32, v: f32):
        if __soft: return
        __glUniform1f(loc, v)
    fn glUniform2f(loc: i32, x: f32, y: f32):
