        __glCheckFramebufferStatus(target)

    fn __gl_gen(kind: int) -> int:
        if __soft:
            if kind == 0: return sgl_create_buffer()
            if kind == 1: return 1
            if kind == 2: return sgl_create_texture()
            if kind == 3: return sgl_create_framebuffer()
            return sgl_create_renderbuffer()
        id: u32 = 0
        if kind == 0: __glGenBuffers(1, &id)
        else if kind == 1: __glGenVertexArrays(1, &id)
        else if kind == 2: __glGenTextures(1, &id)
        else if kind == 3: __glGenFramebuffers(1, &id)
        else: __glGenRenderbuffers(1, &id)
        int(id)
    fn __gl_del(kind: int, x: int):
        if __soft:
            if kind == 2: __st_alloc(x, 0, 0)
            return
        id := u32(x)
        if kind == 0: __glDeleteBuffers(1, &id)
        else if kind == 1: __glDeleteVertexArrays(1, &id)
        else if kind == 2: __glDeleteTextures(1, &id)
        else if kind == 3: __glDeleteFramebuffers(1, &id)
        else: __glDeleteRenderbuffers(1, &id)
    fn gl_create_buffer() -> int: __gl_gen(0)
    fn gl_delete_buffer(b: int): __gl_del(0, b)
    fn gl_create_vertex_array() -> int: __gl_gen(1)
    fn gl_delete_vertex_array(v: int): __gl_del(1, v)
    fn gl_create_texture() -> int: __gl_gen(2)
    fn gl_delete_texture(t: int): __gl_del(2, t)
    fn gl_create_framebuffer() -> int: __gl_gen(3)
    fn gl_delete_framebuffer(f: int): __gl_del(3, f)
    fn gl_create_renderbuffer() -> int: __gl_gen(4)
    fn gl_delete_renderbuffer(r: int): __gl_del(4, r)

    fn __gl_shader(kind: int, src: str) -> int:
        s := __glCreateShader(u32(kind))
        p := data(src)
        n := i32(len(src))
        __glShaderSource(s, 1, &p, &n)
        __glCompileShader(s)
        ok: i32 = 0
        __glGetShaderiv(s, GL_COMPILE_STATUS, &ok)
        if ok == 0:
            buf := __alloc(4096)
            ln: i32 = 0
            __glGetShaderInfoLog(s, 4095, &ln, buf)
            eprint("shader compile error:\n{__cstr(buf)}\n--- source ---\n{src}")
            panic("shader compilation failed")
        int(s)

    fn gl_create_program(vs: str, fs: str) -> int:
        if __soft: return sgl_create_program()
        v := __gl_shader(GL_VERTEX_SHADER, vs)
        f := __gl_shader(GL_FRAGMENT_SHADER, fs)
        p := __glCreateProgram()
        __glAttachShader(p, u32(v))
        __glAttachShader(p, u32(f))
        __glLinkProgram(p)
        ok: i32 = 0
        __glGetProgramiv(p, GL_LINK_STATUS, &ok)
        if ok == 0:
            buf := __alloc(4096)
            ln: i32 = 0
            __glGetProgramInfoLog(p, 4095, &ln, buf)
            eprint("shader link error:\n{__cstr(buf)}")
            panic("shader linking failed")
        __glDeleteShader(u32(v))
        __glDeleteShader(u32(f))
        int(p)

    fn gl_uniform_location(p: int, name: str) -> int:
        if __soft: return -1
        int(__glGetUniformLocation(u32(p), data(__zstr(name))))
    fn gl_tex_image(w: int, h: int, internal: int, format: int, ty: int, pixels: *u8, size: int):
        if __soft:
            sgl_tex_image(w, h, format, ty, pixels)
            return
        __glTexImage2D(GL_TEXTURE_2D, 0, i32(internal), i32(w), i32(h), 0, u32(format), u32(ty), pixels)
    fn gl_tex_sub_image(x: int, y: int, w: int, h: int, format: int, ty: int, pixels: *u8, size: int):
        if __soft:
            sgl_tex_sub_image(x, y, w, h, format, ty, pixels)
            return
        __glTexSubImage2D(GL_TEXTURE_2D, 0, i32(x), i32(y), i32(w), i32(h), u32(format), u32(ty), pixels)
    fn gl_read_pixels(x: int, y: int, w: int, h: int, out: *u8):
        if __soft:
            sgl_read_pixels(x, y, w, h, out)
            return
        __glReadPixels(i32(x), i32(y), i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, out)
