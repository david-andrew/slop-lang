# A frame statistics overlay: frame times as a graph, CPU time, time handing frames to the
# screen, and frames that took much longer than usual (stutter). show_stats() turns it on, as do
# JOT_STATS=1 and, in a web page, ?stats in the URL. JOT_STATS=log (?stats=log) prints the same
# numbers every two seconds instead, and each long frame as it happens.

const __STATS_N = 240
__stats_on = false
__stats_log = false
__stats_checked = false
__stats_interval: f64[]       # the time between consecutive frames (a ring)
__stats_cpu: f64[]            # update + draw + submitting the drawing
__stats_present: f64[]        # handing the frame to the screen (including waiting for vsync)
__stats_i = 0
__stats_last = -1.0
__last_present = 0.0

show_stats = (on: bool = true): __stats_on = on

__stats_record = (cpu: f64):
    if not __stats_checked:
        __stats_checked = true
        mode = env("JOT_STATS") ?? ""
        __stats_on = mode == "1"
        __stats_log = mode == "log"
    now = time()
    if __stats_interval.len() == 0:
        __stats_interval = fill(0.0, __STATS_N)
        __stats_cpu = fill(0.0, __STATS_N)
        __stats_present = fill(0.0, __STATS_N)
    if __stats_last >= 0.0:
        k = __stats_i % __STATS_N
        __stats_interval[k] = now - __stats_last
        __stats_cpu[k] = cpu
        __stats_present[k] = __last_present
        __stats_i += 1
        if __stats_log and __stats_i > 1 and now - __stats_last > __stats_typical(min(__stats_i, __STATS_N)) * 1.5 + 0.001:
            eprint("long frame: {(now - __stats_last) * 1000.0:.1} ms (cpu {cpu * 1000.0:.1} ms, present {__last_present * 1000.0:.1} ms)")
        if __stats_log and __stats_i % 120 == 0:
            st = __stats_summary(120)
            eprint("stats: {st.0}; {st.1}; {st.2}")
    __stats_last = now

# three lines about the last n frames (at most __STATS_N)
__stats_summary = (count: int) -> (str, str, str):
    n = min(min(count, __stats_i), __STATS_N)
    recent = min(n, 60)
    sum_i = 0.0
    sum_c = 0.0
    sum_p = 0.0
    worst = 0.0
    loop j in [0..recent):
        k = (__stats_i - 1 - j) % __STATS_N
        sum_i += __stats_interval[k]
        sum_c += __stats_cpu[k]
        sum_p += __stats_present[k]
    loop j in [0..n): worst = max(worst, __stats_interval[(__stats_i - 1 - j) % __STATS_N])
    avg = sum_i / f64(recent)
    typical = __stats_typical(n)
    long = 0
    loop j in [0..n):
        if __stats_interval[(__stats_i - 1 - j) % __STATS_N] > typical * 1.5 + 0.001: long += 1
    msec = (s: f64) -> str: "{s * 1000.0:.1}"
    ("{1.0 / max(avg, 0.0001):.0} fps   {msec(avg)} ms   (slowest {msec(worst)} ms)",
     "cpu {msec(sum_c / f64(recent))} ms   present {msec(sum_p / f64(recent))} ms",
     "long frames: {long} of the last {n}")

# the median of the last n frame intervals
__stats_typical = (n: int) -> f64:
    sorted: f64[]
    loop j in [0..n): sorted.push(__stats_interval[(__stats_i - 1 - j) % __STATS_N])
    sorted.sort()
    sorted[n / 2]

# (drawn over everything, in pixels)
__stats_draw = ():
    if not __stats_on or __stats_i == 0: return
    draw_to_screen()
    saved_proj = __proj
    saved_xform = __xform
    __proj = orthographic(0.0, f64(__win_w), f64(__win_h), 0.0, -1.0, 1.0)
    __xform = mat4()
    n = min(__stats_i, __STATS_N)
    st = __stats_summary(n)
    typical = __stats_typical(n)
    u = max(1.0, f64(__win_h) / 900.0)
    size = 15.0 * u
    gw = f64(__STATS_N) * 2.0 * u
    gh = 70.0 * u
    x0 = 10.0 * u
    y0 = 10.0 * u
    rect(x0 - 6.0 * u, y0 - 6.0 * u, gw + 12.0 * u, gh + 4.0 * size + 22.0 * u, vec4(0, 0, 0, 0.65))
    white = vec4(1, 1, 1, 1)
    grey = vec4(0.75, 0.75, 0.8, 1)
    text(st.0, vec2(f32(x0), f32(y0)), size, white)
    text(st.1, vec2(f32(x0), f32(y0 + size * 1.2)), size, grey)
    text(st.2, vec2(f32(x0), f32(y0 + size * 2.4)), size, grey)
    text("{__win_w}x{__win_h}  {__present_how()}", vec2(f32(x0), f32(y0 + size * 3.6)), size, grey)
    # the graph: one bar per frame, newest at the right; lines at 1/60 and 1/30 s
    gy = y0 + size * 4.8 + 4.0 * u
    scale = gh / 0.05                      # 50 ms tall
    loop j in [0..n):
        k = (__stats_i - n + j) % __STATS_N
        t = __stats_interval[k]
        c = vec4(0.3, 0.85, 0.4, 1)
        if t > typical * 1.5 + 0.001: c = vec4(1.0, 0.3, 0.25, 1)
        else if t > 1.0 / 50.0: c = vec4(1.0, 0.8, 0.2, 1)
        bh = min(t * scale, gh)
        x = x0 + gw - f64(n - j) * 2.0 * u
        rect(x, gy + gh - bh, 2.0 * u, bh, c)
        cb = min(__stats_cpu[k] * scale, bh)
        rect(x, gy + gh - cb, 2.0 * u, cb, vec4(0.35, 0.55, 1.0, 1))
    loop t in [1.0 / 60.0, 1.0 / 30.0]:
        rect(x0, gy + gh - t * scale, gw, max(1.0, u), vec4(1, 1, 1, 0.35))
    flush()
    __proj = saved_proj
    __xform = saved_xform
