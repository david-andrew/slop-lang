# Math basics.

const PI = 3.141592653589793
const TAU = 6.283185307179586
const E = 2.718281828459045
const INF = 1e308 * 10.0
const MAX_INT = 9223372036854775807
const MIN_INT = -9223372036854775807 - 1

fn abs(x: int) -> int:
    if x < 0: return -x
    x
fn abs(x: float) -> float:
    if x < 0.0: return -x
    x
fn abs(x: f32) -> f32:
    if x < 0.0: return -x
    x

fn min(a: int, b: int) -> int:
    if a < b: return a
    b
fn max(a: int, b: int) -> int:
    if a > b: return a
    b
fn min(a: float, b: float) -> float:
    if a < b: return a
    b
fn max(a: float, b: float) -> float:
    if a > b: return a
    b
fn min(a: f32, b: f32) -> f32:
    if a < b: return a
    b
fn max(a: f32, b: f32) -> f32:
    if a > b: return a
    b
fn clamp(x: int, lo: int, hi: int) -> int:
    if x < lo: return lo
    if x > hi: return hi
    x
fn clamp(x: float, lo: float, hi: float) -> float:
    if x < lo: return lo
    if x > hi: return hi
    x
fn clamp(x: f32, lo: f32, hi: f32) -> f32:
    if x < lo: return lo
    if x > hi: return hi
    x
fn sign(x: float) -> float:
    if x > 0.0: return 1.0
    if x < 0.0: return -1.0
    0.0
fn sign(x: int) -> int:
    if x > 0: return 1
    if x < 0: return -1
    0

fn floor(x: float) -> float:
    if x != x or x >= 4503599627370496.0 or x <= -4503599627370496.0: return x
    i := float(int(x))
    if i > x: return i - 1.0
    i
fn ceil(x: float) -> float:
    if x != x or x >= 4503599627370496.0 or x <= -4503599627370496.0: return x
    i := float(int(x))
    if i < x: return i + 1.0
    i
fn round(x: float) -> float:
    if x < 0.0: return -floor(-x + 0.5)
    floor(x + 0.5)
fn trunc(x: float) -> float:
    if x != x or x >= 4503599627370496.0 or x <= -4503599627370496.0: return x
    float(int(x))
fn fract(x: float) -> float: x - floor(x)
fn mod(x: float, y: float) -> float: x - y * floor(x / y)
fn mod(x: int, y: int) -> int:
    r := x % y
    if r < 0: return r + y
    r
fn is_nan(x: float) -> bool: x != x
fn lerp(a: float, b: float, t: float) -> float: a + (b - a) * t
fn smoothstep(e0: float, e1: float, x: float) -> float:
    t := clamp((x - e0) / (e1 - e0), 0.0, 1.0)
    t * t * (3.0 - 2.0 * t)

# reduce x to [-pi, pi]
# Elementary functions follow fdlibm (Sun Microsystems): argument reduction with split
# constants and minimax polynomials, accurate to about 1 ulp.

# sin/cos kernels on [-pi/4, pi/4]
fn __ksin(x: float) -> float:
    z := x * x
    v := z * x
    r := 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * (2.75573137070700676789e-06 + z * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)))
    x + v * (-1.66666666666666324348e-01 + z * r)

fn __kcos(x: float) -> float:
    z := x * x
    r := z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * (2.48015872894767294178e-05 + z * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))))
    hz := 0.5 * z
    w := 1.0 - hz
    w + (((1.0 - w) - hz) + z * r)

# x = n * pi/2 + r with |r| <= pi/4 (three-part pi/2 keeps r exact for large x)
fn __rem_pio2(x: float) -> (int, float):
    if x >= -0.7853981633974483 and x <= 0.7853981633974483: return (0, x)
    n := floor(x * 0.63661977236758134308 + 0.5)
    r := x - n * 1.57079632673412561417e+00
    r = r - n * 6.07710050630396597660e-11
    r = r - n * 2.02226624879595063154e-21
    (int(n), r)

fn sin(x: float) -> float:
    if x != x or x == INF or x == -INF: return 0.0 / 0.0
    n, r := __rem_pio2(x)
    match n & 3:
        0: __ksin(r)
        1: __kcos(r)
        2: -__ksin(r)
        _: -__kcos(r)

fn cos(x: float) -> float:
    if x != x or x == INF or x == -INF: return 0.0 / 0.0
    n, r := __rem_pio2(x)
    match n & 3:
        0: __kcos(r)
        1: -__ksin(r)
        2: -__kcos(r)
        _: __ksin(r)

fn tan(x: float) -> float: sin(x) / cos(x)

fn atan(x0: float) -> float:
    x := x0
    if x != x: return x
    neg := x < 0.0
    if neg: x = -x
    if x > 1e300: x = 1e300
    id := -1
    if x >= 0.4375:
        if x < 0.6875:
            id = 0
            x = (2.0 * x - 1.0) / (2.0 + x)
        else if x < 1.1875:
            id = 1
            x = (x - 1.0) / (x + 1.0)
        else if x < 2.4375:
            id = 2
            x = (x - 1.5) / (1.0 + 1.5 * x)
        else:
            id = 3
            x = -1.0 / x
    z := x * x
    w := z * z
    s1 := z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
    s2 := w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))))
    r := 0.0
    if id < 0: r = x - x * (s1 + s2)
    else:
        hi := 4.63647609000806093515e-01
        lo := 2.26987774529616870924e-17
        if id == 1:
            hi = 7.85398163397448278999e-01
            lo = 3.06161699786838301793e-17
        else if id == 2:
            hi = 9.82793723247329054082e-01
            lo = 1.39033110312309984516e-17
        else if id == 3:
            hi = 1.57079632679489655800e+00
            lo = 6.12323399573676603587e-17
        r = hi - ((x * (s1 + s2) - lo) - x)
    if neg: return -r
    r

fn atan2(y: float, x: float) -> float:
    if x != x or y != y: return x + y
    if x > 0.0: return atan(y / x)
    if x < 0.0:
        if y >= 0.0: return atan(y / x) + PI
        return atan(y / x) - PI
    if y > 0.0: return PI / 2.0
    if y < 0.0: return -PI / 2.0
    0.0

fn asin(x: float) -> float:
    if x >= 1.0: return PI / 2.0
    if x <= -1.0: return -PI / 2.0
    atan2(x, sqrt(1.0 - x * x))
fn acos(x: float) -> float: PI / 2.0 - asin(x)

fn exp(x: float) -> float:
    if x != x: return x
    if x > 709.782712893384: return INF
    if x < -745.1332191019411: return 0.0
    # x = k*ln2 + r, |r| <= ln2/2; exp(r) by a rational minimax approximation
    k := floor(x * 1.44269504088896338700 + 0.5)
    hi := x - k * 6.93147180369123816490e-01
    lo := k * 1.90821492927058770002e-10
    r := hi - lo
    t := r * r
    c := r - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 + t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 + t * 4.13813679705723846039e-08))))
    y := 1.0 - ((lo - (r * c) / (2.0 - c)) - hi)
    ki := int(k)
    if ki > 1000:
        y = y * __pow2(1000)
        ki -= 1000
    if ki < -1000:
        y = y * __pow2(-1000)
        ki += 1000
    y * __pow2(ki)

fn __pow2(k: int) -> float:
    if k < -1022: return __pow2(k + 60) / 1152921504606846976.0
    if k > 1023: return INF
    (u64(k + 1023) << 52) as float

fn log(x: float) -> float:
    if x != x or x < 0.0: return 0.0 / 0.0
    if x == 0.0: return -INF
    if x > 1.7976931348623157e308: return x
    # x = m * 2^e with m in [sqrt(1/2), sqrt(2))
    bits := x as u64
    e := int((bits >> 52) & 0x7FF) - 1023
    m := ((bits & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000) as float
    if e == -1023:
        # subnormal
        return log(x * 4503599627370496.0) - 36.04365338911715
    if m > 1.4142135623730951:
        m = m / 2.0
        e += 1
    f := m - 1.0
    sq := f / (2.0 + f)
    z := sq * sq
    w := z * z
    t1 := w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
    t2 := z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)))
    rr := t2 + t1
    hfsq := 0.5 * f * f
    fe := float(e)
    fe * 6.93147180369123816490e-01 - ((hfsq - (sq * (hfsq + rr) + fe * 1.90821492927058770002e-10)) - f)

fn log2(x: float) -> float: log(x) / 0.6931471805599453
fn log10(x: float) -> float: log(x) / 2.302585092994046

fn pow(x: float, y: float) -> float:
    if y == 0.0: return 1.0
    if x == 0.0: return 0.0
    yi := int(y)
    if float(yi) == y and yi >= -64 and yi <= 64:
        r := 1.0
        b := x
        n := yi
        if n < 0: n = -n
        while n > 0:
            if n & 1 == 1: r = r * b
            b = b * b
            n = n >> 1
        if yi < 0: return 1.0 / r
        return r
    if x < 0.0: return 0.0 / 0.0
    exp(y * log(x))

# f32 versions (shader code, games): computed in double with shorter polynomials, so they are
# within an ulp of the f32 result at a fraction of the cost of the full-precision ones
fn exp(x: f32) -> f32:
    if x != x: return x
    f32(__exp_fast(float(x)))

fn log(x: f32) -> f32:
    if x != x or x < 0.0: return f32(0.0 / 0.0)
    if x == 0.0: return f32(-INF)
    if float(x) > 3.4028234663852886e38: return x
    f32(__log_fast(float(x)))

fn pow(x: f32, y: f32) -> f32:
    if y == 0.0 or x == 1.0: return 1.0
    yi := int(y)
    if f32(yi) == y and yi >= -64 and yi <= 64:
        r := 1.0
        b := float(x)
        n := yi
        if n < 0: n = -n
        while n > 0:
            if n & 1 == 1: r = r * b
            b = b * b
            n = n >> 1
        if yi < 0: return f32(1.0 / r)
        return f32(r)
    if x == 0.0:
        if y > 0.0: return 0.0
        return f32(INF)
    if x < 0.0 or x != x or y != y: return f32(0.0 / 0.0)
    if float(x) > 3.4028234663852886e38:
        if y > 0.0: return x
        return 0.0
    f32(__exp_fast(float(y) * __log_fast(float(x))))

# e^t for results in the f32 range (relative error ~1e-12)
fn __exp_fast(t: float) -> float:
    if t > 89.0: return INF
    if t < -104.0: return 0.0
    u := t * 1.4426950408889634 + 0.5
    k := int(u)
    if float(k) > u: k -= 1
    r := t - float(k) * 0.6931471805599453
    p := 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * (2.48015873015873e-05 + r * 2.7557319223985893e-06))))))))
    p * ((u64(k + 1023) << 52) as float)

# ln x for positive, finite, normal doubles (absolute error ~1e-12)
fn __log_fast(d: float) -> float:
    bits := d as u64
    e := int((bits >> 52) & 0x7FF) - 1023
    m := ((bits & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000) as float
    if m > 1.4142135623730951:
        m = m * 0.5
        e += 1
    s := (m - 1.0) / (m + 1.0)
    z := s * s
    float(e) * 0.6931471805599453 + 2.0 * s * (1.0 + z * (0.3333333333333333 + z * (0.2 + z * (0.14285714285714285 + z * (0.1111111111111111 + z * (0.09090909090909091 + z * 0.07692307692307693))))))

fn pow(x: int, n: int) -> int:
    r := 1
    b := x
    e := n
    while e > 0:
        if e & 1 == 1: r = r * b
        b = b * b
        e = e >> 1
    r

fn hypot(x: float, y: float) -> float: sqrt(x * x + y * y)
fn radians(deg: float) -> float: deg * PI / 180.0
fn degrees(rad: float) -> float: rad * 180.0 / PI

# ---------------- random numbers (xoshiro256**) ----------------
struct Rng:
    s0: u64 = 0x9E3779B97F4A7C15
    s1: u64 = 0xBF58476D1CE4E5B9
    s2: u64 = 0x94D049BB133111EB
    s3: u64 = 0x2545F4914F6CDD1D

fn __rotl(x: u64, k: int) -> u64: (x << u64(k)) | (x >> u64(64 - k))

fn rng(seed: int) -> Rng:
    r := Rng()
    z := u64(seed) + 0x9E3779B97F4A7C15
    r.s0 = __splitmix(z)
    r.s1 = __splitmix(r.s0)
    r.s2 = __splitmix(r.s1)
    r.s3 = __splitmix(r.s2)
    r

fn __splitmix(x: u64) -> u64:
    z := x + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z ^ (z >> 31)

fn next_u64(r: mut Rng) -> u64:
    result := __rotl(r.s1 * 5, 7) * 9
    t := r.s1 << 17
    r.s2 = r.s2 ^ r.s0
    r.s3 = r.s3 ^ r.s1
    r.s1 = r.s1 ^ r.s2
    r.s0 = r.s0 ^ r.s3
    r.s2 = r.s2 ^ t
    r.s3 = __rotl(r.s3, 45)
    result

# uniform float in [0, 1)
fn next_float(r: mut Rng) -> float: float(next_u64(r) >> 11) * (1.0 / 9007199254740992.0)

# uniform int in [lo, hi)
fn next_int(r: mut Rng, lo: int, hi: int) -> int:
    if hi <= lo: return lo
    lo + int(next_u64(r) % u64(hi - lo))

__global_rng := rng(12345)

fn seed_random(seed: int): __global_rng = rng(seed)
# random float in [0, 1)
fn random() -> float: next_float(__global_rng)
# random float in [lo, hi)
fn random(lo: float, hi: float) -> float: lo + (hi - lo) * next_float(__global_rng)
# random int in [lo, hi)
fn random_int(lo: int, hi: int) -> int: next_int(__global_rng, lo, hi)
