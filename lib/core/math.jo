# Math basics.

const PI = 3.141592653589793
const TAU = 6.283185307179586
const E = 2.718281828459045
const INF = 1e308 * 10.0
const MAX_INT = 9223372036854775807
const MIN_INT = -9223372036854775807 - 1

abs = (x: int) -> int:
    if x < 0: return -x
    x
abs = (x: f64) -> f64:
    if x < 0.0: return -x
    x
abs = (x: f32) -> f32:
    if x < 0.0: return -x
    x

min = (a: int, b: int) -> int:
    if a < b: return a
    b
max = (a: int, b: int) -> int:
    if a > b: return a
    b
min = (a: f64, b: f64) -> f64:
    if a < b: return a
    b
max = (a: f64, b: f64) -> f64:
    if a > b: return a
    b
min = (a: f32, b: f32) -> f32:
    if a < b: return a
    b
max = (a: f32, b: f32) -> f32:
    if a > b: return a
    b
clamp = (x: int, lo: int, hi: int) -> int:
    if x < lo: return lo
    if x > hi: return hi
    x
clamp = (x: f64, lo: f64, hi: f64) -> f64:
    if x < lo: return lo
    if x > hi: return hi
    x
clamp = (x: f32, lo: f32, hi: f32) -> f32:
    if x < lo: return lo
    if x > hi: return hi
    x
sign = (x: f64) -> f64:
    if x > 0.0: return 1.0
    if x < 0.0: return -1.0
    0.0
sign = (x: int) -> int:
    if x > 0: return 1
    if x < 0: return -1
    0

floor = (x: f64) -> f64:
    if x != x or x >= 4503599627370496.0 or x <= -4503599627370496.0: return x
    i = f64(int(x))
    if i > x: return i - 1.0
    i
ceil = (x: f64) -> f64:
    if x != x or x >= 4503599627370496.0 or x <= -4503599627370496.0: return x
    i = f64(int(x))
    if i < x: return i + 1.0
    i
round = (x: f64) -> f64:
    if x < 0.0: return -floor(-x + 0.5)
    floor(x + 0.5)
trunc = (x: f64) -> f64:
    if x != x or x >= 4503599627370496.0 or x <= -4503599627370496.0: return x
    f64(int(x))
fract = (x: f64) -> f64: x - floor(x)
mod = (x: f64, y: f64) -> f64: x - y * floor(x / y)
mod = (x: int, y: int) -> int:
    r = x % y
    if r < 0: return r + y
    r
is_nan = (x: f64) -> bool: x != x
lerp = (a: f64, b: f64, t: f64) -> f64: a + (b - a) * t
smoothstep = (e0: f64, e1: f64, x: f64) -> f64:
    t = clamp((x - e0) / (e1 - e0), 0.0, 1.0)
    t * t * (3.0 - 2.0 * t)

# reduce x to [-pi, pi]
# Elementary functions follow fdlibm (Sun Microsystems): argument reduction with split
# constants and minimax polynomials, accurate to about 1 ulp.

# sin/cos kernels on [-pi/4, pi/4] for x + y (y: what the argument reduction could not fit in
# x); the polynomials in Estrin's form, with shorter chains of dependent operations than Horner's
__ksin = (x: f64, y: f64) -> f64:
    z = x * x
    w = z * z
    v = z * x
    r = (8.33333333332248946124e-03 + z * -1.98412698298579493134e-04) + w * ((2.75573137070700676789e-06 + z * -2.50507602534068634195e-08) + w * 1.58969099521155010221e-10)
    x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01)

__kcos = (x: f64, y: f64) -> f64:
    z = x * x
    w = z * z
    r = z * ((4.16666666666666019037e-02 + z * -1.38888888888741095749e-03) + w * ((2.48015872894767294178e-05 + z * -2.75573143513906633035e-07) + w * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))
    hz = 0.5 * z
    w1 = 1.0 - hz
    w1 + (((1.0 - w1) - hz) + (z * r - x * y))

# x = n * pi/2 + (y0 + y1) with |y0 + y1| <= pi/4 (fdlibm's reduction: pi/2 in parts, as many
# as the cancellation needs, so sin and cos are within an ulp for |x| < 2^20 * pi/2; beyond
# that the error grows, to about |x| * 1e-16)
struct __Reduced:
    n: int
    y0: f64
    y1: f64

__rem_pio2 = (x0: f64) -> __Reduced:
    x = abs(x0)
    fq = 0.0
    if x < 1647099.3291652855:
        fq = (x * 6.36619772367581382433e-01 + 6755399441055744.0) - 6755399441055744.0
    else: fq = floor(x * 6.36619772367581382433e-01 + 0.5)
    r = x - fq * 1.57079632673412561417e+00
    w = fq * 6.07710050650619224932e-11
    y0 = r - w
    j = int((x as u64) >> 52)
    if j - int(((y0 as u64) >> 52) & 0x7FF) > 16:
        t = r
        w = fq * 6.07710050630396597660e-11
        r = t - w
        w = fq * 2.02226624879595063154e-21 - ((t - r) - w)
        y0 = r - w
        if j - int(((y0 as u64) >> 52) & 0x7FF) > 49:
            t = r
            w = fq * 2.02226624871116645580e-21
            r = t - w
            w = fq * 8.47842766036889956997e-32 - ((t - r) - w)
            y0 = r - w
    y1 = (r - y0) - w
    if x0 < 0.0: return __Reduced(-int(fq), -y0, -y1)
    __Reduced(int(fq), y0, y1)

sin = (x: f64) -> f64:
    if x >= -0.7853981633974483 and x <= 0.7853981633974483: return __ksin(x, 0.0)
    __sin_q(x, 0)

cos = (x: f64) -> f64:
    if x >= -0.7853981633974483 and x <= 0.7853981633974483: return __kcos(x, 0.0)
    __sin_q(x, 1)

# sin(x + q * pi/2) for |x| > pi/4 (the first step of __rem_pio2 inline: it nearly always suffices)
__sin_q = (x: f64, q: int) -> f64:
    if x - x != 0.0: return 0.0 / 0.0          # (infinite or not a number)
    n = 0
    y0 = 0.0
    y1 = 0.0
    a = abs(x)
    done = false
    if a < 1647099.3291652855:
        fq = (a * 6.36619772367581382433e-01 + 6755399441055744.0) - 6755399441055744.0
        r = a - fq * 1.57079632673412561417e+00
        w = fq * 6.07710050650619224932e-11
        y0 = r - w
        if int((a as u64) >> 52) - int(((y0 as u64) >> 52) & 0x7FF) <= 16:
            y1 = (r - y0) - w
            n = int(fq)
            if x < 0.0:
                n = -n
                y0 = -y0
                y1 = -y1
            done = true
    if not done:
        rd = __rem_pio2(x)
        n = rd.n
        y0 = rd.y0
        y1 = rd.y1
    # __ksin or __kcos of (y0, y1), written out here (no calls: this is the common path)
    k = (n + q) & 3
    z = y0 * y0
    w = z * z
    r = 0.0
    if k & 1 == 0:
        v = z * y0
        p = (8.33333333332248946124e-03 + z * -1.98412698298579493134e-04) + w * ((2.75573137070700676789e-06 + z * -2.50507602534068634195e-08) + w * 1.58969099521155010221e-10)
        r = y0 - ((z * (0.5 * y1 - v * p) - y1) - v * -1.66666666666666324348e-01)
    else:
        p = z * ((4.16666666666666019037e-02 + z * -1.38888888888741095749e-03) + w * ((2.48015872894767294178e-05 + z * -2.75573143513906633035e-07) + w * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))
        hz = 0.5 * z
        w1 = 1.0 - hz
        r = w1 + (((1.0 - w1) - hz) + (z * p - y0 * y1))
    if k & 2 != 0: return -r
    r

tan = (x: f64) -> f64: sin(x) / cos(x)

atan = (x0: f64) -> f64:
    x = x0
    if x != x: return x
    neg = x < 0.0
    if neg: x = -x
    if x > 1e300: x = 1e300
    id = -1
    if x >= 0.4375:
        if x < 0.6875:
            id = 0
            x = (2.0 * x - 1.0) / (2.0 + x)
        else if x < 1.1875:
            id = 1
            x = (x - 1.0) / (x + 1.0)
        else if x < 2.4375:
            id = 2
            x = (x - 1.5) / (1.0 + 1.5 * x)
        else:
            id = 3
            x = -1.0 / x
    z = x * x
    w = z * z
    s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
    s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))))
    r = 0.0
    if id < 0: r = x - x * (s1 + s2)
    else:
        hi = 4.63647609000806093515e-01
        lo = 2.26987774529616870924e-17
        if id == 1:
            hi = 7.85398163397448278999e-01
            lo = 3.06161699786838301793e-17
        else if id == 2:
            hi = 9.82793723247329054082e-01
            lo = 1.39033110312309984516e-17
        else if id == 3:
            hi = 1.57079632679489655800e+00
            lo = 6.12323399573676603587e-17
        r = hi - ((x * (s1 + s2) - lo) - x)
    if neg: return -r
    r

atan2 = (y: f64, x: f64) -> f64:
    if x != x or y != y: return x + y
    if x > 0.0: return atan(y / x)
    if x < 0.0:
        if y >= 0.0: return atan(y / x) + PI
        return atan(y / x) - PI
    if y > 0.0: return PI / 2.0
    if y < 0.0: return -PI / 2.0
    0.0

asin = (x: f64) -> f64:
    if x >= 1.0: return PI / 2.0
    if x <= -1.0: return -PI / 2.0
    atan2(x, sqrt(1.0 - x * x))
acos = (x: f64) -> f64: PI / 2.0 - asin(x)

exp = (x: f64) -> f64:
    if x != x: return x
    if x > 709.782712893384: return INF
    if x < -745.1332191019411: return 0.0
    # x = k*ln2 + r, |r| <= ln2/2; exp(r) by a rational minimax approximation
    k = floor(x * 1.44269504088896338700 + 0.5)
    hi = x - k * 6.93147180369123816490e-01
    lo = k * 1.90821492927058770002e-10
    r = hi - lo
    t = r * r
    c = r - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 + t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 + t * 4.13813679705723846039e-08))))
    y = 1.0 - ((lo - (r * c) / (2.0 - c)) - hi)
    ki = int(k)
    if ki > 1000:
        y = y * __pow2(1000)
        ki -= 1000
    if ki < -1000:
        y = y * __pow2(-1000)
        ki += 1000
    y * __pow2(ki)

__pow2 = (k: int) -> f64:
    if k < -1022: return __pow2(k + 60) / 1152921504606846976.0
    if k > 1023: return INF
    (u64(k + 1023) << 52) as f64

log = (x: f64) -> f64:
    if x != x or x < 0.0: return 0.0 / 0.0
    if x == 0.0: return -INF
    if x > 1.7976931348623157e308: return x
    # x = m * 2^e with m in [sqrt(1/2), sqrt(2))
    bits = x as u64
    e = int((bits >> 52) & 0x7FF) - 1023
    m = ((bits & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000) as f64
    if e == -1023:
        # subnormal
        return log(x * 4503599627370496.0) - 36.04365338911715
    if m > 1.4142135623730951:
        m = m / 2.0
        e += 1
    f = m - 1.0
    sq = f / (2.0 + f)
    z = sq * sq
    w = z * z
    t1 = w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
    t2 = z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)))
    rr = t2 + t1
    hfsq = 0.5 * f * f
    fe = f64(e)
    fe * 6.93147180369123816490e-01 - ((hfsq - (sq * (hfsq + rr) + fe * 1.90821492927058770002e-10)) - f)

log2 = (x: f64) -> f64: log(x) / 0.6931471805599453
log10 = (x: f64) -> f64: log(x) / 2.302585092994046

pow = (x: f64, y: f64) -> f64:
    if y == 0.0: return 1.0
    if x == 0.0: return 0.0
    yi = int(y)
    if f64(yi) == y and yi >= -64 and yi <= 64:
        r = 1.0
        b = x
        n = yi
        if n < 0: n = -n
        loop n > 0:
            if n & 1 == 1: r = r * b
            b = b * b
            n = n >> 1
        if yi < 0: return 1.0 / r
        return r
    if x < 0.0: return 0.0 / 0.0
    exp(y * log(x))

# f32 versions (shader code, games): computed in double with shorter polynomials, so they are
# within an ulp of the f32 result at a fraction of the cost of the full-precision ones
exp = (x: f32) -> f32:
    if x != x: return x
    f32(__exp_fast(f64(x)))

log = (x: f32) -> f32:
    if x != x or x < 0.0: return f32(0.0 / 0.0)
    if x == 0.0: return f32(-INF)
    if f64(x) > 3.4028234663852886e38: return x
    f32(__log_fast(f64(x)))

pow = (x: f32, y: f32) -> f32:
    if y == 0.0 or x == 1.0: return 1.0
    yi = int(y)
    if f32(yi) == y and yi >= -64 and yi <= 64:
        r = 1.0
        b = f64(x)
        n = yi
        if n < 0: n = -n
        loop n > 0:
            if n & 1 == 1: r = r * b
            b = b * b
            n = n >> 1
        if yi < 0: return f32(1.0 / r)
        return f32(r)
    if x == 0.0:
        if y > 0.0: return 0.0
        return f32(INF)
    if x < 0.0 or x != x or y != y: return f32(0.0 / 0.0)
    if f64(x) > 3.4028234663852886e38:
        if y > 0.0: return x
        return 0.0
    f32(__exp_fast(f64(y) * __log_fast(f64(x))))

# e^t for results in the f32 range (relative error ~1e-12)
__exp_fast = (t: f64) -> f64:
    if t > 89.0: return INF
    if t < -104.0: return 0.0
    u = t * 1.4426950408889634 + 0.5
    k = int(u)
    if f64(k) > u: k -= 1
    r = t - f64(k) * 0.6931471805599453
    p = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * (2.48015873015873e-05 + r * 2.7557319223985893e-06))))))))
    p * ((u64(k + 1023) << 52) as f64)

# ln x for positive, finite, normal doubles (absolute error ~1e-12)
__log_fast = (d: f64) -> f64:
    bits = d as u64
    e = int((bits >> 52) & 0x7FF) - 1023
    m = ((bits & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000) as f64
    if m > 1.4142135623730951:
        m = m * 0.5
        e += 1
    s = (m - 1.0) / (m + 1.0)
    z = s * s
    f64(e) * 0.6931471805599453 + 2.0 * s * (1.0 + z * (0.3333333333333333 + z * (0.2 + z * (0.14285714285714285 + z * (0.1111111111111111 + z * (0.09090909090909091 + z * 0.07692307692307693))))))

pow = (x: int, n: int) -> int:
    r = 1
    b = x
    e = n
    loop e > 0:
        if e & 1 == 1: r = r * b
        b = b * b
        e = e >> 1
    r

hypot = (x: f64, y: f64) -> f64: sqrt(x * x + y * y)
radians = (deg: f64) -> f64: deg * PI / 180.0
degrees = (rad: f64) -> f64: rad * 180.0 / PI

# ---------------- random numbers (xoshiro256**) ----------------
struct Rng:
    s0: u64 = 0x9E3779B97F4A7C15
    s1: u64 = 0xBF58476D1CE4E5B9
    s2: u64 = 0x94D049BB133111EB
    s3: u64 = 0x2545F4914F6CDD1D

__rotl = (x: u64, k: int) -> u64: (x << u64(k)) | (x >> u64(64 - k))

rng = (seed: int) -> Rng:
    r = Rng()
    z = u64(seed) + 0x9E3779B97F4A7C15
    r.s0 = __splitmix(z)
    r.s1 = __splitmix(r.s0)
    r.s2 = __splitmix(r.s1)
    r.s3 = __splitmix(r.s2)
    r

__splitmix = (x: u64) -> u64:
    z = x + 0x9E3779B97F4A7C15
    z = ((z xor (z >> 30))) * 0xBF58476D1CE4E5B9
    z = ((z xor (z >> 27))) * 0x94D049BB133111EB
    (z xor (z >> 31))

next_u64 = (r: mut Rng) -> u64:
    result = __rotl(r.s1 * 5, 7) * 9
    t = r.s1 << 17
    r.s2 = (r.s2 xor r.s0)
    r.s3 = (r.s3 xor r.s1)
    r.s1 = (r.s1 xor r.s2)
    r.s0 = (r.s0 xor r.s3)
    r.s2 = (r.s2 xor t)
    r.s3 = __rotl(r.s3, 45)
    result

# uniform f64 in [0, 1)
next_float = (r: mut Rng) -> f64: f64(next_u64(r) >> 11) * (1.0 / 9007199254740992.0)

# uniform int in [lo, hi)
next_int = (r: mut Rng, lo: int, hi: int) -> int:
    if hi <= lo: return lo
    lo + int(next_u64(r) % u64(hi - lo))

__global_rng = rng(12345)

seed_random = (seed: int): __global_rng = rng(seed)
# random f64 in [0, 1)
random = () -> f64: next_float(__global_rng)
# random f64 in [lo, hi)
random = (lo: f64, hi: f64) -> f64: lo + (hi - lo) * next_float(__global_rng)
# random int in [lo, hi)
random_int = (lo: int, hi: int) -> int: next_int(__global_rng, lo, hi)
