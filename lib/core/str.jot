# String utilities. Strings are immutable UTF-8 byte sequences; indexing gives bytes.

fn is_digit(c: u8) -> bool: c >= '0' and c <= '9'
fn is_alpha(c: u8) -> bool: (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
fn is_alnum(c: u8) -> bool: is_alpha(c) or is_digit(c)
fn is_space(c: u8) -> bool: c == ' ' or c == '\t' or c == '\n' or c == '\r'
fn is_upper(c: u8) -> bool: c >= 'A' and c <= 'Z'
fn is_lower(c: u8) -> bool: c >= 'a' and c <= 'z'

# string made of a single byte
fn chr(c: int) -> str:
    b: [u8]
    b.push(u8(c & 255))
    str_from_bytes(b)

fn find(s: str, sub: str, start: int = 0) -> int:
    n := len(s)
    m := len(sub)
    if m == 0: return start
    i := start
    first := sub[0]
    while i + m <= n:
        if s[i] == first and __mem_eq(data(s) + i, data(sub), m): return i
        i += 1
    -1

fn rfind(s: str, sub: str) -> int:
    n := len(s)
    m := len(sub)
    i := n - m
    while i >= 0:
        if __mem_eq(data(s) + i, data(sub), m): return i
        i -= 1
    -1

fn find_byte(s: str, c: u8, start: int = 0) -> int:
    i := start
    n := len(s)
    p := data(s)
    while i < n:
        if p[i] == c: return i
        i += 1
    -1

fn contains(s: str, sub: str) -> bool: find(s, sub) >= 0

fn starts_with(s: str, prefix: str) -> bool:
    m := len(prefix)
    if m > len(s): return false
    __mem_eq(data(s), data(prefix), m)

fn ends_with(s: str, suffix: str) -> bool:
    m := len(suffix)
    n := len(s)
    if m > n: return false
    __mem_eq(data(s) + n - m, data(suffix), m)

fn trim(s: str) -> str:
    a := 0
    b := len(s)
    while a < b and is_space(s[a]): a += 1
    while b > a and is_space(s[b - 1]): b -= 1
    s[a..b]

fn trim_start(s: str) -> str:
    a := 0
    while a < len(s) and is_space(s[a]): a += 1
    s[a..]

fn trim_end(s: str) -> str:
    b := len(s)
    while b > 0 and is_space(s[b - 1]): b -= 1
    s[..b]

fn split(s: str, sep: str) -> [str]:
    out: [str]
    if len(sep) == 0:
        for c in s: out.push(chr(int(c)))
        return out
    start := 0
    while true:
        i := find(s, sep, start)
        if i < 0:
            out.push(s[start..])
            return out
        out.push(s[start..i])
        start = i + len(sep)
    out

# split on runs of whitespace
fn words(s: str) -> [str]:
    out: [str]
    i := 0
    n := len(s)
    while i < n:
        while i < n and is_space(s[i]): i += 1
        if i >= n: break
        j := i
        while j < n and not is_space(s[j]): j += 1
        out.push(s[i..j])
        i = j
    out

fn lines(s: str) -> [str]:
    out := split(s, "\n")
    if out.len() > 0 and len(out[out.len() - 1]) == 0: out.pop()
    for mut l in out:
        if len(l) > 0 and l[len(l) - 1] == '\r': l = l[..len(l) - 1]
    out

fn join(parts: [str], sep: str = "") -> str:
    buf: [u8]
    for i, p in parts:
        if i > 0: __buf_append_str(buf, sep)
        __buf_append_str(buf, p)
    __buf_finish_val(buf)

fn __buf_finish_val(buf: [u8]) -> str: str_from_bytes(buf)

fn replace(s: str, old: str, new: str) -> str:
    if len(old) == 0: return s
    buf: [u8]
    start := 0
    while true:
        i := find(s, old, start)
        if i < 0: break
        __buf_append_raw(buf, data(s) + start, i - start)
        __buf_append_str(buf, new)
        start = i + len(old)
    __buf_append_raw(buf, data(s) + start, len(s) - start)
    str_from_bytes(buf)

fn repeat(s: str, n: int) -> str:
    buf: [u8]
    for i in 0..n: __buf_append_str(buf, s)
    str_from_bytes(buf)

fn *(s: str, n: int) -> str: repeat(s, n)

fn upper(s: str) -> str:
    b := bytes(s)
    for mut c in b:
        if c >= 'a' and c <= 'z': c = c - 32
    str_from_bytes(b)

fn lower(s: str) -> str:
    b := bytes(s)
    for mut c in b:
        if c >= 'A' and c <= 'Z': c = c + 32
    str_from_bytes(b)

fn to_int(s: str) -> int?:
    t := trim(s)
    n := len(t)
    if n == 0: return none
    i := 0
    neg := false
    if t[0] == '-' or t[0] == '+':
        neg = t[0] == '-'
        i = 1
    if i >= n: return none
    base := 10
    if i + 1 < n and t[i] == '0' and (t[i + 1] == 'x' or t[i + 1] == 'X'):
        base = 16
        i += 2
    v := 0
    any := false
    while i < n:
        c := t[i]
        d := -1
        if c >= '0' and c <= '9': d = int(c) - 48
        else if c >= 'a' and c <= 'f': d = int(c) - 87
        else if c >= 'A' and c <= 'F': d = int(c) - 55
        else if c == '_':
            i += 1
            continue
        if d < 0 or d >= base: return none
        v = v * base + d
        any = true
        i += 1
    if not any: return none
    if neg: return -v
    v

# Parse a decimal number. The result is the double nearest to the exact decimal value
# (ties to even), like C's strtod: an estimate, then exact big-integer comparisons.
fn to_float(s: str) -> float?:
    t := trim(s)
    n := len(t)
    if n == 0: return none
    i := 0
    neg := false
    if t[0] == '-' or t[0] == '+':
        neg = t[0] == '-'
        i = 1
    if t[i..] == "inf":
        if neg: return -1e308 * 10.0
        return 1e308 * 10.0
    if t[i..] == "nan": return 0.0 / 0.0
    digs: [u8]            # significant digits (leading zeros dropped)
    exp := 0              # value = digs * 10^exp
    any := false
    while i < n and is_digit(t[i]):
        if digs.len() > 0 or t[i] != '0': digs.push(t[i] - '0')
        any = true
        i += 1
    if i < n and t[i] == '.':
        i += 1
        while i < n and is_digit(t[i]):
            if digs.len() > 0 or t[i] != '0': digs.push(t[i] - '0')
            exp -= 1
            any = true
            i += 1
    if not any: return none
    if i < n and (t[i] == 'e' or t[i] == 'E'):
        i += 1
        eneg := false
        if i < n and (t[i] == '-' or t[i] == '+'):
            eneg = t[i] == '-'
            i += 1
        e := 0
        if i >= n: return none
        while i < n and is_digit(t[i]):
            if e < 100000: e = e * 10 + int(t[i]) - 48
            i += 1
        if eneg: exp -= e
        else: exp += e
    if i != n: return none
    v := __decimal_to_float(digs, exp)
    if neg: return -v
    v

fn __decimal_to_float(digs0: [u8], exp0: int) -> float:
    digs := digs0
    exp := exp0
    # trailing zeros only scale the exponent
    while digs.len() > 0 and digs[digs.len() - 1] == 0:
        digs.pop()
        exp += 1
    if digs.len() == 0: return 0.0
    if exp + digs.len() > 310: return 1e308 * 10.0
    if exp + digs.len() < -330: return 0.0
    # very long inputs: keep 780 digits plus a sticky digit (enough to decide the rounding)
    if digs.len() > 780:
        exp += digs.len() - 781
        digs.truncate(780)
        digs.push(1)
    mant: u64 = 0
    for k in 0..min(digs.len(), 19): mant = mant * 10 + u64(digs[k])
    e19 := exp + max(digs.len() - 19, 0)
    # fast path (Clinger): exact operands, one correctly rounded operation
    if digs.len() <= 15 and exp >= -22 and exp <= 22:
        if exp >= 0: return float(mant) * __pow10(exp)
        return float(mant) / __pow10(-exp)
    x := __scale10(float(mant), e19)
    if x != x: x = 1e308
    __float_correct(digs, exp, x)

# nudge the estimate x until it is the double nearest to digs * 10^exp
fn __float_correct(digs: [u8], exp: int, x0: float) -> float:
    d := __big_from_digits(digs)
    x := x0
    if x > 1.7976931348623157e308: x = 1.7976931348623157e308
    if x <= 0.0: x = 5e-324
    for iter in 0..80:
        bits := x as u64
        ef := int((bits >> 52) & 0x7FF)
        m := int(bits & 0x000FFFFFFFFFFFFF)
        k := -1074
        if ef > 0:
            m = m | (1 << 52)
            k = ef - 1075
        # above the halfway point to the next double?
        c := __cmp_scaled(d, exp, 2 * m + 1, k - 1)
        if c > 0 or (c == 0 and m & 1 == 1):
            if bits == 0x7FEFFFFFFFFFFFFF: return 1e308 * 10.0
            x = (bits + 1) as float
            continue
        # below the halfway point to the previous one? (the gap halves below a power of two)
        c2 := 0
        if m == 1 << 52 and ef > 1: c2 = __cmp_scaled(d, exp, 4 * m - 1, k - 2)
        else: c2 = __cmp_scaled(d, exp, 2 * m - 1, k - 1)
        if c2 < 0 or (c2 == 0 and m & 1 == 1):
            if bits == 1: return 0.0
            x = (bits - 1) as float
            continue
        return x
    x

# ---- minimal unsigned big integers: little-endian 32-bit limbs in ints ----
fn __big_from_digits(digs: [u8]) -> [int]:
    b := [0]
    k := 0
    while k < digs.len():
        # take up to 9 digits at a time
        chunk := 0
        p := 1
        j := 0
        while j < 9 and k < digs.len():
            chunk = chunk * 10 + int(digs[k])
            p *= 10
            j += 1
            k += 1
        __big_mul_small(b, p)
        __big_add_small(b, chunk)
    b

fn __big_mul_small(b: mut [int], m: int):
    carry := 0
    for i in 0..b.len():
        v := b[i] * m + carry
        b[i] = v & 0xFFFFFFFF
        carry = v >> 32
    while carry > 0:
        b.push(carry & 0xFFFFFFFF)
        carry = carry >> 32

fn __big_add_small(b: mut [int], a: int):
    carry := a
    i := 0
    while carry > 0:
        if i == b.len(): b.push(0)
        v := b[i] + carry
        b[i] = v & 0xFFFFFFFF
        carry = v >> 32
        i += 1

fn __big_mul_pow10(b: mut [int], e: int):
    k := e
    while k >= 9:
        __big_mul_small(b, 1000000000)
        k -= 9
    p := 1
    for _ in 0..k: p *= 10
    if p > 1: __big_mul_small(b, p)

fn __big_shl(b: mut [int], bits: int):
    if bits <= 0: return
    words := bits / 32
    r := bits % 32
    if r > 0:
        carry := 0
        for i in 0..b.len():
            v := (b[i] << r) | carry
            b[i] = v & 0xFFFFFFFF
            carry = (v >> 32) & 0xFFFFFFFF
        if carry > 0: b.push(carry)
    if words > 0:
        old := b.len()
        b.resize(old + words)
        i := old - 1
        while i >= 0:
            b[i + words] = b[i]
            i -= 1
        for j in 0..words: b[j] = 0

fn __big_of(v: int) -> [int]:
    if v >> 32 == 0: return [v]
    [v & 0xFFFFFFFF, v >> 32]

# a + b as a new number
fn __big_add(a: [int], b: [int]) -> [int]:
    n := max(a.len(), b.len())
    out := [0; n]
    carry := 0
    for i in 0..n:
        v := carry
        if i < a.len(): v += a[i]
        if i < b.len(): v += b[i]
        out[i] = v & 0xFFFFFFFF
        carry = v >> 32
    if carry > 0: out.push(carry)
    out

# a -= b (requires a >= b)
fn __big_sub(a: mut [int], b: [int]):
    borrow := 0
    for i in 0..a.len():
        v := a[i] - borrow
        if i < b.len(): v -= b[i]
        borrow = 0
        if v < 0:
            v += 1 << 32
            borrow = 1
        a[i] = v

fn __big_shr(b: mut [int], bits: int):
    words := bits / 32
    r := bits % 32
    if words >= b.len():
        b.clear()
        b.push(0)
        return
    if words > 0:
        for i in 0..b.len() - words: b[i] = b[i + words]
        b.truncate(b.len() - words)
    if r > 0:
        for i in 0..b.len():
            hi := 0
            if i + 1 < b.len(): hi = b[i + 1]
            b[i] = ((b[i] >> r) | (hi << (32 - r))) & 0xFFFFFFFF

# divide in place by a small number; returns the remainder
fn __big_divmod_small(b: mut [int], d: int) -> int:
    rem := 0
    i := b.len() - 1
    while i >= 0:
        cur := (rem << 32) | b[i]
        b[i] = cur / d
        rem = cur % d
        i -= 1
    rem

fn __big_to_dec(b0: [int]) -> str:
    b := b0
    chunks: [int]
    while true:
        nz := false
        for w in b:
            if w != 0: nz = true
        if not nz: break
        chunks.push(__big_divmod_small(b, 1000000000))
    if chunks.len() == 0: return "0"
    out := "{chunks[chunks.len() - 1]}"
    i := chunks.len() - 2
    while i >= 0:
        c := "{chunks[i]}"
        out = out + repeat("0", 9 - len(c)) + c
        i -= 1
    out

fn __big_cmp(a0: [int], b0: [int]) -> int:
    a := a0
    b := b0
    na := a.len()
    nb := b.len()
    while na > 0 and a[na - 1] == 0: na -= 1
    while nb > 0 and b[nb - 1] == 0: nb -= 1
    if na != nb:
        if na < nb: return -1
        return 1
    i := na - 1
    while i >= 0:
        if a[i] != b[i]:
            if a[i] < b[i]: return -1
            return 1
        i -= 1
    0

# compare d * 10^exp with q * 2^e (all exact)
fn __cmp_scaled(d: [int], exp: int, q: int, e: int) -> int:
    lhs := d
    rhs: [int] = [q & 0xFFFFFFFF, q >> 32]
    if exp >= 0: __big_mul_pow10(lhs, exp)
    else: __big_mul_pow10(rhs, -exp)
    if e >= 0: __big_shl(rhs, e)
    else: __big_shl(lhs, -e)
    __big_cmp(lhs, rhs)

fn reverse(s: str) -> str:
    b := bytes(s)
    n := b.len()
    i := 0
    while i < n / 2:
        t := b[i]
        b[i] = b[n - 1 - i]
        b[n - 1 - i] = t
        i += 1
    str_from_bytes(b)

# number of unicode code points
fn char_count(s: str) -> int:
    n := 0
    for c in s:
        if c & 0xC0 != 0x80: n += 1
    n

# unicode code points of s
fn chars(s: str) -> [int]:
    out: [int]
    i := 0
    n := len(s)
    while i < n:
        c := int(s[i])
        if c < 0x80:
            out.push(c)
            i += 1
        else if c < 0xE0 and i + 1 < n:
            out.push(((c & 0x1F) << 6) | (int(s[i + 1]) & 0x3F))
            i += 2
        else if c < 0xF0 and i + 2 < n:
            out.push(((c & 0x0F) << 12) | ((int(s[i + 1]) & 0x3F) << 6) | (int(s[i + 2]) & 0x3F))
            i += 3
        else if i + 3 < n:
            out.push(((c & 0x07) << 18) | ((int(s[i + 1]) & 0x3F) << 12) | ((int(s[i + 2]) & 0x3F) << 6) | (int(s[i + 3]) & 0x3F))
            i += 4
        else:
            out.push(0xFFFD)
            i += 1
    out

fn hash(s: str) -> u64: __str_hash(s)
