# 3D scene: terrain, instanced trees, shadows, sky, fog and bloom.
hill = (x: f64, z: f64) -> f64: 2.5 * sin(x * 0.15) * cos(z * 0.12) + 0.8 * sin(x * 0.5 + z * 0.3)
ground_color = (x: f64, y: f64, z: f64) -> vec4:
    lerp(rgb(0.35, 0.55, 0.25), rgb(0.75, 0.7, 0.5), f32(clamp((y + 2.0) / 5.0, 0.0, 1.0)))

terrain = terrain_mesh(120, 120, hill, ground_color)
trunk = cylinder_mesh(0.15, 1.2, 8)
crown = cone_mesh(0.9, 2.2, 10)
ball = sphere_mesh(0.6)
trees: Instance3D[]
crowns: Instance3D[]
seed_random(7)
loop i in [0..300):
    x = random(-55.0, 55.0)
    z = random(-55.0, 55.0)
    y = hill(x, z)
    s = random(0.7, 1.4)
    trees.push(instance(transform(vec3(f32(x), f32(y), f32(z)), 0.0, s), rgb(0.45, 0.3, 0.2)))
    crowns.push(instance(transform(vec3(f32(x), f32(y + 1.0 * s), f32(z)), random(0.0, 6.0), s), rgb(0.2, f32(random(0.45, 0.6)), 0.25)))
t = 0.0

update = (dt: f64): t += dt

draw = ():
    clear(BLACK)
    sun(vec3(0.6, 0.5, 0.3), vec3(1.0, 0.9, 0.75))
    sky(vec3(0.2, 0.4, 0.8), vec3(0.85, 0.75, 0.65))
    fog(vec3(0.85, 0.78, 0.7), 0.012)
    post_effects(0.5, 0.75, 0.3)
    a = t * 0.15
    camera3d(vec3(f32(cos(a) * 22.0), 9, f32(sin(a) * 22.0)), vec3(0, 1, 0))
    draw_mesh(terrain)
    draw_mesh_instanced(trunk, trees)
    draw_mesh_instanced(crown, crowns, wind = 0.05)
    draw_mesh(ball, translation(vec3(0, f32(hill(0.0, 0.0) + 1.5 + sin(t * 2.0) * 0.5), 0)), rgb(1, 0.5, 0.2), emissive = 1.5)
    text("3D: terrain, 600 instanced meshes, shadows, fog, bloom   fps {fps():.0}", vec2(20, 20), 22)
