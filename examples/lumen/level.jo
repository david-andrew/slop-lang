# The valleys of Lumen: how each is made (from a seed: no level files), what is in it, and how
# it is drawn. lumen.jo plays them.

struct Valley:
    name: str
    length: f64                 # how far it goes
    seed: int
    ledges: f64                 # chance of floating ledges over each stretch of ground
    thorns: f64                 # chance of thorns on each stretch
    pits: f64                   # gaps between stretches of ground: how wide at most
    moving: f64                 # chance a ledge drifts
    dusk: vec3                  # the sky's color before the light returns
    dawn: vec3                  # and after

valleys = [
    Valley("Dusk Meadow", 4200.0, 2024, 0.6, 0.3, 200.0, 0.0, vec3(0.16, 0.14, 0.3), vec3(0.3, 0.42, 0.72)),
    Valley("Thorn Hollow", 5200.0, 77, 0.8, 0.75, 300.0, 0.0, vec3(0.2, 0.1, 0.22), vec3(0.42, 0.3, 0.6)),
    Valley("Drifting Isles", 5600.0, 913, 1.0, 0.5, 420.0, 0.6, vec3(0.08, 0.14, 0.26), vec3(0.24, 0.5, 0.7)),
    Valley("The Old Tree", 7200.0, 4096, 0.9, 0.7, 380.0, 0.35, vec3(0.12, 0.1, 0.2), vec3(0.36, 0.44, 0.78)),
]

const GROUND_Y = 600.0

struct Platform:
    rect: Rect
    home: vec2                  # where a drifting ledge's path is centered
    sway: vec2 = vec2(0, 0)     # how far it drifts each way (zero: it stays)
    speed: f64 = 0.0
    phase: f64 = 0.0
    moved: vec2 = vec2(0, 0)    # how far it moved in the last step

struct Seed:
    pos: vec2
    taken = false
    phase: f32

struct Flower:
    pos: vec2
    glow: f32 = 0.0
    hue: f32

struct Vine:
    top: vec2
    len: f32
    phase: f32

# what is in the valley being played
valley = valleys[0]
platforms: Platform[]
seeds: Seed[]
thorns: Rect[]
flowers: Flower[]
vines: Vine[]
clouds: vec3[]                  # x, y, size
hills: vec2[][]
world_w = 4200.0

build_valley = (v: Valley):
    valley = v
    world_w = v.length
    seed_random(v.seed)
    platforms.clear()
    seeds.clear()
    thorns.clear()
    x = -200.0
    loop x < world_w:
        w = random(500.0, 1100.0)
        if x + w > world_w - 600.0: w = world_w + 400.0 - x       # (the last stretch reaches the end)
        h = random(-60.0, 60.0)
        ground(Rect(f32(x), f32(GROUND_Y + h), f32(w), 400))
        if random() < v.ledges and x > 300.0 and w > 400.0:
            lw = random(140.0, 260.0)
            ly = GROUND_Y + h - random(150.0, 260.0)
            lx = x + random(40.0, w - lw - 40.0)
            ledge(Rect(f32(lx), f32(ly), f32(lw), 24), v)
            seeds.push(Seed(vec2(f32(lx + lw / 2.0), f32(ly - 50.0)), phase = f32(random(0.0, 6.0))))
            if random() < 0.5:
                l2 = lx + random(-120.0, 160.0)
                ledge(Rect(f32(l2), f32(ly - 170.0), 150, 24), v)
                seeds.push(Seed(vec2(f32(l2 + 75.0), f32(ly - 220.0)), phase = f32(random(0.0, 6.0))))
        if x > 600.0 and x < world_w - 700.0 and random() < v.thorns:
            tx = x + random(100.0, w - 200.0)
            if tx < world_w - 700.0: thorns.push(Rect(f32(tx), f32(GROUND_Y + h - 22.0), f32(random(60.0, 140.0)), 22))
        seeds.push(Seed(vec2(f32(x + w * 0.5), f32(GROUND_Y + h - 60.0)), phase = f32(random(0.0, 6.0))))
        gap = random(120.0, v.pits)
        # (a wide pit gets a ledge over it, to cross by)
        if gap > 260.0:
            sx = x + w + gap / 2.0 - 80.0
            ledge(Rect(f32(sx), f32(GROUND_Y - 120.0), 160, 24), v)
        x += w + gap
    flowers.clear()
    vines.clear()
    loop p in platforms:
        r = p.rect
        if r.h > 100.0:
            fx = r.x + 60.0
            loop fx < r.x + r.w - 40.0:
                if random() < 0.35: flowers.push(Flower(vec2(f32(fx), r.y), hue = f32(random(0.85, 1.12))))
                fx += f32(random(70.0, 160.0))
        else if p.speed == 0.0:
            loop k in [0..int(r.w / 40.0)):
                if random() < 0.6: vines.push(Vine(vec2(r.x + f32(k) * 40.0 + 15.0, r.y + r.h - 4.0), f32(random(30.0, 110.0)), f32(random(0.0, 6.0))))
    clouds.clear()
    loop k in [0..14): clouds.push(vec3(f32(random(-400.0, 3000.0)), f32(random(40.0, 260.0)), f32(random(60.0, 140.0))))
    hills.clear()
    loop layer in [0..4):
        pts: vec2[]
        loop i in [0..80):
            hx = f64(i) * 160.0 - 400.0
            hy = 330.0 + f64(layer) * 75.0 - fbm(hx * 0.002 + f64(layer + v.seed) * 10.0, f64(layer)) * 240.0
            pts.push(vec2(f32(hx), f32(hy)))
        hills.push(pts)

ground = (r: Rect): platforms.push(Platform(r, vec2(r.x, r.y)))

ledge = (r: Rect, v: Valley):
    p = Platform(r, vec2(r.x, r.y))
    if random() < v.moving:
        if random() < 0.5: p.sway = vec2(f32(random(80.0, 180.0)), 0)
        else: p.sway = vec2(0, f32(random(50.0, 110.0)))
        p.speed = random(0.6, 1.2)
        p.phase = random(0.0, TAU)
    platforms.push(p)

# drifting ledges move along their paths
move_platforms = (t: f64):
    loop mut p in platforms:
        if p.speed == 0.0: continue
        to = p.home + p.sway * f32(sin(t * p.speed + p.phase))
        p.moved = to - vec2(p.rect.x, p.rect.y)
        p.rect.x = to.x
        p.rect.y = to.y

# the index of the platform r overlaps, or -1
solid_at = (r: Rect) -> int:
    loop i in 0.. and p in platforms:
        if overlaps(r, p.rect): return i
    -1

# ---------------- drawing ----------------
# palette: dusk at the start; warmer and richer as the light returns (color_t from 0 to 1)
sky_top = (color_t: f32) -> vec4:
    a = valley.dusk
    b = valley.dawn
    lerp(rgb(a.x, a.y, a.z), rgb(b.x, b.y, b.z), color_t)
sky_bottom = (color_t: f32) -> vec4: lerp(rgb(0.78, 0.5, 0.48), rgb(1.0, 0.8, 0.62), color_t)
mist = (color_t: f32) -> vec4: lerp(rgb(0.62, 0.5, 0.6), rgb(0.98, 0.78, 0.7), color_t)

draw_background = (cam: vec2, color_t: f32):
    t = f32(elapsed())
    v = visible_rect()
    rect_gradient(f64(v.x), f64(v.y), f64(v.z), f64(v.w), sky_top(color_t), sky_bottom(color_t))
    sun = vec2(f32(880.0 - cam.x * 0.02), f32(330.0 - 140.0 * color_t))
    blend(.add)
    circle_gradient(sun, 420, rgba(1, 0.75, 0.55, 0.35), rgba(1, 0.6, 0.5, 0))
    circle_gradient(sun, 90, rgba(1, 0.95, 0.85, 0.9), rgba(1, 0.85, 0.7, 0))
    blend(.alpha)
    loop c in clouds:
        cx = (c.x - cam.x * 0.05 + t * 6.0) % 3400.0 - 300.0
        if cx < -300.0 or cx > 1600.0: continue
        col = lerp(rgba(0.85, 0.75, 0.85, 0.16), rgba(1, 0.9, 0.92, 0.13), color_t)
        clear_ = vec4(col.x, col.y, col.z, 0)
        loop k in [0..5):
            off = vec2(f32((f64(k) - 2.0) * f64(c.z) * 0.45), f32(sin(f64(k) * 1.7) * f64(c.z) * 0.12))
            circle_gradient(vec2(f32(cx), c.y) + off, f64(c.z) * (0.7 + 0.2 * f64(k % 2)), col, clear_)
    loop layer in [0..4):
        depth = 0.08 + 0.16 * f32(layer)
        far = 1.0 - f32(layer) / 3.0
        base = lerp(lerp(rgb(0.42, 0.34, 0.5), rgb(0.62, 0.58, 0.78), color_t), lerp(rgb(0.16, 0.13, 0.22), rgb(0.22, 0.28, 0.32), color_t), f32(layer) / 3.0)
        top = lerp(base, mist(color_t), far * 0.35)
        bottom = lerp(base, mist(color_t), 0.55)
        pts = hills[layer]
        ox = -cam.x * depth
        oy = -cam.y * depth * 0.5
        loop i in [0..pts.len() - 1):
            a = pts[i] + vec2(ox, oy)
            b = pts[i + 1] + vec2(ox, oy)
            if b.x < -200.0 or a.x > 1500.0: continue
            quad_gradient(a, b, vec2(b.x, 1400), vec2(a.x, 1400), top, top, bottom, bottom)
        my = 520.0 + f64(layer) * 40.0 + f64(oy)
        m = mist(color_t)
        rect_gradient(f64(v.x), my - 120.0, f64(v.z), 220, rgba(m.x, m.y, m.z, 0), rgba(m.x, m.y, m.z, 0.28))
        bottom_y = f64(v.y + v.w)
        if layer == 3 and bottom_y > my + 100.0: rect(f64(v.x), my + 100.0, f64(v.z), bottom_y - my - 100.0, rgba(m.x, m.y, m.z, 0.28))

fract_hash = (x: f64) -> f64:
    v = sin(x * 12.9898) * 43758.5453
    v - floor(v)

draw_ground = (p: Rect, t: f32, color_t: f32):
    top = lerp(rgb(0.24, 0.22, 0.3), rgb(0.2, 0.36, 0.34), color_t)
    deep = rgb(0.05, 0.04, 0.07)
    step = 24.0
    x = f64(p.x)
    prev = vec2(p.x, p.y + f32(fbm(x * 0.03, 1.0) * 8.0 - 4.0))
    loop x < f64(p.x + p.w):
        nx = min(x + step, f64(p.x + p.w))
        cur = vec2(f32(nx), p.y + f32(fbm(nx * 0.03, 1.0) * 8.0 - 4.0))
        quad_gradient(prev, cur, vec2(cur.x, p.y + p.h), vec2(prev.x, p.y + p.h), top, top, deep, deep)
        line(prev, cur, 3, lerp(rgba(0.75, 0.7, 0.8, 0.5), rgba(0.95, 0.85, 0.6, 0.7), color_t))
        gx = (prev.x + cur.x) * 0.5
        if fract_hash(f64(gx)) > 0.35:
            sway = sinf(t * 1.6 + gx * 0.05) * 5.0
            gc = lerp(rgb(0.3, 0.3, 0.36), rgb(0.35, 0.62, 0.45), color_t)
            loop b in [0..3):
                bx = gx + f32(b) * 5.0 - 5.0
                hgt = 10.0 + 8.0 * f32(fract_hash(f64(bx) * 3.1))
                triangle(vec2(bx - 2.0, prev.y + 2.0), vec2(bx + sway + f32(b - 1) * 3.0, prev.y - hgt), vec2(bx + 2.0, prev.y + 2.0), gc)
        prev = cur
        x = nx

draw_ledge = (p: Platform, color_t: f32):
    r = p.rect
    top = lerp(rgb(0.3, 0.27, 0.36), rgb(0.42, 0.36, 0.42), color_t)
    if p.speed != 0.0: top = lerp(rgb(0.32, 0.3, 0.44), rgb(0.42, 0.5, 0.62), color_t)
    bottom = rgb(0.1, 0.08, 0.13)
    rr = f64(r.h) / 2.0
    circle(vec2(r.x + f32(rr), r.y + f32(rr)), rr, lerp(top, bottom, 0.5))
    circle(vec2(r.x + r.w - f32(rr), r.y + f32(rr)), rr, lerp(top, bottom, 0.5))
    rect_gradient(f64(r.x) + rr, f64(r.y), f64(r.w) - rr * 2.0, f64(r.h), top, bottom)
    rect(f64(r.x) + rr * 0.5, f64(r.y), f64(r.w) - rr, 3, lerp(rgba(0.8, 0.75, 0.85, 0.45), rgba(1, 0.9, 0.7, 0.6), color_t))
    if p.speed != 0.0:
        # drifting stones glow faintly underneath
        blend(.add)
        circle_gradient(vec2(r.x + r.w / 2.0, r.y + r.h), f64(r.w) * 0.5, rgba(0.6, 0.8, 1, 0.18), rgba(0.5, 0.7, 1, 0))
        blend(.alpha)

# the old tree (and, in the other valleys, a young one): branches recurse; blossoms open as
# the light returns
draw_branch = (pos: vec2, angle: f64, len: f64, depth: int, lit: f32, t: f32):
    sway = sin(f64(t) * 0.7 + f64(pos.x) * 0.01) * 0.025 * f64(7 - depth)
    end = pos + from_angle(angle + sway) * f32(len)
    line(pos, end, f64(depth) * 3.2 + 1.5, lerp(rgb(0.1, 0.08, 0.12), rgb(0.22, 0.14, 0.16), lit))
    if depth == 0:
        n = 1 + int(4.0 * f64(lit))
        loop k in [0..n):
            off = from_angle(f64(k) * 2.4 + f64(end.x)) * f32(6.0 + 9.0 * f64(lit))
            bc = lerp(rgba(0.38, 0.34, 0.42, 0.9), hsv(0.92 + 0.12 * fract_hash(f64(end.x) + f64(k)), 0.38, 1.0), lit)
            circle(end + off, 6.0 + 7.0 * f64(lit), bc)
        if lit > 0.3:
            blend(.add)
            circle_gradient(end, 30, rgba(1, 0.8, 0.85, 0.12 * lit), rgba(1, 0.7, 0.8, 0))
            blend(.alpha)
        return
    up = -PI / 2.0
    spread = 0.32 + 0.18 * fract_hash(f64(pos.x) * 1.3 + f64(depth))
    loop side in [-1.0, 1.0]:
        a = angle + side * spread
        a = a + (up - a) * 0.18
        draw_branch(end, a, len * (0.68 + 0.08 * fract_hash(f64(end.y) + side)), depth - 1, lit, t)

# where the tree at the end of the valley stands: on the ground there
tree_pos = () -> vec2:
    x = f32(world_w - 250.0)
    loop p in platforms:
        if p.rect.h > 100.0 and x >= p.rect.x and x <= p.rect.x + p.rect.w: return vec2(x, p.rect.y + 4.0)
    vec2(x, f32(GROUND_Y))

draw_valley = (cam: vec2, color_t: f32, lit: f32, final_tree: bool):
    t = f32(elapsed())
    loop v in vines:
        if v.top.x < cam.x - 100.0 or v.top.x > cam.x + 1400.0: continue
        sw = sinf(t * 1.3 + v.phase) * 6.0
        line(v.top, v.top + vec2(sw, v.len), 2, lerp(rgba(0.3, 0.3, 0.38, 0.9), rgba(0.3, 0.55, 0.4, 0.9), color_t))
        circle(v.top + vec2(sw, v.len), 3, lerp(rgba(0.5, 0.45, 0.55, 1), rgba(0.95, 0.6, 0.7, 1), color_t))
    loop p in platforms:
        r = p.rect
        if r.x > cam.x + 1400.0 or r.x + r.w < cam.x - 100.0: continue
        if r.h > 100.0: draw_ground(r, t, color_t)
        else: draw_ledge(p, color_t)
    loop r in thorns:
        n = int(r.w / 18.0)
        loop k in [0..n):
            bx = r.x + f32(k) * 18.0
            triangle(vec2(bx, r.y + r.h), vec2(bx + 9.0, r.y - 6.0 * sinf(t * 3.0 + bx)), vec2(bx + 18.0, r.y + r.h), lerp(rgb(0.4, 0.15, 0.25), rgb(0.62, 0.12, 0.28), color_t))
    loop f in flowers:
        if f.pos.x < cam.x - 50.0 or f.pos.x > cam.x + 1350.0: continue
        stem = f.pos + vec2(0, -26)
        line(f.pos, stem, 2, lerp(rgb(0.3, 0.3, 0.35), rgb(0.3, 0.55, 0.4), color_t))
        petal = lerp(rgba(0.55, 0.5, 0.6, 1), hsv(f64(f.hue % 1.0), 0.55, 1.0), f32(max(f64(f.glow), f64(color_t) * 0.6)))
        loop k in [0..5):
            circle(stem + from_angle(f64(k) * TAU / 5.0 + f64(t) * 0.2) * 6.0, 5, petal)
        if f.glow > 0.01:
            blend(.add)
            circle_gradient(stem, 40, rgba(1, 0.8, 0.6, 0.35 * f.glow), rgba(1, 0.6, 0.5, 0))
            blend(.alpha)
        circle(stem, 3, rgba(1, 0.9, 0.6, 1))
    blend(.add)
    loop s in seeds:
        if s.taken: continue
        bob = vec2(0, sinf(t * 2.0 + s.phase) * 6.0)
        circle_gradient(s.pos + bob, 38, rgba(1, 0.8, 0.45, 0.6), rgba(1, 0.5, 0.2, 0))
        circle(s.pos + bob, 7, rgba(1, 0.95, 0.85, 1))
    tree = tree_pos()
    size = 70.0
    depth = 5
    if final_tree:
        size = 120.0
        depth = 7
    circle_gradient(tree + vec2(0, f32(-size * 2.2)), size * 2.8, rgba(1, 0.8, 0.6, 0.08 + 0.22 * lit), rgba(1, 0.6, 0.4, 0))
    blend(.alpha)
    draw_branch(tree, -PI / 2.0, size, depth, lit, t)
