# LUMEN - a small 2D platformer vertical slice written in Jot.
# Guide a spirit of light across a dusky valley, gather the scattered light seeds and
# wake the old tree. Arrows/WASD to move, Space/Up to jump (double jump in the air).

build:
    output = "lumen"

enum State: title, play, won

struct Player:
    pos: vec2
    vel: vec2
    on_ground = false
    coyote: f32 = 0.0
    jumps = 0
    facing: f32 = 1.0
    trail: vec2[]
    hurt: f32 = 0.0

struct Seed:
    pos: vec2
    taken = false
    phase: f32

struct Thorn:
    rect: Rect

const GRAVITY = 1900.0
const RUN = 420.0
const JUMP = 760.0
const WORLD_W = 7200.0
const GROUND_Y = 600.0

state = State.title
player = Player(vec2(120, 400), vec2(0, 0))
start_x = 120.0
platforms: Rect[]
seeds: Seed[]
thorns: Thorn[]
checkpoint = vec2(120, 400)
cam = vec2(0, 0)
shake = 0.0
sparks = Particles(gravity = vec2(0, -40), drag = 1.5)
motes = Particles(gravity = vec2(0, -12), drag = 0.3)
collected = 0
deaths = 0
play_time = 0.0
won_time = 0.0
music_id = 0
chime_pitch = 1.0
hills: vec2[][]

struct Flower:
    pos: vec2
    glow: f32 = 0.0
    hue: f32

struct Vine:
    top: vec2
    len: f32
    phase: f32

flowers: Flower[]
vines: Vine[]
clouds: vec3[]                  # x, y, size
color_t = 0.0                  # how much color has returned to the world (Gris-like restoration)

# ---------------- world generation ----------------
build_world = ():
    seed_random(2024)
    platforms.clear()
    seeds.clear()
    thorns.clear()
    x = -200.0
    loop x < WORLD_W:
        w = random(500.0, 1100.0)
        h = random(-60.0, 60.0)
        platforms.push(Rect(f32(x), f32(GROUND_Y + h), f32(w), 400))
        # floating ledges above the ground
        if random() < 0.8 and x > 300.0:
            lw = random(140.0, 260.0)
            ly = GROUND_Y + h - random(150.0, 260.0)
            lx = x + random(40.0, w - lw - 40.0)
            platforms.push(Rect(f32(lx), f32(ly), f32(lw), 24))
            seeds.push(Seed(vec2(f32(lx + lw / 2.0), f32(ly - 50.0)), phase = f32(random(0.0, 6.0))))
            if random() < 0.5:
                l2 = lx + random(-120.0, 160.0)
                platforms.push(Rect(f32(l2), f32(ly - 170.0), 150, 24))
                seeds.push(Seed(vec2(f32(l2 + 75.0), f32(ly - 220.0)), phase = f32(random(0.0, 6.0))))
        # thorns on the ground
        if x > 600.0 and random() < 0.6:
            tx = x + random(100.0, w - 200.0)
            thorns.push(Thorn(Rect(f32(tx), f32(GROUND_Y + h - 22.0), f32(random(60.0, 140.0)), 22)))
        seeds.push(Seed(vec2(f32(x + w * 0.5), f32(GROUND_Y + h - 60.0)), phase = f32(random(0.0, 6.0))))
        x += w + random(120.0, 260.0)
    # flowers on the ground and vines under the ledges
    flowers.clear()
    vines.clear()
    loop p in platforms:
        if p.h > 100.0:
            fx = p.x + 60.0
            loop fx < p.x + p.w - 40.0:
                if random() < 0.35: flowers.push(Flower(vec2(f32(fx), p.y), hue = f32(random(0.85, 1.12))))
                fx += f32(random(70.0, 160.0))
        else:
            loop k in [0..int(p.w / 40.0)):
                if random() < 0.6: vines.push(Vine(vec2(p.x + f32(k) * 40.0 + 15.0, p.y + p.h - 4.0), f32(random(30.0, 110.0)), f32(random(0.0, 6.0))))
    clouds.clear()
    loop k in [0..14): clouds.push(vec3(f32(random(-400.0, 3000.0)), f32(random(40.0, 260.0)), f32(random(60.0, 140.0))))
    # background hill silhouettes (parallax layers)
    hills.clear()
    loop layer in [0..4):
        pts: vec2[]
        loop i in [0..80):
            hx = f64(i) * 160.0 - 400.0
            hy = 330.0 + f64(layer) * 75.0 - fbm(hx * 0.002 + f64(layer) * 10.0, f64(layer)) * 240.0
            pts.push(vec2(f32(hx), f32(hy)))
        hills.push(pts)

reset = ():
    build_world()
    player = Player(vec2(f32(start_x), 300), vec2(0, 0))
    checkpoint = player.pos
    collected = 0
    deaths = 0
    play_time = 0.0
    chime_pitch = 1.0

# ---------------- audio ----------------
snd_jump = sfx_jump()
snd_chime = sfx_chime()
snd_hit = sfx_hit()
snd_land = tone(90.0, 0.08, .sine, 0.25, 0.001, 0.07)
theme = mix([melody("E4 - G4 B4 - A4 G4 - E4 - D4 E4 - - . . C4 - E4 G4 - F#4 E4 - B3 - C4 D4 - - . .", 84.0, .triangle, 0.16),
              melody("E3 - - - - - - - C3 - - - - - - - A2 - - - - - - - B2 - - - - - - -", 84.0, .sine, 0.18)])

# ---------------- gameplay ----------------
solid_at = (r: Rect) -> int:
    loop i in 0.. and p in platforms:
        if overlaps(r, p): return i
    -1

player_rect = (p: vec2) -> Rect: Rect(p.x - 14.0, p.y - 34.0, 28, 34)

move_player = (dt: f64):
    input = input_axis()
    target = input.x * f32(RUN)
    accel = 12.0
    if not player.on_ground: accel = 6.0
    player.vel.x = f32(approach(f64(player.vel.x), f64(target), accel, dt))
    if input.x != 0.0: player.facing = sign(input.x)
    player.coyote -= f32(dt)
    if key_pressed(.space) or key_pressed(.up) or key_pressed(.w) or gamepad_pressed(.a):
        if player.on_ground or player.coyote > 0.0:
            player.vel.y = f32(-JUMP)
            player.jumps = 1
            player.coyote = 0.0
            play(snd_jump, 0.5, pitch = random(0.95, 1.05))
            emit(sparks, player.pos, 10, 160.0, rgba(1, 0.9, 0.6, 0.8), 0.5, 5.0, PI, PI / 2.0)
        else if player.jumps < 2:
            player.vel.y = f32(-JUMP * 0.85)
            player.jumps = 2
            play(snd_jump, 0.4, pitch = 1.3)
            emit(sparks, player.pos, 16, 220.0, rgba(0.6, 0.9, 1, 0.9), 0.6, 5.0)
    # variable jump height
    if player.vel.y < 0.0 and not (key_down(.space) or key_down(.up) or key_down(.w) or gamepad_down(.a)): player.vel.y += f32(GRAVITY * dt)
    player.vel.y = min(player.vel.y + f32(GRAVITY * dt), 1400.0)
    # horizontal then vertical collision
    was_ground = player.on_ground
    nx = player.pos + vec2(player.vel.x * f32(dt), 0)
    if solid_at(player_rect(nx)) < 0: player.pos = nx
    else: player.vel.x = 0.0
    ny = player.pos + vec2(0, player.vel.y * f32(dt))
    hit = solid_at(player_rect(ny))
    player.on_ground = false
    if hit < 0: player.pos = ny
    else:
        p = platforms[hit]
        if player.vel.y > 0.0:
            player.pos.y = p.y
            player.on_ground = true
            player.coyote = 0.12
            player.jumps = 0
            if not was_ground and player.vel.y > 500.0:
                play(snd_land, 0.6)
                emit(motes, player.pos, 6, 80.0, rgba(1, 1, 1, 0.4), 0.6, 3.0, PI, -PI / 2.0)
        else: player.pos.y = p.y + p.h + 34.0
        player.vel.y = 0.0
    player.pos.x = clamp(player.pos.x, 20.0, f32(WORLD_W))
    # hazards and falling
    pr = player_rect(player.pos)
    loop t in thorns:
        if overlaps(pr, t.rect): hurt()
    if player.pos.y > 1400.0: hurt()
    if player.on_ground and player.pos.x > checkpoint.x + 600.0: checkpoint = player.pos
    # trail
    player.trail.insert(0, player.pos + vec2(0, -18))
    if player.trail.len() > 18: player.trail.pop()

hurt = ():
    play(snd_hit, 0.7)
    shake = 14.0
    deaths += 1
    emit(sparks, player.pos, 40, 400.0, rgba(1, 0.4, 0.3, 1), 0.8, 6.0)
    player.pos = checkpoint
    player.vel = vec2(0, 0)
    player.trail.clear()

collect_seeds = ():
    loop mut s in seeds:
        if s.taken: continue
        if circles_overlap(player.pos + vec2(0, -18), 26.0, s.pos, 18.0):
            s.taken = true
            collected += 1
            play(snd_chime, 0.5, pitch = chime_pitch)
            chime_pitch = min(chime_pitch * 1.06, 2.2)
            emit(sparks, s.pos, 30, 260.0, rgba(1, 0.85, 0.4, 1), 0.9, 6.0)

update = (dt: f64):
    if state == .title:
        if key_pressed(.space) or key_pressed(.enter) or gamepad_pressed(.a) or gamepad_pressed(.start):
            reset()
            color_t = 0.0
            state = .play
            music_id = play(theme, 0.7, looping = true)
        return
    if state == .won:
        won_time += dt
        update(sparks, dt)
        if every(1, 0.4): emit(sparks, vec2(f32(WORLD_W - 250.0), 300), 25, 300.0, hsv(random(), 0.5, 1.0), 1.5, 7.0)
        if key_pressed(.enter): state = .title
        return
    play_time += dt
    move_player(dt)
    collect_seeds()
    goal = f32(collected) / f32(max(seeds.len(), 1))
    color_t = approach(color_t, goal, 1.5, dt)
    loop mut f in flowers:
        near = length(f.pos - player.pos) < 110.0
        if near: f.glow = min(f.glow + f32(dt) * 3.0, 1.0)
        else: f.glow = max(f.glow - f32(dt) * 0.15, 0.0)
    update(sparks, dt)
    update(motes, dt)
    if every(2, 0.05): emit(motes, cam + vec2(f32(random(0.0, 1280.0)), 760), 1, 30.0, rgba(1, 0.9, 0.7, 0.5), 6.0, 3.0, 0.5, -PI / 2.0)
    if player.pos.x > WORLD_W - 300.0 and collected * 10 >= seeds.len() * 6:
        state = .won
        won_time = 0.0
        play(sfx_powerup(), 0.6)
    target = vec2(player.pos.x - 520.0 + player.facing * 90.0, player.pos.y - 430.0)
    cam = approach(cam, target, 4.0, dt)
    cam.y = clamp(cam.y, -200.0, 200.0)
    shake = approach(shake, 0.0, 6.0, dt)
    if key_pressed(.escape): quit()

# ---------------- drawing ----------------
progress = () -> f32: clamp(cam.x / f32(WORLD_W), 0.0, 1.0)

# palette: muted dusk at the start; warmer and richer as light returns
sky_top = () -> vec4: lerp(rgb(0.16, 0.14, 0.3), rgb(0.3, 0.42, 0.72), color_t)
sky_bottom = () -> vec4: lerp(rgb(0.78, 0.5, 0.48), rgb(1.0, 0.8, 0.62), color_t)
mist = () -> vec4: lerp(rgb(0.62, 0.5, 0.6), rgb(0.98, 0.78, 0.7), color_t)

draw_background = ():
    t = f32(elapsed())
    w = f64(screen_width())
    h = f64(screen_height())
    rect_gradient(0, 0, w, h, sky_top(), sky_bottom())
    # a large soft sun
    sun = vec2(f32(880.0 - cam.x * 0.02), f32(330.0 - 140.0 * color_t))
    blend(.add)
    circle_gradient(sun, 420, rgba(1, 0.75, 0.55, 0.35), rgba(1, 0.6, 0.5, 0))
    circle_gradient(sun, 90, rgba(1, 0.95, 0.85, 0.9), rgba(1, 0.85, 0.7, 0))
    blend(.alpha)
    # soft drifting clouds
    loop c in clouds:
        cx = (c.x - cam.x * 0.05 + t * 6.0) % 3400.0 - 300.0
        if cx < -300.0 or cx > 1600.0: continue
        col = lerp(rgba(0.85, 0.75, 0.85, 0.16), rgba(1, 0.9, 0.92, 0.13), color_t)
        clear_ = vec4(col.x, col.y, col.z, 0)
        loop k in [0..5):
            off = vec2(f32((f64(k) - 2.0) * f64(c.z) * 0.45), f32(sin(f64(k) * 1.7) * f64(c.z) * 0.12))
            circle_gradient(vec2(f32(cx), c.y) + off, f64(c.z) * (0.7 + 0.2 * f64(k % 2)), col, clear_)
    # layered hills with mist between them (watercolor depth)
    loop layer in [0..4):
        depth = 0.08 + 0.16 * f32(layer)
        far = 1.0 - f32(layer) / 3.0
        base = lerp(lerp(rgb(0.42, 0.34, 0.5), rgb(0.62, 0.58, 0.78), color_t), lerp(rgb(0.16, 0.13, 0.22), rgb(0.22, 0.28, 0.32), color_t), f32(layer) / 3.0)
        top = lerp(base, mist(), far * 0.35)
        bottom = lerp(base, mist(), 0.55)
        pts = hills[layer]
        ox = -cam.x * depth
        oy = -cam.y * depth * 0.5
        loop i in [0..pts.len() - 1):
            a = pts[i] + vec2(ox, oy)
            b = pts[i + 1] + vec2(ox, oy)
            if b.x < -200.0 or a.x > 1500.0: continue
            quad_gradient(a, b, vec2(b.x, 1400), vec2(a.x, 1400), top, top, bottom, bottom)
        # mist band in front of each layer
        my = 520.0 + f64(layer) * 40.0 + f64(oy)
        m = mist()
        rect_gradient(0, my - 120.0, w, 220, rgba(m.x, m.y, m.z, 0), rgba(m.x, m.y, m.z, 0.28))

draw_ground = (p: Rect, t: f32):
    # an organic top edge over a deep gradient body
    top = lerp(rgb(0.24, 0.22, 0.3), rgb(0.2, 0.36, 0.34), color_t)
    deep = rgb(0.05, 0.04, 0.07)
    step = 24.0
    x = f64(p.x)
    prev = vec2(p.x, p.y + f32(fbm(x * 0.03, 1.0) * 8.0 - 4.0))
    loop x < f64(p.x + p.w):
        nx = min(x + step, f64(p.x + p.w))
        cur = vec2(f32(nx), p.y + f32(fbm(nx * 0.03, 1.0) * 8.0 - 4.0))
        quad_gradient(prev, cur, vec2(cur.x, p.y + p.h), vec2(prev.x, p.y + p.h), top, top, deep, deep)
        line(prev, cur, 3, lerp(rgba(0.75, 0.7, 0.8, 0.5), rgba(0.95, 0.85, 0.6, 0.7), color_t))
        # grass tufts swaying in the wind
        gx = (prev.x + cur.x) * 0.5
        if fract_hash(f64(gx)) > 0.35:
            sway = sinf(t * 1.6 + gx * 0.05) * 5.0
            gc = lerp(rgb(0.3, 0.3, 0.36), rgb(0.35, 0.62, 0.45), color_t)
            loop b in [0..3):
                bx = gx + f32(b) * 5.0 - 5.0
                hgt = 10.0 + 8.0 * f32(fract_hash(f64(bx) * 3.1))
                triangle(vec2(bx - 2.0, prev.y + 2.0), vec2(bx + sway + f32(b - 1) * 3.0, prev.y - hgt), vec2(bx + 2.0, prev.y + 2.0), gc)
        prev = cur
        x = nx

fract_hash = (x: f64) -> f64:
    v = sin(x * 12.9898) * 43758.5453
    v - floor(v)

draw_ledge = (p: Rect):
    # a rounded stone slab
    top = lerp(rgb(0.3, 0.27, 0.36), rgb(0.42, 0.36, 0.42), color_t)
    bottom = rgb(0.1, 0.08, 0.13)
    r = f64(p.h) / 2.0
    circle(vec2(p.x + f32(r), p.y + f32(r)), r, lerp(top, bottom, 0.5))
    circle(vec2(p.x + p.w - f32(r), p.y + f32(r)), r, lerp(top, bottom, 0.5))
    rect_gradient(f64(p.x) + r, f64(p.y), f64(p.w) - r * 2.0, f64(p.h), top, bottom)
    rect(f64(p.x) + r * 0.5, f64(p.y), f64(p.w) - r, 3, lerp(rgba(0.8, 0.75, 0.85, 0.45), rgba(1, 0.9, 0.7, 0.6), color_t))

# the old tree: branches recurse; blossoms open as the light returns
draw_branch = (pos: vec2, angle: f64, len: f64, depth: int, lit: f32, t: f32):
    sway = sin(f64(t) * 0.7 + f64(pos.x) * 0.01) * 0.025 * f64(7 - depth)
    end = pos + from_angle(angle + sway) * f32(len)
    line(pos, end, f64(depth) * 3.2 + 1.5, lerp(rgb(0.1, 0.08, 0.12), rgb(0.22, 0.14, 0.16), lit))
    if depth == 0:
        # a cluster of blossoms that opens as the light returns
        n = 1 + int(4.0 * f64(lit))
        loop k in [0..n):
            off = from_angle(f64(k) * 2.4 + f64(end.x)) * f32(6.0 + 9.0 * f64(lit))
            bc = lerp(rgba(0.38, 0.34, 0.42, 0.9), hsv(0.92 + 0.12 * fract_hash(f64(end.x) + f64(k)), 0.38, 1.0), lit)
            circle(end + off, 6.0 + 7.0 * f64(lit), bc)
        if lit > 0.3:
            blend(.add)
            circle_gradient(end, 30, rgba(1, 0.8, 0.85, 0.12 * lit), rgba(1, 0.7, 0.8, 0))
            blend(.alpha)
        return
    up = -PI / 2.0
    spread = 0.32 + 0.18 * fract_hash(f64(pos.x) * 1.3 + f64(depth))
    loop side in [-1.0, 1.0]:
        a = angle + side * spread
        a = a + (up - a) * 0.18                     # branches keep reaching for the sky
        draw_branch(end, a, len * (0.68 + 0.08 * fract_hash(f64(end.y) + side)), depth - 1, lit, t)

draw_world = ():
    push_transform()
    sx = f32(random(-shake, shake))
    sy = f32(random(-shake, shake))
    translate(f64(-cam.x + sx), f64(-cam.y + sy))
    t = f32(elapsed())
    # vines hang under the ledges (drawn first, behind the stone)
    loop v in vines:
        if v.top.x < cam.x - 100.0 or v.top.x > cam.x + 1400.0: continue
        sw = sinf(t * 1.3 + v.phase) * 6.0
        line(v.top, v.top + vec2(sw, v.len), 2, lerp(rgba(0.3, 0.3, 0.38, 0.9), rgba(0.3, 0.55, 0.4, 0.9), color_t))
        circle(v.top + vec2(sw, v.len), 3, lerp(rgba(0.5, 0.45, 0.55, 1), rgba(0.95, 0.6, 0.7, 1), color_t))
    # ground and ledges
    loop p in platforms:
        if p.x > cam.x + 1400.0 or p.x + p.w < cam.x - 100.0: continue
        if p.h > 100.0: draw_ground(p, t)
        else: draw_ledge(p)
    loop th in thorns:
        r = th.rect
        n = int(r.w / 18.0)
        loop k in [0..n):
            bx = r.x + f32(k) * 18.0
            triangle(vec2(bx, r.y + r.h), vec2(bx + 9.0, r.y - 6.0 * sinf(t * 3.0 + bx)), vec2(bx + 18.0, r.y + r.h), lerp(rgb(0.4, 0.15, 0.25), rgb(0.62, 0.12, 0.28), color_t))
    # flowers wake up as the spirit passes
    loop f in flowers:
        if f.pos.x < cam.x - 50.0 or f.pos.x > cam.x + 1350.0: continue
        stem = f.pos + vec2(0, -26)
        line(f.pos, stem, 2, lerp(rgb(0.3, 0.3, 0.35), rgb(0.3, 0.55, 0.4), color_t))
        petal = lerp(rgba(0.55, 0.5, 0.6, 1), hsv(f64(f.hue % 1.0), 0.55, 1.0), f32(max(f64(f.glow), f64(color_t) * 0.6)))
        loop k in [0..5):
            circle(stem + from_angle(f64(k) * TAU / 5.0 + f64(t) * 0.2) * 6.0, 5, petal)
        if f.glow > 0.01:
            blend(.add)
            circle_gradient(stem, 40, rgba(1, 0.8, 0.6, 0.35 * f.glow), rgba(1, 0.6, 0.5, 0))
            blend(.alpha)
        circle(stem, 3, rgba(1, 0.9, 0.6, 1))
    # seeds
    blend(.add)
    loop s in seeds:
        if s.taken: continue
        bob = vec2(0, sinf(t * 2.0 + s.phase) * 6.0)
        circle_gradient(s.pos + bob, 38, rgba(1, 0.8, 0.45, 0.6), rgba(1, 0.5, 0.2, 0))
        circle(s.pos + bob, 7, rgba(1, 0.95, 0.85, 1))
    # the old tree at the end of the valley
    tree = vec2(f32(WORLD_W - 250.0), f32(GROUND_Y))
    lit = f32(collected) / f32(max(seeds.len(), 1))
    if state == .won: lit = 1.0
    circle_gradient(tree + vec2(0, -260), 340, rgba(1, 0.8, 0.6, 0.08 + 0.22 * lit), rgba(1, 0.6, 0.4, 0))
    blend(.alpha)
    draw_branch(tree, -PI / 2.0, 120.0, 7, lit, t)
    # player: a glowing spirit with a ribbon trail
    blend(.add)
    loop i in 0.. and p in player.trail:
        k = 1.0 - f32(i) / f32(player.trail.len())
        circle_gradient(p, f64(14.0 * k + 4.0), rgba(0.6, 0.85, 1, 0.35 * k), rgba(0.4, 0.6, 1, 0))
    pc = player.pos + vec2(0, -18)
    circle_gradient(pc, 70, rgba(0.7, 0.9, 1, 0.5), rgba(0.5, 0.7, 1, 0))
    blend(.alpha)
    circle(pc, 13, rgb(0.95, 0.98, 1))
    circle(pc + vec2(player.facing * 4.0, -2), 3, rgb(0.2, 0.3, 0.5))
    draw(sparks)
    pop_transform()
    draw(motes)

draw = ():
    clear(BLACK)
    # Gris-like restoration: the world is almost grey until the seeds bring its color back
    post_effects(0.7, f64(0.55 + 0.15 * color_t), 0.45, f64(0.35 + 0.85 * color_t), lerp(vec3(0.95, 0.97, 1.05), vec3(1.05, 1.0, 0.95), color_t))
    draw_background()
    if state == .title:
        text_centered("L U M E N", vec2(640, 260), 96, rgba(1, 0.95, 0.85, 1))
        text_centered("gather the light seeds and wake the old tree", vec2(640, 350), 26, rgba(1, 1, 1, 0.8))
        a = f32(0.5 + 0.5 * sin(elapsed() * 3.0))
        text_centered("press space to begin", vec2(640, 470), 28, rgba(1, 0.9, 0.6, a))
        text_centered("arrows / wasd to move   space to jump (twice for a double jump)", vec2(640, 660), 18, rgba(1, 1, 1, 0.5))
        return
    draw_world()
    text("seeds {collected} / {seeds.len()}", vec2(30, 24), 30, rgba(1, 0.9, 0.7, 1))
    text("time {play_time:.1}s   falls {deaths}", vec2(30, 64), 20, rgba(1, 1, 1, 0.6))
    if collected * 10 < seeds.len() * 6 and player.pos.x > WORLD_W - 900.0:
        text_centered("the tree needs more light...", vec2(640, 140), 26, rgba(1, 1, 1, 0.8))
    if state == .won:
        a = f32(clamp(won_time / 2.0, 0.0, 1.0))
        text_centered("the old tree awakens", vec2(640, 220), 64, rgba(1, 0.95, 0.8, a))
        text_centered("{collected} seeds in {play_time:.1} seconds - press enter", vec2(640, 300), 26, rgba(1, 1, 1, a * 0.8))

window("Lumen", 1280, 720)
build_world()
