# LUMEN - a small 2D platformer written in Sloppy.
# A spirit of light crosses four dusky valleys, gathering the scattered light seeds that bring
# their color back, to wake the old tree at the end of the last one.
# Arrows/WASD (or a gamepad) to move, Space/Up/A to jump (again in the air for a double jump),
# Escape/Start to pause. Progress and settings are saved.

build:
    output = "lumen"
    name = "Lumen"

use 'level.jo'

enum Screen: title, valleys, settings, play, paused, cleared, ending

struct Player:
    pos: vec2
    vel: vec2
    on_ground = false
    ground = -1                 # the platform stood on (drifting ledges carry the player)
    coyote: f32 = 0.0           # a moment after walking off an edge in which a jump still counts
    jumps = 0
    facing: f32 = 1.0
    trail: vec2[]

struct Settings:
    music = 0.7
    sound = 0.8
    fullscreen = false

const GRAVITY = 1900.0
const RUN = 420.0
const JUMP = 760.0
const NEEDED = 0.6              # the share of a valley's seeds that wakes its tree

screen = Screen.title
entered = 0                     # the frame the screen was entered in (its menu waits a frame)
frame = 0
settings_back = Screen.title    # where the settings screen returns to
settings = Settings()
current = 0                     # the valley being played
unlocked = 1                    # how many valleys are open
best_time: f64[] = fill(0.0, valleys.len())     # 0: not cleared yet
best_seeds: int[] = fill(0, valleys.len())

player = Player(vec2(120, 400), vec2(0, 0))
checkpoint = vec2(120, 400)
cam = vec2(0, 0)
shake = 0.0
sparks = Particles(gravity = vec2(0, -40), drag = 1.5)
motes = Particles(gravity = vec2(0, -12), drag = 0.3)
collected = 0
falls = 0
play_time = 0.0
cleared_time = 0.0
new_best = false
chime_pitch = 1.0
color_t = 0.0                   # how much color has come back to the valley
music_id = -1

# ---------------- saving ----------------
save_progress = ():
    lines = ["unlocked {unlocked}"]
    loop i in [0..valleys.len()): lines.push("valley {i} {best_time[i]} {best_seeds[i]}")
    save_data("progress", join(lines, "\n"))

save_settings = ():
    save_data("settings", "music {settings.music}\nsound {settings.sound}\nfullscreen {settings.fullscreen}")

load_saved = ():
    if let s = load_data("settings"):
        loop line in split(s, "\n"):
            w = split(line, " ")
            if w.len() < 2: continue
            if w[0] == "music": settings.music = clamp(to_float(w[1]) ?? 0.7, 0.0, 1.0)
            else if w[0] == "sound": settings.sound = clamp(to_float(w[1]) ?? 0.8, 0.0, 1.0)
            else if w[0] == "fullscreen": settings.fullscreen = w[1] == "true"
    if let s = load_data("progress"):
        loop line in split(s, "\n"):
            w = split(line, " ")
            if w.len() == 2 and w[0] == "unlocked": unlocked = clamp(to_int(w[1]) ?? 1, 1, valleys.len())
            else if w.len() == 4 and w[0] == "valley":
                i = to_int(w[1]) ?? -1
                if i >= 0 and i < valleys.len():
                    best_time[i] = to_float(w[2]) ?? 0.0
                    best_seeds[i] = to_int(w[3]) ?? 0

# ---------------- sound ----------------
snd_jump = sfx_jump()
snd_chime = sfx_chime()
snd_hit = sfx_hit()
snd_land = tone(90.0, 0.08, .sine, 0.25, 0.001, 0.07)
snd_move = tone(660.0, 0.05, .triangle, 0.2, 0.001, 0.04)
theme = mix([melody("E4 - G4 B4 - A4 G4 - E4 - D4 E4 - - . . C4 - E4 G4 - F#4 E4 - B3 - C4 D4 - - . .", 84.0, .triangle, 0.16),
             melody("E3 - - - - - - - C3 - - - - - - - A2 - - - - - - - B2 - - - - - - -", 84.0, .sine, 0.18)])

sfx = (s: Sound, volume: f64, pitch: f64 = 1.0): play(s, volume * settings.sound, pitch = pitch)

music = ():
    if music_id < 0: music_id = play(theme, settings.music, looping = true)
    set_volume(music_id, settings.music)

# ---------------- flow ----------------
go = (s: Screen):
    screen = s
    entered = frame

start_valley = (i: int):
    current = i
    build_valley(valleys[i])
    player = Player(vec2(120, 300), vec2(0, 0))
    checkpoint = player.pos
    cam = vec2(0, 0)
    collected = 0
    falls = 0
    play_time = 0.0
    chime_pitch = 1.0
    color_t = 0.0
    go(.play)

valley_cleared = ():
    cleared_time = 0.0
    new_best = best_time[current] == 0.0 or play_time < best_time[current]
    if new_best: best_time[current] = play_time
    best_seeds[current] = max(best_seeds[current], collected)
    if current + 1 < valleys.len(): unlocked = max(unlocked, current + 2)
    save_progress()
    sfx(sfx_powerup(), 0.7)
    if current + 1 == valleys.len(): go(.ending)
    else: go(.cleared)

# ---------------- playing ----------------
player_rect = (p: vec2) -> Rect: Rect(p.x - 14.0, p.y - 34.0, 28, 34)

jump_pressed = () -> bool: key_pressed(.space) or key_pressed(.up) or key_pressed(.w) or gamepad_pressed(.a)
jump_held = () -> bool: key_down(.space) or key_down(.up) or key_down(.w) or gamepad_down(.a)

move_player = (dt: f64):
    # standing on a drifting ledge: go along with it
    if player.on_ground and player.ground >= 0: player.pos += platforms[player.ground].moved
    input = input_axis()
    target = input.x * f32(RUN)
    accel = 12.0
    if not player.on_ground: accel = 6.0
    player.vel.x = f32(approach(f64(player.vel.x), f64(target), accel, dt))
    if input.x != 0.0: player.facing = sign(input.x)
    player.coyote -= f32(dt)
    if jump_pressed():
        if player.on_ground or player.coyote > 0.0:
            player.vel.y = f32(-JUMP)
            player.jumps = 1
            player.coyote = 0.0
            sfx(snd_jump, 0.5, random(0.95, 1.05))
            emit(sparks, player.pos, 10, 160.0, rgba(1, 0.9, 0.6, 0.8), 0.5, 5.0, PI, PI / 2.0)
        else if player.jumps < 2:
            player.vel.y = f32(-JUMP * 0.85)
            player.jumps = 2
            sfx(snd_jump, 0.4, 1.3)
            emit(sparks, player.pos, 16, 220.0, rgba(0.6, 0.9, 1, 0.9), 0.6, 5.0)
    # (letting go of jump early makes a lower jump)
    if player.vel.y < 0.0 and not jump_held(): player.vel.y += f32(GRAVITY * dt)
    player.vel.y = min(player.vel.y + f32(GRAVITY * dt), 1400.0)
    # horizontal, then vertical
    was_ground = player.on_ground
    nx = player.pos + vec2(player.vel.x * f32(dt), 0)
    if solid_at(player_rect(nx)) < 0: player.pos = nx
    else: player.vel.x = 0.0
    ny = player.pos + vec2(0, player.vel.y * f32(dt))
    hit = solid_at(player_rect(ny))
    player.on_ground = false
    player.ground = -1
    if hit < 0: player.pos = ny
    else:
        p = platforms[hit].rect
        if player.vel.y > 0.0:
            player.pos.y = p.y
            player.on_ground = true
            player.ground = hit
            player.coyote = 0.12
            player.jumps = 0
            if not was_ground and player.vel.y > 500.0:
                sfx(snd_land, 0.6)
                emit(motes, player.pos, 6, 80.0, rgba(1, 1, 1, 0.4), 0.6, 3.0, PI, -PI / 2.0)
        else: player.pos.y = p.y + p.h + 34.0
        player.vel.y = 0.0
    player.pos.x = clamp(player.pos.x, 20.0, f32(world_w))
    pr = player_rect(player.pos)
    loop t in thorns:
        if overlaps(pr, t): fall()
    if player.pos.y > 1400.0: fall()
    if player.on_ground and platforms[player.ground].speed == 0.0 and player.pos.x > checkpoint.x + 600.0: checkpoint = player.pos
    player.trail.insert(0, player.pos + vec2(0, -18))
    if player.trail.len() > 18: player.trail.pop()

fall = ():
    sfx(snd_hit, 0.7)
    shake = 14.0
    falls += 1
    emit(sparks, player.pos, 40, 400.0, rgba(1, 0.4, 0.3, 1), 0.8, 6.0)
    player.pos = checkpoint
    player.vel = vec2(0, 0)
    player.trail.clear()

collect_seeds = ():
    loop mut s in seeds:
        if s.taken: continue
        if circles_overlap(player.pos + vec2(0, -18), 26.0, s.pos, 18.0):
            s.taken = true
            collected += 1
            sfx(snd_chime, 0.5, chime_pitch)
            chime_pitch = min(chime_pitch * 1.06, 2.2)
            emit(sparks, s.pos, 30, 260.0, rgba(1, 0.85, 0.4, 1), 0.9, 6.0)

enough = () -> bool: f64(collected) >= f64(seeds.len()) * NEEDED

update = (dt: f64):
    frame += 1
    update(sparks, dt)
    update(motes, dt)
    if screen == .cleared or screen == .ending:
        cleared_time += dt
        if every(1, 0.4): emit(sparks, tree_pos() + vec2(0, -200), 25, 300.0, hsv(random(), 0.5, 1.0), 1.5, 7.0)
        # (the tree to the right, the words to the left)
        cam = approach(cam, vec2(tree_pos().x - 1020.0, cam.y), 2.0, dt)
    if screen != .play: return
    if key_pressed(.escape) or gamepad_pressed(.start):
        go(.paused)
        return
    play_time += dt
    move_platforms(play_time)
    move_player(dt)
    collect_seeds()
    color_t = approach(color_t, f32(f64(collected) / f64(max(seeds.len(), 1))), 1.5, dt)
    loop mut f in flowers:
        near = length(f.pos - player.pos) < 110.0
        if near: f.glow = min(f.glow + f32(dt) * 3.0, 1.0)
        else: f.glow = max(f.glow - f32(dt) * 0.15, 0.0)
    if every(2, 0.05): emit(motes, cam + vec2(f32(random(0.0, 1280.0)), 760), 1, 30.0, rgba(1, 0.9, 0.7, 0.5), 6.0, 3.0, 0.5, -PI / 2.0)
    if player.pos.x > world_w - 300.0 and enough(): valley_cleared()
    target = vec2(player.pos.x - 520.0 + player.facing * 90.0, player.pos.y - 430.0)
    cam = approach(cam, target, 4.0, dt)
    cam.y = clamp(cam.y, -200.0, 200.0)
    shake = approach(shake, 0.0, 6.0, dt)

# ---------------- drawing ----------------
draw_player = ():
    blend(.add)
    loop i in 0.. and p in player.trail:
        k = 1.0 - f32(i) / f32(player.trail.len())
        circle_gradient(p, f64(14.0 * k + 4.0), rgba(0.6, 0.85, 1, 0.35 * k), rgba(0.4, 0.6, 1, 0))
    pc = player.pos + vec2(0, -18)
    circle_gradient(pc, 70, rgba(0.7, 0.9, 1, 0.5), rgba(0.5, 0.7, 1, 0))
    blend(.alpha)
    circle(pc, 13, rgb(0.95, 0.98, 1))
    circle(pc + vec2(player.facing * 4.0, -2), 3, rgb(0.2, 0.3, 0.5))

draw_world = ():
    push_transform()
    translate(f64(-cam.x + f32(random(-shake, shake))), f64(-cam.y + f32(random(-shake, shake))))
    lit = f32(min(f64(collected) / (f64(max(seeds.len(), 1)) * NEEDED), 1.0))
    if screen == .cleared or screen == .ending: lit = 1.0
    draw_valley(cam, color_t, lit, current + 1 == valleys.len())
    draw_player()
    draw(sparks)
    pop_transform()
    draw(motes)

time_str = (t: f64) -> str:
    m = int(t / 60.0)
    "{m}:{t - f64(m) * 60.0:05.2}"

dim = (): rect(f64(visible_rect().x), f64(visible_rect().y), f64(visible_rect().z), f64(visible_rect().w), rgba(0.05, 0.03, 0.08, 0.55))

# a menu that waits for the frame after its screen was entered (the key that opened it is
# still down in that frame)
menu = (name: str, at: vec2) -> bool:
    ui_begin(name, at)
    frame > entered

draw = ():
    clear(BLACK)
    post_effects(0.7, f64(0.55 + 0.15 * color_t), 0.45, f64(0.35 + 0.85 * color_t), lerp(vec3(0.95, 0.97, 1.05), vec3(1.05, 1.0, 0.95), color_t))
    draw_background(cam, color_t)
    if screen == .title: draw_title()
    else if screen == .valleys: draw_valley_list()
    else if screen == .settings: draw_settings()
    else:
        draw_world()
        draw_hud()
        if screen == .paused: draw_pause()
        else if screen == .cleared: draw_cleared()
        else if screen == .ending: draw_ending()

draw_title = ():
    text_centered("L U M E N", vec2(640, 200), 96, rgba(1, 0.95, 0.85, 1))
    text_centered("gather the light seeds and wake the old tree", vec2(640, 280), 26, rgba(1, 1, 1, 0.8))
    on = menu("title", vec2(640, 380))
    furthest = unlocked - 1
    if unlocked > 1 or best_time[0] > 0.0:
        if ui_button("Continue: {valleys[furthest].name}") and on: start_valley(furthest)
        if ui_button("Valleys") and on: go(.valleys)
    else:
        if ui_button("Begin") and on: start_valley(0)
    if ui_button("Settings") and on:
        settings_back = .title
        go(.settings)
    when TARGET != "wasm":
        if ui_button("Quit") and on: quit()
    ui_end()
    text_centered("arrows / wasd to move   space to jump (twice for a double jump)   escape to pause", vec2(640, 680), 18, rgba(1, 1, 1, 0.5))

draw_valley_list = ():
    text_centered("Valleys", vec2(640, 150), 64, rgba(1, 0.95, 0.85, 1))
    on = menu("valleys", vec2(640, 290))
    loop i in 0.. and v in valleys:
        label = "{i + 1}. {v.name}"
        if best_time[i] > 0.0: label = "{label}   best {time_str(best_time[i])}"
        if i >= unlocked: label = "{i + 1}. ..."
        if ui_button(label, i < unlocked) and on: start_valley(i)
    if (ui_button("Back") or ui_back()) and on: go(.title)
    ui_end()

draw_settings = ():
    text_centered("Settings", vec2(640, 150), 64, rgba(1, 0.95, 0.85, 1))
    on = menu("settings", vec2(640, 300))
    was = settings
    settings.music = ui_slider("Music", settings.music)
    settings.sound = ui_slider("Sounds", settings.sound)
    when TARGET != "wasm":
        settings.fullscreen = ui_switch("Fullscreen", settings.fullscreen)
    back = ui_button("Back") or ui_back()
    ui_end()
    if settings.sound != was.sound: sfx(snd_move, 0.8)
    if settings.music != was.music: music()
    if settings.fullscreen != was.fullscreen: set_fullscreen(settings.fullscreen)
    if back and on:
        save_settings()
        go(settings_back)

draw_hud = ():
    if screen == .ending: return
    need = int(ceil(f64(seeds.len()) * NEEDED))
    text("{valleys[current].name}", vec2(30, 20), 22, rgba(1, 1, 1, 0.55))
    text("seeds {collected} / {need}", vec2(30, 48), 30, rgba(1, 0.9, 0.7, 1))
    text("{time_str(play_time)}   falls {falls}", vec2(30, 86), 20, rgba(1, 1, 1, 0.6))
    if screen == .play and not enough() and player.pos.x > world_w - 900.0:
        text_centered("the tree needs more light...", vec2(640, 160), 26, rgba(1, 1, 1, 0.8))

draw_pause = ():
    dim()
    text_centered("Paused", vec2(640, 200), 64, rgba(1, 0.95, 0.85, 1))
    on = menu("pause", vec2(640, 320))
    if (ui_button("Resume") or ui_back() or gamepad_pressed(.start)) and on: go(.play)
    if ui_button("Start the valley again") and on: start_valley(current)
    if ui_button("Settings") and on:
        settings_back = .paused
        go(.settings)
    if ui_button("Leave to the title") and on: go(.title)
    ui_end()

draw_cleared = ():
    a = f32(clamp(cleared_time / 1.5, 0.0, 1.0))
    text_centered("the tree blossoms", vec2(440, 190), 64, rgba(1, 0.95, 0.8, a))
    line1 = "{collected} of {seeds.len()} seeds in {time_str(play_time)}"
    if new_best and best_time[current] == play_time: line1 = "{line1}   (a new best)"
    text_centered(line1, vec2(440, 260), 26, rgba(1, 1, 1, a * 0.85))
    if cleared_time < 1.0: return
    on = menu("cleared", vec2(440, 360))
    if ui_button("On to {valleys[current + 1].name}") and on: start_valley(current + 1)
    if ui_button("This valley again") and on: start_valley(current)
    if ui_button("Title") and on: go(.title)
    ui_end()

draw_ending = ():
    a = f32(clamp(cleared_time / 3.0, 0.0, 1.0))
    text_centered("the old tree awakens", vec2(440, 170), 72, rgba(1, 0.95, 0.8, a))
    text_centered("and the valleys are bright again", vec2(440, 245), 28, rgba(1, 1, 1, a * 0.85))
    total = 0.0
    loop t in best_time: total += t
    text_centered("all four valleys: {time_str(total)} (best times)", vec2(440, 300), 24, rgba(1, 0.9, 0.7, a * 0.85))
    text_centered("made with Sloppy  -  sloppy-lang.org", vec2(440, 640), 20, rgba(1, 1, 1, a * 0.5))
    if cleared_time < 3.0: return
    on = menu("ending", vec2(440, 420))
    if ui_button("Title") and on: go(.title)
    ui_end()

window("Lumen", 1280, 720)
load_saved()
when TARGET != "wasm":
    if settings.fullscreen: set_fullscreen(true)
build_valley(valleys[0])
music()
