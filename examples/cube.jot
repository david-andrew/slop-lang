# Custom GPU shaders written in Jot: a spinning, lit cube.
struct Vertex:
    pos: vec3
    normal: vec3
    color: vec3

struct Params:
    mvp: mat4
    model: mat4
    light_dir: vec3
    time: f32

struct Varying:
    pos: vec4
    normal: vec3
    color: vec3

cube_vs = (v: Vertex, u: Params) -> Varying:
    n = (u.model * vec4(v.normal, 0)).xyz
    Varying(u.mvp * vec4(v.pos, 1), n, v.color)

cube_fs = (i: Varying, u: Params) -> vec4:
    light = max(dot(normalize(i.normal), normalize(u.light_dir)), 0.0)
    pulse = 0.85 + 0.15 * sin(u.time * 3.0)
    vec4(i.color * (0.25 + 0.75 * light) * pulse, 1)

make_cube = () -> Vertex[]:
    out: Vertex[]
    faces = [(vec3(1, 0, 0), vec3(0, 1, 0)), (vec3(-1, 0, 0), vec3(0, 1, 0)), (vec3(0, 1, 0), vec3(0, 0, 1)),
              (vec3(0, -1, 0), vec3(0, 0, 1)), (vec3(0, 0, 1), vec3(0, 1, 0)), (vec3(0, 0, -1), vec3(0, 1, 0))]
    loop f in faces:
        n = f.0
        up = f.1
        side = cross(n, up)
        c = abs(n) * 0.6 + vec3(0.3, 0.3, 0.3)
        corners = [n + up + side, n + up - side, n - up - side, n - up + side]
        loop k in [0, 1, 2, 0, 2, 3]: out.push(Vertex(corners[k] * 0.5, n, c))
    out

prog = make_shader(shader(cube_vs, cube_fs))
cube = mesh(make_cube())
t = 0.0

update = (dt: f64): t += dt

draw = ():
    clear(rgb(0.05, 0.06, 0.1))
    glEnable(GL_DEPTH_TEST)
    model = rotation_y(t) * rotation_x(t * 0.7)
    proj = perspective(1.0, aspect_ratio(), 0.1, 100.0)
    view = look_at(vec3(0, 0, 3), vec3(0, 0, 0), vec3(0, 1, 0))
    draw(prog, cube, Params(proj * view * model, model, vec3(0.5, 1, 0.8), f32(t)))
    glDisable(GL_DEPTH_TEST)
    text("custom Jot shader", vec2(20, 20), 24)
