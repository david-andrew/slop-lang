fannkuch = (n: int) -> (int, int):
    perm = fill(0, n)
    perm1 = fill(0, n)
    count = fill(0, n)
    loop i in [0..n): perm1[i] = i
    max_flips = 0
    checksum = 0
    r = n
    nperm = 0
    loop true:
        loop r != 1:
            count[r - 1] = r
            r -= 1
        loop i in [0..n): perm[i] = perm1[i]
        flips = 0
        k = perm[0]
        loop k != 0:
            i = 0
            j = k
            loop i < j:
                t = perm[i]
                perm[i] = perm[j]
                perm[j] = t
                i += 1
                j -= 1
            flips += 1
            k = perm[0]
        if flips > max_flips: max_flips = flips
        if nperm % 2 == 0: checksum += flips
        else: checksum -= flips
        loop true:
            if r == n: return (checksum, max_flips)
            p0 = perm1[0]
            loop i in [0..r): perm1[i] = perm1[i + 1]
            perm1[r] = p0
            count[r] -= 1
            if count[r] > 0: break
            r += 1
        nperm += 1
    (0, 0)

c, m = fannkuch(10)
print(c)
print("Pfannkuchen(10) = {m}")
