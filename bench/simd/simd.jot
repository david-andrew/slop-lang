# Loops the release compiler vectorizes (AVX2 where the processor has it, else SSE2; force the
# second with JOT_NO_AVX=1), over arrays that fit in the cache: nanoseconds per element, next to
# bench/simd/simd.c. Lines: "<name> <ns per element> <a result>".
build:
    opt = release

axpy = (ys: mut f32[], xs: f32[], a: f32):
    loop i in [0..ys.len()): ys[i] = ys[i] + a * xs[i]

scale = (ys: mut f64[], xs: f64[], k: f64):
    loop i in [0..ys.len()): ys[i] = xs[i] * k + 1.0

iadd = (ys: mut i32[], xs: i32[]):
    loop i in [0..ys.len()): ys[i] = ys[i] + xs[i] * 3

const N = 4096
const R = 20000

main = ():
    ns = (t: f64) -> str: "{t * 1e9 / f64(R * N):.3}"
    ys = fill(f32(1), N)
    xs = [loop i in [0..N): f32(i) * 0.5]
    t = time()
    loop _ in [0..R): axpy(ys, xs, 0.001)
    print("axpy_f32 {ns(time() - t)} {ys[100]}")
    a = fill(0.0, N)
    b = [loop i in [0..N): f64(i)]
    t = time()
    loop _ in [0..R): scale(a, b, 0.5)
    print("scale_f64 {ns(time() - t)} {a[100]}")
    p = fill(i32(1), N)
    q = [loop i in [0..N): i32(i)]
    t = time()
    loop _ in [0..R): iadd(p, q)
    print("iadd_i32 {ns(time() - t)} {p[100]}")
    d = [loop i in [0..N): f64(i)]
    e = fill(1.5, N)
    t = time()
    loop _ in [0..R / 10): d = d .+ e .* 0.016
    print("dotted_f64 {f64(time() - t) * 1e9 / f64(R / 10 * N):.3} {d[10]}")
