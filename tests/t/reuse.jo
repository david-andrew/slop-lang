# requires: sloppy
# Freed memory is handed out again without zeroing where every byte is written first. Fill the
# allocator with junk, then build arrays every way that makes them longer.
struct P:
    name: str = "p"
    hp = 7
    tag: int? = none

junk = ():
    loop r in [0..40):
        a = [loop i in [0..r * 37 + 5): -1 - i]
        b = [loop i in [0..r * 11 + 3): "junk{i}"]
        c = [loop i in [0..r * 5 + 2): P("x{i}", -99, 12345)]
        if a.len() + b.len() + c.len() == 0: print("never")

main = ():
    junk()
    zs = fill(0, 300)
    print("zeros {zs.sum()} {zs.len()}")
    fs = fill(0.0, 50)
    print("fzeros {fs.sum()}")
    junk()
    os: int?[] = fill(none, 20)
    print("nones {os.filter((o): o != none).len()}")
    junk()
    rs: int[]
    rs.resize(100)
    print("resized {rs.sum()}")
    junk()
    ss: str[]
    ss.reserve(64)
    loop i in [0..10): ss.push("s{i}")
    ss.resize(14)
    print("strs {ss.join(",")}|")
    junk()
    ps: P[]
    ps.reserve(16)
    ps.push(P())
    ps.push(P(name = "q"))
    ps.insert(1, P(hp = 3))
    ps.resize(5)
    loop p in ps: print("{p.name} {p.hp} {p.tag}")
    junk()
    xs = [1.5, 2.5, 3.5, 4.5, 5.5]
    ys = xs .* 2.0 .+ 1.0
    print("dotted {ys}")
    names = ["a", "b", "c"]
    print("dotted str {names .+ "!"}")
    junk()
    m: {int: str} = {}
    loop i in [0..200): m[i * 7] = "v{i}"
    print("map {m.len()} {m[0]} {m[1393]} {m.get(5)}")
    b = ""
    loop i in [0..300): b = "{b}{i % 10}"
    print("built {b.len()} {b[295..]}")
    inner = fill(fill(0, 3), 4)
    print("nested {inner}")
