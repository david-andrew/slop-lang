# requires: sloppy
# loops the release compiler runs several elements at a time (AVX2, or SSE2 with SLOPPY_NO_AVX=1)
# must give exactly what one element at a time gives, for every length and arrangement
axpy = (ys: mut f32[], xs: f32[], a: f32):
    loop i in [0..ys.len()): ys[i] = ys[i] + a * xs[i]

blend = (out: mut f64[], a: f64[], b: f64[], t: f64):
    loop i in [0..out.len()): out[i] = a[i] * (1.0 - t) + b[i] * t

clampish = (xs: mut f32[], lo: f32, hi: f32):
    loop i in [0..xs.len()): xs[i] = min(max(xs[i], lo), hi)

ints = (ys: mut i32[], xs: i32[], k: i32):
    loop i in [0..ys.len()): ys[i] = (ys[i] + xs[i] * k) xor 5

longs = (ys: mut int[], xs: int[]):
    loop i in [0..ys.len()): ys[i] = ys[i] - xs[i] + 7

copy_from = (ys: mut f32[], xs: f32[], from: int):
    loop i in [from..ys.len()): ys[i] = xs[i] / 4.0

shift_left = (xs: mut f32[]):
    # each element reads the next one: not independent
    loop i in [0..xs.len() - 1): xs[i] = xs[i + 1] * 2.0

total = (xs: f32[]) -> f32:
    # a sum keeps its order
    s: f32 = 0.0
    loop i in [0..xs.len()): s += xs[i]
    s

h = (xs: f32[]) -> str:
    s: f32 = 0.0
    loop i in 0.. and x in xs: s += x * f32(i % 7 + 1)
    "{s}"

main = ():
    loop n in [0, 1, 3, 4, 5, 7, 8, 9, 15, 16, 17, 33, 100]:
        ys = [loop i in [0..n): f32(i) * 0.25]
        xs = [loop i in [0..n): f32(n - i) * 1.5 + 0.1]
        axpy(ys, xs, 0.3)
        clampish(ys, 0.5, 9.0)
        d = fill(0.0, n)
        da = [loop i in [0..n): f64(i) / 3.0]
        db = [loop i in [0..n): f64(i * i)]
        blend(d, da, db, 0.25)
        iy = [loop i in [0..n): i32(i * 3)]
        ix = [loop i in [0..n): i32(100 - i)]
        ints(iy, ix, 7)
        ly = [loop i in [0..n): i * 1000000007]
        longs(ly, ly)
        c = fill(f32(-1), n)
        copy_from(c, xs, n / 3)
        sl = xs
        shift_left(sl)
        dl = 0.0
        il: i32 = 0
        ll = 0
        if n > 0:
            dl = d[n - 1]
            il = iy[n - 1]
            ll = ly[n - 1]
        print(n, h(ys), dl, il, ll, h(c), h(sl), total(xs))
    # the same array as both arguments (an update in place)
    zs = [loop i in [0..20): f32(i)]
    axpy(zs, zs, 1.0)
    print(h(zs))
    # an array and a copy of it sharing storage until written
    a = [loop i in [0..20): f32(i)]
    b = a
    axpy(a, b, 0.5)
    print(h(a), h(b))
