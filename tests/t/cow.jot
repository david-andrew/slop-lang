# copy-on-write must hold even when the optimizer hoists uniqueness checks out of loops
fn zero_all(xs: mut [int]):
    for i in 0..xs.len(): xs[i] = 0

fn keep(xs: [int]) -> [int]: xs

g: [[int]]

fn stash(xs: [int]): g.push(xs)

fn main():
    a := [1, 2, 3]
    b := a                       # shared before the loop
    for i in 0..3: a[i] = 0
    print(a, b)
    c := [1, 2, 3]
    for i in 0..3:
        d := c                   # a copy made inside the loop
        c[i] = 9
        print(d, c)
    x := [5, 6]
    y := x
    zero_all(x)
    print(x, y)
    e := [1, 2, 3]
    for i in 0..3:
        stash(e)                 # escapes through a call
        e[i] = i * 10
    print(e, g)
    f := [1, 2]
    for i in 0..2:
        h := keep(f)
        f[i] = 7
        print(h)
    m := [3, 1, 2]
    for i in 0..3:
        m.push(i)
        m[i] = m[i] * 2
    print(m)
    n := [[1, 2], [3, 4]]
    snap := n
    for i in 0..2: n[i][0] = 0
    print(n, snap)
    k := [1, 2, 3]
    for v in k: k[0] += v        # iterating over a snapshot of k
    print(k)
