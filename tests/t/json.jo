# requires: sloppy
# parse_json, reading with get/at/as_*, to_json, and where errors are
text = "\{ \"name\": \"map\", \"width\": 30, \"ok\": true, \"pi\": -3.5e2, \"none\": null,\n  \"layers\": [ \{\"name\": \"ground\", \"data\": [1, 2, 0]}, \{\"name\": \"\\u00e9t\\u00e9 \\ud83d\\ude00 \\\"q\\\"\"} ] }"
j = parse_json(text)
if j is JsonError: print("error {j.message} at {j.line}:{j.column}")
else:
    print(j.get("width").as_int() ?? -1)
    print(j.get("layers").at(1).get("name").as_str() ?? "?")
    print(j.get("pi").as_num() ?? 0.0, j.get("ok").as_bool() ?? false, j.get("none").is_null(), j.get("missing").at(3).as_int() ?? 7)
    loop l in j.get("layers").as_list(): print(l.get("name").as_str() ?? "", l.get("data").as_list().len())
    print(keys(j))
    print(to_json(j))
    print(to_json(j.get("layers").at(0)!, 2))
    again = parse_json(to_json(j))
    if again is Json: print(to_json(again) == to_json(j))
loop bad in ["[1, 2", "\{\"a\" 1}", "tru", "[1,]", "\"abc", "1 2", "\n\n  [x]"]:
    r = parse_json(bad)
    if r is JsonError: print("{r.line}:{r.column} {r.message}")
