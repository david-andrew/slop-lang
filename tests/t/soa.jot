# requires: jot
# soa T[]: an array of structs stored as one array per field
struct P:
    x: f64
    y: f64
    alive: bool = true

main = ():
    ps: soa P[]
    ps.push(P(1.0, 2.0))
    ps.push(P(3.0, 4.0, false))
    ps.push(P(x = 5.0, y = 6.0))
    print(ps.len(), len(ps), ps[1], ps[2].x)
    ps[0].x += 10.0
    ps[1] = P(-1.0, -2.0)
    print(ps.x, ps.y, ps.alive)
    total = 0.0
    loop p in ps: total += p.x * p.y
    print(total)
    loop i in 0.. and p in ps: print(i, p.y)
    ps.x = ps.x .+ ps.y .* 0.5
    print(ps.x)
    last = ps.pop()
    print(last, ps.len())
    first = ps.remove(0)
    print(first, ps.len(), ps[0])
    qs: soa P[] = [P(7.0, 8.0), P(9.0, 10.0)]
    print(qs.len(), qs[1].y)
    qs.clear()
    print(qs.len())
