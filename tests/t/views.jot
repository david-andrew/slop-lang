# requires: jot
# `b = xs[i]` is a copy; release builds may make b the element itself when that cannot be
# told apart. These are the cases where it can: the copy must stay a copy.
struct P:
    name: str
    hp: int
    pos: vec2

G: P[]
hook: () -> void = (): pass

hurt_global = (): G[0].hp -= 50
grow_global = (): G.push(P("late", 1, vec2(9, 9)))
reads_global = () -> int: G[0].hp
hurt = (ps: mut P[]): ps[0].hp -= 7

through_mut = (ps: mut P[]):
    b = ps[0]
    hurt_global()               # ps may be G
    print("mut param: {b.hp} now {ps[0].hp}")

total_hp = (b: P) -> int: b.hp

main = ():
    xs = [P("ann", 100, vec2(1, 2)), P("bob", 80, vec2(3, 4))]
    # written in place while b is used
    b = xs[0]
    xs[0].hp = 5
    print("{b.name} {b.hp} / {xs[0].hp}")
    # resized while b is used (the storage may move)
    c = xs[1]
    loop k in [0..50): xs.push(P("x{k}", k, vec2(0, 0)))
    print("{c.name} {c.hp} {c.pos}")
    # handed to a function that changes it
    d = xs[0]
    hurt(xs)
    print("{d.hp} / {xs[0].hp}")
    # changed by `loop mut`
    e = xs[1]
    loop mut p in xs: p.hp += 1
    print("{e.hp} / {xs[1].hp}")
    # a global, changed by a function
    G = [P("gil", 300, vec2(0, 0))]
    f = G[0]
    hurt_global()
    print("{f.hp} / {G[0].hp}")
    # ... by a function that grows it
    g = G[0]
    grow_global()
    print("{g.name} {g.hp} / {G.len()}")
    # ... by a function value
    hook = (): G[0].hp = 1
    h = G[0]
    hook()
    print("{h.hp} / {G[0].hp}")
    # a mut parameter that is the global
    through_mut(G)
    # only read while b is used: the same either way
    i = G[0]
    print("read: {i.name} {i.hp} {reads_global()} {total_hp(i)} {i.pos.x + i.pos.y}")
    kept: P[]
    j = xs[2]
    kept.push(j)
    xs.clear()
    print("kept: {kept[0].name} {kept[0].hp} {xs.len()}")
    # a view in a loop, with the array written after the last use
    ys = [P("p", 1, vec2(1, 0)), P("q", 2, vec2(0, 1)), P("r", 3, vec2(1, 1))]
    s = 0
    loop i2 in [0..ys.len()):
        a = ys[i2]
        s += a.hp * 10 + int(a.pos.x)
        ys[i2].hp = a.hp + 100
    print("{s} {ys[0].hp} {ys[2].hp}")
    # a part of an element
    t = ys[1].pos
    ys[1].pos = vec2(7, 7)
    print("{t} {ys[1].pos}")
    tup = [(1, "one"), (2, "two")]
    u = tup[1]
    tup[1] = (3, "three")
    print("{u.0} {u.1} {tup[1].1}")

