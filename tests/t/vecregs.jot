# requires: jot
# vector values that release builds keep in registers (one per lane) must behave as in memory
struct Body:
    pos: vec2
    vel: vec3
    tint: vec4

spin = (v: vec2, a: f32) -> vec2: vec2(v.x * cos(a) - v.y * sin(a), v.x * sin(a) + v.y * cos(a))

main = ():
    a = vec2(1, 2)
    b = vec2(3, -4)
    c = a + b * 2.0 - b / 4.0
    c.x += 1.0
    c.y = c.y * c.x
    print(c, length(c), length_sq(a - b), dot(a, b))
    d = 2.0 * c
    d -= a
    print(d, d == vec2(f32(d.x), f32(d.y)), d != c)
    v3 = vec3(1, 2, 3)
    w3 = v3 * v3 + vec3(0.5)
    w3.z -= 10.0
    print(w3, cross(v3, w3), normalize(vec3(3, 0, 4)))
    v4 = vec4(1, 2, 3, 4)
    v4 = v4 / 2.0 + vec4(v3, 1.0)
    v4.w = v4.x + v4.y
    print(v4)
    bs = [Body(a, v3, v4), Body(b, w3, vec4(0))]
    loop mut x in bs:
        x.pos += vec2(1, 1) * 0.5
        x.vel = x.vel * 2.0
        x.tint.y = 7.0
    p = bs[0].pos
    q = spin(p, 0.5)
    bs[1].pos = q - p
    print(bs[0].pos, bs[1].pos, bs[0].vel, bs[1].tint)
    acc = vec2(0, 0)
    loop i in [0..10):
        acc += vec2(f32(i), 1) / f32(i + 1)
        if i % 3 == 0: acc.x -= 0.25
    print(acc)
    t = (vec2(1, 1), vec2(2, 2))
    u = t.0 + t.1
    print(u, [vec2(5, 6), u + a].len())
