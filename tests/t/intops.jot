# integer semantics the optimizer must preserve
show = (xs: int[]): print(xs)
vals = [-17, -16, -9, -8, -1, 0, 1, 7, 8, 9, 16, 17]
d2: int[]
d8: int[]
m8: int[]
loop v in vals:
    d2.push(v / 2)
    d8.push(v / 8)
    m8.push(v % 8)
show(d2)
show(d8)
show(m8)
u: u64 = 0xFFFFFFFFFFFFFFF0
print(u / 16, u % 16, u >> 60)
x = 0x7FFFFFFFFFFFFFFF
x += 1
print(x, x - 1)
i: i32 = 2147483647
i += 1
print(i)
b: u8 = 250
b += 10
print(b)
k = 5
print(k * 0, k * 1, k * 8, k << 3, -k >> 1, k & 4, k | 2, (k xor 7), ~k)
n = 1
loop _ in [0..70): n = n * 3 + 1
print(n)
noinline = (a: int, b: int) -> int: a * b - a / (b | 1)
acc = 0
loop j in [0..1000): acc += noinline(j, j % 13) % 7
print(acc)
f = 1.0
loop _ in [0..10): f = f * 1.5 - 0.25
print(f)
print(int(-3.7), int(3.7), f64(7) / 2, 7 / 2)
