# requires: jot (list comprehensions)
fn main():
    xs := [3, 1, 4, 1, 5, 9, 2, 6]
    print([x * x for x in xs])
    print([x for x in xs if x > 2])
    print([(i, x) for i, x in xs if i % 2 == 0])
    print([x * 10 + y for x in 0..3 for y in 0..2])
    names := ["ann", "bo", "cyd"]
    print([n.upper() for n in names if len(n) > 2])
    grid := [[r * 3 + c for c in 0..3] for r in 0..3]
    print(grid)
    print([float(x) / 2.0 for x in 0..4])
    k := 7
    print([x + k for x in [1, 2]], [x for x in xs if x > 100])
