# requires: jot
# unit literals: SI values (seconds, meters, kilograms, radians, newtons) folded at compile time
print(120ms, 2min, 1.5h, 250us)
print(3km, 25cm, 4mm, 2kg, 500g)
print(90deg, 0.5turn, 1rad, 10N)
print(1.2(m/s), 36(km/h), 9.81(m/s^2), 2(N*m))
print([1.2 0](m/s), [36 72](km/h), [1 2; 3 4](mm))
x = 2.0
print([x 1](cm))
delay = 16ms
print(delay * 60.0)
