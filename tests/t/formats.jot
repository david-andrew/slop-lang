# format specs ([[fill]align][+][0][width][,][.prec][type]), ** and other Python-familiar helpers
# requires: jot (** is not in the C bootstrap compiler)
print("[{"ab":<6}] [{"ab":>6}] [{"ab":^6}] [{"ab":*^7}] [{"ab"}]")
print("[{42:5}] [{42:<5}] [{42:05}] [{-42:05}] [{42:+}] [{1234567:,}] [{-1234567:_}]")
print("[{3.14159:.2}] [{3.14159:8.3}] [{3.14159:<8.3}] [{-2.5:08.2}] [{0.256:.1%}] [{1234567.891:,.2}]")
print("[{255:x}] [{255:X}] [{255:08b}] [{8:o}] [{-255:x}] [{1.5:f}]")
x = 7
print("[{x:>4}] [{x * 2:03}] [{{literal}}]")
y = 3.0
print(y ^ 2, 2 ^ 10, -2 ^ 2, 2 ^ -1.0, 2 ^ 3 ^ 2, (1 + 1) ^ 0.5)
z: f32 = 1.5
print(z ^ 2.0, 10 ^ 2 * 3)
print(trim("--a-b--", "-"), trim("  x "), ", ".join(["a", "b", "c"]), join(["a", "b"], "+"))
m = {"a": 1}
print(m.get("a", 0), m.get("b", 0), m.get("b") == none)
