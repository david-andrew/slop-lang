# first-class functions, closures, partial application, generics over functions
apply = (f: (int) -> int, x: int) -> int: f(x)
twice = (f, x): f(f(x))
compose = (f: (int) -> int, g: (int) -> int) -> (int) -> int: (x: int): g(f(x))

make_adder = () -> (int) -> int:
    k = 10
    f = (x: int): x + k       # (closures share variables: see shared.jot)
    f
print(make_adder()(1))
print(apply((x): x * x, 7))
print(twice((x: int): x + 3, 1))
print(twice((s: str): s + "!", "hi"))
add = (a: int, b: int): a + b
inc = add(1, _)
dec = add(_, -1)
print(inc(41), dec(43))
sq_then_inc = compose((x): x * x, inc)
print(sq_then_inc(5))
fs: ((int) -> int)[]
loop i in [0..4): fs.push((x: int): x * i)
out: int[]
loop f in fs: out.push(f(10))
print(out)
nums = [5, 3, 9, 1, 7]
print(nums.map((x): x * 2))
print(nums.filter((x): x > 4))
total = 0
nums.each((x): print(x))
names = ["carol", "al", "bob"]
names.sort_by((s): len(s))
print(names)
# closure capturing an array and a string (refcounted captures)
tag = "item"
xs = [1, 2, 3]
label = (i: int): "{tag}-{xs[i]}"
xs.push(4)
print(label(0), label(2), xs.len())
