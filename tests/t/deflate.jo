# deflate: what inflate reads back, and PNG files that decode to the same pixels
# requires: sloppy
tests: u8[][]
tests.push([])
tests.push(bytes("a"))
tests.push(bytes("hello hello hello hello hello world"))
r: u8[]
seed = 12345
loop i in [0..200000):
    seed = (seed * 1103515245 + 12345) % 2147483648
    if i % 3 == 0: r.push(u8(seed % 7))
    else: r.push(u8((i / 100) % 256))
tests.push(r)
z: u8[] = fill(u8(0), 100000)
tests.push(z)
rnd: u8[]
loop i in [0..50000):
    seed = (seed * 1103515245 + 12345) % 2147483648
    rnd.push(u8((seed >> 16) % 256))
tests.push(rnd)
txt = ""
loop i in [0..3000): txt += "line {i}: the quick brown fox {i % 17} jumps\n"
tests.push(bytes(txt))
loop i in 0.. and t in tests:
    d = deflate(t)
    rt = inflate(d) ?? [u8(1)]
    print(i, t.len(), d.len(), rt == t)
img = image(300, 200, vec4(0.2, 0.3, 0.4, 1))
loop y in [0..200):
    loop x in [0..300):
        if (x / 20 + y / 20) % 2 == 0: img.set(x, y, vec4(f32(x) / 300.0, f32(y) / 200.0, 0.5, 1))
png = encode_png(img)
back = load_png(png) ?? image(1, 1, BLACK)
print(back.pixels == img.pixels, png.len() < 5000)
