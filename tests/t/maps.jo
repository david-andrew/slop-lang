# maps: insertion order, update, delete, value semantics, iteration
# requires: sloppy (uses features the C bootstrap compiler does not implement)
ages: {str: int} = {}
ages["bob"] = 30
ages["al"] = 25
ages["cy"] = 41
ages["bob"] += 1
print(ages.len(), ages["bob"], ages.get("zed") ?? -1)
loop k, v in ages: print(k, v)
copy = ages
copy["al"] = 99
print(ages["al"], copy["al"])
ages.remove("al")
print(ages.len(), ages.has("al"), ages.has("cy"))
counts: {int: int} = {}
loop i in [0..1000): counts[i % 7] = (counts.get(i % 7) ?? 0) + 1
total = 0
loop k, v in counts: total += v
print(counts.len(), total, counts[0], counts[6])
m = {"x": 1.5, "y": 2.5}
print(m["x"] + m["y"])
keys: str[]
loop k, v in m: keys.push(k)
print(keys)
