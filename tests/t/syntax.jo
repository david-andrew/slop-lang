# requires: sloppy
# assorted syntax: Array[T], ^=, end, inline fields, comprehensions, steps, or-loops, ranges as values
struct Rect: w: f64; h: f64
main = ():
    a: Array[int] = [1, 2]
    print(a)
    x = 3
    x ^= 2
    print(x)
    xs = [10 20 30 40]
    print(xs[end], xs[1..end-1])
    print(Rect(1.0, 2.0))
    print([loop i in xs i / 10])
    loop i in 0,2..8: print(i)
    print([0, 3..9], [loop k in 10,7..0: k])
    loop p in [1, 2] or q in ["a", "b", "c"]: print(p, q)

rv = ():
    x = 5
    print(x in 1..10, x in [6..9], 10 in [1..10), x * 2 in 1..)
    r = [1..4]
    print(r, r.map((v): v * v), sum([1..100]))
rv()
