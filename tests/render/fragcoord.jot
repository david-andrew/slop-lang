# the fragment shader's position field is gl_FragCoord (window pixels, depth, 1/w)
struct V:
    pos: vec3
struct U:
    mvp: mat4
struct O:
    pos: vec4
    h: f32
fn vs(v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1), v.pos.y)
fn fs(i: O, u: U) -> vec4: vec4(i.pos.x / 1280.0, i.pos.y / 720.0, i.pos.z, 1)
sh := make_shader(shader(vs, fs))
m := mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
fn draw():
    clear()
    draw(sh, m, U(mat4()))
