# triangle strips and fans (with and without indices) draw like a GPU draws them
struct V:
    pos: vec3
    color: vec4
struct U:
    mvp: mat4
struct O:
    pos: vec4
    color: vec4
fn vs(v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1), v.color)
fn fs(i: O, u: U) -> vec4: i.color
sh := make_shader(shader(vs, fs))
strip := mesh([V(vec3(-0.9, -0.1, 0), vec4(1, 0, 0, 1)), V(vec3(-0.9, -0.9, 0), vec4(0, 1, 0, 1)),
               V(vec3(-0.5, -0.1, 0), vec4(0, 0, 1, 1)), V(vec3(-0.5, -0.9, 0), vec4(1, 1, 0, 1)),
               V(vec3(-0.1, -0.1, 0), vec4(0, 1, 1, 1))], [], GL_TRIANGLE_STRIP)
fan_v := [V(vec3(0.5, 0.5, 0), vec4(1, 1, 1, 1))]
for k in 0..7:
    a := float(k) * 0.9
    fan_v.push(V(vec3(f32(0.5 + 0.4 * cos(a)), f32(0.5 + 0.4 * sin(a)), 0), vec4(f32(k) / 7.0, 0.3, 1.0 - f32(k) / 7.0, 1)))
fan := mesh(fan_v, [u32(0), 1, 2, 3, 4, 5, 6, 7], GL_TRIANGLE_FAN)
fn draw():
    clear()
    glEnable(GL_CULL_FACE)
    draw(sh, strip, U(mat4()))
    draw(sh, fan, U(mat4()))
