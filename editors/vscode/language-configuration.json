{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""], ["'", "'"]],
  "folding": { "offSide": true },
  "indentationRules": {
    "increaseIndentPattern": "^[^#]*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*else\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    { "beforeText": "^[^#]*:\\s*(#.*)?$", "action": { "indent": "indent" } },
    { "beforeText": "^\\s+(return|break|continue|pass)\\b.*$", "action": { "indent": "outdent" } }
  ],
  "wordPattern": "[A-Za-z_\\u0080-\\uffff][A-Za-z0-9_\\u0080-\\uffff]*|-?\\d[\\d_]*(\\.\\d+)?"
}
